constant folding:
  in : (>= (+ 1 2) (* 2 3))
  status: 1
  out: (>= 3 6)
(* 1 (f)) -> (f):
  in : (>= (* 1 (f)) 2)
  status: 1
  out: (>= (f) 2)
(+ 0 (f)) and (- (f) 0) -> (f):
  in : (>= (+ 0 (f)) (- (f) 0))
  status: 1
  out: (>= (f) (f))
(* 0 (f)) -> 0:
  in : (>= (* 0 (f)) 1)
  status: 1
  out: (>= 0 1)
multiplication constants folded:
  in : (>= (* 2 (* 3 (f))) 1)
  status: 1
  out: (>= (* 6 (f)) 1)
integral float recast to int:
  in : (>= 2 1)
  status: 1
  out: (>= 2 1)
