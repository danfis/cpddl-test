Predicate[4]:
    =: 0 0 :: read: 0, write: 0, in-init: 0
    tree_cell: 1 :: read: 1, write: 1, in-init: 1
    low_tree_cell: 1 :: read: 1, write: 1, in-init: 0
    crafting_table_cell: 1 :: read: 1, write: 0, in-init: 1
Function[7]:
    count_log_in_inventory: :: read: 1, write: 1, in-init: 1
    count_planks_in_inventory: :: read: 1, write: 1, in-init: 1
    count_stick_in_inventory: :: read: 1, write: 1, in-init: 1
    count_sack_polyisoprene_pellets_in_inventory: :: read: 1, write: 1, in-init: 1
    count_tree_tap_in_inventory: :: read: 1, write: 1, in-init: 1
    count_pogo_stick: :: read: 1, write: 1, in-init: 1
    toxicity: :: read: 1, write: 1, in-init: 1
Action[10]:
    break: ?pos:1
        pre: (and (RW:tree_cell ?pos))
        eff: (and (N:RW:tree_cell ?pos) (increase (count_log_in_inventory) 2))
    break_low: ?pos:1
        pre: (and (RW:low_tree_cell ?pos))
        eff: (and (N:RW:low_tree_cell ?pos) (increase (count_log_in_inventory) 1))
    break_brutal: ?pos:1
        pre: (and (RW:tree_cell ?pos))
        eff: (and (N:RW:tree_cell ?pos) (increase (count_log_in_inventory) 4))
    craft_plank: 
        pre: (and (>= (count_log_in_inventory) 2))
        eff: (and (decrease (count_log_in_inventory) 2) (increase (count_planks_in_inventory) 4))
    craft_stick: 
        pre: (and (>= (count_planks_in_inventory) 2))
        eff: (and (decrease (count_planks_in_inventory) 2) (increase (count_stick_in_inventory) 4))
    craft_tree_tap: ?pos:1
        pre: (and (R:crafting_table_cell ?pos) (>= (count_planks_in_inventory) 5) (>= (count_stick_in_inventory) 1))
        eff: (and (decrease (count_planks_in_inventory) 5) (decrease (count_stick_in_inventory) 1) (increase (count_tree_tap_in_inventory) 1))
    place_tree_tap: ?pos:1
        pre: (and (RW:tree_cell ?pos) (>= (count_tree_tap_in_inventory) 1))
        eff: (and (N:RW:tree_cell ?pos) (decrease (count_tree_tap_in_inventory) 1) (increase (count_sack_polyisoprene_pellets_in_inventory) 2))
    smelt_pellets_raw: 
        pre: (and (>= (count_log_in_inventory) 4))
        eff: (and (decrease (count_log_in_inventory) 4) (increase (count_sack_polyisoprene_pellets_in_inventory) 1))
    craft_synthetic_pellets: 
        pre: (and (>= (count_log_in_inventory) 2))
        eff: (and (decrease (count_log_in_inventory) 2) (increase (count_sack_polyisoprene_pellets_in_inventory) 2) (increase (toxicity) 1))
    craft_wooden_pogo: ?pos:1
        pre: (and (R:crafting_table_cell ?pos) (>= (count_planks_in_inventory) 2) (>= (count_stick_in_inventory) 4) (>= (count_sack_polyisoprene_pellets_in_inventory) 2) (<= (toxicity) 1))
        eff: (and (decrease (count_planks_in_inventory) 2) (decrease (count_stick_in_inventory) 4) (decrease (count_sack_polyisoprene_pellets_in_inventory) 2) (increase (count_pogo_stick) 1))
