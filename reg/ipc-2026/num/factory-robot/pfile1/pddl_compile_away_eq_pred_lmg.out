Domain: factory-robot
Problem: factory-2r-5s
Require: 117
Type[3]:
    [0]: object, parent: -1
    [1]: robot, parent: 0
    [2]: station, parent: 0
Obj-by-Type:
    [0]: 0 1 2 3 4 5 6
    [1]: 0 1
    [2]: 2 3 4 5 6
Obj[7]:
    [0]: r0, type: 1, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [1]: r1, type: 1, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [2]: charging, type: 2, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [3]: cooling, type: 2, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [4]: assembly0, type: 2, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [5]: assembly1, type: 2, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [6]: assembly2, type: 2, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
Predicate[9]:
    =: 0 0 :: read: 0, write: 0, in-init: 0
    at: 1 2 :: read: 1, write: 1, in-init: 1
    connected: 2 2 :: read: 1, write: 0, in-init: 1
    has-charger: 2 :: read: 1, write: 0, in-init: 1
    has-calibrator: 2 :: read: 1, write: 0, in-init: 1
    free: 2 :: read: 1, write: 1, in-init: 1
    calibrated: 1 :: read: 1, write: 1, in-init: 1, neg-of: NOT-calibrated
    NOT-calibrated: 1 :: read: 1, write: 1, in-init: 0, neg-of: calibrated
    equal: 0 0 :: read: 1, write: 0, in-init: 1
Function[9]:
    energy: 1 :: read: 1, write: 1, in-init: 1
    workload: 1 :: read: 1, write: 1, in-init: 1
    temperature: 1 :: read: 1, write: 1, in-init: 1
    production: 1 :: read: 1, write: 1, in-init: 1
    capacity: 1 :: read: 1, write: 0, in-init: 1
    work-cost: 1 :: read: 1, write: 0, in-init: 1
    max-temp: 1 :: read: 1, write: 0, in-init: 1
    efficiency: 1 :: read: 1, write: 0, in-init: 1
    cooling-power: 2 :: read: 1, write: 0, in-init: 1
Action[13]:
    recharge: ?r:1 ?s:2
        pre: (and (R:has-charger ?s) (RW:at ?r ?s))
        eff: (and (assign (energy ?r) (capacity ?r)))
    work: ?r:1 ?s:2
        pre: (and (RW:at ?r ?s) (RW:calibrated ?r) (>= (energy ?r) (work-cost ?r)) (<= (temperature ?r) (max-temp ?r)))
        eff: (and (decrease (energy ?r) (work-cost ?r)) (increase (workload ?r) 1) (increase (temperature ?r) 3))
    cool-down: ?r:1 ?s:2
        pre: (and (RW:at ?r ?s) (>= (temperature ?r) 1))
        eff: (and (decrease (temperature ?r) (cooling-power ?s)))
    set-low-power: ?r:1
        pre: (and)
        eff: (and (assign (production ?r) 10))
    set-medium-power: ?r:1
        pre: (and)
        eff: (and (assign (production ?r) 50))
    set-high-power: ?r:1
        pre: (and)
        eff: (and (assign (production ?r) 100))
    set-turbo: ?r:1
        pre: (and)
        eff: (and (assign (production ?r) 200))
    overdrive: ?r:1
        pre: (and (>= (production ?r) 250))
        eff: (and (increase (workload ?r) 100))
    overcharge: ?r:1
        pre: (and (>= (energy ?r) 200))
        eff: (and (increase (workload ?r) 50))
    precision-work: ?r:1 ?s:2
        pre: (and (RW:at ?r ?s) (RW:calibrated ?r) (>= (energy ?r) (* (workload ?r) (efficiency ?r))) (<= (temperature ?r) (max-temp ?r)))
        eff: (and (decrease (energy ?r) (work-cost ?r)) (increase (workload ?r) 5) (increase (temperature ?r) 1))
    move: ?r:1 ?s1:2 ?s2:2
        pre: (and (R:connected ?s1 ?s2) (N:R:equal ?s1 ?s2) (RW:at ?r ?s1) (RW:free ?s2) (>= (energy ?r) 5))
        eff: (and (N:RW:at ?r ?s1) (RW:at ?r ?s2) (RW:free ?s1) (N:RW:free ?s2) (decrease (energy ?r) 5))
    turbo-work: ?r:1 ?s:2
        pre: (and (RW:at ?r ?s) (>= (production ?r) 150) (>= (energy ?r) 20))
        eff: (and (N:RW:calibrated ?r) (RW:NOT-calibrated ?r) (decrease (energy ?r) 20) (increase (workload ?r) 10) (increase (temperature ?r) 5))
    calibrate: ?r:1 ?s:2
        pre: (and (R:has-calibrator ?s) (RW:at ?r ?s) (RW:NOT-calibrated ?r))
        eff: (and (RW:calibrated ?r) (N:RW:NOT-calibrated ?r))
Init[34]:
  S:(connected charging cooling)
  S:(connected charging assembly0)
  S:(connected charging assembly1)
  S:(connected charging assembly2)
  S:(connected cooling charging)
  S:(connected cooling assembly0)
  S:(connected cooling assembly1)
  S:(connected cooling assembly2)
  S:(connected assembly0 charging)
  S:(connected assembly0 cooling)
  S:(connected assembly0 assembly1)
  S:(connected assembly0 assembly2)
  S:(connected assembly1 charging)
  S:(connected assembly1 cooling)
  S:(connected assembly1 assembly0)
  S:(connected assembly1 assembly2)
  S:(connected assembly2 charging)
  S:(connected assembly2 cooling)
  S:(connected assembly2 assembly0)
  S:(connected assembly2 assembly1)
  S:(has-charger charging)
  S:(has-calibrator cooling)
  S:(equal charging charging)
  S:(equal cooling cooling)
  S:(equal assembly0 assembly0)
  S:(equal assembly1 assembly1)
  S:(equal assembly2 assembly2)
  (at r0 assembly1)
  (at r1 cooling)
  (free charging)
  (free assembly0)
  (free assembly2)
  (calibrated r0)
  (calibrated r1)
Init[21]:
  (= (energy r0) 79)
  (= (energy r1) 80)
  (= (workload r0) 0)
  (= (workload r1) 0)
  (= (temperature r0) 0)
  (= (temperature r1) 0)
  (= (production r0) 0)
  (= (production r1) 0)
  (= (capacity r0) 80)
  (= (capacity r1) 80)
  (= (work-cost r0) 12)
  (= (work-cost r1) 10)
  (= (max-temp r0) 21)
  (= (max-temp r1) 21)
  (= (efficiency r0) 4)
  (= (efficiency r1) 2)
  (= (cooling-power charging) 0)
  (= (cooling-power cooling) 6)
  (= (cooling-power assembly0) 0)
  (= (cooling-power assembly1) 0)
  (= (cooling-power assembly2) 0)
Goal: (and (>= (workload r0) 38) (>= (workload r1) 39) (<= (temperature r0) 20))
Metric: no-metric
