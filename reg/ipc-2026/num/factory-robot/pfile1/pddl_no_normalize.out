Domain: factory-robot
Problem: factory-2r-5s
Require:
  :conditional-effects
  :disjunctive-preconditions
  :equality
  :existential-preconditions
  :negative-preconditions
  :numeric-fluents
  :strips
  :typing
  :universal-preconditions
Type:
  object
  robot - object
  station - object
Obj:
  assembly0 - station
  assembly1 - station
  assembly2 - station
  charging - station
  cooling - station
  r0 - robot
  r1 - robot
Predicate:
  (= object object) :eq
  (at robot station)
  (calibrated robot)
  (connected station station)
  (free station)
  (has-calibrator station)
  (has-charger station)
Function:
  (capacity robot)
  (cooling-power station)
  (efficiency robot)
  (energy robot)
  (max-temp robot)
  (production robot)
  (temperature robot)
  (work-cost robot)
  (workload robot)
Action:
  calibrate: ?r - robot ?s - station
      pre: (and (at ?r ?s) (has-calibrator ?s) (not (calibrated ?r)))
      eff: (and (calibrated ?r))
  cool-down: ?r - robot ?s - station
      pre: (and (>= (temperature ?r) 1) (at ?r ?s))
      eff: (and (decrease (temperature ?r) (cooling-power ?s)))
  move: ?r - robot ?s1 - station ?s2 - station
      pre: (and (>= (energy ?r) 5) (at ?r ?s1) (connected ?s1 ?s2) (free ?s2))
      eff: (and (at ?r ?s2) (decrease (energy ?r) 5) (free ?s1) (not (at ?r ?s1)) (not (free ?s2)))
  overcharge: ?r - robot
      pre: (and (>= (energy ?r) 200))
      eff: (and (increase (workload ?r) 50))
  overdrive: ?r - robot
      pre: (and (>= (production ?r) 250))
      eff: (and (increase (workload ?r) 100))
  precision-work: ?r - robot ?s - station
      pre: (and (<= (temperature ?r) (max-temp ?r)) (>= (energy ?r) (* (workload ?r) (efficiency ?r))) (at ?r ?s) (calibrated ?r))
      eff: (and (decrease (energy ?r) (work-cost ?r)) (increase (temperature ?r) 1) (increase (workload ?r) 5))
  recharge: ?r - robot ?s - station
      pre: (and (at ?r ?s) (has-charger ?s))
      eff: (and (assign (energy ?r) (capacity ?r)))
  set-high-power: ?r - robot
      pre: (and)
      eff: (and (assign (production ?r) 100))
  set-low-power: ?r - robot
      pre: (and)
      eff: (and (assign (production ?r) 10))
  set-medium-power: ?r - robot
      pre: (and)
      eff: (and (assign (production ?r) 50))
  set-turbo: ?r - robot
      pre: (and)
      eff: (and (assign (production ?r) 200))
  turbo-work: ?r - robot ?s - station
      pre: (and (>= (energy ?r) 20) (>= (production ?r) 150) (at ?r ?s))
      eff: (and (decrease (energy ?r) 20) (increase (temperature ?r) 5) (increase (workload ?r) 10) (not (calibrated ?r)))
  work: ?r - robot ?s - station
      pre: (and (<= (temperature ?r) (max-temp ?r)) (>= (energy ?r) (work-cost ?r)) (at ?r ?s) (calibrated ?r))
      eff: (and (decrease (energy ?r) (work-cost ?r)) (increase (temperature ?r) 3) (increase (workload ?r) 1))
Init:
  (= (capacity r0) 80)
  (= (capacity r1) 80)
  (= (cooling-power assembly0) 0)
  (= (cooling-power assembly1) 0)
  (= (cooling-power assembly2) 0)
  (= (cooling-power charging) 0)
  (= (cooling-power cooling) 6)
  (= (efficiency r0) 4)
  (= (efficiency r1) 2)
  (= (energy r0) 79)
  (= (energy r1) 80)
  (= (max-temp r0) 21)
  (= (max-temp r1) 21)
  (= (production r0) 0)
  (= (production r1) 0)
  (= (temperature r0) 0)
  (= (temperature r1) 0)
  (= (work-cost r0) 12)
  (= (work-cost r1) 10)
  (= (workload r0) 0)
  (= (workload r1) 0)
  (at r0 assembly1)
  (at r1 cooling)
  (calibrated r0)
  (calibrated r1)
  (connected assembly0 assembly1)
  (connected assembly0 assembly2)
  (connected assembly0 charging)
  (connected assembly0 cooling)
  (connected assembly1 assembly0)
  (connected assembly1 assembly2)
  (connected assembly1 charging)
  (connected assembly1 cooling)
  (connected assembly2 assembly0)
  (connected assembly2 assembly1)
  (connected assembly2 charging)
  (connected assembly2 cooling)
  (connected charging assembly0)
  (connected charging assembly1)
  (connected charging assembly2)
  (connected charging cooling)
  (connected cooling assembly0)
  (connected cooling assembly1)
  (connected cooling assembly2)
  (connected cooling charging)
  (free assembly0)
  (free assembly2)
  (free charging)
  (has-calibrator cooling)
  (has-charger charging)
Goal:
  (and (<= (temperature r0) 20) (>= (workload r0) 38) (>= (workload r1) 39))
Metric:
Pred prop:
  (at robot station): in_init in_pre in_eff
  (calibrated robot): in_init in_pre in_pre_neg in_eff
  (connected station station): in_init in_pre
  (free station): in_init in_pre in_eff
  (has-calibrator station): in_init in_pre
  (has-charger station): in_init in_pre
Func prop:
  (capacity robot): in_init init_all_nonneg init_all_int on_num_op_rhs write_delta_nonneg write_delta_nonneg_int
  (cooling-power station): in_init init_all_nonneg init_all_int on_num_op_rhs write_delta_nonneg write_delta_nonneg_int
  (efficiency robot): in_init init_all_nonneg init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
  (energy robot): in_init init_all_nonneg init_all_int in_pre in_eff in_eff_by_assign_or_scale rhs_funcs:(capacity work-cost)
  (max-temp robot): in_init init_all_nonneg init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
  (production robot): in_init init_all_nonneg init_all_nonpos init_all_int in_pre in_eff in_eff_by_assign_or_scale
  (temperature robot): in_init init_all_nonneg init_all_nonpos init_all_int in_pre in_goal in_eff rhs_funcs:(cooling-power)
  (work-cost robot): in_init init_all_nonneg init_all_int in_pre on_num_op_rhs write_delta_nonneg write_delta_nonneg_int
  (workload robot): in_init init_all_nonneg init_all_nonpos init_all_int in_pre in_goal in_eff write_delta_nonneg write_delta_nonneg_int
Global prop:
  has_non_static_neg_cond
  has_num_cmp
  is_numeric
  is_unit_cost
