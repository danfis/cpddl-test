  - gear_up: ?from - gear ?to - gear
      pre: (and (<= (a) (gear_max_acceleration ?to)) (<= (a) (max_acceleration)) (<= (v) (max_speed)) (= (a) 0) (>= (a) (gear_min_acceleration ?to)) (>= (a) (min_acceleration)) (>= (fuel) 0) (>= (v) 0) (current_gear ?from) (gear_next ?from ?to))
