  + gear_up: ?from - gear ?to - gear
      pre: (and (<= (a) (gear_max_acceleration ?to)) (<= (a) (max_acceleration)) (<= (v) (max_speed)) (= (a) 0) (>= (a) (gear_min_acceleration ?to)) (>= (a) (min_acceleration)) (>= (fuel) 0) (>= (v) 0) (current_gear ?from) (gear_next ?from ?to))
      eff: (and (current_gear ?to) (increase (total-cost) 1) (not (current_gear ?from)))
Init:
  - (= (cost) 0)
  + (= (total-cost) 0)
Metric:
  - (cost)
  + (total-cost)
Func prop:
  - (cost): in_init init_all_nonneg init_all_nonpos init_all_int in_metric is_metric_alone in_eff rhs_funcs:(alpha beta gear_fuel_aligned gear_fuel_over gear_fuel_under) write_delta_nonneg write_delta_nonneg_int
  + (total-cost): in_init init_all_nonneg init_all_nonpos init_all_int in_metric is_metric_alone in_eff rhs_funcs:(alpha beta gear_fuel_aligned gear_fuel_over gear_fuel_under) write_delta_nonneg write_delta_nonneg_int
Global prop:
  - action_cost_func:(cost)
  + action_cost_func:(total-cost)
