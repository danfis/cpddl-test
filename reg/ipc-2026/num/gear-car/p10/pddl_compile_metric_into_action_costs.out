Function:
  - (cost)
  + (total-cost) :total-cost
Action:
  - drive_aligned_gear: ?g - gear
      pre: (and (<= (+ (v) (a)) (max_speed)) (<= (a) (gear_max_acceleration ?g)) (<= (a) (max_acceleration)) (<= (v) (gear_v_max ?g)) (<= (v) (max_speed)) (>= (+ (v) (a)) 0) (>= (a) (gear_min_acceleration ?g)) (>= (a) (min_acceleration)) (>= (fuel) (gear_fuel_aligned ?g)) (>= (fuel) 0) (>= (v) (gear_v_min ?g)) (>= (v) 0) (current_gear ?g))
      eff: (and (decrease (fuel) (gear_fuel_aligned ?g)) (increase (cost) (+ (alpha) (* (beta) (gear_fuel_aligned ?g)))) (increase (d) (+ (* 2 (v)) (a))) (increase (fuel_used) (gear_fuel_aligned ?g)) (increase (v) (a)))
  + drive_aligned_gear: ?g - gear
      pre: (and (<= (+ (v) (a)) (max_speed)) (<= (a) (gear_max_acceleration ?g)) (<= (a) (max_acceleration)) (<= (v) (gear_v_max ?g)) (<= (v) (max_speed)) (>= (+ (v) (a)) 0) (>= (a) (gear_min_acceleration ?g)) (>= (a) (min_acceleration)) (>= (fuel) (gear_fuel_aligned ?g)) (>= (fuel) 0) (>= (v) (gear_v_min ?g)) (>= (v) 0) (current_gear ?g))
      eff: (and (decrease (fuel) (gear_fuel_aligned ?g)) (increase (d) (+ (* 2 (v)) (a))) (increase (fuel_used) (gear_fuel_aligned ?g)) (increase (total-cost) (+ (alpha) (* (beta) (gear_fuel_aligned ?g)))) (increase (v) (a)))
  - drive_over_gear: ?g - gear
      pre: (and (<= (+ (v) (a)) (max_speed)) (<= (a) (gear_max_acceleration ?g)) (<= (a) (max_acceleration)) (<= (v) (max_speed)) (> (v) (gear_v_max ?g)) (>= (+ (v) (a)) 0) (>= (a) (gear_min_acceleration ?g)) (>= (a) (min_acceleration)) (>= (fuel) (gear_fuel_over ?g)) (>= (fuel) 0) (>= (v) 0) (current_gear ?g))
      eff: (and (decrease (fuel) (gear_fuel_over ?g)) (increase (cost) (+ (alpha) (* (beta) (gear_fuel_over ?g)))) (increase (d) (+ (* 2 (v)) (a))) (increase (fuel_used) (gear_fuel_over ?g)) (increase (v) (a)))
  + drive_over_gear: ?g - gear
      pre: (and (<= (+ (v) (a)) (max_speed)) (<= (a) (gear_max_acceleration ?g)) (<= (a) (max_acceleration)) (<= (v) (max_speed)) (> (v) (gear_v_max ?g)) (>= (+ (v) (a)) 0) (>= (a) (gear_min_acceleration ?g)) (>= (a) (min_acceleration)) (>= (fuel) (gear_fuel_over ?g)) (>= (fuel) 0) (>= (v) 0) (current_gear ?g))
      eff: (and (decrease (fuel) (gear_fuel_over ?g)) (increase (d) (+ (* 2 (v)) (a))) (increase (fuel_used) (gear_fuel_over ?g)) (increase (total-cost) (+ (alpha) (* (beta) (gear_fuel_over ?g)))) (increase (v) (a)))
  - drive_under_gear: ?g - gear
      pre: (and (< (v) (gear_v_min ?g)) (<= (+ (v) (a)) (max_speed)) (<= (a) (gear_max_acceleration ?g)) (<= (a) (max_acceleration)) (<= (v) (max_speed)) (>= (+ (v) (a)) 0) (>= (a) (gear_min_acceleration ?g)) (>= (a) (min_acceleration)) (>= (fuel) (gear_fuel_under ?g)) (>= (fuel) 0) (>= (v) 0) (current_gear ?g))
      eff: (and (decrease (fuel) (gear_fuel_under ?g)) (increase (cost) (+ (alpha) (* (beta) (gear_fuel_under ?g)))) (increase (d) (+ (* 2 (v)) (a))) (increase (fuel_used) (gear_fuel_under ?g)) (increase (v) (a)))
  + drive_under_gear: ?g - gear
      pre: (and (< (v) (gear_v_min ?g)) (<= (+ (v) (a)) (max_speed)) (<= (a) (gear_max_acceleration ?g)) (<= (a) (max_acceleration)) (<= (v) (max_speed)) (>= (+ (v) (a)) 0) (>= (a) (gear_min_acceleration ?g)) (>= (a) (min_acceleration)) (>= (fuel) (gear_fuel_under ?g)) (>= (fuel) 0) (>= (v) 0) (current_gear ?g))
      eff: (and (decrease (fuel) (gear_fuel_under ?g)) (increase (d) (+ (* 2 (v)) (a))) (increase (fuel_used) (gear_fuel_under ?g)) (increase (total-cost) (+ (alpha) (* (beta) (gear_fuel_under ?g)))) (increase (v) (a)))
  - gear_down: ?from - gear ?to - gear
      pre: (and (<= (a) (gear_max_acceleration ?to)) (<= (a) (max_acceleration)) (<= (v) (max_speed)) (= (a) 0) (>= (a) (gear_min_acceleration ?to)) (>= (a) (min_acceleration)) (>= (fuel) 0) (>= (v) 0) (current_gear ?from) (gear_next ?to ?from))
      eff: (and (current_gear ?to) (increase (cost) 1) (not (current_gear ?from)))
  + gear_down: ?from - gear ?to - gear
      pre: (and (<= (a) (gear_max_acceleration ?to)) (<= (a) (max_acceleration)) (<= (v) (max_speed)) (= (a) 0) (>= (a) (gear_min_acceleration ?to)) (>= (a) (min_acceleration)) (>= (fuel) 0) (>= (v) 0) (current_gear ?from) (gear_next ?to ?from))
