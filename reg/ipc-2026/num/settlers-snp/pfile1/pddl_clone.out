Predicate[20]:
    =: 0 0 :: read: 0, write: 0, in-init: 0
    connected-by-land: 4 4 :: read: 1, write: 0, in-init: 1
    connected-by-rail: 4 4 :: read: 1, write: 1, in-init: 0
    connected-by-sea: 4 4 :: read: 1, write: 0, in-init: 1
    woodland: 4 :: read: 1, write: 0, in-init: 1
    mountain: 4 :: read: 1, write: 0, in-init: 1
    metalliferous: 4 :: read: 1, write: 0, in-init: 1
    by-coast: 4 :: read: 1, write: 0, in-init: 1
    has-cabin: 4 :: read: 1, write: 1, in-init: 0
    has-coal-stack: 4 :: read: 1, write: 1, in-init: 0
    has-quarry: 4 :: read: 1, write: 1, in-init: 0
    has-mine: 4 :: read: 1, write: 1, in-init: 0
    has-sawmill: 4 :: read: 1, write: 1, in-init: 0
    has-ironworks: 4 :: read: 1, write: 1, in-init: 0
    has-docks: 4 :: read: 1, write: 1, in-init: 0
    is-cart: 3 :: read: 1, write: 1, in-init: 0
    is-train: 3 :: read: 1, write: 1, in-init: 0
    is-ship: 3 :: read: 1, write: 1, in-init: 0
    is-at: 3 4 :: read: 1, write: 1, in-init: 0
    potential: 3 :: read: 1, write: 1, in-init: 1
Function[6]:
    available: 1 2 :: read: 1, write: 1, in-init: 1
    space-in: 3 :: read: 1, write: 1, in-init: 1
    labour: :: read: 1, write: 1, in-init: 1
    resource-use: :: read: 1, write: 1, in-init: 1
    pollution: :: read: 1, write: 1, in-init: 1
    housing: 4 :: read: 1, write: 1, in-init: 1
Action[24]:
    load1: ?v:3 ?p:4 ?r:1
        pre: (and (RW:is-at ?v ?p) (>= (available ?r ?p) 1) (>= (space-in ?v) 1))
        eff: (and (decrease (space-in ?v) 1) (increase (available ?r ?v) 1) (decrease (available ?r ?p) 1) (increase (labour) 1))
    unload1: ?v:3 ?p:4 ?r:1
        pre: (and (RW:is-at ?v ?p) (>= (available ?r ?v) 1))
        eff: (and (increase (space-in ?v) 1) (decrease (available ?r ?v) 1) (increase (available ?r ?p) 1) (increase (labour) 1))
    movecart1: ?v:3 ?p1:4 ?p2:4
        pre: (and (R:connected-by-land ?p1 ?p2) (RW:is-cart ?v) (RW:is-at ?v ?p1))
        eff: (and (N:RW:is-at ?v ?p1) (RW:is-at ?v ?p2) (increase (labour) 2))
    movetrain1: ?v:3 ?p1:4 ?p2:4
        pre: (and (RW:connected-by-rail ?p1 ?p2) (RW:is-train ?v) (RW:is-at ?v ?p1) (>= (available coal ?v) 1))
        eff: (and (N:RW:is-at ?v ?p1) (RW:is-at ?v ?p2) (decrease (available coal ?v) 1) (increase (pollution) 1))
    moveship1: ?v:3 ?p1:4 ?p2:4
        pre: (and (R:connected-by-sea ?p1 ?p2) (RW:is-ship ?v) (RW:is-at ?v ?p1) (>= (available coal ?v) 2))
        eff: (and (N:RW:is-at ?v ?p1) (RW:is-at ?v ?p2) (decrease (available coal ?v) 2) (increase (pollution) 2))
    buildcabin1: ?p:4
        pre: (and (R:woodland ?p))
        eff: (and (RW:has-cabin ?p) (increase (labour) 1))
    buildquarry1: ?p:4
        pre: (and (R:mountain ?p))
        eff: (and (RW:has-quarry ?p) (increase (labour) 2))
    buildcoalstack1: ?p:4
        pre: (and (>= (available timber ?p) 1))
        eff: (and (RW:has-coal-stack ?p) (increase (labour) 2) (decrease (available timber ?p) 1))
    buildsawmill1: ?p:4
        pre: (and (>= (available timber ?p) 2))
        eff: (and (RW:has-sawmill ?p) (increase (labour) 2) (decrease (available timber ?p) 2))
    buildmine1: ?p:4
        pre: (and (R:metalliferous ?p) (>= (available wood ?p) 2))
        eff: (and (RW:has-mine ?p) (increase (labour) 3) (decrease (available wood ?p) 2))
    buildironworks1: ?p:4
        pre: (and (>= (available stone ?p) 2) (>= (available wood ?p) 2))
        eff: (and (RW:has-ironworks ?p) (increase (labour) 3) (decrease (available stone ?p) 2) (decrease (available wood ?p) 2))
    builddocks1: ?p:4
        pre: (and (R:by-coast ?p) (>= (available stone ?p) 2) (>= (available wood ?p) 2))
        eff: (and (RW:has-docks ?p) (decrease (available stone ?p) 2) (decrease (available wood ?p) 2) (increase (labour) 2))
    buildwharf1: ?p:4
        pre: (and (RW:has-docks ?p) (>= (available stone ?p) 2) (>= (available iron ?p) 2))
        eff: (and (decrease (available stone ?p) 2) (decrease (available iron ?p) 2) (increase (labour) 2))
    buildrail1: ?p1:4 ?p2:4
        pre: (and (R:connected-by-land ?p1 ?p2) (>= (available wood ?p1) 1) (>= (available iron ?p1) 1))
        eff: (and (RW:connected-by-rail ?p1 ?p2) (decrease (available wood ?p1) 1) (decrease (available iron ?p1) 1) (increase (labour) 2))
    buildhouse1: ?p:4
        pre: (and (>= (available wood ?p) 1) (>= (available stone ?p) 1))
        eff: (and (increase (housing ?p) 1) (decrease (available wood ?p) 1) (decrease (available stone ?p) 1))
    buildcart1: ?p:4 ?v:3
        pre: (and (RW:potential ?v) (>= (available timber ?p) 1))
        eff: (and (RW:is-cart ?v) (RW:is-at ?v ?p) (N:RW:potential ?v) (decrease (available timber ?p) 1) (increase (space-in ?v) 1) (increase (labour) 1))
    buildtrain1: ?p:4 ?v:3
        pre: (and (RW:potential ?v) (>= (available iron ?p) 2))
        eff: (and (RW:is-train ?v) (RW:is-at ?v ?p) (N:RW:potential ?v) (decrease (available iron ?p) 2) (increase (space-in ?v) 5) (increase (labour) 2))
    buildship1: ?p:4 ?v:3
        pre: (and (RW:potential ?v) (>= (available iron ?p) 4))
        eff: (and (RW:is-ship ?v) (RW:is-at ?v ?p) (N:RW:potential ?v) (decrease (available iron ?p) 4) (increase (space-in ?v) 10) (increase (labour) 3))
    felltimber1: ?p:4
        pre: (and (RW:has-cabin ?p))
        eff: (and (increase (available timber ?p) 1) (increase (labour) 1))
    breakstone1: ?p:4
        pre: (and (RW:has-quarry ?p))
        eff: (and (increase (available stone ?p) 1) (increase (labour) 1) (increase (resource-use) 1))
    mineore1: ?p:4
        pre: (and (RW:has-mine ?p))
        eff: (and (increase (available ore ?p) 1) (increase (resource-use) 2))
    burncoal1: ?p:4
        pre: (and (RW:has-coal-stack ?p) (>= (available timber ?p) 1))
        eff: (and (decrease (available timber ?p) 1) (increase (available coal ?p) 1) (increase (pollution) 1))
    sawwood1: ?p:4
        pre: (and (RW:has-sawmill ?p) (>= (available timber ?p) 1))
        eff: (and (decrease (available timber ?p) 1) (increase (available wood ?p) 1))
    makeiron1: ?p:4
        pre: (and (RW:has-ironworks ?p) (>= (available ore ?p) 1) (>= (available coal ?p) 2))
        eff: (and (decrease (available ore ?p) 1) (decrease (available coal ?p) 2) (increase (available iron ?p) 1) (increase (pollution) 2))
