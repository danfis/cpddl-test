Domain: line-exchange
Problem: prob01
Require:
  :conditional-effects
  :disjunctive-preconditions
  :equality
  :existential-preconditions
  :negative-preconditions
  :numeric-fluents
  :strips
  :typing
  :universal-preconditions
Type:
  object
  robot - object
Obj:
  r0 - robot
  r1 - robot
  r2 - robot
  r3 - robot
Predicate:
  (= object object) :eq
  (next robot robot)
  (pd robot robot)
  (ps robot)
Function:
  (d)
  (i robot)
  (q robot)
  (x robot)
Action:
  conn: ?r1 - robot ?r2 - robot
      pre: (and (= (x ?r1) (x ?r2)) (next ?r1 ?r2))
      eff: (and (pd ?r1 ?r2) (ps ?r1) (ps ?r2))
  disc: ?r1 - robot ?r2 - robot
      pre: (and (next ?r1 ?r2) (pd ?r1 ?r2))
      eff: (and (not (pd ?r1 ?r2)) (not (ps ?r1)) (not (ps ?r2)))
  exch-lre: ?r1 - robot ?r2 - robot
      pre: (and (>= (q ?r1) 1) (next ?r1 ?r2) (pd ?r1 ?r2))
      eff: (and (decrease (q ?r1) 1) (increase (q ?r2) 1))
  exch-rle: ?r1 - robot ?r2 - robot
      pre: (and (>= (q ?r2) 1) (next ?r1 ?r2) (pd ?r1 ?r2))
      eff: (and (decrease (q ?r1) -1) (increase (q ?r2) -1))
  lft: ?r - robot
      pre: (and (> (x ?r) (* (d) (i ?r))) (not (ps ?r)))
      eff: (and (decrease (x ?r) 1))
  rgt: ?r - robot
      pre: (and (< (x ?r) (* (d) (+ (i ?r) 1))) (not (ps ?r)))
      eff: (and (increase (x ?r) 1))
Init:
  (= (d) 50)
  (= (i r0) 0)
  (= (i r1) 1)
  (= (i r2) 2)
  (= (i r3) 3)
  (= (q r0) 13)
  (= (q r1) 9)
  (= (q r2) 5)
  (= (q r3) 13)
  (= (x r0) 25)
  (= (x r1) 75)
  (= (x r2) 125)
  (= (x r3) 175)
  (next r0 r1)
  (next r1 r2)
  (next r2 r3)
Goal:
  (and (= (q r0) (q r1)) (= (q r1) (q r2)) (= (q r2) (q r3)) (= (x r0) 25) (= (x r1) 75) (= (x r2) 125) (= (x r3) 175))
Metric:
Pred prop:
  (next robot robot): in_init in_pre
  (pd robot robot): in_pre in_eff
  (ps robot): in_pre in_pre_neg in_eff
Func prop:
  (d): in_init init_all_nonneg init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
  (i robot): in_init init_all_nonneg init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
  (q robot): in_init init_all_nonneg init_all_int in_pre in_goal in_eff
  (x robot): in_init init_all_nonneg init_all_int in_pre in_goal in_eff
Global prop:
  has_non_static_neg_cond
  has_num_cmp
  is_numeric
  is_unit_cost
