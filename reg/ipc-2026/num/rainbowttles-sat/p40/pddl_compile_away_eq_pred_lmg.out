    pour: ?b:1 ?c:2 ?c1:2 ?b1:1
        pre: (and (R:real-colour ?c) (N:R:equal ?b ?b1) (RW:upper-colour ?b ?c) (RW:upper-colour ?b1 ?c) (RW:colour-below ?b ?c ?c1) (RW:NOT-closed ?b) (RW:NOT-closed ?b1) (> (colour-segments ?b ?c) 0) (> (segments-filled ?b) 0) (> (colour-segments ?b1 ?c) 0) (> (segments-filled ?b1) 0) (<= (+ (segments-filled ?b1) (colour-segments ?b ?c)) (bottle-capacity ?b1)))
