    pour-to-empty-bottle: ?b:1 ?c:2 ?c1:2 ?e:2 ?b1:1
        pre: (and (R:empty-colour ?e) (R:real-colour ?c) (N:R:equal ?b ?b1) (RW:upper-colour ?b ?c) (RW:upper-colour ?b1 ?e) (RW:colour-below ?b ?c ?c1) (RW:NOT-closed ?b) (RW:NOT-closed ?b1) (> (colour-segments ?b ?c) 0) (> (segments-filled ?b) 0) (= (colour-segments ?b1 ?c) 0) (= (segments-filled ?b1) 0) (<= (colour-segments ?b ?c) (bottle-capacity ?b1)))
        eff: (and (N:RW:upper-colour ?b ?c) (RW:upper-colour ?b ?c1) (RW:upper-colour ?b1 ?c) (N:RW:upper-colour ?b1 ?e) (RW:colour-below ?b1 ?c ?e) (decrease (segments-filled ?b) (colour-segments ?b ?c)) (assign (colour-segments ?b ?c) 0) (increase (segments-filled ?b1) (colour-segments ?b ?c)) (increase (colour-segments ?b1 ?c) (colour-segments ?b ?c)))
    close-bottle: ?b:1 ?c:2
        pre: (and (R:real-colour ?c) (= (colour-segments ?b ?c) (bottle-capacity ?b)))
        eff: (and (RW:closed ?b) (N:RW:NOT-closed ?b))
    close-empty-bottle: ?b:1
        pre: (and (= (segments-filled ?b) 0))
        eff: (and (RW:closed ?b) (N:RW:NOT-closed ?b))
