Action:
  close-bottle: ?b - bottle ?c - colour
      pre: (and (= (colour-segments ?b ?c) (bottle-capacity ?b)) (real-colour ?c))
      eff: (and (closed ?b))
  close-empty-bottle: ?b - bottle
      pre: (and (= (segments-filled ?b) 0))
      eff: (and (closed ?b))
  pour-to-empty-bottle: ?b - bottle ?c - colour ?c1 - colour ?e - colour ?b1 - bottle
      pre: (and (<= (colour-segments ?b ?c) (bottle-capacity ?b1)) (= (colour-segments ?b1 ?c) 0) (= (segments-filled ?b1) 0) (> (colour-segments ?b ?c) 0) (> (segments-filled ?b) 0) (colour-below ?b ?c ?c1) (empty-colour ?e) (not (= ?b ?b1)) (not (closed ?b)) (not (closed ?b1)) (real-colour ?c) (upper-colour ?b ?c) (upper-colour ?b1 ?e))
      eff: (and (assign (colour-segments ?b ?c) 0) (colour-below ?b1 ?c ?e) (decrease (segments-filled ?b) (colour-segments ?b ?c)) (increase (colour-segments ?b1 ?c) (colour-segments ?b ?c)) (increase (segments-filled ?b1) (colour-segments ?b ?c)) (not (upper-colour ?b ?c)) (not (upper-colour ?b1 ?e)) (upper-colour ?b ?c1) (upper-colour ?b1 ?c))
  pour: ?b - bottle ?c - colour ?c1 - colour ?b1 - bottle
      pre: (and (<= (+ (segments-filled ?b1) (colour-segments ?b ?c)) (bottle-capacity ?b1)) (> (colour-segments ?b ?c) 0) (> (colour-segments ?b1 ?c) 0) (> (segments-filled ?b) 0) (> (segments-filled ?b1) 0) (colour-below ?b ?c ?c1) (not (= ?b ?b1)) (not (closed ?b)) (not (closed ?b1)) (real-colour ?c) (upper-colour ?b ?c) (upper-colour ?b1 ?c))
      eff: (and (assign (colour-segments ?b ?c) 0) (decrease (segments-filled ?b) (colour-segments ?b ?c)) (increase (colour-segments ?b1 ?c) (colour-segments ?b ?c)) (increase (segments-filled ?b1) (colour-segments ?b ?c)) (not (upper-colour ?b ?c)) (upper-colour ?b ?c1))
