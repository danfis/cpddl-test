  cell8 - cell
  cell9 - cell
Predicate:
  (= object object) :eq
  (air_cell cell)
  (connected cell cell)
  (crafting_table_cell cell)
  (dead_tree_cell cell)
  (low_tree_cell cell)
  (position cell)
  (tree_cell cell)
Function:
  (count_log_in_inventory)
  (count_planks_in_inventory)
  (count_pogo_stick)
  (count_sack_polyisoprene_pellets_in_inventory)
  (count_stick_in_inventory)
  (count_tree_tap_in_inventory)
  (toxicity)
Action:
  break: ?pos - cell
      pre: (and (tree_cell ?pos))
      eff: (and (air_cell ?pos) (increase (count_log_in_inventory) 1) (not (tree_cell ?pos)))
  break_brutal: ?pos - cell
      pre: (and (tree_cell ?pos))
      eff: (and (dead_tree_cell ?pos) (increase (count_log_in_inventory) 2) (not (tree_cell ?pos)))
  break_low: ?pos - cell
      pre: (and (low_tree_cell ?pos))
      eff: (and (air_cell ?pos) (increase (count_log_in_inventory) 0.5) (not (low_tree_cell ?pos)))
  craft_plank:
      pre: (and (>= (count_log_in_inventory) 1))
      eff: (and (decrease (count_log_in_inventory) 1) (increase (count_planks_in_inventory) 4))
  craft_stick:
      pre: (and (>= (count_planks_in_inventory) 2))
      eff: (and (decrease (count_planks_in_inventory) 2) (increase (count_stick_in_inventory) 4))
  craft_synthetic_pellets:
      pre: (and (>= (count_log_in_inventory) 1))
      eff: (and (decrease (count_log_in_inventory) 1) (increase (count_sack_polyisoprene_pellets_in_inventory) 1) (increase (toxicity) 1))
  craft_tree_tap: ?pos - cell
      pre: (and (>= (count_planks_in_inventory) 5) (>= (count_stick_in_inventory) 1) (crafting_table_cell ?pos))
      eff: (and (decrease (count_planks_in_inventory) 5) (decrease (count_stick_in_inventory) 1) (increase (count_tree_tap_in_inventory) 1))
  craft_wooden_pogo: ?pos - cell
      pre: (and (<= (toxicity) 1) (>= (count_planks_in_inventory) 2) (>= (count_sack_polyisoprene_pellets_in_inventory) 1) (>= (count_stick_in_inventory) 4) (crafting_table_cell ?pos))
      eff: (and (decrease (count_planks_in_inventory) 2) (decrease (count_sack_polyisoprene_pellets_in_inventory) 1) (decrease (count_stick_in_inventory) 4) (increase (count_pogo_stick) 1))
  place_tree_tap: ?pos - cell
      pre: (and (>= (count_tree_tap_in_inventory) 1) (tree_cell ?pos))
      eff: (and (air_cell ?pos) (decrease (count_tree_tap_in_inventory) 1) (increase (count_sack_polyisoprene_pellets_in_inventory) 1) (not (tree_cell ?pos)))
  smelt_pellets_raw:
      pre: (and (>= (count_log_in_inventory) 2))
      eff: (and (decrease (count_log_in_inventory) 2) (increase (count_sack_polyisoprene_pellets_in_inventory) 0.5))
Init:
  (= (count_log_in_inventory) 0)
  (= (count_planks_in_inventory) 0)
  (= (count_pogo_stick) 0)
  (= (count_sack_polyisoprene_pellets_in_inventory) 0)
  (= (count_stick_in_inventory) 0)
  (= (count_tree_tap_in_inventory) 0)
  (= (toxicity) 0)
