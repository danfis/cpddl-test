Domain: polycraft
Problem: p10_opt
Require:
  :conditional-effects
  :disjunctive-preconditions
  :equality
  :existential-preconditions
  :negative-preconditions
  :numeric-fluents
  :object-fluents
  :strips
  :typing
  :universal-preconditions
Type:
  cell - object
  object
Obj:
  cell0 - cell
  cell1 - cell
  cell10 - cell
  cell11 - cell
  cell12 - cell
