Domain: expedition
Problem: instance_2_sled_1
Require: 103
Type[3]:
    [0]: object, parent: -1
    [1]: sled, parent: 0
    [2]: waypoint, parent: 0
Obj-by-Type:
    [0]: 0 1 2 3 4 5 6 7
    [1]: 0 1
    [2]: 2 3 4 5 6 7
Obj[8]:
    [0]: s0, type: 1, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [1]: s1, type: 1, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [2]: wa0, type: 2, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [3]: wa1, type: 2, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [4]: wa2, type: 2, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [5]: wa3, type: 2, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [6]: wa4, type: 2, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [7]: wa5, type: 2, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
Predicate[3]:
    =: 0 0 :: read: 0, write: 0, in-init: 0
    at: 1 2 :: read: 1, write: 1, in-init: 1
    is_next: 2 2 :: read: 1, write: 0, in-init: 1
Function[3]:
    sled_supplies: 1 :: read: 1, write: 1, in-init: 1
    sled_capacity: 1 :: read: 1, write: 0, in-init: 1
    waypoint_supplies: 2 :: read: 1, write: 1, in-init: 1
Action[4]:
    move_forwards: ?s:1 ?w1:2 ?w2:2
        pre: (and (R:is_next ?w1 ?w2) (RW:at ?s ?w1) (>= (sled_supplies ?s) 1))
        eff: (and (N:RW:at ?s ?w1) (RW:at ?s ?w2) (decrease (sled_supplies ?s) 1))
    move_backwards: ?s:1 ?w1:2 ?w2:2
        pre: (and (R:is_next ?w2 ?w1) (RW:at ?s ?w1) (>= (sled_supplies ?s) 1))
        eff: (and (N:RW:at ?s ?w1) (RW:at ?s ?w2) (decrease (sled_supplies ?s) 1))
    store_supplies: ?s:1 ?w:2
        pre: (and (RW:at ?s ?w) (>= (sled_supplies ?s) 1))
        eff: (and (increase (waypoint_supplies ?w) 1) (decrease (sled_supplies ?s) 1))
    retrieve_supplies: ?s:1 ?w:2
        pre: (and (RW:at ?s ?w) (>= (waypoint_supplies ?w) 1) (> (sled_capacity ?s) (sled_supplies ?s)))
        eff: (and (decrease (waypoint_supplies ?w) 1) (increase (sled_supplies ?s) 1))
Init[7]:
  S:(is_next wa0 wa1)
  S:(is_next wa1 wa2)
  S:(is_next wa2 wa3)
  S:(is_next wa3 wa4)
  S:(is_next wa4 wa5)
  (at s0 wa0)
  (at s1 wa0)
Init[10]:
  (= (sled_capacity s0) 4)
  (= (sled_supplies s0) 1)
  (= (waypoint_supplies wa0) 1000)
  (= (waypoint_supplies wa1) 0)
  (= (waypoint_supplies wa2) 0)
  (= (waypoint_supplies wa3) 0)
  (= (waypoint_supplies wa4) 0)
  (= (waypoint_supplies wa5) 0)
  (= (sled_capacity s1) 4)
  (= (sled_supplies s1) 1)
Goal: (and (RW:at s0 wa5) (RW:at s1 wa5))
Metric: no-metric
