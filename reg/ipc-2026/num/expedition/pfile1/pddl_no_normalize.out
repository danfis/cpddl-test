Domain: expedition
Problem: instance_2_sled_1
Require:
  :conditional-effects
  :disjunctive-preconditions
  :equality
  :existential-preconditions
  :negative-preconditions
  :numeric-fluents
  :object-fluents
  :strips
  :typing
  :universal-preconditions
Type:
  object
  sled - object
  waypoint - object
Obj:
  s0 - sled
  s1 - sled
  wa0 - waypoint
  wa1 - waypoint
  wa2 - waypoint
  wa3 - waypoint
  wa4 - waypoint
  wa5 - waypoint
Predicate:
  (= object object) :eq
  (at sled waypoint)
  (is_next waypoint waypoint)
Function:
  (sled_capacity sled)
  (sled_supplies sled)
  (waypoint_supplies waypoint)
Action:
  move_backwards: ?s - sled ?w1 - waypoint ?w2 - waypoint
      pre: (and (>= (sled_supplies ?s) 1) (at ?s ?w1) (is_next ?w2 ?w1))
      eff: (and (at ?s ?w2) (decrease (sled_supplies ?s) 1) (not (at ?s ?w1)))
  move_forwards: ?s - sled ?w1 - waypoint ?w2 - waypoint
      pre: (and (>= (sled_supplies ?s) 1) (at ?s ?w1) (is_next ?w1 ?w2))
      eff: (and (at ?s ?w2) (decrease (sled_supplies ?s) 1) (not (at ?s ?w1)))
  retrieve_supplies: ?s - sled ?w - waypoint
      pre: (and (> (sled_capacity ?s) (sled_supplies ?s)) (>= (waypoint_supplies ?w) 1) (at ?s ?w))
      eff: (and (decrease (waypoint_supplies ?w) 1) (increase (sled_supplies ?s) 1))
  store_supplies: ?s - sled ?w - waypoint
      pre: (and (>= (sled_supplies ?s) 1) (at ?s ?w))
      eff: (and (decrease (sled_supplies ?s) 1) (increase (waypoint_supplies ?w) 1))
Init:
  (= (sled_capacity s0) 4)
  (= (sled_capacity s1) 4)
  (= (sled_supplies s0) 1)
  (= (sled_supplies s1) 1)
  (= (waypoint_supplies wa0) 1000)
  (= (waypoint_supplies wa1) 0)
  (= (waypoint_supplies wa2) 0)
  (= (waypoint_supplies wa3) 0)
  (= (waypoint_supplies wa4) 0)
  (= (waypoint_supplies wa5) 0)
  (at s0 wa0)
  (at s1 wa0)
  (is_next wa0 wa1)
  (is_next wa1 wa2)
  (is_next wa2 wa3)
  (is_next wa3 wa4)
  (is_next wa4 wa5)
Goal:
  (and (at s0 wa5) (at s1 wa5))
Metric:
Pred prop:
  (at sled waypoint): in_init in_pre in_goal in_eff
  (is_next waypoint waypoint): in_init in_pre
Func prop:
  (sled_capacity sled): in_init init_all_nonneg init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
  (sled_supplies sled): in_init init_all_nonneg init_all_int in_pre in_eff
  (waypoint_supplies waypoint): in_init init_all_nonneg init_all_int in_pre in_eff
Global prop:
  has_num_cmp
  is_numeric
  is_unit_cost
