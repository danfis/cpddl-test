Domain: coins
Problem: p1
Require:
  :numeric-fluents
  :strips
  :typing
Type:
  coin - object
  object
Obj:
  c1 - coin
  c2 - coin
  c3 - coin
  c4 - coin
  c5 - coin
Predicate:
  (= object object) :eq
  (coin-update coin)
  (no-coin-update coin)
Function:
  (coin-count)
  (current-value)
  (denomination coin)
  (denomination-penalty coin)
  (penalty)
Action:
  addcoin: ?c - coin
      pre: (and (= (penalty) 0) (no-coin-update ?c))
      eff: (and (coin-update ?c) (increase (current-value) (denomination ?c)) (increase (penalty) (denomination-penalty ?c)) (not (no-coin-update ?c)))
  apply-penalty-hundred:
      pre: (and (>= (penalty) 100))
      eff: (and (decrease (penalty) 100) (increase (coin-count) 100))
  apply-penalty-one:
      pre: (and (>= (penalty) 1))
      eff: (and (decrease (penalty) 1) (increase (coin-count) 1))
  apply-penalty-ten-thousand:
      pre: (and (>= (penalty) 10000))
      eff: (and (decrease (penalty) 10000) (increase (coin-count) 10000))
  apply-penalty-ten:
      pre: (and (>= (penalty) 10))
      eff: (and (decrease (penalty) 10) (increase (coin-count) 10))
  apply-penalty-thousand:
      pre: (and (>= (penalty) 1000))
      eff: (and (decrease (penalty) 1000) (increase (coin-count) 1000))
  update-penalty: ?c - coin
      pre: (and (coin-update ?c))
      eff: (and (increase (denomination-penalty ?c) 1) (no-coin-update ?c) (not (coin-update ?c)))
Init:
  (= (coin-count) 0)
  (= (current-value) 0)
  (= (denomination c1) 1)
  (= (denomination c2) 2)
  (= (denomination c3) 3)
  (= (denomination c4) 5)
  (= (denomination c5) 7)
  (= (denomination-penalty c1) 1)
  (= (denomination-penalty c2) 1)
  (= (denomination-penalty c3) 1)
  (= (denomination-penalty c4) 1)
  (= (denomination-penalty c5) 1)
  (= (penalty) 0)
  (no-coin-update c1)
  (no-coin-update c2)
  (no-coin-update c3)
  (no-coin-update c4)
  (no-coin-update c5)
Goal:
  (and (= (current-value) 265) (= (penalty) 0))
Metric:
  (coin-count)
Pred prop:
  (coin-update coin): in_pre in_eff
  (no-coin-update coin): in_init in_pre in_eff
Func prop:
  (coin-count): in_init init_all_nonneg init_all_nonpos init_all_int in_metric is_metric_alone in_eff write_delta_nonneg write_delta_nonneg_int
  (current-value): in_init init_all_nonneg init_all_nonpos init_all_int in_goal in_eff rhs_funcs:(denomination) write_delta_nonneg write_delta_nonneg_int
  (denomination coin): in_init init_all_nonneg init_all_int on_num_op_rhs write_delta_nonneg write_delta_nonneg_int
  (denomination-penalty coin): in_init init_all_nonneg init_all_int on_num_op_rhs in_eff write_delta_nonneg write_delta_nonneg_int
  (penalty): in_init init_all_nonneg init_all_nonpos init_all_int in_pre in_goal in_eff rhs_funcs:(denomination-penalty)
Global prop:
  action_cost_func:(coin-count)
  has_int_action_cost_func
  has_num_cmp
  is_numeric
