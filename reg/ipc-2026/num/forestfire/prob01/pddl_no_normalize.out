Domain: forestfire
Problem: foresfire01
Require:
  :conditional-effects
  :disjunctive-preconditions
  :equality
  :existential-preconditions
  :negative-preconditions
  :numeric-fluents
  :strips
  :typing
  :universal-preconditions
Type:
  axe - locatable
  bot - locatable
  bushes - location
  grass - location
  locatable - object
  location - object
  object
  water - locatable
Obj:
  axe1 - axe
  bot1 - bot
  bushes1_2 - bushes
  bushes3_2 - bushes
  grass1_1 - grass
  grass1_3 - grass
  grass2_1 - grass
  grass2_2 - grass
  grass2_3 - grass
  grass3_1 - grass
  grass3_3 - grass
Predicate:
  (= object object) :eq
  (at locatable location)
  (connected location location)
  (has bot axe)
  (pond grass)
Function:
  (cost)
  (durability axe)
  (fire location)
  (has-water bot)
  (max-water bushes)
  (tree location)
  (water-capacity bot)
Action:
  chop-tree: ?r - bot ?ax - axe ?l - location
      pre: (and (>= (durability ?ax) 1) (>= (tree ?l) 1) (at ?r ?l) (has ?r ?ax))
      eff: (and (decrease (durability ?ax) 1) (decrease (tree ?l) 1) (increase (cost) 1))
  drop-water: ?r - bot
      pre: (>= (has-water ?r) 1)
      eff: (and (decrease (has-water ?r) 1) (increase (cost) 1))
  fill-water: ?r - bot ?x - grass
      pre: (and (< (has-water ?r) (water-capacity ?r)) (at ?r ?x) (pond ?x))
      eff: (and (increase (cost) 1) (increase (has-water ?r) 1))
  move-bushes: ?r - bot ?x - bushes ?y - location
      pre: (and (<= (has-water ?r) (max-water ?x)) (<= (tree ?x) 0) (at ?r ?x) (connected ?x ?y))
      eff: (and (at ?r ?y) (increase (cost) 1) (not (at ?r ?x)))
  move-grass: ?r - bot ?x - grass ?y - location
      pre: (and (<= (tree ?x) 0) (at ?r ?x) (connected ?x ?y))
      eff: (and (at ?r ?y) (increase (cost) 1) (not (at ?r ?x)))
  pick-ax: ?r - bot ?ax - axe ?l - location
      pre: (and (at ?ax ?l) (at ?r ?l))
      eff: (and (has ?r ?ax) (increase (cost) 1) (not (at ?ax ?l)))
  put-out-fire: ?r - bot ?l - location
      pre: (and (>= (fire ?l) 1) (>= (has-water ?r) 1) (at ?r ?l))
      eff: (and (decrease (fire ?l) 1) (decrease (has-water ?r) 1) (increase (cost) 1))
Init:
  (= (cost) 0)
  (= (durability axe1) 3)
  (= (fire bushes1_2) 0)
  (= (fire bushes3_2) 0)
  (= (fire grass1_1) 0)
  (= (fire grass1_3) 0)
  (= (fire grass2_1) 0)
  (= (fire grass2_2) 0)
  (= (fire grass2_3) 0)
  (= (fire grass3_1) 0)
  (= (fire grass3_3) 5)
  (= (has-water bot1) 0)
  (= (max-water bushes1_2) 1)
  (= (max-water bushes3_2) 1)
  (= (tree bushes1_2) 0)
  (= (tree bushes3_2) 0)
  (= (tree grass1_1) 0)
  (= (tree grass1_3) 0)
  (= (tree grass2_1) 0)
  (= (tree grass2_2) 3)
  (= (tree grass2_3) 0)
  (= (tree grass3_1) 0)
  (= (tree grass3_3) 0)
  (= (water-capacity bot1) 3)
  (at axe1 grass1_1)
  (at bot1 grass1_1)
  (connected bushes1_2 grass1_1)
  (connected bushes1_2 grass1_3)
  (connected bushes1_2 grass2_2)
  (connected bushes3_2 grass2_2)
  (connected bushes3_2 grass3_1)
  (connected bushes3_2 grass3_3)
  (connected grass1_1 bushes1_2)
  (connected grass1_1 grass2_1)
  (connected grass1_3 bushes1_2)
  (connected grass1_3 grass2_3)
  (connected grass2_1 grass1_1)
  (connected grass2_1 grass2_2)
  (connected grass2_1 grass3_1)
  (connected grass2_2 bushes1_2)
  (connected grass2_2 bushes3_2)
  (connected grass2_2 grass2_1)
  (connected grass2_2 grass2_3)
  (connected grass2_3 grass1_3)
  (connected grass2_3 grass2_2)
  (connected grass2_3 grass3_3)
  (connected grass3_1 bushes3_2)
  (connected grass3_1 grass2_1)
  (connected grass3_3 bushes3_2)
  (connected grass3_3 grass2_3)
  (pond grass1_1)
  (pond grass3_1)
Goal:
  (and (= (fire grass3_3) 0))
Metric:
  (cost)
Pred prop:
  (at locatable location): in_init in_pre in_eff
  (connected location location): in_init in_pre
  (has bot axe): in_pre in_eff
  (pond grass): in_init in_pre
Func prop:
  (cost): in_init init_all_nonneg init_all_nonpos init_all_int in_metric is_metric_alone in_eff write_delta_nonneg write_delta_nonneg_int
  (durability axe): in_init init_all_nonneg init_all_int in_pre in_eff
  (fire location): in_init init_all_nonneg init_all_int in_pre in_goal in_eff
  (has-water bot): in_init init_all_nonneg init_all_nonpos init_all_int in_pre in_eff
  (max-water bushes): in_init init_all_nonneg init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
  (tree location): in_init init_all_nonneg init_all_int in_pre in_eff
  (water-capacity bot): in_init init_all_nonneg init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
Global prop:
  action_cost_func:(cost)
  has_int_action_cost_func
  has_num_cmp
  is_numeric
