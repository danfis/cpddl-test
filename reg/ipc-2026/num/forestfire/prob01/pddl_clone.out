Predicate[5]:
    =: 0 0 :: read: 0, write: 0, in-init: 0
    at: 2 1 :: read: 1, write: 1, in-init: 1
    connected: 1 1 :: read: 1, write: 0, in-init: 1
    has: 5 6 :: read: 1, write: 1, in-init: 0
    pond: 4 :: read: 1, write: 0, in-init: 1
Function[7]:
    durability: 6 :: read: 1, write: 1, in-init: 1
    water-capacity: 5 :: read: 1, write: 0, in-init: 1
    has-water: 5 :: read: 1, write: 1, in-init: 1
    tree: 1 :: read: 1, write: 1, in-init: 1
    max-water: 3 :: read: 1, write: 0, in-init: 1
    fire: 1 :: read: 1, write: 1, in-init: 1
    cost: :: read: 1, write: 1, in-init: 1
Action[7]:
    move-grass: ?r:5 ?x:4 ?y:1
        pre: (and (R:connected ?x ?y) (RW:at ?r ?x) (<= (tree ?x) 0))
        eff: (and (N:RW:at ?r ?x) (RW:at ?r ?y) (increase (cost) 1))
    move-bushes: ?r:5 ?x:3 ?y:1
        pre: (and (R:connected ?x ?y) (RW:at ?r ?x) (<= (tree ?x) 0) (<= (has-water ?r) (max-water ?x)))
        eff: (and (N:RW:at ?r ?x) (RW:at ?r ?y) (increase (cost) 1))
    drop-water: ?r:5
        pre: (and (>= (has-water ?r) 1))
        eff: (and (decrease (has-water ?r) 1) (increase (cost) 1))
    chop-tree: ?r:5 ?ax:6 ?l:1
        pre: (and (RW:at ?r ?l) (RW:has ?r ?ax) (>= (tree ?l) 1) (>= (durability ?ax) 1))
        eff: (and (decrease (tree ?l) 1) (decrease (durability ?ax) 1) (increase (cost) 1))
    fill-water: ?r:5 ?x:4
        pre: (and (R:pond ?x) (RW:at ?r ?x) (< (has-water ?r) (water-capacity ?r)))
        eff: (and (increase (has-water ?r) 1) (increase (cost) 1))
    pick-ax: ?r:5 ?ax:6 ?l:1
        pre: (and (RW:at ?r ?l) (RW:at ?ax ?l))
        eff: (and (N:RW:at ?ax ?l) (RW:has ?r ?ax) (increase (cost) 1))
    put-out-fire: ?r:5 ?l:1
        pre: (and (RW:at ?r ?l) (>= (fire ?l) 1) (>= (has-water ?r) 1))
        eff: (and (decrease (fire ?l) 1) (decrease (has-water ?r) 1) (increase (cost) 1))
