Domain: trader
Problem: marketcount2
Require:
  :conditional-effects
  :disjunctive-preconditions
  :equality
  :existential-preconditions
  :negative-preconditions
  :numeric-fluents
  :object-fluents
  :strips
  :typing
  :universal-preconditions
Type:
  camel - locatable
  goods - locatable
  locatable - object
  market - place
  object
  place - object
Obj:
  camel0 - camel
  cars - goods
  cattle - goods
  coffee - goods
  computers - goods
  copper - goods
  dvds - goods
  expensiverugs - goods
  food - goods
  footballs - goods
  gold - goods
  gummybears - goods
  kittens - goods
  laminatefloor - goods
  minerals - goods
  oslo - market
  palanga - market
  platinum - goods
  turingmachines - goods
  water - goods
Predicate:
  (= object object) :eq
  (at camel place)
  (can-drive place place)
Function:
  (bought goods)
  (capacity)
  (cash)
  (drive-cost place place)
  (on-sale goods market)
  (price goods market)
  (sellprice goods market)
Action:
  buy: ?t - camel ?g - goods ?m - market
      pre: (and (<= (+ 7 (price ?g ?m)) (cash)) (> (on-sale ?g ?m) 0) (>= (capacity) 1) (at ?t ?m))
      eff: (and (decrease (capacity) 1) (decrease (cash) (price ?g ?m)) (increase (bought ?g) 1))
  sell: ?t - camel ?g - goods ?m - market
      pre: (and (>= (bought ?g) 1) (at ?t ?m))
      eff: (and (decrease (bought ?g) 1) (increase (capacity) 1) (increase (cash) (price ?g ?m)))
  travel: ?t - camel ?from - market ?to - market
      pre: (and (>= (cash) (drive-cost ?from ?to)) (at ?t ?from) (can-drive ?from ?to))
      eff: (and (at ?t ?to) (decrease (cash) (drive-cost ?from ?to)) (not (at ?t ?from)))
  upgrade: ?t - camel
      pre: (and (>= (cash) 57))
      eff: (and (decrease (cash) 50) (increase (capacity) 20))
