Function[6]:
    on-sale: 5 2 :: read: 1, write: 0, in-init: 1
    drive-cost: 1 1 :: read: 1, write: 0, in-init: 1
    price: 5 2 :: read: 1, write: 0, in-init: 1
    bought: 5 :: read: 1, write: 1, in-init: 1
    cash: :: read: 1, write: 1, in-init: 1
    capacity: :: read: 1, write: 1, in-init: 1
Action[4]:
    travel: ?t:4 ?from:2 ?to:2
        pre: (and (R:can-drive ?from ?to) (RW:at ?t ?from) (>= (cash) (* 10 (drive-cost ?from ?to))))
        eff: (and (N:RW:at ?t ?from) (RW:at ?t ?to) (decrease (cash) (* 10 (drive-cost ?from ?to))))
    buy: ?t:4 ?g:5 ?m:2
        pre: (and (RW:at ?t ?m) (<= (+ 70 (price ?g ?m)) (cash)) (>= (capacity) 1) (> (on-sale ?g ?m) 0))
        eff: (and (decrease (capacity) 1) (increase (bought ?g) 1) (decrease (cash) (price ?g ?m)))
    upgrade: ?t:4
        pre: (and (>= (cash) 570))
        eff: (and (increase (capacity) 20) (decrease (cash) 500))
    sell: ?t:4 ?g:5 ?m:2
        pre: (and (RW:at ?t ?m) (>= (bought ?g) 1))
        eff: (and (increase (capacity) 1) (decrease (bought ?g) 1) (increase (cash) (price ?g ?m)))
