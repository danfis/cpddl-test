Action[4]:
    travel: ?t:4 ?from:2 ?to:2
        pre: (and (R:can-drive ?from ?to) (RW:at ?t ?from) (>= (cash) (drive-cost ?from ?to)))
        eff: (and (N:RW:at ?t ?from) (RW:at ?t ?to) (decrease (cash) (drive-cost ?from ?to)))
    buy: ?t:4 ?g:5 ?m:2
        pre: (and (RW:at ?t ?m) (<= (+ 7 (price ?g ?m)) (cash)) (>= (capacity) 1) (> (on-sale ?g ?m) 0))
        eff: (and (decrease (capacity) 1) (increase (bought ?g) 1) (decrease (cash) (price ?g ?m)))
    upgrade: ?t:4
        pre: (and (>= (cash) 57))
        eff: (and (increase (capacity) 20) (decrease (cash) 50))
    sell: ?t:4 ?g:5 ?m:2
        pre: (and (RW:at ?t ?m) (>= (bought ?g) 1))
        eff: (and (increase (capacity) 1) (decrease (bought ?g) 1) (increase (cash) (price ?g ?m)))
