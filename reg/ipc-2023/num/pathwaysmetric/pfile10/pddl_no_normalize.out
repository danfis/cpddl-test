  choose: ?x - simple
      pre: (and (possible ?x))
      eff: (and (chosen ?x) (increase (num-subs) 1) (not (possible ?x)))
  initialize: ?x - simple
      pre: (and (chosen ?x))
      eff: (and (increase (available ?x) 1))
  self-associate-with-catalyze: ?x1 - molecule ?x3 - complex
      pre: (and (>= (available ?x1) (need-for-catalyzed-self-association ?x1 ?x3)) (catalyzed-self-association-reaction ?x1 ?x3))
      eff: (and (decrease (available ?x1) (need-for-catalyzed-self-association ?x1 ?x3)) (increase (available ?x3) (prod-by-catalyzed-self-association ?x1 ?x3)))
  synthesize: ?x1 - molecule ?x2 - molecule
      pre: (and (>= (available ?x1) (need-for-synthesis ?x1 ?x2)) (synthesis-reaction ?x1 ?x2))
      eff: (and (increase (available ?x2) (prod-by-synthesis ?x1 ?x2)))
