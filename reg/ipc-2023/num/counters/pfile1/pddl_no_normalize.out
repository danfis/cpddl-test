Domain: fn-counters
Problem: instance_4
Require:
  :conditional-effects
  :disjunctive-preconditions
  :equality
  :existential-preconditions
  :negative-preconditions
  :numeric-fluents
  :strips
  :typing
  :universal-preconditions
Type:
  counter - object
  object
Obj:
  c0 - counter
  c1 - counter
  c2 - counter
  c3 - counter
Predicate:
  (= object object) :eq
Function:
  (max_int)
  (value counter)
Action:
  decrement: ?c - counter
      pre: (and (>= (value ?c) 1))
      eff: (and (decrease (value ?c) 1))
  increment: ?c - counter
      pre: (and (<= (+ (value ?c) 1) (max_int)))
      eff: (and (increase (value ?c) 1))
Init:
  (= (max_int) 8)
  (= (value c0) 6)
  (= (value c1) 4)
  (= (value c2) 2)
  (= (value c3) 0)
Goal:
  (and (<= (+ (value c0) 1) (value c1)) (<= (+ (value c1) 1) (value c2)) (<= (+ (value c2) 1) (value c3)))
Metric:
Pred prop:
Func prop:
  (max_int): in_init init_all_nonneg init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
  (value counter): in_init init_all_nonneg init_all_int in_pre in_goal in_eff
Global prop:
  has_num_cmp
  is_numeric
  is_unit_cost
