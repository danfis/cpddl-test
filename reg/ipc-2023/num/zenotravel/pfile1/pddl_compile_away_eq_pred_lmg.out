Domain: zenotravel
Problem: ztravel-1-2
Require: 3ff
Type[5]:
    [0]: object, parent: -1
    [1]: locatable, parent: 0
    [2]: city, parent: 0
    [3]: aircraft, parent: 1
    [4]: person, parent: 1
Obj-by-Type:
    [0]: 0 1 2 3 4 5 6
    [1]: 0 1 2 3
    [2]: 4 5 6
    [3]: 0
    [4]: 1 2 3
Obj[7]:
    [0]: plane1, type: 3, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [1]: person1, type: 4, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [2]: person2, type: 4, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [3]: person3, type: 4, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [4]: city0, type: 2, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [5]: city1, type: 2, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [6]: city2, type: 2, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
Predicate[4]:
    =: 0 0 :: read: 0, write: 0, in-init: 0
    located: 1 2 :: read: 1, write: 1, in-init: 1
    in: 4 3 :: read: 1, write: 1, in-init: 0
    equal: 0 0 :: read: 1, write: 0, in-init: 1
Function[8]:
    fuel: 3 :: read: 1, write: 1, in-init: 1
    distance: 2 2 :: read: 1, write: 0, in-init: 1
    slow-burn: 3 :: read: 1, write: 0, in-init: 1
    fast-burn: 3 :: read: 1, write: 0, in-init: 1
    capacity: 3 :: read: 1, write: 0, in-init: 1
    total-fuel-used: :: read: 1, write: 1, in-init: 1
    onboard: 3 :: read: 1, write: 1, in-init: 1
    zoom-limit: 3 :: read: 1, write: 0, in-init: 1
Action[6]:
    board: ?p:4 ?a:3 ?c:2
        pre: (and (R:equal ?a plane1) (RW:located plane1 ?c) (RW:located ?p ?c))
        eff: (and (N:RW:located ?p ?c) (RW:in ?p plane1) (increase (onboard ?a) 1))
    debark: ?p:4 ?a:3 ?c:2
        pre: (and (RW:located ?a ?c) (RW:in ?p ?a))
        eff: (and (RW:located ?p ?c) (N:RW:in ?p ?a) (decrease (onboard ?a) 1))
    fly-slow: ?a:3 ?c1:2 ?c2:2
        pre: (and (RW:located ?a ?c1) (>= (fuel ?a) (* (distance ?c1 ?c2) (slow-burn ?a))))
        eff: (and (N:RW:located ?a ?c1) (RW:located ?a ?c2) (increase (total-fuel-used) (* (distance ?c1 ?c2) (slow-burn ?a))) (decrease (fuel ?a) (* (distance ?c1 ?c2) (slow-burn ?a))))
    fly-fast: ?a:3 ?c1:2 ?c2:2
        pre: (and (RW:located ?a ?c1) (>= (fuel ?a) (* (distance ?c1 ?c2) (fast-burn ?a))) (<= (onboard ?a) (zoom-limit ?a)))
        eff: (and (N:RW:located ?a ?c1) (RW:located ?a ?c2) (increase (total-fuel-used) (* (distance ?c1 ?c2) (fast-burn ?a))) (decrease (fuel ?a) (* (distance ?c1 ?c2) (fast-burn ?a))))
    refuel: ?a:3
        pre: (and (> (capacity ?a) (fuel ?a)))
        eff: (and (assign (fuel ?a) (capacity ?a)))
    board: ?p:4 ?a:3 ?c:2
        pre: (and (N:R:equal ?p person1) (N:R:equal ?p person2) (N:R:equal ?p person3) (RW:located ?p ?c) (RW:located ?a ?c))
        eff: (and (N:RW:located ?p ?c) (RW:in ?p ?a) (increase (onboard ?a) 1))
Init[8]:
  S:(equal plane1 plane1)
  S:(equal person1 person1)
  S:(equal person2 person2)
  S:(equal person3 person3)
  (located plane1 city0)
  (located person1 city0)
  (located person2 city0)
  (located person3 city1)
Init[16]:
  (= (capacity plane1) 6000)
  (= (fuel plane1) 4000)
  (= (slow-burn plane1) 4)
  (= (fast-burn plane1) 15)
  (= (onboard plane1) 0)
  (= (zoom-limit plane1) 8)
  (= (distance city0 city0) 0)
  (= (distance city0 city1) 678)
  (= (distance city0 city2) 775)
  (= (distance city1 city0) 678)
  (= (distance city1 city1) 0)
  (= (distance city1 city2) 810)
  (= (distance city2 city0) 775)
  (= (distance city2 city1) 810)
  (= (distance city2 city2) 0)
  (= (total-fuel-used) 0)
Goal: (and (RW:located person1 city2) (RW:located person2 city1) (RW:located person3 city2))
Metric: (total-fuel-used)
