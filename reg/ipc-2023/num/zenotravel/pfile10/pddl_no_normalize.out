  plane1 - aircraft
  plane2 - aircraft
  plane3 - aircraft
Predicate:
  (= object object) :eq
  (in person aircraft)
  (located locatable city)
Function:
  (capacity aircraft)
  (distance city city)
  (fast-burn aircraft)
  (fuel aircraft)
  (onboard aircraft)
  (slow-burn aircraft)
  (total-fuel-used)
  (zoom-limit aircraft)
Action:
  board: ?p - person ?a - aircraft ?c - city
      pre: (and (located ?a ?c) (located ?p ?c))
      eff: (and (in ?p ?a) (increase (onboard ?a) 1) (not (located ?p ?c)))
  debark: ?p - person ?a - aircraft ?c - city
      pre: (and (in ?p ?a) (located ?a ?c))
      eff: (and (decrease (onboard ?a) 1) (located ?p ?c) (not (in ?p ?a)))
  fly-fast: ?a - aircraft ?c1 - city ?c2 - city
      pre: (and (<= (onboard ?a) (zoom-limit ?a)) (>= (fuel ?a) (* (distance ?c1 ?c2) (fast-burn ?a))) (located ?a ?c1))
      eff: (and (decrease (fuel ?a) (* (distance ?c1 ?c2) (fast-burn ?a))) (increase (total-fuel-used) (* (distance ?c1 ?c2) (fast-burn ?a))) (located ?a ?c2) (not (located ?a ?c1)))
  fly-slow: ?a - aircraft ?c1 - city ?c2 - city
      pre: (and (>= (fuel ?a) (* (distance ?c1 ?c2) (slow-burn ?a))) (located ?a ?c1))
      eff: (and (decrease (fuel ?a) (* (distance ?c1 ?c2) (slow-burn ?a))) (increase (total-fuel-used) (* (distance ?c1 ?c2) (slow-burn ?a))) (located ?a ?c2) (not (located ?a ?c1)))
  refuel: ?a - aircraft
      pre: (and (> (capacity ?a) (fuel ?a)))
      eff: (and (assign (fuel ?a) (capacity ?a)))
