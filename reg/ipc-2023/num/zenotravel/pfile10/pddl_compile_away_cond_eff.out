Function[8]:
    fuel: 3 :: read: 1, write: 1, in-init: 1
    distance: 2 2 :: read: 1, write: 0, in-init: 1
    slow-burn: 3 :: read: 1, write: 0, in-init: 1
    fast-burn: 3 :: read: 1, write: 0, in-init: 1
    capacity: 3 :: read: 1, write: 0, in-init: 1
    total-fuel-used: :: read: 1, write: 1, in-init: 1
    onboard: 3 :: read: 1, write: 1, in-init: 1
    zoom-limit: 3 :: read: 1, write: 0, in-init: 1
Action[5]:
    board: ?p:4 ?a:3 ?c:2
        pre: (and (RW:located ?p ?c) (RW:located ?a ?c))
        eff: (and (N:RW:located ?p ?c) (RW:in ?p ?a) (increase (onboard ?a) 1))
    debark: ?p:4 ?a:3 ?c:2
        pre: (and (RW:located ?a ?c) (RW:in ?p ?a))
        eff: (and (RW:located ?p ?c) (N:RW:in ?p ?a) (decrease (onboard ?a) 1))
    fly-slow: ?a:3 ?c1:2 ?c2:2
        pre: (and (RW:located ?a ?c1) (>= (fuel ?a) (* (distance ?c1 ?c2) (slow-burn ?a))))
        eff: (and (N:RW:located ?a ?c1) (RW:located ?a ?c2) (increase (total-fuel-used) (* (distance ?c1 ?c2) (slow-burn ?a))) (decrease (fuel ?a) (* (distance ?c1 ?c2) (slow-burn ?a))))
    fly-fast: ?a:3 ?c1:2 ?c2:2
        pre: (and (RW:located ?a ?c1) (>= (fuel ?a) (* (distance ?c1 ?c2) (fast-burn ?a))) (<= (onboard ?a) (zoom-limit ?a)))
        eff: (and (N:RW:located ?a ?c1) (RW:located ?a ?c2) (increase (total-fuel-used) (* (distance ?c1 ?c2) (fast-burn ?a))) (decrease (fuel ?a) (* (distance ?c1 ?c2) (fast-burn ?a))))
    refuel: ?a:3
        pre: (and (> (capacity ?a) (fuel ?a)))
        eff: (and (assign (fuel ?a) (capacity ?a)))
