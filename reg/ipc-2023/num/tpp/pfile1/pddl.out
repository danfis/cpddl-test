Domain: tpp-metric
Problem: pfile02
Require:
  :numeric-fluents
  :strips
  :typing
Type:
  depot - place
  goods - locatable
  locatable - object
  market - place
  object
  place - object
  truck - locatable
Obj:
  depot0 - depot
  goods0 - goods
  goods1 - goods
  market1 - market
  market2 - market
  market3 - market
  market4 - market
  market5 - market
  truck0 - truck
Predicate:
  (= object object) :eq
  (loc truck place)
Function:
  (bought goods)
  (drive-cost place place)
  (on-sale goods market)
  (price goods market)
  (request goods)
  (total-cost)
Action:
  buy-all: ?t - truck ?g - goods ?m - market
      pre: (and (<= (on-sale ?g ?m) (- (request ?g) (bought ?g))) (> (on-sale ?g ?m) 0) (loc ?t ?m))
      eff: (and (assign (on-sale ?g ?m) 0) (increase (bought ?g) (on-sale ?g ?m)) (increase (total-cost) (* (on-sale ?g ?m) (price ?g ?m))))
  buy-allneeded: ?t - truck ?g - goods ?m - market
      pre: (and (> (on-sale ?g ?m) (- (request ?g) (bought ?g))) (> (on-sale ?g ?m) 0) (loc ?t ?m))
      eff: (and (assign (bought ?g) (request ?g)) (decrease (on-sale ?g ?m) (- (request ?g) (bought ?g))) (increase (total-cost) (* (- (request ?g) (bought ?g)) (price ?g ?m))))
  drive: ?t - truck ?from - place ?to - place
      pre: (and (loc ?t ?from))
      eff: (and (increase (total-cost) (drive-cost ?from ?to)) (loc ?t ?to) (not (loc ?t ?from)))
Init:
  (= (bought goods0) 0)
  (= (bought goods1) 0)
  (= (drive-cost depot0 market1) 381.2)
  (= (drive-cost depot0 market2) 737.52)
  (= (drive-cost depot0 market3) 452.95)
  (= (drive-cost depot0 market4) 516.44)
  (= (drive-cost depot0 market5) 558.53)
