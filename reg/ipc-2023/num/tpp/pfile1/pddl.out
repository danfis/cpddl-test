  (= (total-cost) 0)
  (loc truck0 depot0)
Goal:
  (and (>= (bought goods0) (request goods0)) (>= (bought goods1) (request goods1)) (loc truck0 depot0))
Metric:
  (total-cost)
Pred prop:
  (loc truck place): in_init in_pre in_goal in_eff
Func prop:
  (bought goods): in_init init_all_nonneg init_all_nonpos init_all_int in_pre in_goal on_num_op_rhs in_eff in_eff_by_assign_or_scale rhs_funcs:(on-sale request)
  (drive-cost place place): in_init init_all_nonneg on_num_op_rhs write_delta_nonneg write_delta_nonneg_int
  (on-sale goods market): in_init init_all_nonneg init_all_int in_pre on_num_op_rhs in_eff in_eff_by_assign_or_scale rhs_funcs:(bought request)
  (price goods market): in_init init_all_nonneg init_all_int on_num_op_rhs write_delta_nonneg write_delta_nonneg_int
  (request goods): in_init init_all_nonneg init_all_int in_pre in_goal on_num_op_rhs write_delta_nonneg write_delta_nonneg_int
  (total-cost): in_init init_all_nonneg init_all_nonpos init_all_int in_metric is_metric_alone in_eff rhs_funcs:(bought drive-cost on-sale price request)
Global prop:
  has_num_cmp
  is_numeric
