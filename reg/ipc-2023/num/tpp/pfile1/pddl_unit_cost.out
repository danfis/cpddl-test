Predicate[2]:
    =: 0 0 :: read: 0, write: 0, in-init: 0
    loc: 5 1 :: read: 1, write: 1, in-init: 1
Function[3]:
    on-sale: 6 4 :: read: 1, write: 1, in-init: 1
    bought: 6 :: read: 1, write: 1, in-init: 1
    request: 6 :: read: 1, write: 0, in-init: 1
Action[3]:
    drive: ?t:5 ?from:1 ?to:1
        pre: (and (RW:loc ?t ?from))
        eff: (and (N:RW:loc ?t ?from) (RW:loc ?t ?to))
    buy-allneeded: ?t:5 ?g:6 ?m:4
        pre: (and (RW:loc ?t ?m) (> (on-sale ?g ?m) 0) (> (on-sale ?g ?m) (- (request ?g) (bought ?g))))
        eff: (and (decrease (on-sale ?g ?m) (- (request ?g) (bought ?g))) (assign (bought ?g) (request ?g)))
    buy-all: ?t:5 ?g:6 ?m:4
        pre: (and (RW:loc ?t ?m) (> (on-sale ?g ?m) 0) (<= (on-sale ?g ?m) (- (request ?g) (bought ?g))))
        eff: (and (assign (on-sale ?g ?m) 0) (increase (bought ?g) (on-sale ?g ?m)))
Init[1]:
  (loc truck0 depot0)
Init[14]:
