    =: 0 0 :: read: 0, write: 0, in-init: 0
    loc: 5 1 :: read: 1, write: 1, in-init: 1
Function[6]:
    on-sale: 6 4 :: read: 1, write: 1, in-init: 1
    drive-cost: 1 1 :: read: 1, write: 0, in-init: 1
    price: 6 4 :: read: 1, write: 0, in-init: 1
    bought: 6 :: read: 1, write: 1, in-init: 1
    request: 6 :: read: 1, write: 0, in-init: 1
    total-cost: :: read: 1, write: 1, in-init: 1
Action[3]:
    drive: ?t:5 ?from:1 ?to:1
        pre: (and (RW:loc ?t ?from))
        eff: (and (N:RW:loc ?t ?from) (RW:loc ?t ?to) (increase (total-cost) (drive-cost ?from ?to)))
    buy-allneeded: ?t:5 ?g:6 ?m:4
        pre: (and (RW:loc ?t ?m) (> (on-sale ?g ?m) 0) (> (on-sale ?g ?m) (- (request ?g) (bought ?g))))
        eff: (and (decrease (on-sale ?g ?m) (- (request ?g) (bought ?g))) (increase (total-cost) (* (- (request ?g) (bought ?g)) (* 100 (price ?g ?m)))) (assign (bought ?g) (request ?g)))
    buy-all: ?t:5 ?g:6 ?m:4
        pre: (and (RW:loc ?t ?m) (> (on-sale ?g ?m) 0) (<= (on-sale ?g ?m) (- (request ?g) (bought ?g))))
        eff: (and (assign (on-sale ?g ?m) 0) (increase (total-cost) (* (* 100 (on-sale ?g ?m)) (price ?g ?m))) (increase (bought ?g) (on-sale ?g ?m)))
