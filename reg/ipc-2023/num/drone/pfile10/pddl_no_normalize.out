Predicate:
  (= object object) :eq
  (visited location)
Function:
  (battery-level)
  (battery-level-full)
  (max_x)
  (max_y)
  (max_z)
  (min_x)
  (min_y)
  (min_z)
  (x)
  (xl location)
  (y)
  (yl location)
  (z)
  (zl location)
Action:
  decrease_x:
      pre: (and (>= (battery-level) 1) (>= (x) (+ (min_x) 1)))
      eff: (and (decrease (battery-level) 1) (decrease (x) 1))
  decrease_y:
      pre: (and (>= (battery-level) 1) (>= (y) (+ (min_y) 1)))
      eff: (and (decrease (battery-level) 1) (decrease (y) 1))
  decrease_z:
      pre: (and (>= (battery-level) 1) (>= (z) (+ (min_z) 1)))
      eff: (and (decrease (battery-level) 1) (decrease (z) 1))
  increase_x:
      pre: (and (<= (x) (- (max_x) 1)) (>= (battery-level) 1))
      eff: (and (decrease (battery-level) 1) (increase (x) 1))
  increase_y:
      pre: (and (<= (y) (- (max_y) 1)) (>= (battery-level) 1))
      eff: (and (decrease (battery-level) 1) (increase (y) 1))
  increase_z:
      pre: (and (<= (z) (- (max_z) 1)) (>= (battery-level) 1))
      eff: (and (decrease (battery-level) 1) (increase (z) 1))
  recharge:
      pre: (and (= (x) 0) (= (y) 0) (= (z) 0))
      eff: (and (assign (battery-level) (battery-level-full)))
  visit: ?l - location
      pre: (and (= (xl ?l) (x)) (= (yl ?l) (y)) (= (zl ?l) (z)) (>= (battery-level) 1))
      eff: (and (decrease (battery-level) 1) (visited ?l))
