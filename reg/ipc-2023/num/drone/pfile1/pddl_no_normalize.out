Domain: domain_name
Problem: name
Require:
  :numeric-fluents
  :strips
  :typing
Type:
  location - object
  object
Obj:
  x0y0z0 - location
  x0y0z1 - location
Predicate:
  (= object object) :eq
  (visited location)
Function:
  (battery-level)
  (battery-level-full)
  (max_x)
  (max_y)
  (max_z)
  (min_x)
  (min_y)
  (min_z)
  (x)
  (xl location)
  (y)
  (yl location)
  (z)
  (zl location)
Action:
  decrease_x:
      pre: (and (>= (battery-level) 1) (>= (x) (+ (min_x) 1)))
      eff: (and (decrease (battery-level) 1) (decrease (x) 1))
  decrease_y:
      pre: (and (>= (battery-level) 1) (>= (y) (+ (min_y) 1)))
      eff: (and (decrease (battery-level) 1) (decrease (y) 1))
  decrease_z:
      pre: (and (>= (battery-level) 1) (>= (z) (+ (min_z) 1)))
      eff: (and (decrease (battery-level) 1) (decrease (z) 1))
  increase_x:
      pre: (and (<= (x) (- (max_x) 1)) (>= (battery-level) 1))
      eff: (and (decrease (battery-level) 1) (increase (x) 1))
  increase_y:
      pre: (and (<= (y) (- (max_y) 1)) (>= (battery-level) 1))
      eff: (and (decrease (battery-level) 1) (increase (y) 1))
  increase_z:
      pre: (and (<= (z) (- (max_z) 1)) (>= (battery-level) 1))
      eff: (and (decrease (battery-level) 1) (increase (z) 1))
  recharge:
      pre: (and (= (x) 0) (= (y) 0) (= (z) 0))
      eff: (and (assign (battery-level) (battery-level-full)))
  visit: ?l - location
      pre: (and (= (xl ?l) (x)) (= (yl ?l) (y)) (= (zl ?l) (z)) (>= (battery-level) 1))
      eff: (and (decrease (battery-level) 1) (visited ?l))
Init:
  (= (battery-level) 9)
  (= (battery-level-full) 9)
  (= (max_x) 1)
  (= (max_y) 1)
  (= (max_z) 2)
  (= (min_x) 0)
  (= (min_y) 0)
  (= (min_z) 0)
  (= (x) 0)
  (= (xl x0y0z0) 0)
  (= (xl x0y0z1) 0)
  (= (y) 0)
  (= (yl x0y0z0) 0)
  (= (yl x0y0z1) 0)
  (= (z) 0)
  (= (zl x0y0z0) 0)
  (= (zl x0y0z1) 1)
Goal:
  (and (= (x) 0) (= (y) 0) (= (z) 0) (visited x0y0z0) (visited x0y0z1))
Metric:
Pred prop:
  (visited location): in_goal in_eff
Func prop:
  (battery-level): in_init init_all_nonneg init_all_int in_pre in_eff in_eff_by_assign_or_scale rhs_funcs:(battery-level-full)
  (battery-level-full): in_init init_all_nonneg init_all_int on_num_op_rhs write_delta_nonneg write_delta_nonneg_int
  (max_x): in_init init_all_nonneg init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
  (max_y): in_init init_all_nonneg init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
  (max_z): in_init init_all_nonneg init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
  (min_x): in_init init_all_nonneg init_all_nonpos init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
  (min_y): in_init init_all_nonneg init_all_nonpos init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
  (min_z): in_init init_all_nonneg init_all_nonpos init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
  (x): in_init init_all_nonneg init_all_nonpos init_all_int in_pre in_goal in_eff
  (xl location): in_init init_all_nonneg init_all_nonpos init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
  (y): in_init init_all_nonneg init_all_nonpos init_all_int in_pre in_goal in_eff
  (yl location): in_init init_all_nonneg init_all_nonpos init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
  (z): in_init init_all_nonneg init_all_nonpos init_all_int in_pre in_goal in_eff
  (zl location): in_init init_all_nonneg init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
Global prop:
  has_num_cmp
  is_numeric
  is_unit_cost
