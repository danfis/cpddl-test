Domain: mt-block-grouping
Problem: instance_20_5_2_2
Require:
  :conditional-effects
  :disjunctive-preconditions
  :equality
  :existential-preconditions
  :negative-preconditions
  :numeric-fluents
  :strips
  :typing
  :universal-preconditions
Type:
  block - object
  object
Obj:
  b1 - block
  b2 - block
  b3 - block
  b4 - block
  b5 - block
Predicate:
  (= object object) :eq
Function:
  (max_x)
  (max_y)
  (min_x)
  (min_y)
  (x block)
  (y block)
Action:
  move_block_down: ?b - block
      pre: (and (>= (- (y ?b) 1) (min_y)))
      eff: (and (decrease (y ?b) 1))
  move_block_left: ?b - block
      pre: (and (>= (- (x ?b) 1) (min_x)))
      eff: (and (decrease (x ?b) 1))
  move_block_right: ?b - block
      pre: (and (<= (+ (x ?b) 1) (max_x)))
      eff: (and (increase (x ?b) 1))
  move_block_up: ?b - block
      pre: (and (<= (+ (y ?b) 1) (max_y)))
      eff: (and (increase (y ?b) 1))
Init:
  (= (max_x) 20)
  (= (max_y) 20)
  (= (min_x) 1)
  (= (min_y) 1)
  (= (x b1) 11)
  (= (x b2) 12)
  (= (x b3) 10)
  (= (x b4) 2)
  (= (x b5) 3)
  (= (y b1) 12)
  (= (y b2) 5)
  (= (y b3) 18)
  (= (y b4) 9)
  (= (y b5) 1)
Goal:
  (and (= (x b1) (x b2)) (= (x b1) (x b3)) (= (x b2) (x b3)) (= (x b4) (x b5)) (= (y b1) (y b2)) (= (y b1) (y b3)) (= (y b2) (y b3)) (= (y b4) (y b5)) (or (not (= (x b1) (x b4))) (not (= (y b1) (y b4)))) (or (not (= (x b1) (x b5))) (not (= (y b1) (y b5)))) (or (not (= (x b2) (x b4))) (not (= (y b2) (y b4)))) (or (not (= (x b2) (x b5))) (not (= (y b2) (y b5)))) (or (not (= (x b3) (x b4))) (not (= (y b3) (y b4)))) (or (not (= (x b3) (x b5))) (not (= (y b3) (y b5)))))
Metric:
Pred prop:
Func prop:
  (max_x): in_init init_all_nonneg init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
  (max_y): in_init init_all_nonneg init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
  (min_x): in_init init_all_nonneg init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
  (min_y): in_init init_all_nonneg init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
  (x block): in_init init_all_nonneg init_all_int in_pre in_goal in_eff
  (y block): in_init init_all_nonneg init_all_int in_pre in_goal in_eff
Global prop:
  has_num_cmp
  is_numeric
  is_unit_cost
