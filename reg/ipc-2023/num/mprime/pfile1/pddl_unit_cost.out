Domain: mystery-prime-typed
Problem: mprime-x-25
Require:
  :numeric-fluents
  :strips
  :typing
Type:
  emotion - object
  food - object
  object
  pain - emotion
  pleasure - emotion
Obj:
  angina - pain
  chicken - food
  depression - pain
  expectation - pleasure
  pistachio - food
  rest - pleasure
  tuna - food
  wurst - food
Predicate:
  (= object object) :eq
  (craves emotion food)
  (eats food food)
  (fears pain pleasure)
Function:
  (harmony emotion)
  (locale food)
Action:
  drink: ?n1 - food ?n2 - food
      pre: (and (>= (locale ?n1) 1))
      eff: (and (decrease (locale ?n1) 1) (increase (locale ?n2) 1))
  feast: ?v - pleasure ?n1 - food ?n2 - food
      pre: (and (>= (locale ?n1) 1) (craves ?v ?n1) (eats ?n1 ?n2))
      eff: (and (craves ?v ?n2) (decrease (locale ?n1) 1) (not (craves ?v ?n1)))
  overcome: ?c - pain ?v - pleasure ?n - food
      pre: (and (>= (harmony ?v) 1) (craves ?c ?n) (craves ?v ?n))
      eff: (and (decrease (harmony ?v) 1) (fears ?c ?v) (not (craves ?c ?n)))
  succumb: ?c - pain ?v - pleasure ?n - food
      pre: (and (craves ?v ?n) (fears ?c ?v))
      eff: (and (craves ?c ?n) (increase (harmony ?v) 1) (not (fears ?c ?v)))
Init:
  (= (harmony expectation) 1)
  (= (harmony rest) 3)
  (= (locale chicken) 2)
  (= (locale pistachio) 5)
  (= (locale tuna) 2)
  (= (locale wurst) 2)
  (craves angina chicken)
  (craves depression wurst)
  (craves expectation tuna)
  (craves rest pistachio)
  (eats chicken pistachio)
  (eats chicken wurst)
  (eats pistachio chicken)
  (eats pistachio tuna)
  (eats pistachio wurst)
  (eats tuna pistachio)
  (eats tuna wurst)
  (eats wurst chicken)
  (eats wurst pistachio)
  (eats wurst tuna)
Goal:
  (craves depression chicken)
Metric:
Pred prop:
  (craves emotion food): in_init in_pre in_goal in_eff
  (eats food food): in_init in_pre
  (fears pain pleasure): in_pre in_eff
Func prop:
  (harmony emotion): in_init init_all_nonneg init_all_int in_pre in_eff
  (locale food): in_init init_all_nonneg init_all_int in_pre in_eff
Global prop:
  has_num_cmp
  is_numeric
  is_unit_cost
