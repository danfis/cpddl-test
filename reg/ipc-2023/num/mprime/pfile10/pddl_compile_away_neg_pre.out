Action[4]:
    overcome: ?c:4 ?v:3 ?n:1
        pre: (and (RW:craves ?c ?n) (RW:craves ?v ?n) (>= (harmony ?v) 1))
        eff: (and (N:RW:craves ?c ?n) (RW:fears ?c ?v) (decrease (harmony ?v) 1))
    feast: ?v:3 ?n1:1 ?n2:1
        pre: (and (R:eats ?n1 ?n2) (RW:craves ?v ?n1) (>= (locale ?n1) 1))
        eff: (and (N:RW:craves ?v ?n1) (RW:craves ?v ?n2) (decrease (locale ?n1) 1))
    succumb: ?c:4 ?v:3 ?n:1
        pre: (and (RW:craves ?v ?n) (RW:fears ?c ?v))
        eff: (and (RW:craves ?c ?n) (N:RW:fears ?c ?v) (increase (harmony ?v) 1))
    drink: ?n1:1 ?n2:1
