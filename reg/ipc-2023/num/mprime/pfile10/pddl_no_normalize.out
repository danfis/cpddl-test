  (fears pain pleasure)
Function:
  (harmony emotion)
  (locale food)
Action:
  drink: ?n1 - food ?n2 - food
      pre: (and (>= (locale ?n1) 1))
      eff: (and (decrease (locale ?n1) 1) (increase (locale ?n2) 1))
  feast: ?v - pleasure ?n1 - food ?n2 - food
      pre: (and (>= (locale ?n1) 1) (craves ?v ?n1) (eats ?n1 ?n2))
      eff: (and (craves ?v ?n2) (decrease (locale ?n1) 1) (not (craves ?v ?n1)))
  overcome: ?c - pain ?v - pleasure ?n - food
      pre: (and (>= (harmony ?v) 1) (craves ?c ?n) (craves ?v ?n))
      eff: (and (decrease (harmony ?v) 1) (fears ?c ?v) (not (craves ?c ?n)))
  succumb: ?c - pain ?v - pleasure ?n - food
      pre: (and (craves ?v ?n) (fears ?c ?v))
      eff: (and (craves ?c ?n) (increase (harmony ?v) 1) (not (fears ?c ?v)))
