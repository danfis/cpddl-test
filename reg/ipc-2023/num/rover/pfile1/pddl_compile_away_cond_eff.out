    =: 0 0 :: read: 0, write: 0, in-init: 0
    in: 1 2 :: read: 1, write: 1, in-init: 1
    at_lander: 6 2 :: read: 1, write: 0, in-init: 1
    can_traverse: 1 2 2 :: read: 1, write: 0, in-init: 1
