    equipped_for_rock_analysis: 1 :: read: 1, write: 0, in-init: 1
    equipped_for_imaging: 1 :: read: 1, write: 0, in-init: 1
    empty: 3 :: read: 1, write: 1, in-init: 1
    have_rock_analysis: 1 2 :: read: 1, write: 1, in-init: 0
    have_soil_analysis: 1 2 :: read: 1, write: 1, in-init: 0
    full: 3 :: read: 1, write: 1, in-init: 0
    calibrated: 4 1 :: read: 1, write: 1, in-init: 0
    supports: 4 5 :: read: 1, write: 0, in-init: 1
    available: 1 :: read: 1, write: 1, in-init: 1
    visible: 2 2 :: read: 1, write: 0, in-init: 1
    have_image: 1 7 5 :: read: 1, write: 1, in-init: 0
    communicated_soil_data: 2 :: read: 1, write: 1, in-init: 0
    communicated_rock_data: 2 :: read: 1, write: 1, in-init: 0
    communicated_image_data: 7 5 :: read: 1, write: 1, in-init: 0
    at_soil_sample: 2 :: read: 1, write: 1, in-init: 1
    at_rock_sample: 2 :: read: 1, write: 1, in-init: 1
    visible_from: 7 2 :: read: 1, write: 0, in-init: 1
    store_of: 3 1 :: read: 1, write: 0, in-init: 1
    calibration_target: 4 7 :: read: 1, write: 0, in-init: 1
    on_board: 4 1 :: read: 1, write: 0, in-init: 1
    channel_free: 6 :: read: 1, write: 0, in-init: 1
    in_sun: 2 :: read: 1, write: 0, in-init: 1
Function[2]:
    energy: 1 :: read: 1, write: 1, in-init: 1
    recharges: :: read: 1, write: 1, in-init: 1
Action[10]:
    navigate: ?x:1 ?y:2 ?z:2
        pre: (and (R:can_traverse ?x ?y ?z) (R:visible ?y ?z) (RW:in ?x ?y) (RW:available ?x) (>= (energy ?x) 8))
        eff: (and (N:RW:in ?x ?y) (RW:in ?x ?z) (decrease (energy ?x) 8))
    recharge: ?x:1 ?w:2
        pre: (and (R:in_sun ?w) (RW:in ?x ?w) (<= (energy ?x) 80))
        eff: (and (increase (energy ?x) 20) (increase (recharges) 1))
    sample_soil: ?x:1 ?s:3 ?p:2
        pre: (and (R:equipped_for_soil_analysis ?x) (R:store_of ?s ?x) (RW:in ?x ?p) (RW:empty ?s) (RW:at_soil_sample ?p) (>= (energy ?x) 3))
        eff: (and (N:RW:empty ?s) (RW:have_soil_analysis ?x ?p) (RW:full ?s) (N:RW:at_soil_sample ?p) (decrease (energy ?x) 3))
    sample_rock: ?x:1 ?s:3 ?p:2
        pre: (and (R:equipped_for_rock_analysis ?x) (R:store_of ?s ?x) (RW:in ?x ?p) (RW:empty ?s) (RW:at_rock_sample ?p) (>= (energy ?x) 5))
        eff: (and (N:RW:empty ?s) (RW:have_rock_analysis ?x ?p) (RW:full ?s) (N:RW:at_rock_sample ?p) (decrease (energy ?x) 5))
    drop: ?x:1 ?y:3
        pre: (and (R:store_of ?y ?x) (RW:full ?y))
        eff: (and (RW:empty ?y) (N:RW:full ?y))
    calibrate: ?r:1 ?i:4 ?t:7 ?w:2
        pre: (and (R:equipped_for_imaging ?r) (R:visible_from ?t ?w) (R:calibration_target ?i ?t) (R:on_board ?i ?r) (RW:in ?r ?w) (>= (energy ?r) 2))
        eff: (and (RW:calibrated ?i ?r) (decrease (energy ?r) 2))
    take_image: ?r:1 ?p:2 ?o:7 ?i:4 ?m:5
        pre: (and (R:equipped_for_imaging ?r) (R:supports ?i ?m) (R:visible_from ?o ?p) (R:on_board ?i ?r) (RW:in ?r ?p) (RW:calibrated ?i ?r) (>= (energy ?r) 1))
        eff: (and (N:RW:calibrated ?i ?r) (RW:have_image ?r ?o ?m) (decrease (energy ?r) 1))
    communicate_soil_data: ?r:1 ?l:6 ?p:2 ?x:2 ?y:2
        pre: (and (R:at_lander ?l ?y) (R:visible ?x ?y) (R:channel_free ?l) (RW:in ?r ?x) (RW:have_soil_analysis ?r ?p) (RW:available ?r) (>= (energy ?r) 4))
        eff: (and (RW:available ?r) (RW:communicated_soil_data ?p) (decrease (energy ?r) 4))
    communicate_rock_data: ?r:1 ?l:6 ?p:2 ?x:2 ?y:2
        pre: (and (R:at_lander ?l ?y) (R:visible ?x ?y) (R:channel_free ?l) (RW:in ?r ?x) (RW:have_rock_analysis ?r ?p) (RW:available ?r) (>= (energy ?r) 4))
        eff: (and (RW:available ?r) (RW:communicated_rock_data ?p) (decrease (energy ?r) 4))
    communicate_image_data: ?r:1 ?l:6 ?o:7 ?m:5 ?x:2 ?y:2
        pre: (and (R:at_lander ?l ?y) (R:visible ?x ?y) (R:channel_free ?l) (RW:in ?r ?x) (RW:available ?r) (RW:have_image ?r ?o ?m) (>= (energy ?r) 6))
        eff: (and (RW:available ?r) (RW:communicated_image_data ?o ?m) (decrease (energy ?r) 6))
