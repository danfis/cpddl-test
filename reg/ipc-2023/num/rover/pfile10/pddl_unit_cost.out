Domain: rover
Problem: roverprob4132
Require:
  :numeric-fluents
  :strips
  :typing
Type:
  camera - object
  lander - object
  mode - object
  object
  objective - object
  rover - object
  store - object
  waypoint - object
Obj:
  camera0 - camera
  camera1 - camera
  camera2 - camera
  camera3 - camera
  camera4 - camera
  colour - mode
  general - lander
  high_res - mode
  low_res - mode
  objective0 - objective
  objective1 - objective
  objective2 - objective
  rover0 - rover
  rover0store - store
  rover1 - rover
  rover1store - store
  rover2 - rover
  rover2store - store
  rover3 - rover
  rover3store - store
  waypoint0 - waypoint
  waypoint1 - waypoint
  waypoint2 - waypoint
  waypoint3 - waypoint
  waypoint4 - waypoint
  waypoint5 - waypoint
  waypoint6 - waypoint
Predicate:
  (= object object) :eq
  (at_lander lander waypoint)
  (at_rock_sample waypoint)
  (at_soil_sample waypoint)
  (available rover)
  (calibrated camera rover)
  (calibration_target camera objective)
  (can_traverse rover waypoint waypoint)
  (channel_free lander)
  (communicated_image_data objective mode)
  (communicated_rock_data waypoint)
  (communicated_soil_data waypoint)
  (empty store)
  (equipped_for_imaging rover)
  (equipped_for_rock_analysis rover)
  (equipped_for_soil_analysis rover)
  (full store)
  (have_image rover objective mode)
  (have_rock_analysis rover waypoint)
  (have_soil_analysis rover waypoint)
  (in rover waypoint)
  (in_sun waypoint)
  (on_board camera rover)
  (store_of store rover)
  (supports camera mode)
  (visible waypoint waypoint)
  (visible_from objective waypoint)
Function:
  (energy rover)
Action:
  calibrate: ?r - rover ?i - camera ?t - objective ?w - waypoint
      pre: (and (>= (energy ?r) 2) (calibration_target ?i ?t) (equipped_for_imaging ?r) (in ?r ?w) (on_board ?i ?r) (visible_from ?t ?w))
      eff: (and (calibrated ?i ?r) (decrease (energy ?r) 2))
  communicate_image_data: ?r - rover ?l - lander ?o - objective ?m - mode ?x - waypoint ?y - waypoint
      pre: (and (>= (energy ?r) 6) (at_lander ?l ?y) (available ?r) (channel_free ?l) (have_image ?r ?o ?m) (in ?r ?x) (visible ?x ?y))
      eff: (and (available ?r) (communicated_image_data ?o ?m) (decrease (energy ?r) 6))
  communicate_rock_data: ?r - rover ?l - lander ?p - waypoint ?x - waypoint ?y - waypoint
      pre: (and (>= (energy ?r) 4) (at_lander ?l ?y) (available ?r) (channel_free ?l) (have_rock_analysis ?r ?p) (in ?r ?x) (visible ?x ?y))
      eff: (and (available ?r) (communicated_rock_data ?p) (decrease (energy ?r) 4))
  communicate_soil_data: ?r - rover ?l - lander ?p - waypoint ?x - waypoint ?y - waypoint
      pre: (and (>= (energy ?r) 4) (at_lander ?l ?y) (available ?r) (channel_free ?l) (have_soil_analysis ?r ?p) (in ?r ?x) (visible ?x ?y))
      eff: (and (available ?r) (communicated_soil_data ?p) (decrease (energy ?r) 4))
  drop: ?x - rover ?y - store
      pre: (and (full ?y) (store_of ?y ?x))
      eff: (and (empty ?y) (not (full ?y)))
  navigate: ?x - rover ?y - waypoint ?z - waypoint
      pre: (and (>= (energy ?x) 8) (available ?x) (can_traverse ?x ?y ?z) (in ?x ?y) (visible ?y ?z))
      eff: (and (decrease (energy ?x) 8) (in ?x ?z) (not (in ?x ?y)))
  recharge: ?x - rover ?w - waypoint
      pre: (and (<= (energy ?x) 80) (in ?x ?w) (in_sun ?w))
      eff: (and (increase (energy ?x) 20))
  sample_rock: ?x - rover ?s - store ?p - waypoint
      pre: (and (>= (energy ?x) 5) (at_rock_sample ?p) (empty ?s) (equipped_for_rock_analysis ?x) (in ?x ?p) (store_of ?s ?x))
      eff: (and (decrease (energy ?x) 5) (full ?s) (have_rock_analysis ?x ?p) (not (at_rock_sample ?p)) (not (empty ?s)))
  sample_soil: ?x - rover ?s - store ?p - waypoint
      pre: (and (>= (energy ?x) 3) (at_soil_sample ?p) (empty ?s) (equipped_for_soil_analysis ?x) (in ?x ?p) (store_of ?s ?x))
      eff: (and (decrease (energy ?x) 3) (full ?s) (have_soil_analysis ?x ?p) (not (at_soil_sample ?p)) (not (empty ?s)))
  take_image: ?r - rover ?p - waypoint ?o - objective ?i - camera ?m - mode
      pre: (and (>= (energy ?r) 1) (calibrated ?i ?r) (equipped_for_imaging ?r) (in ?r ?p) (on_board ?i ?r) (supports ?i ?m) (visible_from ?o ?p))
      eff: (and (decrease (energy ?r) 1) (have_image ?r ?o ?m) (not (calibrated ?i ?r)))
