Domain: supply-chain
Problem: prob1
Require:
  :numeric-fluents
  :strips
  :typing
Type:
  brand - sugar
  crane - loader
  depot - location
  loader - object
  location - object
  mill - location
  object
  raw-cane - sugar
  sugar - object
  truck - loader
Obj:
  brand1 - brand
  brand2 - brand
  brand3 - brand
  brand4 - brand
  crane1 - crane
  crane2 - crane
  crane3 - crane
  depot1 - depot
  depot2 - depot
  depot3 - depot
  mill1 - mill
  mill2 - mill
  mill3 - mill
  sugar-cane - raw-cane
  truck1 - truck
  truck2 - truck
Predicate:
  (= object object) :eq
  (at-location loader location)
  (available mill)
  (busy mill)
  (change-process brand brand)
  (connected location location)
  (current-process mill brand)
  (place-order raw-cane mill)
  (produce mill brand)
  (ready-crane crane)
  (service-crane crane)
Function:
  (capacity crane)
  (has-resource raw-cane mill)
  (in-storage location brand)
  (in-truck-sugar brand truck)
  (max-changing mill)
  (max-produce mill)
  (max-service-time crane)
  (service-time crane)
  (truck-cap truck)
  (unharvest-field)
Action:
  change-product: ?m - mill ?b1 - brand ?b2 - brand
      pre: (and (change-process ?b1 ?b2) (current-process ?m ?b1))
      eff: (and (current-process ?m ?b2) (decrease (max-changing ?m) 1) (not (current-process ?m ?b1)))
  check-service: ?c - crane ?l - location
      pre: (and (<= (service-time ?c) 0) (>= (service-time ?c) 0) (at-location ?c ?l))
      eff: (and (increase (service-time ?c) (max-service-time ?c)) (not (ready-crane ?c)) (service-crane ?c))
  drive_truck: ?t - truck ?y1 - location ?y2 - location
      pre: (and (at-location ?t ?y1) (connected ?y1 ?y2))
      eff: (and (at-location ?t ?y2) (not (at-location ?t ?y1)))
  load-truck-manual: ?b - brand ?t - truck ?l - location
      pre: (and (> (in-storage ?l ?b) 0) (> (truck-cap ?t) 0) (at-location ?t ?l))
      eff: (and (decrease (in-storage ?l ?b) 1) (decrease (truck-cap ?t) 1) (increase (in-truck-sugar ?b ?t) 1))
  load_truck_crane: ?b - brand ?t - truck ?l - location ?c - crane
      pre: (and (>= (in-storage ?l ?b) (capacity ?c)) (>= (truck-cap ?t) (capacity ?c)) (at-location ?c ?l) (at-location ?t ?l) (ready-crane ?c))
      eff: (and (decrease (in-storage ?l ?b) (capacity ?c)) (decrease (truck-cap ?t) (capacity ?c)) (increase (in-truck-sugar ?b ?t) (capacity ?c)))
  maintainence-crane: ?c - crane ?l - location
      pre: (and (at-location ?c ?l) (service-crane ?c))
      eff: (and (ready-crane ?c))
  order-sugar-cane: ?r - raw-cane ?m - mill
      pre: (and (<= (has-resource ?r ?m) 0) (>= (has-resource ?r ?m) 0))
      eff: (and (place-order ?r ?m))
  produce_sugar: ?r - raw-cane ?m - mill ?b - brand
      pre: (and (> (has-resource ?r ?m) 0) (> (max-changing ?m) 0) (available ?m) (current-process ?m ?b) (produce ?m ?b))
      eff: (and (busy ?m) (decrease (has-resource ?r ?m) 1) (increase (in-storage ?m ?b) 1) (not (available ?m)))
  produce_sugar_max: ?r - raw-cane ?m - mill ?b - brand
      pre: (and (> (max-changing ?m) 0) (>= (has-resource ?r ?m) (max-produce ?m)) (available ?m) (current-process ?m ?b) (produce ?m ?b))
      eff: (and (busy ?m) (decrease (has-resource ?r ?m) (max-produce ?m)) (increase (in-storage ?m ?b) (max-produce ?m)) (not (available ?m)))
  setting-machine: ?m - mill
      pre: (and (busy ?m))
      eff: (and (available ?m) (not (busy ?m)))
  sugar-cane-farm: ?r - raw-cane ?m - mill
      pre: (and (> (unharvest-field) 0) (place-order ?r ?m))
      eff: (and (decrease (unharvest-field) 1) (increase (has-resource ?r ?m) 5) (not (place-order ?r ?m)))
  sugar-cane-mills: ?r - raw-cane ?m1 - mill ?m2 - mill
      pre: (and (> (has-resource ?r ?m2) 0) (place-order ?r ?m1))
      eff: (and (decrease (has-resource ?r ?m2) 1) (increase (has-resource ?r ?m1) 1) (not (place-order ?r ?m1)))
  unload_truck: ?b - brand ?t - truck ?l - location
      pre: (and (> (in-truck-sugar ?b ?t) 0) (at-location ?t ?l))
      eff: (and (decrease (in-truck-sugar ?b ?t) 1) (increase (in-storage ?l ?b) 1) (increase (truck-cap ?t) 1))
Init:
  (= (capacity crane1) 5)
  (= (capacity crane2) 5)
  (= (capacity crane3) 5)
  (= (has-resource sugar-cane mill1) 10)
  (= (has-resource sugar-cane mill2) 10)
