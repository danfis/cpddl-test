    max-service-time: 9 :: read: 1, write: 0, in-init: 1
    service-time: 9 :: read: 1, write: 1, in-init: 1
    handling-cost: :: read: 0, write: 1, in-init: 1
    max-produce: 6 :: read: 1, write: 0, in-init: 1
    labour-cost: :: read: 0, write: 0, in-init: 0
Action[13]:
    produce_sugar: ?r:5 ?m:6 ?b:4
        pre: (and (R:produce ?m ?b) (RW:available ?m) (RW:current-process ?m ?b) (> (has-resource ?r ?m) 0) (> (max-changing ?m) 0))
        eff: (and (N:RW:available ?m) (RW:busy ?m) (increase (in-storage ?m ?b) 1) (decrease (has-resource ?r ?m) 1) (increase (mill-cost) (cost-process ?m)))
    produce_sugar_max: ?r:5 ?m:6 ?b:4
        pre: (and (R:produce ?m ?b) (RW:available ?m) (RW:current-process ?m ?b) (>= (has-resource ?r ?m) (max-produce ?m)) (> (max-changing ?m) 0))
        eff: (and (N:RW:available ?m) (RW:busy ?m) (increase (in-storage ?m ?b) (max-produce ?m)) (decrease (has-resource ?r ?m) (max-produce ?m)) (increase (mill-cost) (* 5 (cost-process ?m))))
    order-sugar-cane: ?r:5 ?m:6
        pre: (and (>= (has-resource ?r ?m) 0) (<= (has-resource ?r ?m) 0))
        eff: (and (RW:place-order ?r ?m))
    setting-machine: ?m:6
        pre: (and (RW:busy ?m))
        eff: (and (RW:available ?m) (N:RW:busy ?m))
    change-product: ?m:6 ?b1:4 ?b2:4
        pre: (and (R:change-process ?b1 ?b2) (RW:current-process ?m ?b1))
        eff: (and (N:RW:current-process ?m ?b1) (RW:current-process ?m ?b2) (decrease (max-changing ?m) 1))
    sugar-cane-farm: ?r:5 ?m:6
        pre: (and (RW:place-order ?r ?m) (> (unharvest-field) 0))
        eff: (and (N:RW:place-order ?r ?m) (decrease (unharvest-field) 1) (increase (has-resource ?r ?m) 5) (increase (inventory-cost) 10))
    sugar-cane-mills: ?r:5 ?m1:6 ?m2:6
        pre: (and (RW:place-order ?r ?m1) (> (has-resource ?r ?m2) 0))
        eff: (and (N:RW:place-order ?r ?m1) (increase (has-resource ?r ?m1) 1) (decrease (has-resource ?r ?m2) 1) (decrease (inventory-cost) 1))
    load_truck_crane: ?b:4 ?t:8 ?l:2 ?c:9
        pre: (and (RW:at-location ?t ?l) (RW:at-location ?c ?l) (RW:ready-crane ?c) (>= (in-storage ?l ?b) (capacity ?c)) (>= (truck-cap ?t) (capacity ?c)))
        eff: (and (decrease (in-storage ?l ?b) (capacity ?c)) (decrease (truck-cap ?t) (capacity ?c)) (increase (in-truck-sugar ?b ?t) (capacity ?c)) (increase (handling-cost) 10))
    check-service: ?c:9 ?l:2
        pre: (and (RW:at-location ?c ?l) (>= (service-time ?c) 0) (<= (service-time ?c) 0))
        eff: (and (N:RW:ready-crane ?c) (RW:service-crane ?c) (increase (service-time ?c) (max-service-time ?c)))
    maintainence-crane: ?c:9 ?l:2
        pre: (and (RW:at-location ?c ?l) (RW:service-crane ?c))
        eff: (and (RW:ready-crane ?c))
    load-truck-manual: ?b:4 ?t:8 ?l:2
        pre: (and (RW:at-location ?t ?l) (> (in-storage ?l ?b) 0) (> (truck-cap ?t) 0))
        eff: (and (decrease (in-storage ?l ?b) 1) (decrease (truck-cap ?t) 1) (increase (in-truck-sugar ?b ?t) 1) (increase (handling-cost) 1))
    drive_truck: ?t:8 ?y1:2 ?y2:2
        pre: (and (R:connected ?y1 ?y2) (RW:at-location ?t ?y1))
        eff: (and (N:RW:at-location ?t ?y1) (RW:at-location ?t ?y2))
    unload_truck: ?b:4 ?t:8 ?l:2
        pre: (and (RW:at-location ?t ?l) (> (in-truck-sugar ?b ?t) 0))
        eff: (and (increase (in-storage ?l ?b) 1) (decrease (in-truck-sugar ?b ?t) 1) (increase (truck-cap ?t) 1))
