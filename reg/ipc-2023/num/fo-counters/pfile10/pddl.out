Action:
  decrement: ?c - counter
      pre: (and (>= (- (value ?c) (rate_value ?c)) 0))
      eff: (and (decrease (value ?c) (rate_value ?c)))
  decrement_rate: ?c - counter
      pre: (and (>= (rate_value ?c) 1))
      eff: (and (decrease (rate_value ?c) 1))
  increase_rate: ?c - counter
      pre: (and (<= (+ (rate_value ?c) 1) 10))
      eff: (and (increase (rate_value ?c) 1))
  increment: ?c - counter
      pre: (and (<= (+ (value ?c) (rate_value ?c)) (max_int)))
      eff: (and (increase (value ?c) (rate_value ?c)))
