    generate: ?t1:2 ?n1:3
        pre: (and (R:demand ?t1 ?n1) (RW:timenow ?t1) (>= (stored_units) 1))
        eff: (and (decrease (stored_units) 1) (increase (stored_capacity) 1) (increase (funds) (value ?n1)))
