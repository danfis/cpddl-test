Action[3]:
    advance_time: ?t1:2 ?t2:2
        pre: (and (R:before ?t1 ?t2) (RW:timenow ?t1))
        eff: (and (N:RW:timenow ?t1) (RW:timenow ?t2))
    pump_water_up: ?t1:2 ?n1:3
        pre: (and (R:demand ?t1 ?n1) (RW:timenow ?t1) (>= (funds) (* 1.050000 (value ?n1))) (>= (stored_capacity) 1))
