Domain: sailing_ln
Problem: instance_1_1_1229
Require:
  :conditional-effects
  :disjunctive-preconditions
  :equality
  :existential-preconditions
  :negative-preconditions
  :numeric-fluents
  :strips
  :typing
  :universal-preconditions
Type:
  boat - object
  object
  person - object
Obj:
  b0 - boat
  p0 - person
Predicate:
  (= object object) :eq
  (dummy)
  (saved person)
Function:
  (d person)
  (v boat)
  (x boat)
  (y boat)
Action:
  accelerate: ?b - boat
      pre: (and (<= (+ (v ?b) 1) 3))
      eff: (and (increase (v ?b) 1))
  decelerate: ?b - boat
      pre: (and (>= (- (v ?b) 1) 1))
      eff: (and (decrease (v ?b) 1))
  go_est: ?b - boat
      pre: (and (not (dummy)))
      eff: (and (increase (x ?b) (* (v ?b) 3)))
  go_north_east: ?b - boat
      pre: (and (not (dummy)))
      eff: (and (increase (x ?b) (* (v ?b) 1.5)) (increase (y ?b) (* (v ?b) 1.5)))
  go_north_west: ?b - boat
      pre: (and (not (dummy)))
      eff: (and (decrease (x ?b) (* (v ?b) 1.5)) (increase (y ?b) (* (v ?b) 1.5)))
  go_south: ?b - boat
      pre: (and (not (dummy)))
      eff: (and (decrease (y ?b) (* (v ?b) 2)))
  go_south_east: ?b - boat
      pre: (and (not (dummy)))
      eff: (and (decrease (x ?b) (* (v ?b) 2)) (decrease (y ?b) (* (v ?b) 2)))
  go_south_west: ?b - boat
      pre: (and (not (dummy)))
      eff: (and (decrease (y ?b) (* (v ?b) 2)) (increase (x ?b) (* (v ?b) 2)))
  go_west: ?b - boat
      pre: (and (not (dummy)))
      eff: (and (decrease (x ?b) (* (v ?b) 3)))
  save_person: ?b - boat ?t - person
      pre: (and (<= (+ (x ?b) (y ?b)) (+ (d ?t) 25)) (<= (- (y ?b) (x ?b)) (+ (d ?t) 25)) (<= (v ?b) 1) (>= (+ (x ?b) (y ?b)) (d ?t)) (>= (- (y ?b) (x ?b)) (d ?t)))
      eff: (and (saved ?t))
Init:
  (= (d p0) -370)
  (= (v b0) 1)
  (= (x b0) 3)
  (= (y b0) 0)
Goal:
  (and (saved p0))
Metric:
Pred prop:
  (dummy): in_pre in_pre_neg
  (saved person): in_goal in_eff
Func prop:
  (d person): in_init init_all_nonpos init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
  (v boat): in_init init_all_nonneg init_all_int in_pre on_num_op_rhs in_eff
  (x boat): in_init init_all_nonneg init_all_int in_pre in_eff rhs_funcs:(v)
  (y boat): in_init init_all_nonneg init_all_nonpos init_all_int in_pre in_eff rhs_funcs:(v)
Global prop:
  has_num_cmp
  is_numeric
  is_unit_cost
