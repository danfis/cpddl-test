Require:
  - :conditional-effects
  - :disjunctive-preconditions
  - :equality
  - :existential-preconditions
  - :object-fluents
  - :universal-preconditions
Predicate:
  + (equal object object)
Action:
  - move-by-car: ?f1 - farm ?f2 - farm
      pre: (and (>= (x ?f1) (* 4 (num-of-cars))) (adj ?f1 ?f2) (not (= ?f1 ?f2)))
      eff: (and (decrease (x ?f1) (* 4 (num-of-cars))) (increase (cost) (* 0.1 (* 4 (num-of-cars)))) (increase (x ?f2) (* 4 (num-of-cars))))
  + move-by-car: ?f1 - farm ?f2 - farm
      pre: (and (>= (x ?f1) (* 4 (num-of-cars))) (adj ?f1 ?f2) (not (equal ?f1 ?f2)))
      eff: (and (decrease (x ?f1) (* 4 (num-of-cars))) (increase (cost) (* 0.1 (* 4 (num-of-cars)))) (increase (x ?f2) (* 4 (num-of-cars))))
  - move-slow: ?f1 - farm ?f2 - farm
      pre: (and (>= (x ?f1) 1) (adj ?f1 ?f2) (not (= ?f1 ?f2)))
      eff: (and (decrease (x ?f1) 1) (increase (x ?f2) 1))
  + move-slow: ?f1 - farm ?f2 - farm
      pre: (and (>= (x ?f1) 1) (adj ?f1 ?f2) (not (equal ?f1 ?f2)))
      eff: (and (decrease (x ?f1) 1) (increase (x ?f2) 1))
Init:
  + (equal farm0 farm0)
  + (equal farm1 farm1)
Pred prop:
  - (= object object): in_pre in_pre_neg
  + (equal object object): in_init in_pre in_pre_neg
Global prop:
  - has_eq_pred
