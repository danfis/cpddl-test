Action:
  - move-by-car: ?f1 - farm ?f2 - farm
      pre: (and (>= (x ?f1) (* 4 (num-of-cars))) (adj ?f1 ?f2) (not (= ?f1 ?f2)))
      eff: (and (decrease (x ?f1) (* 4 (num-of-cars))) (increase (cost) (* 0.4 (num-of-cars))) (increase (x ?f2) (* 4 (num-of-cars))))
  + move-by-car: ?f1 - farm ?f2 - farm
      pre: (and (>= (x ?f1) (* 4 (num-of-cars))) (adj ?f1 ?f2) (not (= ?f1 ?f2)))
      eff: (and (decrease (x ?f1) (* 4 (num-of-cars))) (increase (cost) (* 4 (num-of-cars))) (increase (x ?f2) (* 4 (num-of-cars))))
Goal:
  - (and (>= (- (+ (x farm0) (+ (* 1.7 (x farm1)) (+ (* 1.3 (x farm2)) (+ (* 1.1 (x farm3)) (+ (* 1.4 (x farm4)) (* 1.9 (x farm5))))))) (cost)) 1260) (>= (x farm0) 1) (>= (x farm1) 1) (>= (x farm2) 1) (>= (x farm3) 1) (>= (x farm4) 1) (>= (x farm5) 1))
  + (and (>= (- (+ (* 10 (x farm0)) (+ (* 17 (x farm1)) (+ (* 13 (x farm2)) (+ (* 11 (x farm3)) (+ (* 14 (x farm4)) (* 19 (x farm5))))))) (cost)) 12600) (>= (x farm0) 1) (>= (x farm1) 1) (>= (x farm2) 1) (>= (x farm3) 1) (>= (x farm4) 1) (>= (x farm5) 1))
