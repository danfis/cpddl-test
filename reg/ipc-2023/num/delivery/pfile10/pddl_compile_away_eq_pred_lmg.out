Function[4]:
    load_limit: 4 :: read: 1, write: 0, in-init: 1
    current_load: 4 :: read: 1, write: 1, in-init: 1
    weight: 2 :: read: 1, write: 0, in-init: 1
    cost: :: read: 1, write: 1, in-init: 1
Action[6]:
    move: ?b:4 ?x:1 ?y:1
        pre: (and (R:door ?x ?y) (RW:at-bot ?b ?x))
        eff: (and (N:RW:at-bot ?b ?x) (RW:at-bot ?b ?y) (increase (cost) 3))
    pick: ?i:2 ?x:1 ?a:3 ?b:4
        pre: (and (R:mount ?a ?b) (RW:at-bot ?b ?x) (RW:at ?i ?x) (RW:free ?a) (<= (+ (current_load ?b) (weight ?i)) (load_limit ?b)))
        eff: (and (N:RW:at ?i ?x) (N:RW:free ?a) (RW:in-arm ?i ?a) (increase (current_load ?b) (weight ?i)) (increase (cost) 2))
    drop: ?i:2 ?x:1 ?a:3 ?b:4
        pre: (and (R:mount ?a ?b) (RW:at-bot ?b ?x) (RW:in-arm ?i ?a))
        eff: (and (RW:at ?i ?x) (RW:free ?a) (N:RW:in-arm ?i ?a) (decrease (current_load ?b) (weight ?i)) (increase (cost) 2))
    to-tray: ?i:2 ?a:3 ?b:4
        pre: (and (R:mount ?a octopus) (R:equal ?b octopus) (RW:in-arm ?i ?a))
        eff: (and (RW:free ?a) (N:RW:in-arm ?i ?a) (RW:in-tray ?i octopus) (increase (cost) 1))
    from-tray: ?i:2 ?a:3 ?b:4
        pre: (and (R:mount ?a ?b) (RW:free ?a) (RW:in-tray ?i ?b))
        eff: (and (N:RW:free ?a) (RW:in-arm ?i ?a) (N:RW:in-tray ?i ?b) (increase (cost) 1))
    to-tray: ?i:2 ?a:3 ?b:4
        pre: (and (R:mount ?a ?b) (N:R:equal ?i item24) (N:R:equal ?i item23) (N:R:equal ?i item22) (N:R:equal ?i item21) (N:R:equal ?i item20) (N:R:equal ?i item19) (N:R:equal ?i item18) (N:R:equal ?i item17) (N:R:equal ?i item16) (N:R:equal ?i item15) (N:R:equal ?i item14) (N:R:equal ?i item13) (N:R:equal ?i item12) (N:R:equal ?i item11) (N:R:equal ?i item10) (N:R:equal ?i item9) (N:R:equal ?i item8) (N:R:equal ?i item7) (N:R:equal ?i item6) (N:R:equal ?i item5) (N:R:equal ?i item4) (N:R:equal ?i item3) (N:R:equal ?i item2) (N:R:equal ?i item1) (RW:in-arm ?i ?a))
        eff: (and (RW:free ?a) (N:RW:in-arm ?i ?a) (RW:in-tray ?i ?b) (increase (cost) 1))
