  S:(door rooma roomb)
  S:(door rooma roomc)
  S:(door roomb rooma)
  S:(door roomc rooma)
  S:(mount left1 bot1)
  S:(mount right1 bot1)
  S:(mount left2 bot2)
  S:(mount right2 bot2)
  (at-bot bot1 rooma)
  (at-bot bot2 rooma)
  (at item4 rooma)
  (at item3 rooma)
  (at item2 rooma)
  (at item1 rooma)
  (free left1)
  (free right1)
  (free left2)
  (free right2)
Init[9]:
  (= (weight item4) 1)
  (= (weight item3) 1)
  (= (weight item2) 1)
  (= (weight item1) 1)
  (= (current_load bot1) 0)
  (= (load_limit bot1) 4)
  (= (current_load bot2) 0)
  (= (load_limit bot2) 4)
  (= (cost) 0)
Goal: (and (RW:at item4 roomb) (RW:at item3 roomb) (RW:at item2 roomc) (RW:at item1 roomc))
Metric: (cost)
