Function:
  - (cost)
  + (total-cost) :total-cost
Action:
  - drop: ?i - item ?x - room ?a - arm ?b - bot
      pre: (and (at-bot ?b ?x) (in-arm ?i ?a) (mount ?a ?b))
      eff: (and (at ?i ?x) (decrease (current_load ?b) (weight ?i)) (free ?a) (increase (cost) 2) (not (in-arm ?i ?a)))
  + drop: ?i - item ?x - room ?a - arm ?b - bot
      pre: (and (at-bot ?b ?x) (in-arm ?i ?a) (mount ?a ?b))
      eff: (and (at ?i ?x) (decrease (current_load ?b) (weight ?i)) (free ?a) (increase (total-cost) 2) (not (in-arm ?i ?a)))
  - from-tray: ?i - item ?a - arm ?b - bot
      pre: (and (free ?a) (in-tray ?i ?b) (mount ?a ?b))
      eff: (and (in-arm ?i ?a) (increase (cost) 1) (not (free ?a)) (not (in-tray ?i ?b)))
  + from-tray: ?i - item ?a - arm ?b - bot
      pre: (and (free ?a) (in-tray ?i ?b) (mount ?a ?b))
      eff: (and (in-arm ?i ?a) (increase (total-cost) 1) (not (free ?a)) (not (in-tray ?i ?b)))
  - move: ?b - bot ?x - room ?y - room
      pre: (and (at-bot ?b ?x) (door ?x ?y))
      eff: (and (at-bot ?b ?y) (increase (cost) 3) (not (at-bot ?b ?x)))
  + move: ?b - bot ?x - room ?y - room
      pre: (and (at-bot ?b ?x) (door ?x ?y))
      eff: (and (at-bot ?b ?y) (increase (total-cost) 3) (not (at-bot ?b ?x)))
  - pick: ?i - item ?x - room ?a - arm ?b - bot
      pre: (and (<= (+ (current_load ?b) (weight ?i)) (load_limit ?b)) (at ?i ?x) (at-bot ?b ?x) (free ?a) (mount ?a ?b))
      eff: (and (in-arm ?i ?a) (increase (cost) 2) (increase (current_load ?b) (weight ?i)) (not (at ?i ?x)) (not (free ?a)))
  + pick: ?i - item ?x - room ?a - arm ?b - bot
      pre: (and (<= (+ (current_load ?b) (weight ?i)) (load_limit ?b)) (at ?i ?x) (at-bot ?b ?x) (free ?a) (mount ?a ?b))
      eff: (and (in-arm ?i ?a) (increase (current_load ?b) (weight ?i)) (increase (total-cost) 2) (not (at ?i ?x)) (not (free ?a)))
  - to-tray: ?i - item ?a - arm ?b - bot
      pre: (and (in-arm ?i ?a) (mount ?a ?b))
      eff: (and (free ?a) (in-tray ?i ?b) (increase (cost) 1) (not (in-arm ?i ?a)))
  + to-tray: ?i - item ?a - arm ?b - bot
      pre: (and (in-arm ?i ?a) (mount ?a ?b))
      eff: (and (free ?a) (in-tray ?i ?b) (increase (total-cost) 1) (not (in-arm ?i ?a)))
Init:
  - (= (cost) 0)
  + (= (total-cost) 0)
Metric:
  - (cost)
  + (total-cost)
Func prop:
  - (cost): in_init init_all_nonneg init_all_nonpos init_all_int in_metric is_metric_alone in_eff write_delta_nonneg write_delta_nonneg_int
  + (total-cost): in_init init_all_nonneg init_all_nonpos init_all_int in_metric is_metric_alone in_eff write_delta_nonneg write_delta_nonneg_int
Global prop:
  - action_cost_func:(cost)
  + action_cost_func:(total-cost)
