    [14]: wb5, type: 2, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [15]: wb6, type: 2, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
Predicate[3]:
    =: 0 0 :: read: 0, write: 0, in-init: 0
    at: 1 2 :: read: 1, write: 1, in-init: 1
    is_next: 2 2 :: read: 1, write: 0, in-init: 1
Function[3]:
    sled_supplies: 1 :: read: 1, write: 1, in-init: 1
    sled_capacity: 1 :: read: 1, write: 0, in-init: 1
    waypoint_supplies: 2 :: read: 1, write: 1, in-init: 1
Action[4]:
    move_forwards: ?s:1 ?w1:2 ?w2:2
        pre: (and (R:is_next ?w1 ?w2) (RW:at ?s ?w1) (>= (sled_supplies ?s) 1))
        eff: (and (N:RW:at ?s ?w1) (RW:at ?s ?w2) (decrease (sled_supplies ?s) 1))
    move_backwards: ?s:1 ?w1:2 ?w2:2
        pre: (and (R:is_next ?w2 ?w1) (RW:at ?s ?w1) (>= (sled_supplies ?s) 1))
        eff: (and (N:RW:at ?s ?w1) (RW:at ?s ?w2) (decrease (sled_supplies ?s) 1))
    store_supplies: ?s:1 ?w:2
        pre: (and (RW:at ?s ?w) (>= (sled_supplies ?s) 1))
        eff: (and (increase (waypoint_supplies ?w) 1) (decrease (sled_supplies ?s) 1))
    retrieve_supplies: ?s:1 ?w:2
        pre: (and (RW:at ?s ?w) (>= (waypoint_supplies ?w) 1) (> (sled_capacity ?s) (sled_supplies ?s)))
        eff: (and (decrease (waypoint_supplies ?w) 1) (increase (sled_supplies ?s) 1))
