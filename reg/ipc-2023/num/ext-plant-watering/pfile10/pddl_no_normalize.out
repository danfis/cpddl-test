  (miny)
  (poured plant)
  (total_loaded)
  (total_poured)
  (water_reserve)
  (x thing)
  (y thing)
Action:
  load: ?a - agent ?t - tap
      pre: (and (<= (+ (carrying ?a) 1) (max_carry ?a)) (= (x ?a) (x ?t)) (= (y ?a) (y ?t)) (>= (- (water_reserve) 1) 0))
      eff: (and (decrease (water_reserve) 1) (increase (carrying ?a) 1) (increase (total_loaded) 1))
  move_down: ?a - agent
      pre: (and (>= (- (y ?a) 1) (miny)))
      eff: (and (decrease (y ?a) 1))
  move_down_left: ?a - agent
      pre: (and (>= (- (x ?a) 1) (minx)) (>= (- (y ?a) 1) (miny)))
      eff: (and (decrease (x ?a) 1) (decrease (y ?a) 1))
  move_down_right: ?a - agent
      pre: (and (<= (+ (x ?a) 1) (maxx)) (>= (- (y ?a) 1) (miny)))
      eff: (and (decrease (y ?a) 1) (increase (x ?a) 1))
  move_left: ?a - agent
      pre: (and (>= (- (x ?a) 1) (minx)))
      eff: (and (decrease (x ?a) 1))
  move_right: ?a - agent
      pre: (and (<= (+ (x ?a) 1) (maxx)))
      eff: (and (increase (x ?a) 1))
  move_up: ?a - agent
      pre: (and (<= (+ (y ?a) 1) (maxy)))
      eff: (and (increase (y ?a) 1))
  move_up_left: ?a - agent
      pre: (and (<= (+ (y ?a) 1) (maxy)) (>= (- (x ?a) 1) (minx)))
      eff: (and (decrease (x ?a) 1) (increase (y ?a) 1))
  move_up_right: ?a - agent
      pre: (and (<= (+ (x ?a) 1) (maxx)) (<= (+ (y ?a) 1) (maxy)))
      eff: (and (increase (x ?a) 1) (increase (y ?a) 1))
  pour: ?a - agent ?p - plant
      pre: (and (= (x ?a) (x ?p)) (= (y ?a) (y ?p)) (>= (carrying ?a) 1))
      eff: (and (decrease (carrying ?a) 1) (increase (poured ?p) 1) (increase (total_poured) 1))
