Function:
  - (labour)
  + (total-cost)
Action:
  - break-stone: ?p - place
      pre: (and (has-quarry ?p))
      eff: (and (increase (available stone ?p) 1) (increase (labour) 1))
  + break-stone: ?p - place
      pre: (and (has-quarry ?p))
      eff: (and (increase (available stone ?p) 1) (increase (total-cost) 2))
  - build-cabin: ?p - place
      pre: (and (woodland ?p))
      eff: (and (has-cabin ?p) (increase (labour) 1))
  + build-cabin: ?p - place
      pre: (and (woodland ?p))
      eff: (and (has-cabin ?p) (increase (total-cost) 2))
  - build-cart: ?p - place
      pre: (and (>= (available timber ?p) 1))
      eff: (and (decrease (available timber ?p) 1) (increase (carts-at ?p) 1) (increase (labour) 1))
  + build-cart: ?p - place
      pre: (and (>= (available timber ?p) 1))
