  - build-docks: ?p - place
      pre: (and (>= (available stone ?p) 2) (>= (available wood ?p) 2) (by-coast ?p))
      eff: (and (decrease (available stone ?p) 2) (decrease (available wood ?p) 2) (has-docks ?p) (increase (labour) 2))
  + build-docks: ?p - place
      pre: (and (>= (available stone ?p) 2) (>= (available wood ?p) 2) (by-coast ?p))
      eff: (and (decrease (available stone ?p) 2) (decrease (available wood ?p) 2) (has-docks ?p) (increase (total-cost) 4))
  - build-ironworks: ?p - place
      pre: (and (>= (available stone ?p) 2) (>= (available wood ?p) 2))
      eff: (and (decrease (available stone ?p) 2) (decrease (available wood ?p) 2) (has-ironworks ?p) (increase (labour) 3))
  + build-ironworks: ?p - place
      pre: (and (>= (available stone ?p) 2) (>= (available wood ?p) 2))
      eff: (and (decrease (available stone ?p) 2) (decrease (available wood ?p) 2) (has-ironworks ?p) (increase (total-cost) 6))
  - build-mine: ?p - place
      pre: (and (>= (available wood ?p) 2) (metalliferous ?p))
      eff: (and (decrease (available wood ?p) 2) (has-mine ?p) (increase (labour) 3))
  + build-mine: ?p - place
      pre: (and (>= (available wood ?p) 2) (metalliferous ?p))
      eff: (and (decrease (available wood ?p) 2) (has-mine ?p) (increase (total-cost) 6))
  - build-quarry: ?p - place
      pre: (and (mountain ?p))
      eff: (and (has-quarry ?p) (increase (labour) 2))
  + build-quarry: ?p - place
      pre: (and (mountain ?p))
      eff: (and (has-quarry ?p) (increase (total-cost) 4))
  - build-rail: ?p1 - place ?p2 - place
      pre: (and (>= (available iron ?p1) 1) (>= (available wood ?p1) 1) (connected-by-land ?p1 ?p2))
      eff: (and (connected-by-rail ?p1 ?p2) (decrease (available iron ?p1) 1) (decrease (available wood ?p1) 1) (increase (labour) 2))
  + build-rail: ?p1 - place ?p2 - place
      pre: (and (>= (available iron ?p1) 1) (>= (available wood ?p1) 1) (connected-by-land ?p1 ?p2))
      eff: (and (connected-by-rail ?p1 ?p2) (decrease (available iron ?p1) 1) (decrease (available wood ?p1) 1) (increase (total-cost) 4))
  - build-sawmill: ?p - place
      pre: (and (>= (available timber ?p) 2))
      eff: (and (decrease (available timber ?p) 2) (has-sawmill ?p) (increase (labour) 2))
  + build-sawmill: ?p - place
      pre: (and (>= (available timber ?p) 2))
      eff: (and (decrease (available timber ?p) 2) (has-sawmill ?p) (increase (total-cost) 4))
  - build-ship: ?p - place ?v - vehicle
      pre: (and (>= (available iron ?p) 4) (potential ?v))
      eff: (and (assign (available coal ?v) 0) (assign (available iron ?v) 0) (assign (available ore ?v) 0) (assign (available stone ?v) 0) (assign (available timber ?v) 0) (assign (available wood ?v) 0) (assign (space-in ?v) 10) (decrease (available iron ?p) 4) (increase (labour) 3) (is-at ?v ?p) (is-ship ?v) (not (potential ?v)))
  + build-ship: ?p - place ?v - vehicle
      pre: (and (>= (available iron ?p) 4) (potential ?v))
      eff: (and (assign (available coal ?v) 0) (assign (available iron ?v) 0) (assign (available ore ?v) 0) (assign (available stone ?v) 0) (assign (available timber ?v) 0) (assign (available wood ?v) 0) (assign (space-in ?v) 10) (decrease (available iron ?p) 4) (increase (total-cost) 6) (is-at ?v ?p) (is-ship ?v) (not (potential ?v)))
  - build-train: ?p - place ?v - vehicle
      pre: (and (>= (available iron ?p) 2) (potential ?v))
      eff: (and (assign (available coal ?v) 0) (assign (available iron ?v) 0) (assign (available ore ?v) 0) (assign (available stone ?v) 0) (assign (available timber ?v) 0) (assign (available wood ?v) 0) (assign (space-in ?v) 5) (decrease (available iron ?p) 2) (increase (labour) 2) (is-at ?v ?p) (is-train ?v) (not (potential ?v)))
  + build-train: ?p - place ?v - vehicle
      pre: (and (>= (available iron ?p) 2) (potential ?v))
