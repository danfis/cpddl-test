  + fell-timber: ?p - place
      pre: (and (has-cabin ?p))
      eff: (and (increase (available timber ?p) 1) (increase (total-cost) 2))
  - load: ?v - vehicle ?p - place ?r - resource
      pre: (and (> (available ?r ?p) 0) (> (space-in ?v) 0) (is-at ?v ?p))
      eff: (and (decrease (available ?r ?p) 1) (decrease (space-in ?v) 1) (increase (available ?r ?v) 1) (increase (labour) 1))
  + load: ?v - vehicle ?p - place ?r - resource
      pre: (and (> (available ?r ?p) 0) (> (space-in ?v) 0) (is-at ?v ?p))
      eff: (and (decrease (available ?r ?p) 1) (decrease (space-in ?v) 1) (increase (available ?r ?v) 1) (increase (total-cost) 2))
  - move-empty-cart: ?p1 - place ?p2 - place
      pre: (and (>= (carts-at ?p1) 1) (connected-by-land ?p1 ?p2))
      eff: (and (decrease (carts-at ?p1) 1) (increase (carts-at ?p2) 1) (increase (labour) 2))
  + move-empty-cart: ?p1 - place ?p2 - place
      pre: (and (>= (carts-at ?p1) 1) (connected-by-land ?p1 ?p2))
      eff: (and (decrease (carts-at ?p1) 1) (increase (carts-at ?p2) 1) (increase (total-cost) 4))
  - move-laden-cart: ?p1 - place ?p2 - place ?r - resource
      pre: (and (>= (available ?r ?p1) 1) (>= (carts-at ?p1) 1) (connected-by-land ?p1 ?p2))
      eff: (and (decrease (available ?r ?p1) 1) (decrease (carts-at ?p1) 1) (increase (available ?r ?p2) 1) (increase (carts-at ?p2) 1) (increase (labour) 2))
  + move-laden-cart: ?p1 - place ?p2 - place ?r - resource
      pre: (and (>= (available ?r ?p1) 1) (>= (carts-at ?p1) 1) (connected-by-land ?p1 ?p2))
      eff: (and (decrease (available ?r ?p1) 1) (decrease (carts-at ?p1) 1) (increase (available ?r ?p2) 1) (increase (carts-at ?p2) 1) (increase (total-cost) 4))
  - unload: ?v - vehicle ?p - place ?r - resource
      pre: (and (> (available ?r ?v) 0) (is-at ?v ?p))
      eff: (and (decrease (available ?r ?v) 1) (increase (available ?r ?p) 1) (increase (labour) 1) (increase (space-in ?v) 1))
  + unload: ?v - vehicle ?p - place ?r - resource
      pre: (and (> (available ?r ?v) 0) (is-at ?v ?p))
      eff: (and (decrease (available ?r ?v) 1) (increase (available ?r ?p) 1) (increase (space-in ?v) 1) (increase (total-cost) 2))
Init:
  - (= (labour) 0)
  + (= (total-cost) 0)
Metric:
  - (* 2 (labour))
  + (total-cost)
Func prop:
  - (labour): in_init init_all_nonneg init_all_nonpos init_all_int in_metric in_eff write_delta_nonneg write_delta_nonneg_int
  + (total-cost): in_init init_all_nonneg init_all_nonpos init_all_int in_metric is_metric_alone in_eff write_delta_nonneg write_delta_nonneg_int
Global prop:
  + action_cost_func:(total-cost)
  + has_int_action_cost_func
