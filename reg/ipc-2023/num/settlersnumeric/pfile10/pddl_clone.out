        eff: (and (W:has-wharf ?p) (RW:is-ship ?v) (RW:is-at ?v ?p) (N:RW:potential ?v) (decrease (available iron ?p) 4) (assign (space-in ?v) 10) (assign (available timber ?v) 0) (assign (available wood ?v) 0) (assign (available coal ?v) 0) (assign (available stone ?v) 0) (assign (available iron ?v) 0) (assign (available ore ?v) 0) (increase (labour) 3))
    fell-timber: ?p:2
