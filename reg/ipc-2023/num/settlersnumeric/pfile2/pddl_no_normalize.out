  (labour): in_init init_all_nonneg init_all_nonpos init_all_int in_metric in_eff write_delta_nonneg write_delta_nonneg_int
  (pollution): in_init init_all_nonneg init_all_nonpos init_all_int in_metric in_eff write_delta_nonneg write_delta_nonneg_int
  (resource-use): in_init init_all_nonneg init_all_nonpos init_all_int in_metric in_eff write_delta_nonneg write_delta_nonneg_int
  (space-in vehicle): init_all_nonneg init_all_nonpos init_all_int in_pre in_eff in_eff_by_assign_or_scale
Global prop:
  has_num_cmp
  is_numeric
