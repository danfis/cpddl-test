Action[25]:
    load: ?v:3 ?p:2 ?r:4
        pre: (and (RW:is-at ?v ?p) (> (available ?r ?p) 0) (> (space-in ?v) 0))
        eff: (and (decrease (space-in ?v) 1) (increase (available ?r ?v) 1) (decrease (available ?r ?p) 1))
    unload: ?v:3 ?p:2 ?r:4
        pre: (and (RW:is-at ?v ?p) (> (available ?r ?v) 0))
        eff: (and (increase (space-in ?v) 1) (decrease (available ?r ?v) 1) (increase (available ?r ?p) 1))
    move-empty-cart: ?p1:2 ?p2:2
        pre: (and (R:connected-by-land ?p1 ?p2) (>= (carts-at ?p1) 1))
        eff: (and (decrease (carts-at ?p1) 1) (increase (carts-at ?p2) 1))
    move-laden-cart: ?p1:2 ?p2:2 ?r:4
        pre: (and (R:connected-by-land ?p1 ?p2) (>= (carts-at ?p1) 1) (>= (available ?r ?p1) 1))
        eff: (and (decrease (carts-at ?p1) 1) (increase (carts-at ?p2) 1) (decrease (available ?r ?p1) 1) (increase (available ?r ?p2) 1))
    move-train: ?v:3 ?p1:2 ?p2:2
        pre: (and (RW:connected-by-rail ?p1 ?p2) (RW:is-train ?v) (RW:is-at ?v ?p1) (>= (available coal ?v) 1))
        eff: (and (N:RW:is-at ?v ?p1) (RW:is-at ?v ?p2) (decrease (available coal ?v) 1) (increase (total-cost) 2))
    move-ship: ?v:3 ?p1:2 ?p2:2
        pre: (and (R:connected-by-sea ?p1 ?p2) (RW:is-ship ?v) (RW:is-at ?v ?p1) (>= (available coal ?v) 2))
        eff: (and (N:RW:is-at ?v ?p1) (RW:is-at ?v ?p2) (decrease (available coal ?v) 2) (increase (total-cost) 4))
    build-cabin: ?p:2
        pre: (and (R:woodland ?p))
        eff: (and (RW:has-cabin ?p))
    build-quarry: ?p:2
        pre: (and (R:mountain ?p))
        eff: (and (RW:has-quarry ?p))
    build-coal-stack: ?p:2
        pre: (and (>= (available timber ?p) 1))
        eff: (and (RW:has-coal-stack ?p) (decrease (available timber ?p) 1))
    build-sawmill: ?p:2
        pre: (and (>= (available timber ?p) 2))
        eff: (and (RW:has-sawmill ?p) (decrease (available timber ?p) 2))
    build-mine: ?p:2
        pre: (and (R:metalliferous ?p) (>= (available wood ?p) 2))
        eff: (and (RW:has-mine ?p) (decrease (available wood ?p) 2))
    build-ironworks: ?p:2
        pre: (and (>= (available stone ?p) 2) (>= (available wood ?p) 2))
        eff: (and (RW:has-ironworks ?p) (decrease (available stone ?p) 2) (decrease (available wood ?p) 2))
    build-docks: ?p:2
        pre: (and (R:by-coast ?p) (>= (available stone ?p) 2) (>= (available wood ?p) 2))
        eff: (and (RW:has-docks ?p) (decrease (available stone ?p) 2) (decrease (available wood ?p) 2))
    build-wharf: ?p:2
        pre: (and (RW:has-docks ?p) (>= (available stone ?p) 2) (>= (available iron ?p) 2))
        eff: (and (decrease (available stone ?p) 2) (decrease (available iron ?p) 2))
    build-rail: ?p1:2 ?p2:2
        pre: (and (R:connected-by-land ?p1 ?p2) (>= (available wood ?p1) 1) (>= (available iron ?p1) 1))
        eff: (and (RW:connected-by-rail ?p1 ?p2) (decrease (available wood ?p1) 1) (decrease (available iron ?p1) 1))
    build-house: ?p:2
        pre: (and (>= (available wood ?p) 1) (>= (available stone ?p) 1))
        eff: (and (increase (housing ?p) 1) (decrease (available wood ?p) 1) (decrease (available stone ?p) 1))
    build-cart: ?p:2
        pre: (and (>= (available timber ?p) 1))
        eff: (and (decrease (available timber ?p) 1) (increase (carts-at ?p) 1))
    build-train: ?p:2 ?v:3
        pre: (and (RW:potential ?v) (>= (available iron ?p) 2))
        eff: (and (RW:is-train ?v) (RW:is-at ?v ?p) (N:RW:potential ?v) (decrease (available iron ?p) 2) (assign (space-in ?v) 5) (assign (available timber ?v) 0) (assign (available wood ?v) 0) (assign (available coal ?v) 0) (assign (available stone ?v) 0) (assign (available iron ?v) 0) (assign (available ore ?v) 0))
    build-ship: ?p:2 ?v:3
        pre: (and (RW:potential ?v) (>= (available iron ?p) 4))
        eff: (and (RW:is-ship ?v) (RW:is-at ?v ?p) (N:RW:potential ?v) (decrease (available iron ?p) 4) (assign (space-in ?v) 10) (assign (available timber ?v) 0) (assign (available wood ?v) 0) (assign (available coal ?v) 0) (assign (available stone ?v) 0) (assign (available iron ?v) 0) (assign (available ore ?v) 0))
    fell-timber: ?p:2
        pre: (and (RW:has-cabin ?p))
        eff: (and (increase (available timber ?p) 1))
    break-stone: ?p:2
        pre: (and (RW:has-quarry ?p))
        eff: (and (increase (available stone ?p) 1) (increase (total-cost) 3))
    mine-ore: ?p:2
        pre: (and (RW:has-mine ?p))
        eff: (and (increase (available ore ?p) 1) (increase (total-cost) 6))
    burn-coal: ?p:2
        pre: (and (RW:has-coal-stack ?p) (>= (available timber ?p) 1))
        eff: (and (decrease (available timber ?p) 1) (increase (available coal ?p) 1) (increase (total-cost) 2))
    saw-wood: ?p:2
        pre: (and (RW:has-sawmill ?p) (>= (available timber ?p) 1))
        eff: (and (decrease (available timber ?p) 1) (increase (available wood ?p) 1))
    make-iron: ?p:2
        pre: (and (RW:has-ironworks ?p) (>= (available ore ?p) 1) (>= (available coal ?p) 2))
        eff: (and (decrease (available ore ?p) 1) (decrease (available coal ?p) 2) (increase (available iron ?p) 1) (increase (total-cost) 4))
