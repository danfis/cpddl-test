Domain: sailing
Problem: instance_3_5_1229
Require:
  :numeric-fluents
  :strips
  :typing
Type:
  boat - object
  object
  person - object
Obj:
  b0 - boat
  b1 - boat
  b2 - boat
  p0 - person
  p1 - person
  p2 - person
  p3 - person
  p4 - person
Predicate:
  (= object object) :eq
  (saved person)
Function:
  (d person)
  (x boat)
  (y boat)
Action:
  go_est: ?b - boat
      pre: (and)
      eff: (and (increase (x ?b) 3))
  go_north_east: ?b - boat
      pre: (and)
      eff: (and (increase (x ?b) 1.5) (increase (y ?b) 1.5))
  go_north_west: ?b - boat
      pre: (and)
      eff: (and (decrease (x ?b) 1.5) (increase (y ?b) 1.5))
  go_south: ?b - boat
      pre: (and)
      eff: (and (decrease (y ?b) 2))
  go_south_east: ?b - boat
      pre: (and)
      eff: (and (decrease (x ?b) 2) (decrease (y ?b) 2))
  go_south_west: ?b - boat
      pre: (and)
      eff: (and (decrease (y ?b) 2) (increase (x ?b) 2))
  go_west: ?b - boat
      pre: (and)
      eff: (and (decrease (x ?b) 3))
  save_person: ?b - boat ?t - person
      pre: (and (<= (+ (x ?b) (y ?b)) (+ (d ?t) 25)) (<= (- (y ?b) (x ?b)) (+ (d ?t) 25)) (>= (+ (x ?b) (y ?b)) (d ?t)) (>= (- (y ?b) (x ?b)) (d ?t)))
      eff: (and (saved ?t))
Init:
  (= (d p0) -370)
  (= (d p1) -58)
  (= (d p2) 63)
  (= (d p3) 483)
  (= (d p4) 223)
  (= (x b0) -7)
  (= (x b1) -2)
  (= (x b2) 0)
  (= (y b0) 0)
  (= (y b1) 0)
  (= (y b2) 0)
Goal:
  (and (saved p0) (saved p1) (saved p2) (saved p3) (saved p4))
Metric:
Pred prop:
  (saved person): in_goal in_eff
Func prop:
  (d person): in_init init_all_int in_pre write_delta_nonneg write_delta_nonneg_int
  (x boat): in_init init_all_nonpos init_all_int in_pre in_eff
  (y boat): in_init init_all_nonneg init_all_nonpos init_all_int in_pre in_eff
Global prop:
  has_num_cmp
  is_numeric
  is_unit_cost
