Require:
  + :conditional-effects
  + :equality
Predicate:
  + (NOT-blocked cell direction) neg-of (blocked)
  + (NOT-free cell) neg-of (free)
  - (blocked cell direction)
  + (blocked cell direction) neg-of (NOT-blocked)
  - (free cell)
  + (free cell) neg-of (NOT-free)
Action:
  - step: ?r - robot ?cfrom - cell ?cto - cell ?dir - direction
      pre: (and (at ?r ?cfrom) (free ?cto) (is-moving ?r ?dir) (next ?cfrom ?cto ?dir) (not (blocked ?cfrom ?dir)))
      eff: (and (at ?r ?cto) (free ?cfrom) (increase (total-cost) (step-cost)) (not (at ?r ?cfrom)) (not (free ?cto)))
  + step: ?r - robot ?cfrom - cell ?cto - cell ?dir - direction
      pre: (and (NOT-blocked ?cfrom ?dir) (at ?r ?cfrom) (free ?cto) (is-moving ?r ?dir) (next ?cfrom ?cto ?dir))
      eff: (and (at ?r ?cto) (free ?cfrom) (increase (total-cost) (step-cost)) (not (NOT-free ?cfrom)) (not (at ?r ?cfrom)) (not (free ?cto)) (when (not (= ?cfrom ?cto)) (NOT-free ?cto)))
  - stop-at-robot: ?r - robot ?cat - cell ?cnext - cell ?dir - direction
      pre: (and (at ?r ?cat) (is-moving ?r ?dir) (next ?cat ?cnext ?dir) (not (free ?cnext)))
      eff: (and (increase (total-cost) (stop-cost)) (not (is-moving ?r ?dir)) (nothing-is-moving))
  + stop-at-robot: ?r - robot ?cat - cell ?cnext - cell ?dir - direction
      pre: (and (NOT-free ?cnext) (at ?r ?cat) (is-moving ?r ?dir) (next ?cat ?cnext ?dir))
      eff: (and (increase (total-cost) (stop-cost)) (not (is-moving ?r ?dir)) (nothing-is-moving))
