      pre: (and (= ?dfrom e) (= ?yfrom ?yto) (NOT-cards-moving) (card-at ?cfrom ?xfrom ?yfrom) (card-at ?cto ?xto ?yto) (next ?xto ?xfrom) (not (= ?dto e)) (not (blocked ?cfrom e)) (not (blocked ?cto ?dto)) (robot-at ?cfrom))
      eff: (and (increase (total-cost) (move-robot-cost)) (not (NOT-robot-at ?cto)) (not (robot-at ?cfrom)) (robot-at ?cto) (when (not (= ?cfrom ?cto)) (NOT-robot-at ?cfrom)))
