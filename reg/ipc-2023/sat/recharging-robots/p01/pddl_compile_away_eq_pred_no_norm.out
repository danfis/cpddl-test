    stop-and-guard: ?r:2 ?l:1
        pre: (and (RW:at ?r ?l) (N:RW:stopped ?r))
        eff: (and (RW:stopped ?r) (RW:guarded ?l) (forall (?l2:1 I[0]:?r:2 I[1]:?l:1) (when (or (R:connected ?l ?l2) (R:connected ?l2 ?l)) (RW:guarded ?l2))))
