  move: ?r - robot ?from - location ?to - location ?fpre - battery-level ?fpost - battery-level
      pre: (and (NOT-stopped ?r) (at ?r ?from) (battery ?r ?fpre) (battery-predecessor ?fpost ?fpre) (connected ?to ?from))
      eff: (and (at ?r ?to) (battery ?r ?fpost) (increase (total-cost) (move-cost)) (not (at ?r ?from)) (not (battery ?r ?fpre)))
  recharge: ?rfrom - robot ?rto - robot ?loc - location ?fpre-from - battery-level ?fpost-from - battery-level ?fpre-to - battery-level ?fpost-to - battery-level
      pre: (and (at ?rfrom ?loc) (at ?rto ?loc) (battery ?rfrom ?fpre-from) (battery ?rto ?fpre-to) (battery-predecessor ?fpost-from ?fpre-from) (battery-predecessor ?fpre-to ?fpost-to) (not (= ?rfrom ?rto)))
      eff: (and (battery ?rfrom ?fpost-from) (battery ?rto ?fpost-to) (increase (total-cost) (recharge-cost)) (not (battery ?rfrom ?fpre-from)) (not (battery ?rto ?fpre-to)))
  stop-and-guard: ?r - robot ?l - location
      pre: (and (NOT-stopped ?r) (at ?r ?l))
      eff: (and (not (NOT-stopped ?r)))
