Predicate[11]:
    =: 0 0 :: read: 1, write: 0, in-init: 0
    next-direction: 3 4 3 :: read: 1, write: 0, in-init: 1
    coord-inc: 2 2 :: read: 1, write: 0, in-init: 1
    end-node: 1 :: read: 1, write: 0, in-init: 1
    connected: 1 1 :: read: 1, write: 0, in-init: 1
    at: 1 2 2 :: read: 1, write: 1, in-init: 1
    heading: 1 3 :: read: 1, write: 1, in-init: 1
    free: 2 2 :: read: 1, write: 1, in-init: 1
    rotating: :: read: 1, write: 1, in-init: 0
    node-first-pass-next: 1 4 1 :: read: 1, write: 1, in-init: 0
    node-second-pass-next: 1 :: read: 1, write: 1, in-init: 0
Function[3]:
    total-cost: :: read: 1, write: 1, in-init: 1
    rotate-cost: :: read: 1, write: 0, in-init: 1
    update-cost: :: read: 1, write: 0, in-init: 1
Action[5]:
    rotate: ?n:1 ?r:4 ?fromdir:3 ?todir:3
        pre: (and (R:next-direction ?fromdir ?r ?todir) (RW:heading ?n ?fromdir) (N:RW:rotating))
        eff: (and (N:RW:heading ?n ?fromdir) (RW:heading ?n ?todir) (RW:rotating) (RW:node-first-pass-next ?n ?r ?n) (increase (total-cost) (rotate-cost)))
    rotate-first-pass: ?nstart:1 ?r:4 ?n1:1 ?n2:1 ?n2x:2 ?n2y:2 ?n2dir:3 ?n2setdir:3
        pre: (and (R:next-direction ?n2dir ?r ?n2setdir) (R:connected ?n1 ?n2) (RW:at ?n2 ?n2x ?n2y) (RW:heading ?n2 ?n2dir) (RW:node-first-pass-next ?nstart ?r ?n1))
        eff: (and (N:RW:at ?n2 ?n2x ?n2y) (N:RW:heading ?n2 ?n2dir) (RW:heading ?n2 ?n2setdir) (RW:free ?n2x ?n2y) (N:RW:node-first-pass-next ?nstart ?r ?n1) (RW:node-first-pass-next ?nstart ?r ?n2) (increase (total-cost) (update-cost)))
    rotate-first-pass-end: ?nstart:1 ?r:4 ?n1:1 ?n2:1 ?n2x:2 ?n2y:2
        pre: (and (R:end-node ?n2) (R:connected ?n1 ?n2) (RW:at ?n2 ?n2x ?n2y) (RW:node-first-pass-next ?nstart ?r ?n1))
        eff: (and (N:RW:at ?n2 ?n2x ?n2y) (RW:free ?n2x ?n2y) (N:RW:node-first-pass-next ?nstart ?r ?n1) (RW:node-second-pass-next ?nstart) (increase (total-cost) (update-cost)))
    rotate-second-pass: ?n1:1 ?n1x:2 ?n1y:2 ?n1dir:3 ?n2:1 ?n2x:2 ?n2y:2
        pre: (and (R:connected ?n1 ?n2) (RW:at ?n1 ?n1x ?n1y) (RW:heading ?n1 ?n1dir) (RW:free ?n2x ?n2y) (RW:node-second-pass-next ?n1) (or (and (R:= ?n1dir up) (R:= ?n1x ?n2x) (R:coord-inc ?n1y ?n2y)) (and (R:= ?n1dir down) (R:= ?n1x ?n2x) (R:coord-inc ?n2y ?n1y)) (and (R:= ?n1dir left) (R:= ?n1y ?n2y) (R:coord-inc ?n2x ?n1x)) (and (R:= ?n1dir right) (R:= ?n1y ?n2y) (R:coord-inc ?n1x ?n2x))))
        eff: (and (RW:at ?n2 ?n2x ?n2y) (N:RW:free ?n2x ?n2y) (N:RW:node-second-pass-next ?n1) (RW:node-second-pass-next ?n2) (increase (total-cost) (update-cost)))
    rotate-second-pass-end: ?n:1
        pre: (and (R:end-node ?n) (RW:node-second-pass-next ?n))
        eff: (and (N:RW:rotating) (N:RW:node-second-pass-next ?n) (increase (total-cost) (update-cost)))
