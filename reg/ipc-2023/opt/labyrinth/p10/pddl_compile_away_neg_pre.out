Require:
  - :equality
  - :negative-preconditions
Predicate:
  + (NOT-cards-moving) neg-of (cards-moving)
  + (NOT-cards-moving-east) neg-of (cards-moving-east)
  + (NOT-cards-moving-north) neg-of (cards-moving-north)
  + (NOT-cards-moving-south) neg-of (cards-moving-south)
  + (NOT-cards-moving-west) neg-of (cards-moving-west)
  + (NOT-robot-at card)
  - (blocked card direction)
  - (cards-moving)
  + (cards-moving) neg-of (NOT-cards-moving)
  - (cards-moving-east)
  + (cards-moving-east) neg-of (NOT-cards-moving-east)
  - (cards-moving-north)
  + (cards-moving-north) neg-of (NOT-cards-moving-north)
  - (cards-moving-south)
  + (cards-moving-south) neg-of (NOT-cards-moving-south)
  - (cards-moving-west)
  + (cards-moving-west) neg-of (NOT-cards-moving-west)
  - (robot-at card)
Function:
  - (move-robot-cost)
Action:
  - leave: ?c - card ?prow - gridpos ?pcolumn - gridpos
      pre: (and (card-at ?c ?prow ?pcolumn) (max-pos ?pcolumn) (max-pos ?prow) (not (blocked ?c s)) (not (cards-moving)) (robot-at ?c))
      eff: (and (left))
  - move-card-east: ?cm - card ?x - gridpos ?y - gridpos ?cnext - card ?nextx - gridpos ?prevx - gridpos
      pre: (and (card-at ?cm ?x ?y) (card-at ?cnext ?nextx ?y) (cards-moving) (cards-moving-east) (next ?prevx ?x) (next ?x ?nextx) (next-moving-card ?cm) (not (robot-at ?cm)))
      eff: (and (card-at ?cm ?prevx ?y) (cards-moving) (cards-moving-east) (next-moving-card ?cnext) (not (card-at ?cm ?x ?y)) (not (next-moving-card ?cm)))
  + move-card-east: ?cm - card ?x - gridpos ?y - gridpos ?cnext - card ?nextx - gridpos ?prevx - gridpos
      pre: (and (NOT-robot-at ?cm) (card-at ?cm ?x ?y) (card-at ?cnext ?nextx ?y) (cards-moving) (cards-moving-east) (next ?prevx ?x) (next ?x ?nextx) (next-moving-card ?cm))
      eff: (and (card-at ?cm ?prevx ?y) (cards-moving) (cards-moving-east) (next-moving-card ?cnext) (not (NOT-cards-moving)) (not (NOT-cards-moving-east)) (not (card-at ?cm ?x ?y)) (not (next-moving-card ?cm)))
  - move-card-north: ?cm - card ?x - gridpos ?y - gridpos ?cnext - card ?nexty - gridpos ?prevy - gridpos
      pre: (and (card-at ?cm ?x ?y) (card-at ?cnext ?x ?nexty) (cards-moving) (cards-moving-north) (next ?nexty ?y) (next ?y ?prevy) (next-moving-card ?cm) (not (robot-at ?cm)))
      eff: (and (card-at ?cm ?x ?prevy) (cards-moving) (cards-moving-north) (next-moving-card ?cnext) (not (card-at ?cm ?x ?y)) (not (next-moving-card ?cm)))
  + move-card-north: ?cm - card ?x - gridpos ?y - gridpos ?cnext - card ?nexty - gridpos ?prevy - gridpos
      pre: (and (NOT-robot-at ?cm) (card-at ?cm ?x ?y) (card-at ?cnext ?x ?nexty) (cards-moving) (cards-moving-north) (next ?nexty ?y) (next ?y ?prevy) (next-moving-card ?cm))
      eff: (and (card-at ?cm ?x ?prevy) (cards-moving) (cards-moving-north) (next-moving-card ?cnext) (not (NOT-cards-moving)) (not (NOT-cards-moving-north)) (not (card-at ?cm ?x ?y)) (not (next-moving-card ?cm)))
  - move-card-south: ?cm - card ?x - gridpos ?y - gridpos ?cnext - card ?nexty - gridpos ?prevy - gridpos
      pre: (and (card-at ?cm ?x ?y) (card-at ?cnext ?x ?nexty) (cards-moving) (cards-moving-south) (next ?prevy ?y) (next ?y ?nexty) (next-moving-card ?cm) (not (robot-at ?cm)))
      eff: (and (card-at ?cm ?x ?prevy) (cards-moving) (cards-moving-south) (next-moving-card ?cnext) (not (card-at ?cm ?x ?y)) (not (next-moving-card ?cm)))
  + move-card-south: ?cm - card ?x - gridpos ?y - gridpos ?cnext - card ?nexty - gridpos ?prevy - gridpos
      pre: (and (NOT-robot-at ?cm) (card-at ?cm ?x ?y) (card-at ?cnext ?x ?nexty) (cards-moving) (cards-moving-south) (next ?prevy ?y) (next ?y ?nexty) (next-moving-card ?cm))
      eff: (and (card-at ?cm ?x ?prevy) (cards-moving) (cards-moving-south) (next-moving-card ?cnext) (not (NOT-cards-moving)) (not (NOT-cards-moving-south)) (not (card-at ?cm ?x ?y)) (not (next-moving-card ?cm)))
  - move-card-west: ?cm - card ?x - gridpos ?y - gridpos ?cnext - card ?nextx - gridpos ?prevx - gridpos
      pre: (and (card-at ?cm ?x ?y) (card-at ?cnext ?nextx ?y) (cards-moving) (cards-moving-west) (next ?nextx ?x) (next ?x ?prevx) (next-moving-card ?cm) (not (robot-at ?cm)))
      eff: (and (card-at ?cm ?prevx ?y) (cards-moving) (cards-moving-west) (next-moving-card ?cnext) (not (card-at ?cm ?x ?y)) (not (next-moving-card ?cm)))
  + move-card-west: ?cm - card ?x - gridpos ?y - gridpos ?cnext - card ?nextx - gridpos ?prevx - gridpos
      pre: (and (NOT-robot-at ?cm) (card-at ?cm ?x ?y) (card-at ?cnext ?nextx ?y) (cards-moving) (cards-moving-west) (next ?nextx ?x) (next ?x ?prevx) (next-moving-card ?cm))
      eff: (and (card-at ?cm ?prevx ?y) (cards-moving) (cards-moving-west) (next-moving-card ?cnext) (not (NOT-cards-moving)) (not (NOT-cards-moving-west)) (not (card-at ?cm ?x ?y)) (not (next-moving-card ?cm)))
  - move-east: ?cfrom - card ?xfrom - gridpos ?yfrom - gridpos ?dfrom - directionh ?cto - card ?xto - gridpos ?yto - gridpos ?dto - directionh
      pre: (and (= ?dfrom e) (= ?yfrom ?yto) (card-at ?cfrom ?xfrom ?yfrom) (card-at ?cto ?xto ?yto) (next ?xto ?xfrom) (not (= ?dto e)) (not (blocked ?cfrom e)) (not (blocked ?cto ?dto)) (not (cards-moving)) (robot-at ?cfrom))
      eff: (and (increase (total-cost) (move-robot-cost)) (not (robot-at ?cfrom)) (robot-at ?cto))
  - move-north: ?cfrom - card ?xfrom - gridpos ?yfrom - gridpos ?dfrom - directionv ?cto - card ?xto - gridpos ?yto - gridpos ?dto - directionv
      pre: (and (= ?dfrom n) (= ?xfrom ?xto) (card-at ?cfrom ?xfrom ?yfrom) (card-at ?cto ?xto ?yto) (next ?yfrom ?yto) (not (= ?dto n)) (not (blocked ?cfrom n)) (not (blocked ?cto ?dto)) (not (cards-moving)) (robot-at ?cfrom))
      eff: (and (increase (total-cost) (move-robot-cost)) (not (robot-at ?cfrom)) (robot-at ?cto))
  - move-south: ?cfrom - card ?xfrom - gridpos ?yfrom - gridpos ?dfrom - directionv ?cto - card ?xto - gridpos ?yto - gridpos ?dto - directionv
      pre: (and (= ?dfrom s) (= ?xfrom ?xto) (card-at ?cfrom ?xfrom ?yfrom) (card-at ?cto ?xto ?yto) (next ?yto ?yfrom) (not (= ?dto s)) (not (blocked ?cfrom s)) (not (blocked ?cto ?dto)) (not (cards-moving)) (robot-at ?cfrom))
      eff: (and (increase (total-cost) (move-robot-cost)) (not (robot-at ?cfrom)) (robot-at ?cto))
  - move-west: ?cfrom - card ?xfrom - gridpos ?yfrom - gridpos ?dfrom - directionh ?cto - card ?xto - gridpos ?yto - gridpos ?dto - directionh
      pre: (and (= ?dfrom w) (= ?yfrom ?yto) (card-at ?cfrom ?xfrom ?yfrom) (card-at ?cto ?xto ?yto) (next ?xfrom ?xto) (not (= ?dto w)) (not (blocked ?cfrom w)) (not (blocked ?cto ?dto)) (not (cards-moving)) (robot-at ?cfrom))
      eff: (and (increase (total-cost) (move-robot-cost)) (not (robot-at ?cfrom)) (robot-at ?cto))
  - start-move-card-east: ?cm - card ?x - gridpos ?y - gridpos ?cnext - card ?nextx - gridpos
      pre: (and (card-at ?cm ?x ?y) (card-at ?cnext ?nextx ?y) (max-pos ?x) (next ?x ?nextx) (not (cards-moving)) (not (cards-moving-east)) (not (robot-at ?cm)))
      eff: (and (cards-moving) (cards-moving-east) (increase (total-cost) (move-card)) (new-headtail-card ?cm) (next-moving-card ?cnext) (not (card-at ?cm ?x ?y)))
  + start-move-card-east: ?cm - card ?x - gridpos ?y - gridpos ?cnext - card ?nextx - gridpos
      pre: (and (NOT-cards-moving) (NOT-cards-moving-east) (NOT-robot-at ?cm) (card-at ?cm ?x ?y) (card-at ?cnext ?nextx ?y) (max-pos ?x) (next ?x ?nextx))
      eff: (and (cards-moving) (cards-moving-east) (increase (total-cost) (move-card)) (new-headtail-card ?cm) (next-moving-card ?cnext) (not (NOT-cards-moving)) (not (NOT-cards-moving-east)) (not (card-at ?cm ?x ?y)))
  - start-move-card-north: ?cm - card ?x - gridpos ?y - gridpos ?cnext - card ?nexty - gridpos
      pre: (and (card-at ?cm ?x ?y) (card-at ?cnext ?x ?nexty) (min-pos ?y) (next ?nexty ?y) (not (cards-moving)) (not (cards-moving-north)) (not (robot-at ?cm)))
      eff: (and (cards-moving) (cards-moving-north) (increase (total-cost) (move-card)) (new-headtail-card ?cm) (next-moving-card ?cnext) (not (card-at ?cm ?x ?y)))
  + start-move-card-north: ?cm - card ?x - gridpos ?y - gridpos ?cnext - card ?nexty - gridpos
      pre: (and (NOT-cards-moving) (NOT-cards-moving-north) (NOT-robot-at ?cm) (card-at ?cm ?x ?y) (card-at ?cnext ?x ?nexty) (min-pos ?y) (next ?nexty ?y))
      eff: (and (cards-moving) (cards-moving-north) (increase (total-cost) (move-card)) (new-headtail-card ?cm) (next-moving-card ?cnext) (not (NOT-cards-moving)) (not (NOT-cards-moving-north)) (not (card-at ?cm ?x ?y)))
  - start-move-card-south: ?cm - card ?x - gridpos ?y - gridpos ?cnext - card ?nexty - gridpos
      pre: (and (card-at ?cm ?x ?y) (card-at ?cnext ?x ?nexty) (max-pos ?y) (next ?y ?nexty) (not (cards-moving)) (not (cards-moving-south)) (not (robot-at ?cm)))
      eff: (and (cards-moving) (cards-moving-south) (increase (total-cost) (move-card)) (new-headtail-card ?cm) (next-moving-card ?cnext) (not (card-at ?cm ?x ?y)))
  + start-move-card-south: ?cm - card ?x - gridpos ?y - gridpos ?cnext - card ?nexty - gridpos
      pre: (and (NOT-cards-moving) (NOT-cards-moving-south) (NOT-robot-at ?cm) (card-at ?cm ?x ?y) (card-at ?cnext ?x ?nexty) (max-pos ?y) (next ?y ?nexty))
      eff: (and (cards-moving) (cards-moving-south) (increase (total-cost) (move-card)) (new-headtail-card ?cm) (next-moving-card ?cnext) (not (NOT-cards-moving)) (not (NOT-cards-moving-south)) (not (card-at ?cm ?x ?y)))
  - start-move-card-west: ?cm - card ?x - gridpos ?y - gridpos ?cnext - card ?nextx - gridpos
      pre: (and (card-at ?cm ?x ?y) (card-at ?cnext ?nextx ?y) (min-pos ?x) (next ?nextx ?x) (not (cards-moving)) (not (cards-moving-west)) (not (robot-at ?cm)))
