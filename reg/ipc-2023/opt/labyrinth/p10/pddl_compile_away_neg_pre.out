      eff: (and (cards-moving) (cards-moving-west) (increase (total-cost) (move-card)) (new-headtail-card ?cm) (next-moving-card ?cnext) (not (NOT-cards-moving)) (not (NOT-cards-moving-west)) (not (card-at ?cm ?x ?y)))
  - stop-move-card-east: ?cm - card ?x - gridpos ?y - gridpos ?prevx - gridpos ?newtc - card
      pre: (and (card-at ?cm ?x ?y) (cards-moving) (cards-moving-east) (min-pos ?x) (new-headtail-card ?newtc) (next ?prevx ?x) (next-moving-card ?cm) (not (robot-at ?cm)))
      eff: (and (card-at ?cm ?prevx ?y) (card-at ?newtc ?x ?y) (not (card-at ?cm ?x ?y)) (not (cards-moving)) (not (cards-moving-east)) (not (new-headtail-card ?newtc)) (not (next-moving-card ?cm)))
  + stop-move-card-east: ?cm - card ?x - gridpos ?y - gridpos ?prevx - gridpos ?newtc - card
      pre: (and (NOT-robot-at ?cm) (card-at ?cm ?x ?y) (cards-moving) (cards-moving-east) (min-pos ?x) (new-headtail-card ?newtc) (next ?prevx ?x) (next-moving-card ?cm))
      eff: (and (NOT-cards-moving) (NOT-cards-moving-east) (card-at ?cm ?prevx ?y) (card-at ?newtc ?x ?y) (not (card-at ?cm ?x ?y)) (not (cards-moving)) (not (cards-moving-east)) (not (new-headtail-card ?newtc)) (not (next-moving-card ?cm)))
  - stop-move-card-north: ?cm - card ?x - gridpos ?y - gridpos ?prevy - gridpos ?newtc - card
      pre: (and (card-at ?cm ?x ?y) (cards-moving) (cards-moving-north) (max-pos ?y) (new-headtail-card ?newtc) (next ?y ?prevy) (next-moving-card ?cm) (not (robot-at ?cm)))
      eff: (and (card-at ?cm ?x ?prevy) (card-at ?newtc ?x ?y) (not (card-at ?cm ?x ?y)) (not (cards-moving)) (not (cards-moving-north)) (not (new-headtail-card ?newtc)) (not (next-moving-card ?cm)))
  + stop-move-card-north: ?cm - card ?x - gridpos ?y - gridpos ?prevy - gridpos ?newtc - card
      pre: (and (NOT-robot-at ?cm) (card-at ?cm ?x ?y) (cards-moving) (cards-moving-north) (max-pos ?y) (new-headtail-card ?newtc) (next ?y ?prevy) (next-moving-card ?cm))
