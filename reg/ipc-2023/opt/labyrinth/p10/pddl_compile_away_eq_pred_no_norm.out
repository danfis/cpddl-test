Require:
  - :conditional-effects
  - :disjunctive-preconditions
  - :equality
  - :existential-preconditions
  - :universal-preconditions
Predicate:
  + (equal object object)
Action:
  - move-east: ?cfrom - card ?xfrom - gridpos ?yfrom - gridpos ?dfrom - directionh ?cto - card ?xto - gridpos ?yto - gridpos ?dto - directionh
      pre: (and (= ?dfrom e) (= ?yfrom ?yto) (card-at ?cfrom ?xfrom ?yfrom) (card-at ?cto ?xto ?yto) (next ?xto ?xfrom) (not (= ?dfrom ?dto)) (not (blocked ?cfrom ?dfrom)) (not (blocked ?cto ?dto)) (not (cards-moving)) (robot-at ?cfrom))
      eff: (and (increase (total-cost) (move-robot-cost)) (not (robot-at ?cfrom)) (robot-at ?cto))
  + move-east: ?cfrom - card ?xfrom - gridpos ?yfrom - gridpos ?dfrom - directionh ?cto - card ?xto - gridpos ?yto - gridpos ?dto - directionh
      pre: (and (card-at ?cfrom ?xfrom ?yfrom) (card-at ?cto ?xto ?yto) (equal ?dfrom e) (equal ?yfrom ?yto) (next ?xto ?xfrom) (not (blocked ?cfrom ?dfrom)) (not (blocked ?cto ?dto)) (not (cards-moving)) (not (equal ?dfrom ?dto)) (robot-at ?cfrom))
      eff: (and (increase (total-cost) (move-robot-cost)) (not (robot-at ?cfrom)) (robot-at ?cto))
  - move-north: ?cfrom - card ?xfrom - gridpos ?yfrom - gridpos ?dfrom - directionv ?cto - card ?xto - gridpos ?yto - gridpos ?dto - directionv
      pre: (and (= ?dfrom n) (= ?xfrom ?xto) (card-at ?cfrom ?xfrom ?yfrom) (card-at ?cto ?xto ?yto) (next ?yfrom ?yto) (not (= ?dfrom ?dto)) (not (blocked ?cfrom ?dfrom)) (not (blocked ?cto ?dto)) (not (cards-moving)) (robot-at ?cfrom))
      eff: (and (increase (total-cost) (move-robot-cost)) (not (robot-at ?cfrom)) (robot-at ?cto))
  + move-north: ?cfrom - card ?xfrom - gridpos ?yfrom - gridpos ?dfrom - directionv ?cto - card ?xto - gridpos ?yto - gridpos ?dto - directionv
      pre: (and (card-at ?cfrom ?xfrom ?yfrom) (card-at ?cto ?xto ?yto) (equal ?dfrom n) (equal ?xfrom ?xto) (next ?yfrom ?yto) (not (blocked ?cfrom ?dfrom)) (not (blocked ?cto ?dto)) (not (cards-moving)) (not (equal ?dfrom ?dto)) (robot-at ?cfrom))
      eff: (and (increase (total-cost) (move-robot-cost)) (not (robot-at ?cfrom)) (robot-at ?cto))
  - move-south: ?cfrom - card ?xfrom - gridpos ?yfrom - gridpos ?dfrom - directionv ?cto - card ?xto - gridpos ?yto - gridpos ?dto - directionv
      pre: (and (= ?dfrom s) (= ?xfrom ?xto) (card-at ?cfrom ?xfrom ?yfrom) (card-at ?cto ?xto ?yto) (next ?yto ?yfrom) (not (= ?dfrom ?dto)) (not (blocked ?cfrom ?dfrom)) (not (blocked ?cto ?dto)) (not (cards-moving)) (robot-at ?cfrom))
      eff: (and (increase (total-cost) (move-robot-cost)) (not (robot-at ?cfrom)) (robot-at ?cto))
  + move-south: ?cfrom - card ?xfrom - gridpos ?yfrom - gridpos ?dfrom - directionv ?cto - card ?xto - gridpos ?yto - gridpos ?dto - directionv
      pre: (and (card-at ?cfrom ?xfrom ?yfrom) (card-at ?cto ?xto ?yto) (equal ?dfrom s) (equal ?xfrom ?xto) (next ?yto ?yfrom) (not (blocked ?cfrom ?dfrom)) (not (blocked ?cto ?dto)) (not (cards-moving)) (not (equal ?dfrom ?dto)) (robot-at ?cfrom))
      eff: (and (increase (total-cost) (move-robot-cost)) (not (robot-at ?cfrom)) (robot-at ?cto))
  - move-west: ?cfrom - card ?xfrom - gridpos ?yfrom - gridpos ?dfrom - directionh ?cto - card ?xto - gridpos ?yto - gridpos ?dto - directionh
      pre: (and (= ?dfrom w) (= ?yfrom ?yto) (card-at ?cfrom ?xfrom ?yfrom) (card-at ?cto ?xto ?yto) (next ?xfrom ?xto) (not (= ?dfrom ?dto)) (not (blocked ?cfrom ?dfrom)) (not (blocked ?cto ?dto)) (not (cards-moving)) (robot-at ?cfrom))
      eff: (and (increase (total-cost) (move-robot-cost)) (not (robot-at ?cfrom)) (robot-at ?cto))
  + move-west: ?cfrom - card ?xfrom - gridpos ?yfrom - gridpos ?dfrom - directionh ?cto - card ?xto - gridpos ?yto - gridpos ?dto - directionh
      pre: (and (card-at ?cfrom ?xfrom ?yfrom) (card-at ?cto ?xto ?yto) (equal ?dfrom w) (equal ?yfrom ?yto) (next ?xfrom ?xto) (not (blocked ?cfrom ?dfrom)) (not (blocked ?cto ?dto)) (not (cards-moving)) (not (equal ?dfrom ?dto)) (robot-at ?cfrom))
      eff: (and (increase (total-cost) (move-robot-cost)) (not (robot-at ?cfrom)) (robot-at ?cto))
Init:
  + (equal e e)
  + (equal n n)
  + (equal pos0 pos0)
  + (equal pos1 pos1)
  + (equal pos2 pos2)
  + (equal pos3 pos3)
  + (equal pos4 pos4)
  + (equal pos5 pos5)
  + (equal s s)
  + (equal w w)
Pred prop:
  - (= object object): in_pre in_pre_neg
  + (equal object object): in_init in_pre in_pre_neg
Global prop:
  - has_eq_pred
