Domain: quantum
Problem: test
Require:
  :conditional-effects
  :equality
  :negative-preconditions
  :strips
  :typing
Type:
  gateid - object
  lqubit - object
  object
  pqubit - object
Obj:
  l0 - lqubit :constant
  l0_l4_i3 - gateid :constant
  l0_l4_i42 - gateid :constant
  l0_l4_i46 - gateid :constant
  l0_l4_i7 - gateid :constant
  l1 - lqubit :constant
  l1_l4_i1 - gateid :constant
  l1_l4_i40 - gateid :constant
  l1_l4_i44 - gateid :constant
  l1_l4_i5 - gateid :constant
  l2 - lqubit :constant
  l2_l5_i13 - gateid :constant
  l2_l5_i17 - gateid :constant
  l2_l5_i36 - gateid :constant
  l2_l5_i50 - gateid :constant
  l3 - lqubit :constant
  l3_l5_i28 - gateid :constant
  l3_l5_i30 - gateid :constant
  l3_l6_i23 - gateid :constant
  l3_l6_i27 - gateid :constant
  l4 - lqubit :constant
  l4_l5_i11 - gateid :constant
  l4_l5_i15 - gateid :constant
  l4_l5_i34 - gateid :constant
  l4_l5_i38 - gateid :constant
  l5 - lqubit :constant
  l5_l6_i21 - gateid :constant
  l5_l6_i25 - gateid :constant
  l6 - lqubit :constant
  p0 - pqubit
  p1 - pqubit
  p10 - pqubit
  p11 - pqubit
  p12 - pqubit
  p13 - pqubit
  p2 - pqubit
  p3 - pqubit
  p4 - pqubit
  p5 - pqubit
  p6 - pqubit
  p7 - pqubit
  p8 - pqubit
  p9 - pqubit
Predicate:
  (= object object) :eq
  (NOT-initialized pqubit)
  (NOT-occupied_pqubit pqubit)
  (NOT-rcnot gateid) neg-of (rcnot)
  (connected pqubit pqubit)
  (mapped lqubit pqubit)
  (rcnot gateid) neg-of (NOT-rcnot)
Function:
Action:
  apply_cnot_l0_l4_i3: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-initialized ?p1) (NOT-rcnot l1_l4_i1) (connected ?p1 ?p2) (mapped l4 ?p2) (rcnot l0_l4_i3))
      eff: (and (NOT-rcnot l0_l4_i3) (mapped l0 ?p1) (not (NOT-initialized ?p1)) (not (NOT-occupied_pqubit ?p1)) (not (rcnot l0_l4_i3)))
  apply_cnot_l0_l4_i42: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l0_l4_i7) (NOT-rcnot l1_l4_i40) (connected ?p1 ?p2) (mapped l0 ?p1) (mapped l4 ?p2) (rcnot l0_l4_i42))
      eff: (and (NOT-rcnot l0_l4_i42) (not (rcnot l0_l4_i42)))
  apply_cnot_l0_l4_i46: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l0_l4_i42) (NOT-rcnot l1_l4_i44) (connected ?p1 ?p2) (mapped l0 ?p1) (mapped l4 ?p2) (rcnot l0_l4_i46))
      eff: (and (NOT-rcnot l0_l4_i46) (not (rcnot l0_l4_i46)))
  apply_cnot_l0_l4_i7: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l0_l4_i3) (NOT-rcnot l1_l4_i5) (connected ?p1 ?p2) (mapped l0 ?p1) (mapped l4 ?p2) (rcnot l0_l4_i7))
      eff: (and (NOT-rcnot l0_l4_i7) (not (rcnot l0_l4_i7)))
  apply_cnot_l1_l4_i1: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-initialized ?p1) (NOT-initialized ?p2) (connected ?p1 ?p2) (rcnot l1_l4_i1))
      eff: (and (NOT-rcnot l1_l4_i1) (mapped l1 ?p1) (mapped l4 ?p2) (not (NOT-initialized ?p1)) (not (NOT-initialized ?p2)) (not (NOT-occupied_pqubit ?p1)) (not (NOT-occupied_pqubit ?p2)) (not (rcnot l1_l4_i1)))
  apply_cnot_l1_l4_i40: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l1_l4_i5) (NOT-rcnot l4_l5_i38) (connected ?p1 ?p2) (mapped l1 ?p1) (mapped l4 ?p2) (rcnot l1_l4_i40))
      eff: (and (NOT-rcnot l1_l4_i40) (not (rcnot l1_l4_i40)))
  apply_cnot_l1_l4_i44: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l0_l4_i42) (NOT-rcnot l1_l4_i40) (connected ?p1 ?p2) (mapped l1 ?p1) (mapped l4 ?p2) (rcnot l1_l4_i44))
      eff: (and (NOT-rcnot l1_l4_i44) (not (rcnot l1_l4_i44)))
  apply_cnot_l1_l4_i5: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l0_l4_i3) (NOT-rcnot l1_l4_i1) (connected ?p1 ?p2) (mapped l1 ?p1) (mapped l4 ?p2) (rcnot l1_l4_i5))
      eff: (and (NOT-rcnot l1_l4_i5) (not (rcnot l1_l4_i5)))
  apply_cnot_l2_l5_i13: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-initialized ?p1) (NOT-rcnot l4_l5_i11) (connected ?p1 ?p2) (mapped l5 ?p2) (rcnot l2_l5_i13))
      eff: (and (NOT-rcnot l2_l5_i13) (mapped l2 ?p1) (not (NOT-initialized ?p1)) (not (NOT-occupied_pqubit ?p1)) (not (rcnot l2_l5_i13)))
  apply_cnot_l2_l5_i17: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l2_l5_i13) (NOT-rcnot l4_l5_i15) (connected ?p1 ?p2) (mapped l2 ?p1) (mapped l5 ?p2) (rcnot l2_l5_i17))
      eff: (and (NOT-rcnot l2_l5_i17) (not (rcnot l2_l5_i17)))
  apply_cnot_l2_l5_i36: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l2_l5_i17) (NOT-rcnot l4_l5_i34) (connected ?p1 ?p2) (mapped l2 ?p1) (mapped l5 ?p2) (rcnot l2_l5_i36))
      eff: (and (NOT-rcnot l2_l5_i36) (not (rcnot l2_l5_i36)))
  apply_cnot_l2_l5_i50: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l2_l5_i36) (NOT-rcnot l4_l5_i38) (connected ?p1 ?p2) (mapped l2 ?p1) (mapped l5 ?p2) (rcnot l2_l5_i50))
      eff: (and (NOT-rcnot l2_l5_i50) (not (rcnot l2_l5_i50)))
  apply_cnot_l3_l5_i28: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l3_l6_i27) (NOT-rcnot l5_l6_i25) (connected ?p1 ?p2) (mapped l3 ?p1) (mapped l5 ?p2) (rcnot l3_l5_i28))
      eff: (and (NOT-rcnot l3_l5_i28) (not (rcnot l3_l5_i28)))
  apply_cnot_l3_l5_i30: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l3_l5_i28) (connected ?p1 ?p2) (mapped l3 ?p1) (mapped l5 ?p2) (rcnot l3_l5_i30))
      eff: (and (NOT-rcnot l3_l5_i30) (not (rcnot l3_l5_i30)))
  apply_cnot_l3_l6_i23: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-initialized ?p1) (NOT-rcnot l5_l6_i21) (connected ?p1 ?p2) (mapped l6 ?p2) (rcnot l3_l6_i23))
      eff: (and (NOT-rcnot l3_l6_i23) (mapped l3 ?p1) (not (NOT-initialized ?p1)) (not (NOT-occupied_pqubit ?p1)) (not (rcnot l3_l6_i23)))
  apply_cnot_l3_l6_i27: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l3_l6_i23) (NOT-rcnot l5_l6_i25) (connected ?p1 ?p2) (mapped l3 ?p1) (mapped l6 ?p2) (rcnot l3_l6_i27))
      eff: (and (NOT-rcnot l3_l6_i27) (not (rcnot l3_l6_i27)))
  apply_cnot_l4_l5_i11: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-initialized ?p2) (NOT-rcnot l0_l4_i7) (connected ?p1 ?p2) (mapped l4 ?p1) (rcnot l4_l5_i11))
      eff: (and (NOT-rcnot l4_l5_i11) (mapped l5 ?p2) (not (NOT-initialized ?p2)) (not (NOT-occupied_pqubit ?p2)) (not (rcnot l4_l5_i11)))
  apply_cnot_l4_l5_i15: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l2_l5_i13) (NOT-rcnot l4_l5_i11) (connected ?p1 ?p2) (mapped l4 ?p1) (mapped l5 ?p2) (rcnot l4_l5_i15))
      eff: (and (NOT-rcnot l4_l5_i15) (not (rcnot l4_l5_i15)))
  apply_cnot_l4_l5_i34: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l3_l5_i30) (NOT-rcnot l4_l5_i15) (connected ?p1 ?p2) (mapped l4 ?p1) (mapped l5 ?p2) (rcnot l4_l5_i34))
      eff: (and (NOT-rcnot l4_l5_i34) (not (rcnot l4_l5_i34)))
  apply_cnot_l4_l5_i38: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l2_l5_i36) (NOT-rcnot l4_l5_i34) (connected ?p1 ?p2) (mapped l4 ?p1) (mapped l5 ?p2) (rcnot l4_l5_i38))
      eff: (and (NOT-rcnot l4_l5_i38) (not (rcnot l4_l5_i38)))
  apply_cnot_l5_l6_i21: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-initialized ?p2) (NOT-rcnot l2_l5_i17) (connected ?p1 ?p2) (mapped l5 ?p1) (rcnot l5_l6_i21))
      eff: (and (NOT-rcnot l5_l6_i21) (mapped l6 ?p2) (not (NOT-initialized ?p2)) (not (NOT-occupied_pqubit ?p2)) (not (rcnot l5_l6_i21)))
  apply_cnot_l5_l6_i25: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l3_l6_i23) (NOT-rcnot l5_l6_i21) (connected ?p1 ?p2) (mapped l5 ?p1) (mapped l6 ?p2) (rcnot l5_l6_i25))
      eff: (and (NOT-rcnot l5_l6_i25) (not (rcnot l5_l6_i25)))
  swap-ancilary: ?l1 - lqubit ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-occupied_pqubit ?p2) (connected ?p1 ?p2) (mapped ?l1 ?p1))
      eff: (and (mapped ?l1 ?p2) (not (NOT-initialized ?p2)) (not (NOT-occupied_pqubit ?p2)) (not (mapped ?l1 ?p1)) (when (not (= ?p1 ?p2)) (NOT-occupied_pqubit ?p1)))
  swap: ?l1 - lqubit ?l2 - lqubit ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped ?l1 ?p1) (mapped ?l2 ?p2))
      eff: (and (mapped ?l1 ?p2) (mapped ?l2 ?p1) (not (mapped ?l1 ?p1)) (not (mapped ?l2 ?p2)))
Init:
  (NOT-initialized p0)
  (NOT-initialized p1)
  (NOT-initialized p10)
  (NOT-initialized p11)
