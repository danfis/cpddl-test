Domain: quantum
Problem: test
Require:
  :negative-preconditions
  :strips
  :typing
Type:
  gateid - object
  lqubit - object
  object
  pqubit - object
Obj:
  l0 - lqubit :constant
  l0_l4_i3 - gateid :constant
  l0_l4_i42 - gateid :constant
  l0_l4_i46 - gateid :constant
  l0_l4_i7 - gateid :constant
  l1 - lqubit :constant
  l1_l4_i1 - gateid :constant
  l1_l4_i40 - gateid :constant
  l1_l4_i44 - gateid :constant
  l1_l4_i5 - gateid :constant
  l2 - lqubit :constant
  l2_l5_i13 - gateid :constant
  l2_l5_i17 - gateid :constant
  l2_l5_i36 - gateid :constant
  l2_l5_i50 - gateid :constant
  l3 - lqubit :constant
  l3_l5_i28 - gateid :constant
  l3_l5_i30 - gateid :constant
  l3_l6_i23 - gateid :constant
  l3_l6_i27 - gateid :constant
  l4 - lqubit :constant
  l4_l5_i11 - gateid :constant
  l4_l5_i15 - gateid :constant
  l4_l5_i34 - gateid :constant
  l4_l5_i38 - gateid :constant
  l5 - lqubit :constant
  l5_l6_i21 - gateid :constant
  l5_l6_i25 - gateid :constant
  l6 - lqubit :constant
  p0 - pqubit
  p1 - pqubit
  p10 - pqubit
  p11 - pqubit
  p12 - pqubit
  p13 - pqubit
  p2 - pqubit
  p3 - pqubit
  p4 - pqubit
  p5 - pqubit
  p6 - pqubit
  p7 - pqubit
  p8 - pqubit
  p9 - pqubit
Predicate:
  (= object object) :eq
  (connected pqubit pqubit)
  (initialized pqubit)
  (mapped lqubit pqubit)
  (occupied_pqubit pqubit)
  (rcnot gateid)
Function:
Action:
  apply_cnot_l0_l4_i3: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l4 ?p2) (not (initialized ?p1)) (not (rcnot l1_l4_i1)) (rcnot l0_l4_i3))
      eff: (and (initialized ?p1) (mapped l0 ?p1) (not (rcnot l0_l4_i3)) (occupied_pqubit ?p1))
  apply_cnot_l0_l4_i42: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l0 ?p1) (mapped l4 ?p2) (not (rcnot l0_l4_i7)) (not (rcnot l1_l4_i40)) (rcnot l0_l4_i42))
      eff: (and (not (rcnot l0_l4_i42)))
  apply_cnot_l0_l4_i46: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l0 ?p1) (mapped l4 ?p2) (not (rcnot l0_l4_i42)) (not (rcnot l1_l4_i44)) (rcnot l0_l4_i46))
      eff: (and (not (rcnot l0_l4_i46)))
  apply_cnot_l0_l4_i7: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l0 ?p1) (mapped l4 ?p2) (not (rcnot l0_l4_i3)) (not (rcnot l1_l4_i5)) (rcnot l0_l4_i7))
      eff: (and (not (rcnot l0_l4_i7)))
  apply_cnot_l1_l4_i1: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (not (initialized ?p1)) (not (initialized ?p2)) (rcnot l1_l4_i1))
      eff: (and (initialized ?p1) (initialized ?p2) (mapped l1 ?p1) (mapped l4 ?p2) (not (rcnot l1_l4_i1)) (occupied_pqubit ?p1) (occupied_pqubit ?p2))
  apply_cnot_l1_l4_i40: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l1 ?p1) (mapped l4 ?p2) (not (rcnot l1_l4_i5)) (not (rcnot l4_l5_i38)) (rcnot l1_l4_i40))
      eff: (and (not (rcnot l1_l4_i40)))
  apply_cnot_l1_l4_i44: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l1 ?p1) (mapped l4 ?p2) (not (rcnot l0_l4_i42)) (not (rcnot l1_l4_i40)) (rcnot l1_l4_i44))
      eff: (and (not (rcnot l1_l4_i44)))
  apply_cnot_l1_l4_i5: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l1 ?p1) (mapped l4 ?p2) (not (rcnot l0_l4_i3)) (not (rcnot l1_l4_i1)) (rcnot l1_l4_i5))
      eff: (and (not (rcnot l1_l4_i5)))
  apply_cnot_l2_l5_i13: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l5 ?p2) (not (initialized ?p1)) (not (rcnot l4_l5_i11)) (rcnot l2_l5_i13))
      eff: (and (initialized ?p1) (mapped l2 ?p1) (not (rcnot l2_l5_i13)) (occupied_pqubit ?p1))
  apply_cnot_l2_l5_i17: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l2 ?p1) (mapped l5 ?p2) (not (rcnot l2_l5_i13)) (not (rcnot l4_l5_i15)) (rcnot l2_l5_i17))
      eff: (and (not (rcnot l2_l5_i17)))
  apply_cnot_l2_l5_i36: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l2 ?p1) (mapped l5 ?p2) (not (rcnot l2_l5_i17)) (not (rcnot l4_l5_i34)) (rcnot l2_l5_i36))
      eff: (and (not (rcnot l2_l5_i36)))
  apply_cnot_l2_l5_i50: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l2 ?p1) (mapped l5 ?p2) (not (rcnot l2_l5_i36)) (not (rcnot l4_l5_i38)) (rcnot l2_l5_i50))
      eff: (and (not (rcnot l2_l5_i50)))
  apply_cnot_l3_l5_i28: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l3 ?p1) (mapped l5 ?p2) (not (rcnot l3_l6_i27)) (not (rcnot l5_l6_i25)) (rcnot l3_l5_i28))
      eff: (and (not (rcnot l3_l5_i28)))
  apply_cnot_l3_l5_i30: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l3 ?p1) (mapped l5 ?p2) (not (rcnot l3_l5_i28)) (not (rcnot l3_l5_i28)) (rcnot l3_l5_i30))
      eff: (and (not (rcnot l3_l5_i30)))
  apply_cnot_l3_l6_i23: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l6 ?p2) (not (initialized ?p1)) (not (rcnot l5_l6_i21)) (rcnot l3_l6_i23))
      eff: (and (initialized ?p1) (mapped l3 ?p1) (not (rcnot l3_l6_i23)) (occupied_pqubit ?p1))
  apply_cnot_l3_l6_i27: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l3 ?p1) (mapped l6 ?p2) (not (rcnot l3_l6_i23)) (not (rcnot l5_l6_i25)) (rcnot l3_l6_i27))
      eff: (and (not (rcnot l3_l6_i27)))
  apply_cnot_l4_l5_i11: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l4 ?p1) (not (initialized ?p2)) (not (rcnot l0_l4_i7)) (rcnot l4_l5_i11))
      eff: (and (initialized ?p2) (mapped l5 ?p2) (not (rcnot l4_l5_i11)) (occupied_pqubit ?p2))
  apply_cnot_l4_l5_i15: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l4 ?p1) (mapped l5 ?p2) (not (rcnot l2_l5_i13)) (not (rcnot l4_l5_i11)) (rcnot l4_l5_i15))
      eff: (and (not (rcnot l4_l5_i15)))
  apply_cnot_l4_l5_i34: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l4 ?p1) (mapped l5 ?p2) (not (rcnot l3_l5_i30)) (not (rcnot l4_l5_i15)) (rcnot l4_l5_i34))
      eff: (and (not (rcnot l4_l5_i34)))
  apply_cnot_l4_l5_i38: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l4 ?p1) (mapped l5 ?p2) (not (rcnot l2_l5_i36)) (not (rcnot l4_l5_i34)) (rcnot l4_l5_i38))
      eff: (and (not (rcnot l4_l5_i38)))
  apply_cnot_l5_l6_i21: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l5 ?p1) (not (initialized ?p2)) (not (rcnot l2_l5_i17)) (rcnot l5_l6_i21))
      eff: (and (initialized ?p2) (mapped l6 ?p2) (not (rcnot l5_l6_i21)) (occupied_pqubit ?p2))
  apply_cnot_l5_l6_i25: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l5 ?p1) (mapped l6 ?p2) (not (rcnot l3_l6_i23)) (not (rcnot l5_l6_i21)) (rcnot l5_l6_i25))
      eff: (and (not (rcnot l5_l6_i25)))
  swap-ancilary: ?l1 - lqubit ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped ?l1 ?p1) (not (occupied_pqubit ?p2)))
      eff: (and (initialized ?p2) (mapped ?l1 ?p2) (not (mapped ?l1 ?p1)) (not (occupied_pqubit ?p1)) (occupied_pqubit ?p2))
  swap: ?l1 - lqubit ?l2 - lqubit ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped ?l1 ?p1) (mapped ?l2 ?p2))
      eff: (and (mapped ?l1 ?p2) (mapped ?l2 ?p1) (not (mapped ?l1 ?p1)) (not (mapped ?l2 ?p2)))
Init:
  (connected p1 p0)
  (connected p1 p2)
  (connected p11 p10)
  (connected p11 p12)
  (connected p11 p3)
  (connected p12 p2)
  (connected p13 p1)
  (connected p13 p12)
  (connected p2 p3)
  (connected p4 p10)
  (connected p4 p3)
  (connected p5 p4)
  (connected p5 p6)
  (connected p5 p9)
  (connected p6 p8)
  (connected p7 p8)
  (connected p9 p10)
  (connected p9 p8)
  (rcnot l0_l4_i3)
  (rcnot l0_l4_i42)
  (rcnot l0_l4_i46)
  (rcnot l0_l4_i7)
  (rcnot l1_l4_i1)
  (rcnot l1_l4_i40)
  (rcnot l1_l4_i44)
  (rcnot l1_l4_i5)
  (rcnot l2_l5_i13)
  (rcnot l2_l5_i17)
  (rcnot l2_l5_i36)
  (rcnot l2_l5_i50)
  (rcnot l3_l5_i28)
  (rcnot l3_l5_i30)
  (rcnot l3_l6_i23)
  (rcnot l3_l6_i27)
  (rcnot l4_l5_i11)
  (rcnot l4_l5_i15)
  (rcnot l4_l5_i34)
  (rcnot l4_l5_i38)
  (rcnot l5_l6_i21)
  (rcnot l5_l6_i25)
Goal:
  (and (not (rcnot l0_l4_i3)) (not (rcnot l0_l4_i42)) (not (rcnot l0_l4_i46)) (not (rcnot l0_l4_i7)) (not (rcnot l1_l4_i1)) (not (rcnot l1_l4_i40)) (not (rcnot l1_l4_i44)) (not (rcnot l1_l4_i5)) (not (rcnot l2_l5_i13)) (not (rcnot l2_l5_i17)) (not (rcnot l2_l5_i36)) (not (rcnot l2_l5_i50)) (not (rcnot l3_l5_i28)) (not (rcnot l3_l5_i30)) (not (rcnot l3_l6_i23)) (not (rcnot l3_l6_i27)) (not (rcnot l4_l5_i11)) (not (rcnot l4_l5_i15)) (not (rcnot l4_l5_i34)) (not (rcnot l4_l5_i38)) (not (rcnot l5_l6_i21)) (not (rcnot l5_l6_i25)))
Metric:
Pred prop:
  (connected pqubit pqubit): in_init in_pre
  (initialized pqubit): in_pre in_pre_neg in_eff
  (mapped lqubit pqubit): in_pre in_eff
  (occupied_pqubit pqubit): in_pre in_pre_neg in_eff
  (rcnot gateid): in_init in_pre in_pre_neg in_goal in_goal_neg in_eff
Func prop:
Global prop:
  has_non_static_neg_cond
  is_unit_cost
