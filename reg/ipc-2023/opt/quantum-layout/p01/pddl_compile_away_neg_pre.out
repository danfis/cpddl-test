Require:
  + :conditional-effects
  + :equality
Predicate:
  + (NOT-initialized pqubit)
  + (NOT-occupied_pqubit pqubit)
  + (NOT-rcnot gateid) neg-of (rcnot)
  - (initialized pqubit)
  - (occupied_pqubit pqubit)
  - (rcnot gateid)
  + (rcnot gateid) neg-of (NOT-rcnot)
Action:
  - apply_cnot_l0_l1_i12: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l0 ?p1) (mapped l1 ?p2) (not (rcnot l1_l2_i10)) (not (rcnot l3_l0_i11)) (rcnot l0_l1_i12))
      eff: (and (not (rcnot l0_l1_i12)))
  + apply_cnot_l0_l1_i12: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l1_l2_i10) (NOT-rcnot l3_l0_i11) (connected ?p1 ?p2) (mapped l0 ?p1) (mapped l1 ?p2) (rcnot l0_l1_i12))
      eff: (and (NOT-rcnot l0_l1_i12) (not (rcnot l0_l1_i12)))
  - apply_cnot_l0_l1_i15: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l0 ?p1) (mapped l1 ?p2) (not (rcnot l0_l1_i12)) (rcnot l0_l1_i15))
      eff: (and (not (rcnot l0_l1_i15)))
  + apply_cnot_l0_l1_i15: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l0_l1_i12) (connected ?p1 ?p2) (mapped l0 ?p1) (mapped l1 ?p2) (rcnot l0_l1_i15))
      eff: (and (NOT-rcnot l0_l1_i15) (not (rcnot l0_l1_i15)))
  - apply_cnot_l0_l1_i4: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (not (initialized ?p1)) (not (initialized ?p2)) (rcnot l0_l1_i4))
      eff: (and (initialized ?p1) (initialized ?p2) (mapped l0 ?p1) (mapped l1 ?p2) (not (rcnot l0_l1_i4)) (occupied_pqubit ?p1) (occupied_pqubit ?p2))
  + apply_cnot_l0_l1_i4: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-initialized ?p1) (NOT-initialized ?p2) (connected ?p1 ?p2) (rcnot l0_l1_i4))
      eff: (and (NOT-rcnot l0_l1_i4) (mapped l0 ?p1) (mapped l1 ?p2) (not (NOT-initialized ?p1)) (not (NOT-initialized ?p2)) (not (NOT-occupied_pqubit ?p1)) (not (NOT-occupied_pqubit ?p2)) (not (rcnot l0_l1_i4)))
  - apply_cnot_l1_l2_i10: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l1 ?p1) (mapped l2 ?p2) (not (rcnot l0_l1_i4)) (not (rcnot l2_l3_i9)) (rcnot l1_l2_i10))
      eff: (and (not (rcnot l1_l2_i10)))
  + apply_cnot_l1_l2_i10: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l0_l1_i4) (NOT-rcnot l2_l3_i9) (connected ?p1 ?p2) (mapped l1 ?p1) (mapped l2 ?p2) (rcnot l1_l2_i10))
      eff: (and (NOT-rcnot l1_l2_i10) (not (rcnot l1_l2_i10)))
  - apply_cnot_l2_l3_i16: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l2 ?p1) (mapped l3 ?p2) (not (rcnot l1_l2_i10)) (not (rcnot l3_l0_i11)) (rcnot l2_l3_i16))
      eff: (and (not (rcnot l2_l3_i16)))
  + apply_cnot_l2_l3_i16: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l1_l2_i10) (NOT-rcnot l3_l0_i11) (connected ?p1 ?p2) (mapped l2 ?p1) (mapped l3 ?p2) (rcnot l2_l3_i16))
      eff: (and (NOT-rcnot l2_l3_i16) (not (rcnot l2_l3_i16)))
  - apply_cnot_l2_l3_i19: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l2 ?p1) (mapped l3 ?p2) (not (rcnot l2_l3_i16)) (rcnot l2_l3_i19))
      eff: (and (not (rcnot l2_l3_i19)))
  + apply_cnot_l2_l3_i19: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l2_l3_i16) (connected ?p1 ?p2) (mapped l2 ?p1) (mapped l3 ?p2) (rcnot l2_l3_i19))
      eff: (and (NOT-rcnot l2_l3_i19) (not (rcnot l2_l3_i19)))
  - apply_cnot_l2_l3_i6: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (not (initialized ?p1)) (not (initialized ?p2)) (rcnot l2_l3_i6))
      eff: (and (initialized ?p1) (initialized ?p2) (mapped l2 ?p1) (mapped l3 ?p2) (not (rcnot l2_l3_i6)) (occupied_pqubit ?p1) (occupied_pqubit ?p2))
  + apply_cnot_l2_l3_i6: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-initialized ?p1) (NOT-initialized ?p2) (connected ?p1 ?p2) (rcnot l2_l3_i6))
      eff: (and (NOT-rcnot l2_l3_i6) (mapped l2 ?p1) (mapped l3 ?p2) (not (NOT-initialized ?p1)) (not (NOT-initialized ?p2)) (not (NOT-occupied_pqubit ?p1)) (not (NOT-occupied_pqubit ?p2)) (not (rcnot l2_l3_i6)))
  - apply_cnot_l2_l3_i9: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l2 ?p1) (mapped l3 ?p2) (not (rcnot l2_l3_i6)) (rcnot l2_l3_i9))
      eff: (and (not (rcnot l2_l3_i9)))
  + apply_cnot_l2_l3_i9: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l2_l3_i6) (connected ?p1 ?p2) (mapped l2 ?p1) (mapped l3 ?p2) (rcnot l2_l3_i9))
      eff: (and (NOT-rcnot l2_l3_i9) (not (rcnot l2_l3_i9)))
  - apply_cnot_l3_l0_i11: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l0 ?p2) (mapped l3 ?p1) (not (rcnot l0_l1_i4)) (not (rcnot l2_l3_i9)) (rcnot l3_l0_i11))
      eff: (and (not (rcnot l3_l0_i11)))
  + apply_cnot_l3_l0_i11: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l0_l1_i4) (NOT-rcnot l2_l3_i9) (connected ?p1 ?p2) (mapped l0 ?p2) (mapped l3 ?p1) (rcnot l3_l0_i11))
      eff: (and (NOT-rcnot l3_l0_i11) (not (rcnot l3_l0_i11)))
  - apply_cnot_l3_l0_i21: ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped l0 ?p2) (mapped l3 ?p1) (not (rcnot l0_l1_i15)) (not (rcnot l2_l3_i19)) (rcnot l3_l0_i21))
      eff: (and (not (rcnot l3_l0_i21)))
  + apply_cnot_l3_l0_i21: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l0_l1_i15) (NOT-rcnot l2_l3_i19) (connected ?p1 ?p2) (mapped l0 ?p2) (mapped l3 ?p1) (rcnot l3_l0_i21))
      eff: (and (NOT-rcnot l3_l0_i21) (not (rcnot l3_l0_i21)))
  - swap-ancilary: ?l1 - lqubit ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped ?l1 ?p1) (not (occupied_pqubit ?p2)))
      eff: (and (initialized ?p2) (mapped ?l1 ?p2) (not (mapped ?l1 ?p1)) (not (occupied_pqubit ?p1)) (occupied_pqubit ?p2))
  + swap-ancilary: ?l1 - lqubit ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-occupied_pqubit ?p2) (connected ?p1 ?p2) (mapped ?l1 ?p1))
      eff: (and (mapped ?l1 ?p2) (not (NOT-initialized ?p2)) (not (NOT-occupied_pqubit ?p2)) (not (mapped ?l1 ?p1)) (when (not (= ?p1 ?p2)) (NOT-occupied_pqubit ?p1)))
Init:
  + (NOT-initialized p0)
  + (NOT-initialized p1)
  + (NOT-initialized p10)
  + (NOT-initialized p11)
  + (NOT-initialized p12)
  + (NOT-initialized p13)
