Domain: quantum
Problem: test
Require:
  :conditional-effects
  :equality
  :negative-preconditions
  :strips
  :typing
Type:
  gateid - object
  lqubit - object
  object
  pqubit - object
Obj:
  l0 - lqubit :constant
  l0_l1_i12 - gateid :constant
  l0_l1_i15 - gateid :constant
  l0_l1_i4 - gateid :constant
  l1 - lqubit :constant
  l1_l2_i10 - gateid :constant
  l2 - lqubit :constant
  l2_l3_i16 - gateid :constant
  l2_l3_i19 - gateid :constant
  l2_l3_i6 - gateid :constant
  l2_l3_i9 - gateid :constant
  l3 - lqubit :constant
  l3_l0_i11 - gateid :constant
  l3_l0_i21 - gateid :constant
  p0 - pqubit
  p1 - pqubit
  p10 - pqubit
  p11 - pqubit
  p12 - pqubit
  p13 - pqubit
  p2 - pqubit
  p3 - pqubit
  p4 - pqubit
  p5 - pqubit
  p6 - pqubit
  p7 - pqubit
  p8 - pqubit
  p9 - pqubit
Predicate:
  (= object object) :eq
  (NOT-initialized pqubit)
  (NOT-occupied_pqubit pqubit)
  (NOT-rcnot gateid) neg-of (rcnot)
  (connected pqubit pqubit)
  (mapped lqubit pqubit)
  (rcnot gateid) neg-of (NOT-rcnot)
Function:
Action:
  apply_cnot_l0_l1_i12: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l1_l2_i10) (NOT-rcnot l3_l0_i11) (connected ?p1 ?p2) (mapped l0 ?p1) (mapped l1 ?p2) (rcnot l0_l1_i12))
      eff: (and (NOT-rcnot l0_l1_i12) (not (rcnot l0_l1_i12)))
  apply_cnot_l0_l1_i15: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l0_l1_i12) (connected ?p1 ?p2) (mapped l0 ?p1) (mapped l1 ?p2) (rcnot l0_l1_i15))
      eff: (and (NOT-rcnot l0_l1_i15) (not (rcnot l0_l1_i15)))
  apply_cnot_l0_l1_i4: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-initialized ?p1) (NOT-initialized ?p2) (connected ?p1 ?p2) (rcnot l0_l1_i4))
      eff: (and (NOT-rcnot l0_l1_i4) (mapped l0 ?p1) (mapped l1 ?p2) (not (NOT-initialized ?p1)) (not (NOT-initialized ?p2)) (not (NOT-occupied_pqubit ?p1)) (not (NOT-occupied_pqubit ?p2)) (not (rcnot l0_l1_i4)))
  apply_cnot_l1_l2_i10: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l0_l1_i4) (NOT-rcnot l2_l3_i9) (connected ?p1 ?p2) (mapped l1 ?p1) (mapped l2 ?p2) (rcnot l1_l2_i10))
      eff: (and (NOT-rcnot l1_l2_i10) (not (rcnot l1_l2_i10)))
  apply_cnot_l2_l3_i16: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l1_l2_i10) (NOT-rcnot l3_l0_i11) (connected ?p1 ?p2) (mapped l2 ?p1) (mapped l3 ?p2) (rcnot l2_l3_i16))
      eff: (and (NOT-rcnot l2_l3_i16) (not (rcnot l2_l3_i16)))
  apply_cnot_l2_l3_i19: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l2_l3_i16) (connected ?p1 ?p2) (mapped l2 ?p1) (mapped l3 ?p2) (rcnot l2_l3_i19))
      eff: (and (NOT-rcnot l2_l3_i19) (not (rcnot l2_l3_i19)))
  apply_cnot_l2_l3_i6: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-initialized ?p1) (NOT-initialized ?p2) (connected ?p1 ?p2) (rcnot l2_l3_i6))
      eff: (and (NOT-rcnot l2_l3_i6) (mapped l2 ?p1) (mapped l3 ?p2) (not (NOT-initialized ?p1)) (not (NOT-initialized ?p2)) (not (NOT-occupied_pqubit ?p1)) (not (NOT-occupied_pqubit ?p2)) (not (rcnot l2_l3_i6)))
  apply_cnot_l2_l3_i9: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l2_l3_i6) (connected ?p1 ?p2) (mapped l2 ?p1) (mapped l3 ?p2) (rcnot l2_l3_i9))
      eff: (and (NOT-rcnot l2_l3_i9) (not (rcnot l2_l3_i9)))
  apply_cnot_l3_l0_i11: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l0_l1_i4) (NOT-rcnot l2_l3_i9) (connected ?p1 ?p2) (mapped l0 ?p2) (mapped l3 ?p1) (rcnot l3_l0_i11))
      eff: (and (NOT-rcnot l3_l0_i11) (not (rcnot l3_l0_i11)))
  apply_cnot_l3_l0_i21: ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-rcnot l0_l1_i15) (NOT-rcnot l2_l3_i19) (connected ?p1 ?p2) (mapped l0 ?p2) (mapped l3 ?p1) (rcnot l3_l0_i21))
      eff: (and (NOT-rcnot l3_l0_i21) (not (rcnot l3_l0_i21)))
  swap-ancilary: ?l1 - lqubit ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-occupied_pqubit ?p2) (connected ?p1 ?p2) (mapped ?l1 ?p1))
      eff: (and (mapped ?l1 ?p2) (not (NOT-initialized ?p2)) (not (NOT-occupied_pqubit ?p2)) (not (mapped ?l1 ?p1)) (when (not (= ?p1 ?p2)) (NOT-occupied_pqubit ?p1)))
  swap: ?l1 - lqubit ?l2 - lqubit ?p1 - pqubit ?p2 - pqubit
      pre: (and (connected ?p1 ?p2) (mapped ?l1 ?p1) (mapped ?l2 ?p2))
      eff: (and (mapped ?l1 ?p2) (mapped ?l2 ?p1) (not (mapped ?l1 ?p1)) (not (mapped ?l2 ?p2)))
Init:
  (NOT-initialized p0)
  (NOT-initialized p1)
  (NOT-initialized p10)
  (NOT-initialized p11)
  (NOT-initialized p12)
  (NOT-initialized p13)
  (NOT-initialized p2)
  (NOT-initialized p3)
  (NOT-initialized p4)
  (NOT-initialized p5)
  (NOT-initialized p6)
  (NOT-initialized p7)
  (NOT-initialized p8)
  (NOT-initialized p9)
  (NOT-occupied_pqubit p0)
  (NOT-occupied_pqubit p1)
  (NOT-occupied_pqubit p10)
  (NOT-occupied_pqubit p11)
  (NOT-occupied_pqubit p12)
  (NOT-occupied_pqubit p13)
  (NOT-occupied_pqubit p2)
  (NOT-occupied_pqubit p3)
  (NOT-occupied_pqubit p4)
  (NOT-occupied_pqubit p5)
  (NOT-occupied_pqubit p6)
  (NOT-occupied_pqubit p7)
  (NOT-occupied_pqubit p8)
  (NOT-occupied_pqubit p9)
  (connected p0 p1)
  (connected p1 p0)
  (connected p1 p13)
  (connected p1 p2)
  (connected p10 p11)
  (connected p10 p4)
  (connected p10 p9)
  (connected p11 p10)
  (connected p11 p12)
  (connected p11 p3)
  (connected p12 p11)
  (connected p12 p13)
  (connected p12 p2)
  (connected p13 p1)
  (connected p13 p12)
  (connected p2 p1)
  (connected p2 p12)
  (connected p2 p3)
  (connected p3 p11)
  (connected p3 p2)
  (connected p3 p4)
  (connected p4 p10)
  (connected p4 p3)
  (connected p4 p5)
  (connected p5 p4)
  (connected p5 p6)
  (connected p5 p9)
  (connected p6 p5)
  (connected p6 p8)
  (connected p7 p8)
  (connected p8 p6)
  (connected p8 p7)
  (connected p8 p9)
  (connected p9 p10)
  (connected p9 p5)
  (connected p9 p8)
  (rcnot l0_l1_i12)
  (rcnot l0_l1_i15)
  (rcnot l0_l1_i4)
  (rcnot l1_l2_i10)
  (rcnot l2_l3_i16)
  (rcnot l2_l3_i19)
  (rcnot l2_l3_i6)
  (rcnot l2_l3_i9)
  (rcnot l3_l0_i11)
  (rcnot l3_l0_i21)
Goal:
  (and (NOT-rcnot l0_l1_i12) (NOT-rcnot l0_l1_i15) (NOT-rcnot l0_l1_i4) (NOT-rcnot l1_l2_i10) (NOT-rcnot l2_l3_i16) (NOT-rcnot l2_l3_i19) (NOT-rcnot l2_l3_i6) (NOT-rcnot l2_l3_i9) (NOT-rcnot l3_l0_i11) (NOT-rcnot l3_l0_i21))
Metric:
Pred prop:
  (= object object): in_pre in_pre_neg
  (NOT-initialized pqubit): in_init in_pre in_eff
  (NOT-occupied_pqubit pqubit): in_init in_pre in_eff
  (NOT-rcnot gateid): in_pre in_goal in_eff
  (connected pqubit pqubit): in_init in_pre
  (mapped lqubit pqubit): in_pre in_eff
  (rcnot gateid): in_init in_pre in_eff
Func prop:
Global prop:
  has_cond_eff
  has_eq_pred
  is_unit_cost
