Require:
  - :equality
Predicate:
  + (equal object object)
Action:
  - swap-ancilary: ?l1 - lqubit ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-occupied_pqubit ?p2) (connected ?p1 ?p2) (mapped ?l1 ?p1))
      eff: (and (mapped ?l1 ?p2) (not (NOT-initialized ?p2)) (not (NOT-occupied_pqubit ?p2)) (not (mapped ?l1 ?p1)) (when (not (= ?p1 ?p2)) (NOT-occupied_pqubit ?p1)))
  + swap-ancilary: ?l1 - lqubit ?p1 - pqubit ?p2 - pqubit
      pre: (and (NOT-occupied_pqubit ?p2) (connected ?p1 ?p2) (mapped ?l1 ?p1))
      eff: (and (mapped ?l1 ?p2) (not (NOT-initialized ?p2)) (not (NOT-occupied_pqubit ?p2)) (not (mapped ?l1 ?p1)) (when (not (equal ?p1 ?p2)) (NOT-occupied_pqubit ?p1)))
Init:
  + (equal p0 p0)
  + (equal p1 p1)
  + (equal p10 p10)
  + (equal p11 p11)
  + (equal p12 p12)
  + (equal p13 p13)
  + (equal p2 p2)
  + (equal p3 p3)
  + (equal p4 p4)
  + (equal p5 p5)
  + (equal p6 p6)
  + (equal p7 p7)
  + (equal p8 p8)
  + (equal p9 p9)
Pred prop:
  - (= object object): in_pre in_pre_neg
  + (equal object object): in_init in_pre in_pre_neg
