Require:
  - :conditional-effects
  - :equality
  - :existential-preconditions
  - :universal-preconditions
Predicate:
  + (equal object object)
Action:
  - rotate-second-pass: ?n1 - node ?n1x - coord ?n1y - coord ?n1dir - direction ?n2 - node ?n2x - coord ?n2y - coord
      pre: (and (at ?n1 ?n1x ?n1y) (connected ?n1 ?n2) (free ?n2x ?n2y) (heading ?n1 ?n1dir) (node-second-pass-next ?n1) (or (and (= ?n1dir down) (= ?n1x ?n2x) (coord-inc ?n2y ?n1y)) (and (= ?n1dir left) (= ?n1y ?n2y) (coord-inc ?n2x ?n1x)) (and (= ?n1dir right) (= ?n1y ?n2y) (coord-inc ?n1x ?n2x)) (and (= ?n1dir up) (= ?n1x ?n2x) (coord-inc ?n1y ?n2y))))
      eff: (and (at ?n2 ?n2x ?n2y) (increase (total-cost) (update-cost)) (node-second-pass-next ?n2) (not (free ?n2x ?n2y)) (not (node-second-pass-next ?n1)))
  + rotate-second-pass: ?n1 - node ?n1x - coord ?n1y - coord ?n1dir - direction ?n2 - node ?n2x - coord ?n2y - coord
      pre: (and (at ?n1 ?n1x ?n1y) (connected ?n1 ?n2) (free ?n2x ?n2y) (heading ?n1 ?n1dir) (node-second-pass-next ?n1) (or (and (coord-inc ?n1x ?n2x) (equal ?n1dir right) (equal ?n1y ?n2y)) (and (coord-inc ?n1y ?n2y) (equal ?n1dir up) (equal ?n1x ?n2x)) (and (coord-inc ?n2x ?n1x) (equal ?n1dir left) (equal ?n1y ?n2y)) (and (coord-inc ?n2y ?n1y) (equal ?n1dir down) (equal ?n1x ?n2x))))
      eff: (and (at ?n2 ?n2x ?n2y) (increase (total-cost) (update-cost)) (node-second-pass-next ?n2) (not (free ?n2x ?n2y)) (not (node-second-pass-next ?n1)))
Init:
  + (equal c1 c1)
  + (equal c10 c10)
  + (equal c11 c11)
  + (equal c12 c12)
  + (equal c13 c13)
  + (equal c14 c14)
  + (equal c15 c15)
  + (equal c2 c2)
  + (equal c3 c3)
  + (equal c4 c4)
  + (equal c5 c5)
  + (equal c6 c6)
  + (equal c7 c7)
  + (equal c8 c8)
  + (equal c9 c9)
  + (equal down down)
  + (equal left left)
  + (equal right right)
  + (equal up up)
Pred prop:
  - (= object object): in_pre
  + (equal object object): in_init in_pre
