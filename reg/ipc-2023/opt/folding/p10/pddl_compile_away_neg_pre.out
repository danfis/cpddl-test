Require:
  - :negative-preconditions
Predicate:
  + (NOT-rotating)
  - (rotating)
Action:
  - rotate-second-pass-end: ?n - node
      pre: (and (end-node ?n) (node-second-pass-next ?n))
      eff: (and (increase (total-cost) (update-cost)) (not (node-second-pass-next ?n)) (not (rotating)))
  + rotate-second-pass-end: ?n - node
      pre: (and (end-node ?n) (node-second-pass-next ?n))
      eff: (and (NOT-rotating) (increase (total-cost) (update-cost)) (not (node-second-pass-next ?n)))
  - rotate: ?n - node ?r - rotation ?fromdir - direction ?todir - direction
      pre: (and (heading ?n ?fromdir) (next-direction ?fromdir ?r ?todir) (not (rotating)))
      eff: (and (heading ?n ?todir) (increase (total-cost) (rotate-cost)) (node-first-pass-next ?n ?r ?n) (not (heading ?n ?fromdir)) (rotating))
  + rotate: ?n - node ?r - rotation ?fromdir - direction ?todir - direction
      pre: (and (NOT-rotating) (heading ?n ?fromdir) (next-direction ?fromdir ?r ?todir))
      eff: (and (heading ?n ?todir) (increase (total-cost) (rotate-cost)) (node-first-pass-next ?n ?r ?n) (not (NOT-rotating)) (not (heading ?n ?fromdir)))
Init:
  + (NOT-rotating)
Goal:
  - (and (at n1 c14 c14) (at n10 c18 c19) (at n11 c18 c20) (at n12 c19 c20) (at n13 c19 c19) (at n14 c19 c18) (at n2 c15 c14) (at n3 c15 c15) (at n4 c16 c15) (at n5 c16 c16) (at n6 c17 c16) (at n7 c17 c17) (at n8 c17 c18) (at n9 c18 c18) (not (rotating)))
  + (and (NOT-rotating) (at n1 c14 c14) (at n10 c18 c19) (at n11 c18 c20) (at n12 c19 c20) (at n13 c19 c19) (at n14 c19 c18) (at n2 c15 c14) (at n3 c15 c15) (at n4 c16 c15) (at n5 c16 c16) (at n6 c17 c16) (at n7 c17 c17) (at n8 c17 c18) (at n9 c18 c18))
Pred prop:
  + (NOT-rotating): in_init in_pre in_goal in_eff
  - (rotating): in_pre in_pre_neg in_goal in_goal_neg in_eff
