Predicate[8]:
    =: 0 0 :: read: 1, write: 0, in-init: 0
    next: 2 2 3 :: read: 1, write: 0, in-init: 1
    blocked: 2 3 :: read: 1, write: 0, in-init: 1
    at: 1 2 :: read: 1, write: 1, in-init: 1
    free: 2 :: read: 1, write: 1, in-init: 1, neg-of: NOT-free
    nothing-is-moving: :: read: 1, write: 1, in-init: 1
    is-moving: 1 3 :: read: 1, write: 1, in-init: 0
    NOT-free: 2 :: read: 1, write: 1, in-init: 1, neg-of: free
Function[4]:
    total-cost: :: read: 1, write: 1, in-init: 1
    go-cost: :: read: 1, write: 0, in-init: 1
    step-cost: :: read: 1, write: 0, in-init: 1
    stop-cost: :: read: 1, write: 0, in-init: 1
Action[4]:
    go: ?r:1 ?dir:3
        pre: (and (RW:nothing-is-moving))
        eff: (and (N:RW:nothing-is-moving) (RW:is-moving ?r ?dir) (increase (total-cost) (go-cost)))
    step: ?r:1 ?cfrom:2 ?cto:2 ?dir:3
        pre: (and (N:R:= ?cfrom ?cto) (R:next ?cfrom ?cto ?dir) (N:R:blocked ?cfrom ?dir) (RW:at ?r ?cfrom) (RW:free ?cto) (RW:is-moving ?r ?dir))
        eff: (and (N:RW:at ?r ?cfrom) (RW:at ?r ?cto) (RW:free ?cfrom) (N:RW:free ?cto) (N:RW:NOT-free ?cfrom) (RW:NOT-free ?cto) (increase (total-cost) (step-cost)))
    stop-at-barrier: ?r:1 ?cat:2 ?dir:3
        pre: (and (R:blocked ?cat ?dir) (RW:at ?r ?cat) (RW:is-moving ?r ?dir))
        eff: (and (RW:nothing-is-moving) (N:RW:is-moving ?r ?dir) (increase (total-cost) (stop-cost)))
    stop-at-robot: ?r:1 ?cat:2 ?cnext:2 ?dir:3
        pre: (and (R:next ?cat ?cnext ?dir) (RW:at ?r ?cat) (RW:is-moving ?r ?dir) (RW:NOT-free ?cnext))
        eff: (and (RW:nothing-is-moving) (N:RW:is-moving ?r ?dir) (increase (total-cost) (stop-cost)))
