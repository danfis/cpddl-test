Predicate:
  + (NOT-stopped robot)
  - (stopped robot)
Action:
  - move: ?r - robot ?from - location ?to - location ?fpre - battery-level ?fpost - battery-level
      pre: (and (at ?r ?from) (battery ?r ?fpre) (battery-predecessor ?fpost ?fpre) (connected ?from ?to) (not (stopped ?r)))
      eff: (and (at ?r ?to) (battery ?r ?fpost) (increase (total-cost) (move-cost)) (not (at ?r ?from)) (not (battery ?r ?fpre)))
  - move: ?r - robot ?from - location ?to - location ?fpre - battery-level ?fpost - battery-level
      pre: (and (at ?r ?from) (battery ?r ?fpre) (battery-predecessor ?fpost ?fpre) (connected ?to ?from) (not (stopped ?r)))
      eff: (and (at ?r ?to) (battery ?r ?fpost) (increase (total-cost) (move-cost)) (not (at ?r ?from)) (not (battery ?r ?fpre)))
  + move: ?r - robot ?from - location ?to - location ?fpre - battery-level ?fpost - battery-level
      pre: (and (NOT-stopped ?r) (at ?r ?from) (battery ?r ?fpre) (battery-predecessor ?fpost ?fpre) (connected ?from ?to))
      eff: (and (at ?r ?to) (battery ?r ?fpost) (increase (total-cost) (move-cost)) (not (at ?r ?from)) (not (battery ?r ?fpre)))
  + move: ?r - robot ?from - location ?to - location ?fpre - battery-level ?fpost - battery-level
      pre: (and (NOT-stopped ?r) (at ?r ?from) (battery ?r ?fpre) (battery-predecessor ?fpost ?fpre) (connected ?to ?from))
      eff: (and (at ?r ?to) (battery ?r ?fpost) (increase (total-cost) (move-cost)) (not (at ?r ?from)) (not (battery ?r ?fpre)))
  - stop-and-guard: ?r - robot ?l - location
      pre: (and (at ?r ?l) (not (stopped ?r)))
      eff: (and (stopped ?r))
  + stop-and-guard: ?r - robot ?l - location
      pre: (and (NOT-stopped ?r) (at ?r ?l))
      eff: (and (not (NOT-stopped ?r)))
Init:
  + (NOT-stopped robot-00)
  + (NOT-stopped robot-01)
Pred prop:
  + (NOT-stopped robot): in_init in_pre in_eff
  - (stopped robot): in_pre in_pre_neg in_eff
Global prop:
  - has_non_static_neg_cond
