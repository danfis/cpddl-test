  stop-and-guard: ?r - robot ?l - location
      pre: (and (at ?r ?l) (not (stopped ?r)))
      eff: (and (forall (?l2 - location) (when (or (connected ?l ?l2) (connected ?l2 ?l)) (guarded ?l2))) (guarded ?l) (stopped ?r))
