Require:
  - :equality
Predicate:
  + (equal object object)
Action:
  - drop: ?h - hoist ?c - crate ?a1 - storearea ?a2 - area ?p - place
      pre: (and (at ?h ?a2) (clear ?a1) (connected ?a1 ?a2) (in ?a1 ?p) (lifting ?h ?c) (not (= ?a1 ?a2)))
      eff: (and (available ?h) (in ?c ?p) (not (clear ?a1)) (not (lifting ?h ?c)) (on ?c ?a1))
  - drop: ?h - hoist ?c - crate ?a1 - storearea ?a2 - area ?p - place
      pre: (and (at ?h ?a2) (clear ?a1) (connected ?a1 ?a2) (in ?a1 ?p) (lifting ?h ?c) (not (= ?a2 container-0-0)) (not (= ?a2 depot0-1-1)))
      eff: (and (available ?h) (in ?c ?p) (not (clear ?a1)) (not (lifting ?h ?c)) (on ?c ?a1))
  + drop: ?h - hoist ?c - crate ?a1 - storearea ?a2 - area ?p - place
      pre: (and (at ?h ?a2) (clear ?a1) (connected ?a1 ?a2) (in ?a1 ?p) (lifting ?h ?c) (not (equal ?a1 ?a2)))
      eff: (and (available ?h) (in ?c ?p) (not (clear ?a1)) (not (lifting ?h ?c)) (on ?c ?a1))
  + drop: ?h - hoist ?c - crate ?a1 - storearea ?a2 - area ?p - place
      pre: (and (at ?h ?a2) (clear ?a1) (connected ?a1 ?a2) (in ?a1 ?p) (lifting ?h ?c) (not (equal ?a2 container-0-0)) (not (equal ?a2 depot0-1-1)))
      eff: (and (available ?h) (in ?c ?p) (not (clear ?a1)) (not (lifting ?h ?c)) (on ?c ?a1))
  - lift: ?h - hoist ?c - crate ?a1 - storearea ?a2 - area ?p - place
      pre: (and (at ?h ?a2) (available ?h) (connected ?a1 ?a2) (in ?a1 ?p) (not (= ?a1 ?a2)) (on ?c ?a1))
      eff: (and (clear ?a1) (lifting ?h ?c) (not (available ?h)) (not (in ?c ?p)) (not (on ?c ?a1)))
  - lift: ?h - hoist ?c - crate ?a1 - storearea ?a2 - area ?p - place
      pre: (and (at ?h ?a2) (available ?h) (connected ?a1 ?a2) (in ?a1 ?p) (not (= ?a2 container-0-0)) (not (= ?a2 depot0-1-1)) (on ?c ?a1))
      eff: (and (clear ?a1) (lifting ?h ?c) (not (available ?h)) (not (in ?c ?p)) (not (on ?c ?a1)))
  + lift: ?h - hoist ?c - crate ?a1 - storearea ?a2 - area ?p - place
      pre: (and (at ?h ?a2) (available ?h) (connected ?a1 ?a2) (in ?a1 ?p) (not (equal ?a1 ?a2)) (on ?c ?a1))
      eff: (and (clear ?a1) (lifting ?h ?c) (not (available ?h)) (not (in ?c ?p)) (not (on ?c ?a1)))
  + lift: ?h - hoist ?c - crate ?a1 - storearea ?a2 - area ?p - place
      pre: (and (at ?h ?a2) (available ?h) (connected ?a1 ?a2) (in ?a1 ?p) (not (equal ?a2 container-0-0)) (not (equal ?a2 depot0-1-1)) (on ?c ?a1))
      eff: (and (clear ?a1) (lifting ?h ?c) (not (available ?h)) (not (in ?c ?p)) (not (on ?c ?a1)))
  - move: ?h - hoist ?from - storearea ?to - storearea
      pre: (and (at ?h ?from) (clear ?to) (connected ?from ?to) (not (= ?from ?to)))
      eff: (and (at ?h ?to) (clear ?from) (not (at ?h ?from)) (not (clear ?to)))
  + move: ?h - hoist ?from - storearea ?to - storearea
      pre: (and (at ?h ?from) (clear ?to) (connected ?from ?to) (not (equal ?from ?to)))
      eff: (and (at ?h ?to) (clear ?from) (not (at ?h ?from)) (not (clear ?to)))
Init:
  + (equal container-0-0 container-0-0)
  + (equal depot0-1-1 depot0-1-1)
  + (equal loadarea loadarea)
Pred prop:
  - (= object object): in_pre
  + (equal object object): in_init in_pre
