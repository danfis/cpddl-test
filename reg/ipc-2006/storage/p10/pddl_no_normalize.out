Domain: storage-propositional
Problem: storage-10
Require:
  :conditional-effects
  :disjunctive-preconditions
  :equality
  :existential-preconditions
  :negative-preconditions
  :strips
  :typing
  :universal-preconditions
Type:
  (either crate storearea) (either crate storearea)
  area - surface
  container - place
  crate - surface
  depot - place
  hoist - object
  object
  place - object
  storearea - area
  surface - object
  transitarea - area
Obj:
  container-0-0 - storearea
  container-0-1 - storearea
  container-0-2 - storearea
  container-0-3 - storearea
  container0 - container
  crate0 - crate
  crate1 - crate
  crate2 - crate
  crate3 - crate
  depot0 - depot
  depot0-1-1 - storearea
  depot0-1-2 - storearea
  depot0-1-3 - storearea
  depot0-1-4 - storearea
  depot0-2-1 - storearea
  depot0-2-2 - storearea
  depot0-2-3 - storearea
  depot0-2-4 - storearea
  hoist0 - hoist
  loadarea - transitarea
Predicate:
  (= object object) :eq
  (at hoist area)
  (available hoist)
  (clear storearea)
  (compatible crate crate)
  (connected area area)
  (in (either crate storearea) place)
  (lifting hoist crate)
  (on crate storearea)
Function:
Action:
  drop: ?h - hoist ?c - crate ?a1 - storearea ?a2 - area ?p - place
      pre: (and (at ?h ?a2) (clear ?a1) (connected ?a1 ?a2) (in ?a1 ?p) (lifting ?h ?c))
      eff: (and (available ?h) (in ?c ?p) (not (clear ?a1)) (not (lifting ?h ?c)) (on ?c ?a1))
  go-in: ?h - hoist ?from - transitarea ?to - storearea
      pre: (and (at ?h ?from) (clear ?to) (connected ?from ?to))
      eff: (and (at ?h ?to) (not (at ?h ?from)) (not (clear ?to)))
  go-out: ?h - hoist ?from - storearea ?to - transitarea
      pre: (and (at ?h ?from) (connected ?from ?to))
      eff: (and (at ?h ?to) (clear ?from) (not (at ?h ?from)))
  lift: ?h - hoist ?c - crate ?a1 - storearea ?a2 - area ?p - place
      pre: (and (at ?h ?a2) (available ?h) (connected ?a1 ?a2) (in ?a1 ?p) (on ?c ?a1))
      eff: (and (clear ?a1) (lifting ?h ?c) (not (available ?h)) (not (in ?c ?p)) (not (on ?c ?a1)))
  move: ?h - hoist ?from - storearea ?to - storearea
      pre: (and (at ?h ?from) (clear ?to) (connected ?from ?to))
      eff: (and (at ?h ?to) (clear ?from) (not (at ?h ?from)) (not (clear ?to)))
Init:
  (at hoist0 depot0-1-1)
  (available hoist0)
  (clear depot0-1-2)
  (clear depot0-1-3)
  (clear depot0-1-4)
  (clear depot0-2-1)
  (clear depot0-2-2)
  (clear depot0-2-3)
  (clear depot0-2-4)
  (connected container-0-0 loadarea)
  (connected container-0-1 loadarea)
  (connected container-0-2 loadarea)
  (connected container-0-3 loadarea)
  (connected depot0-1-1 depot0-1-2)
  (connected depot0-1-1 depot0-2-1)
  (connected depot0-1-2 depot0-1-1)
  (connected depot0-1-2 depot0-1-3)
  (connected depot0-1-2 depot0-2-2)
  (connected depot0-1-3 depot0-1-2)
  (connected depot0-1-3 depot0-1-4)
  (connected depot0-1-3 depot0-2-3)
  (connected depot0-1-4 depot0-1-3)
  (connected depot0-1-4 depot0-2-4)
  (connected depot0-2-1 depot0-1-1)
  (connected depot0-2-1 depot0-2-2)
  (connected depot0-2-2 depot0-1-2)
  (connected depot0-2-2 depot0-2-1)
  (connected depot0-2-2 depot0-2-3)
  (connected depot0-2-3 depot0-1-3)
  (connected depot0-2-3 depot0-2-2)
  (connected depot0-2-3 depot0-2-4)
  (connected depot0-2-3 loadarea)
  (connected depot0-2-4 depot0-1-4)
  (connected depot0-2-4 depot0-2-3)
  (connected loadarea container-0-0)
  (connected loadarea container-0-1)
  (connected loadarea container-0-2)
  (connected loadarea container-0-3)
  (connected loadarea depot0-2-3)
  (in container-0-0 container0)
  (in container-0-1 container0)
  (in container-0-2 container0)
  (in container-0-3 container0)
  (in crate0 container0)
  (in crate1 container0)
  (in crate2 container0)
  (in crate3 container0)
  (in depot0-1-1 depot0)
  (in depot0-1-2 depot0)
  (in depot0-1-3 depot0)
  (in depot0-1-4 depot0)
  (in depot0-2-1 depot0)
  (in depot0-2-2 depot0)
  (in depot0-2-3 depot0)
  (in depot0-2-4 depot0)
  (on crate0 container-0-0)
  (on crate1 container-0-1)
  (on crate2 container-0-2)
  (on crate3 container-0-3)
Goal:
  (and (in crate0 depot0) (in crate1 depot0) (in crate2 depot0) (in crate3 depot0))
Metric:
Pred prop:
  (at hoist area): in_init in_pre in_eff
  (available hoist): in_init in_pre in_eff
  (clear storearea): in_init in_pre in_eff
  (connected area area): in_init in_pre
  (in (either crate storearea) place): in_init in_pre in_goal in_eff
  (lifting hoist crate): in_pre in_eff
  (on crate storearea): in_init in_pre in_eff
Func prop:
Global prop:
  is_unit_cost
