Domain: trucks
Problem: truck-1
Require:
  :equality
  :strips
  :typing
Type:
  locatable - object
  location - object
  object
  package - locatable
  time - object
  truck - locatable
  truckarea - object
Obj:
  a1 - truckarea
  a2 - truckarea
  l1 - location
  l2 - location
  l3 - location
  package1 - package
  package2 - package
  package3 - package
  t0 - time
  t1 - time
  t2 - time
  t3 - time
  t4 - time
  t5 - time
  t6 - time
  truck1 - truck
Predicate:
  (= object object) :eq
  (at locatable location)
  (at-destination package location)
  (connected location location)
  (delivered package location time)
  (free truckarea truck)
  (in package truck truckarea)
  (le time time)
  (next time time)
  (time-now time)
Function:
Action:
  deliver: ?p - package ?l - location ?t1 - time ?t2 - time
      pre: (and (at ?p ?l) (le ?t1 ?t2) (time-now ?t1))
      eff: (and (at-destination ?p ?l) (delivered ?p ?l ?t2) (not (at ?p ?l)))
  drive: ?t - truck ?from - location ?to - location ?t1 - time ?t2 - time
      pre: (and (at ?t ?from) (connected ?from ?to) (next ?t1 ?t2) (time-now ?t1))
      eff: (and (at ?t ?to) (not (at ?t ?from)) (not (time-now ?t1)) (time-now ?t2))
  load: ?p - package ?t - truck ?a1 - truckarea ?l - location
      pre: (and (= ?a1 a1) (at ?p ?l) (at ?t ?l) (free a1 ?t))
      eff: (and (in ?p ?t a1) (not (at ?p ?l)) (not (free a1 ?t)))
  load: ?p - package ?t - truck ?a1 - truckarea ?l - location
      pre: (and (= ?a1 a2) (at ?p ?l) (at ?t ?l) (free a1 ?t) (free a2 ?t))
      eff: (and (in ?p ?t a2) (not (at ?p ?l)) (not (free a2 ?t)))
  unload: ?p - package ?t - truck ?a1 - truckarea ?l - location
      pre: (and (= ?a1 a1) (at ?t ?l) (in ?p ?t a1))
      eff: (and (at ?p ?l) (free a1 ?t) (not (in ?p ?t a1)))
  unload: ?p - package ?t - truck ?a1 - truckarea ?l - location
      pre: (and (= ?a1 a2) (at ?t ?l) (free a1 ?t) (in ?p ?t a2))
      eff: (and (at ?p ?l) (free a2 ?t) (not (in ?p ?t a2)))
Init:
  (at package1 l2)
  (at package2 l2)
  (at package3 l2)
  (at truck1 l3)
  (connected l1 l2)
  (connected l1 l3)
  (connected l2 l1)
  (connected l2 l3)
  (connected l3 l1)
  (connected l3 l2)
  (free a1 truck1)
  (free a2 truck1)
  (le t1 t1)
  (le t1 t2)
  (le t1 t3)
  (le t1 t4)
  (le t1 t5)
  (le t1 t6)
  (le t2 t2)
  (le t2 t3)
  (le t2 t4)
  (le t2 t5)
  (le t2 t6)
  (le t3 t3)
  (le t3 t4)
  (le t3 t5)
  (le t3 t6)
  (le t4 t4)
  (le t4 t5)
  (le t4 t6)
  (le t5 t5)
  (le t5 t6)
  (le t6 t6)
  (next t0 t1)
  (next t1 t2)
  (next t2 t3)
  (next t3 t4)
  (next t4 t5)
  (next t5 t6)
  (time-now t0)
Goal:
  (and (at-destination package2 l1) (delivered package1 l3 t3) (delivered package3 l1 t6))
Metric:
Pred prop:
  (= object object): in_pre
  (at locatable location): in_init in_pre in_eff
  (at-destination package location): in_goal in_eff
  (connected location location): in_init in_pre
  (delivered package location time): in_goal in_eff
  (free truckarea truck): in_init in_pre in_eff
  (in package truck truckarea): in_pre in_eff
  (le time time): in_init in_pre
  (next time time): in_init in_pre
  (time-now time): in_init in_pre in_eff
Func prop:
Global prop:
  has_eq_pred
  is_unit_cost
