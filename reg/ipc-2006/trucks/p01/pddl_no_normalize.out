Action[4]:
    load: ?p:6 ?t:5 ?a1:1 ?l:3
        pre: (and (RW:at ?p ?l) (RW:at ?t ?l) (RW:free ?a1 ?t) (forall (?a2:1 I[0]:?p:6 I[1]:?t:5 I[2]:?a1:1 I[3]:?l:3) (imply (R:closer ?a2 ?a1) (RW:free ?a2 ?t))))
        eff: (and (N:RW:at ?p ?l) (RW:in ?p ?t ?a1) (N:RW:free ?a1 ?t))
    unload: ?p:6 ?t:5 ?a1:1 ?l:3
        pre: (and (RW:at ?t ?l) (RW:in ?p ?t ?a1) (forall (?a2:1 I[0]:?p:6 I[1]:?t:5 I[2]:?a1:1 I[3]:?l:3) (imply (R:closer ?a2 ?a1) (RW:free ?a2 ?t))))
        eff: (and (RW:at ?p ?l) (N:RW:in ?p ?t ?a1) (RW:free ?a1 ?t))
    drive: ?t:5 ?from:3 ?to:3 ?t1:2 ?t2:2
        pre: (and (R:connected ?from ?to) (R:next ?t1 ?t2) (RW:at ?t ?from) (RW:time-now ?t1))
        eff: (and (N:RW:at ?t ?from) (RW:at ?t ?to) (N:RW:time-now ?t1) (RW:time-now ?t2))
    deliver: ?p:6 ?l:3 ?t1:2 ?t2:2
        pre: (and (R:le ?t1 ?t2) (RW:at ?p ?l) (RW:time-now ?t1))
        eff: (and (N:RW:at ?p ?l) (RW:delivered ?p ?l ?t2) (RW:at-destination ?p ?l))
