Require:
  - :equality
Predicate:
  + (equal object object)
Action:
  - deliver: ?p - package ?l - location ?t1 - time ?t2 - time
      pre: (and (= ?l l1) (= ?t2 t6) (at ?p l1) (le ?t1 t6) (not (= ?p package1)) (time-now ?t1))
      eff: (and (at-destination ?p l1) (delivered ?p l1 t6) (not (at ?p l1)))
  - deliver: ?p - package ?l - location ?t1 - time ?t2 - time
      pre: (and (= ?l l1) (at ?p l1) (le ?t1 ?t2) (not (= ?p package1)) (not (= ?p package3)) (time-now ?t1))
      eff: (and (at-destination ?p l1) (delivered ?p l1 ?t2) (not (at ?p l1)))
  - deliver: ?p - package ?l - location ?t1 - time ?t2 - time
      pre: (and (= ?l l3) (= ?t2 t3) (at ?p l3) (le ?t1 t3) (not (= ?p package2)) (not (= ?p package3)) (time-now ?t1))
      eff: (and (at-destination ?p l3) (delivered ?p l3 t3) (not (at ?p l3)))
  - deliver: ?p - package ?l - location ?t1 - time ?t2 - time
      pre: (and (at ?p ?l) (le ?t1 ?t2) (not (= ?p package1)) (not (= ?p package2)) (not (= ?p package3)) (time-now ?t1))
      eff: (and (at-destination ?p ?l) (delivered ?p ?l ?t2) (not (at ?p ?l)))
  + deliver: ?p - package ?l - location ?t1 - time ?t2 - time
      pre: (and (at ?p ?l) (le ?t1 ?t2) (not (equal ?p package1)) (not (equal ?p package2)) (not (equal ?p package3)) (time-now ?t1))
      eff: (and (at-destination ?p ?l) (delivered ?p ?l ?t2) (not (at ?p ?l)))
  + deliver: ?p - package ?l - location ?t1 - time ?t2 - time
      pre: (and (at ?p l1) (equal ?l l1) (equal ?t2 t6) (le ?t1 t6) (not (equal ?p package1)) (time-now ?t1))
      eff: (and (at-destination ?p l1) (delivered ?p l1 t6) (not (at ?p l1)))
  + deliver: ?p - package ?l - location ?t1 - time ?t2 - time
      pre: (and (at ?p l1) (equal ?l l1) (le ?t1 ?t2) (not (equal ?p package1)) (not (equal ?p package3)) (time-now ?t1))
      eff: (and (at-destination ?p l1) (delivered ?p l1 ?t2) (not (at ?p l1)))
  + deliver: ?p - package ?l - location ?t1 - time ?t2 - time
      pre: (and (at ?p l3) (equal ?l l3) (equal ?t2 t3) (le ?t1 t3) (not (equal ?p package2)) (not (equal ?p package3)) (time-now ?t1))
      eff: (and (at-destination ?p l3) (delivered ?p l3 t3) (not (at ?p l3)))
  - load: ?p - package ?t - truck ?a1 - truckarea ?l - location
      pre: (and (= ?a1 a1) (= ?t truck1) (at ?p ?l) (at truck1 ?l) (free a1 truck1))
      eff: (and (in ?p truck1 a1) (not (at ?p ?l)) (not (free a1 truck1)))
  - load: ?p - package ?t - truck ?a1 - truckarea ?l - location
      pre: (and (= ?a1 a1) (at ?p ?l) (at ?t ?l) (free a1 ?t) (not (= ?p package1)) (not (= ?p package2)) (not (= ?p package3)))
      eff: (and (in ?p ?t a1) (not (at ?p ?l)) (not (free a1 ?t)))
  - load: ?p - package ?t - truck ?a1 - truckarea ?l - location
      pre: (and (= ?a1 a2) (= ?t truck1) (at ?p ?l) (at truck1 ?l) (free a1 truck1) (free a2 truck1))
      eff: (and (in ?p truck1 a2) (not (at ?p ?l)) (not (free a2 truck1)))
  - load: ?p - package ?t - truck ?a1 - truckarea ?l - location
      pre: (and (= ?a1 a2) (at ?p ?l) (at ?t ?l) (free a1 ?t) (free a2 ?t) (not (= ?p package1)) (not (= ?p package2)) (not (= ?p package3)))
      eff: (and (in ?p ?t a2) (not (at ?p ?l)) (not (free a2 ?t)))
  + load: ?p - package ?t - truck ?a1 - truckarea ?l - location
      pre: (and (at ?p ?l) (at ?t ?l) (equal ?a1 a1) (free a1 ?t) (not (equal ?p package1)) (not (equal ?p package2)) (not (equal ?p package3)))
      eff: (and (in ?p ?t a1) (not (at ?p ?l)) (not (free a1 ?t)))
  + load: ?p - package ?t - truck ?a1 - truckarea ?l - location
      pre: (and (at ?p ?l) (at ?t ?l) (equal ?a1 a2) (free a1 ?t) (free a2 ?t) (not (equal ?p package1)) (not (equal ?p package2)) (not (equal ?p package3)))
      eff: (and (in ?p ?t a2) (not (at ?p ?l)) (not (free a2 ?t)))
  + load: ?p - package ?t - truck ?a1 - truckarea ?l - location
      pre: (and (at ?p ?l) (at truck1 ?l) (equal ?a1 a1) (equal ?t truck1) (free a1 truck1))
      eff: (and (in ?p truck1 a1) (not (at ?p ?l)) (not (free a1 truck1)))
  + load: ?p - package ?t - truck ?a1 - truckarea ?l - location
      pre: (and (at ?p ?l) (at truck1 ?l) (equal ?a1 a2) (equal ?t truck1) (free a1 truck1) (free a2 truck1))
      eff: (and (in ?p truck1 a2) (not (at ?p ?l)) (not (free a2 truck1)))
  - unload: ?p - package ?t - truck ?a1 - truckarea ?l - location
      pre: (and (= ?a1 a1) (at ?t ?l) (in ?p ?t a1))
      eff: (and (at ?p ?l) (free a1 ?t) (not (in ?p ?t a1)))
  - unload: ?p - package ?t - truck ?a1 - truckarea ?l - location
      pre: (and (= ?a1 a2) (at ?t ?l) (free a1 ?t) (in ?p ?t a2))
      eff: (and (at ?p ?l) (free a2 ?t) (not (in ?p ?t a2)))
  + unload: ?p - package ?t - truck ?a1 - truckarea ?l - location
      pre: (and (at ?t ?l) (equal ?a1 a1) (in ?p ?t a1))
      eff: (and (at ?p ?l) (free a1 ?t) (not (in ?p ?t a1)))
  + unload: ?p - package ?t - truck ?a1 - truckarea ?l - location
      pre: (and (at ?t ?l) (equal ?a1 a2) (free a1 ?t) (in ?p ?t a2))
      eff: (and (at ?p ?l) (free a2 ?t) (not (in ?p ?t a2)))
Init:
  + (equal a1 a1)
  + (equal a2 a2)
  + (equal l1 l1)
  + (equal l2 l2)
  + (equal l3 l3)
  + (equal package1 package1)
  + (equal package2 package2)
  + (equal package3 package3)
  + (equal t0 t0)
  + (equal t1 t1)
  + (equal t2 t2)
  + (equal t3 t3)
  + (equal t4 t4)
  + (equal t5 t5)
  + (equal t6 t6)
  + (equal truck1 truck1)
Pred prop:
  - (= object object): in_pre in_pre_neg
  + (equal object object): in_init in_pre in_pre_neg
