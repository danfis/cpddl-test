Domain: tpp-propositional
Problem: tpp
Require:
  :conditional-effects
  :disjunctive-preconditions
  :equality
  :existential-preconditions
  :negative-preconditions
  :strips
  :typing
  :universal-preconditions
Type:
  depot - place
  goods - locatable
  level - object
  locatable - object
  market - place
  object
  place - object
  truck - locatable
Obj:
  depot1 - depot
  goods1 - goods
  level0 - level
  level1 - level
  market1 - market
  truck1 - truck
Predicate:
  (= object object) :eq
  (at truck place)
  (connected place place)
  (loaded goods truck level)
  (next level level)
  (on-sale goods market level)
  (ready-to-load goods market level)
  (stored goods level)
Function:
Action:
  buy: ?t - truck ?g - goods ?m - market ?l1 - level ?l2 - level ?l3 - level ?l4 - level
      pre: (and (at ?t ?m) (next ?l2 ?l1) (next ?l4 ?l3) (on-sale ?g ?m ?l2) (ready-to-load ?g ?m ?l3))
      eff: (and (not (on-sale ?g ?m ?l2)) (not (ready-to-load ?g ?m ?l3)) (on-sale ?g ?m ?l1) (ready-to-load ?g ?m ?l4))
  drive: ?t - truck ?from - place ?to - place
      pre: (and (at ?t ?from) (connected ?from ?to))
      eff: (and (at ?t ?to) (not (at ?t ?from)))
  load: ?g - goods ?t - truck ?m - market ?l1 - level ?l2 - level ?l3 - level ?l4 - level
      pre: (and (at ?t ?m) (loaded ?g ?t ?l3) (next ?l2 ?l1) (next ?l4 ?l3) (ready-to-load ?g ?m ?l2))
      eff: (and (loaded ?g ?t ?l4) (not (loaded ?g ?t ?l3)) (not (ready-to-load ?g ?m ?l2)) (ready-to-load ?g ?m ?l1))
  unload: ?g - goods ?t - truck ?d - depot ?l1 - level ?l2 - level ?l3 - level ?l4 - level
      pre: (and (at ?t ?d) (loaded ?g ?t ?l2) (next ?l2 ?l1) (next ?l4 ?l3) (stored ?g ?l3))
      eff: (and (loaded ?g ?t ?l1) (not (loaded ?g ?t ?l2)) (not (stored ?g ?l3)) (stored ?g ?l4))
Init:
  (at truck1 depot1)
  (connected depot1 market1)
  (connected market1 depot1)
  (loaded goods1 truck1 level0)
  (next level1 level0)
  (on-sale goods1 market1 level1)
  (ready-to-load goods1 market1 level0)
  (stored goods1 level0)
Goal:
  (and (stored goods1 level1))
Metric:
Pred prop:
  (at truck place): in_init in_pre in_eff
  (connected place place): in_init in_pre
  (loaded goods truck level): in_init in_pre in_eff
  (next level level): in_init in_pre
  (on-sale goods market level): in_init in_pre in_eff
  (ready-to-load goods market level): in_init in_pre in_eff
  (stored goods level): in_init in_pre in_goal in_eff
Func prop:
Global prop:
  is_unit_cost
