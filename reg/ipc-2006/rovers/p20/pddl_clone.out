    sample_rock: ?x:1 ?s:3 ?p:2
        pre: (and (RW:at ?x ?p) (RW:at_rock_sample ?p) (R:equipped_for_rock_analysis ?x) (R:store_of ?s ?x) (RW:empty ?s))
        eff: (and (N:RW:empty ?s) (RW:full ?s) (RW:have_rock_analysis ?x ?p) (N:RW:at_rock_sample ?p))
    drop: ?x:1 ?y:3
        pre: (and (R:store_of ?y ?x) (RW:full ?y))
        eff: (and (N:RW:full ?y) (RW:empty ?y))
    calibrate: ?r:1 ?i:4 ?t:7 ?w:2
        pre: (and (R:equipped_for_imaging ?r) (R:calibration_target ?i ?t) (RW:at ?r ?w) (R:visible_from ?t ?w) (R:on_board ?i ?r))
        eff: (and (RW:calibrated ?i ?r))
    take_image: ?r:1 ?p:2 ?o:7 ?i:4 ?m:5
        pre: (and (RW:calibrated ?i ?r) (R:on_board ?i ?r) (R:equipped_for_imaging ?r) (R:supports ?i ?m) (R:visible_from ?o ?p) (RW:at ?r ?p))
        eff: (and (RW:have_image ?r ?o ?m) (N:RW:calibrated ?i ?r))
    communicate_soil_data: ?r:1 ?l:6 ?p:2 ?x:2 ?y:2
        pre: (and (RW:at ?r ?x) (R:at_lander ?l ?y) (RW:have_soil_analysis ?r ?p) (R:visible ?x ?y) (RW:available ?r) (RW:channel_free ?l))
        eff: (and (RW:channel_free ?l) (W:communicated_soil_data ?p) (RW:available ?r))
    communicate_rock_data: ?r:1 ?l:6 ?p:2 ?x:2 ?y:2
        pre: (and (RW:at ?r ?x) (R:at_lander ?l ?y) (RW:have_rock_analysis ?r ?p) (R:visible ?x ?y) (RW:available ?r) (RW:channel_free ?l))
        eff: (and (RW:channel_free ?l) (W:communicated_rock_data ?p) (RW:available ?r))
    communicate_image_data: ?r:1 ?l:6 ?o:7 ?m:5 ?x:2 ?y:2
        pre: (and (RW:at ?r ?x) (R:at_lander ?l ?y) (RW:have_image ?r ?o ?m) (R:visible ?x ?y) (RW:available ?r) (RW:channel_free ?l))
        eff: (and (RW:channel_free ?l) (W:communicated_image_data ?o ?m) (RW:available ?r))
