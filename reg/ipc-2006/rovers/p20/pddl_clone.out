    sample_soil: ?x:1 ?s:3 ?p:2
        pre: (and (RW:at ?x ?p) (RW:at_soil_sample ?p) (R:equipped_for_soil_analysis ?x) (R:store_of ?s ?x) (RW:empty ?s))
