Function:
Action:
  calibrate: ?r - rover ?i - camera ?t - objective ?w - waypoint
      pre: (and (at ?r ?w) (calibration_target ?i ?t) (equipped_for_imaging ?r) (on_board ?i ?r) (visible_from ?t ?w))
      eff: (calibrated ?i ?r)
  communicate_image_data: ?r - rover ?l - lander ?o - objective ?m - mode ?x - waypoint ?y - waypoint
      pre: (and (at ?r ?x) (at_lander ?l ?y) (available ?r) (channel_free ?l) (have_image ?r ?o ?m) (visible ?x ?y))
      eff: (and (available ?r) (channel_free ?l) (communicated_image_data ?o ?m) (not (available ?r)) (not (channel_free ?l)))
  communicate_rock_data: ?r - rover ?l - lander ?p - waypoint ?x - waypoint ?y - waypoint
      pre: (and (at ?r ?x) (at_lander ?l ?y) (available ?r) (channel_free ?l) (have_rock_analysis ?r ?p) (visible ?x ?y))
      eff: (and (available ?r) (channel_free ?l) (communicated_rock_data ?p) (not (available ?r)) (not (channel_free ?l)))
  communicate_soil_data: ?r - rover ?l - lander ?p - waypoint ?x - waypoint ?y - waypoint
      pre: (and (at ?r ?x) (at_lander ?l ?y) (available ?r) (channel_free ?l) (have_soil_analysis ?r ?p) (visible ?x ?y))
      eff: (and (available ?r) (channel_free ?l) (communicated_soil_data ?p) (not (available ?r)) (not (channel_free ?l)))
  drop: ?x - rover ?y - store
      pre: (and (full ?y) (store_of ?y ?x))
      eff: (and (empty ?y) (not (full ?y)))
  navigate: ?x - rover ?y - waypoint ?z - waypoint
      pre: (and (at ?x ?y) (available ?x) (can_traverse ?x ?y ?z) (visible ?y ?z))
      eff: (and (at ?x ?z) (not (at ?x ?y)))
  sample_rock: ?x - rover ?s - store ?p - waypoint
      pre: (and (at ?x ?p) (at_rock_sample ?p) (empty ?s) (equipped_for_rock_analysis ?x) (store_of ?s ?x))
      eff: (and (full ?s) (have_rock_analysis ?x ?p) (not (at_rock_sample ?p)) (not (empty ?s)))
  sample_soil: ?x - rover ?s - store ?p - waypoint
      pre: (and (at ?x ?p) (at_soil_sample ?p) (empty ?s) (equipped_for_soil_analysis ?x) (store_of ?s ?x))
      eff: (and (full ?s) (have_soil_analysis ?x ?p) (not (at_soil_sample ?p)) (not (empty ?s)))
  take_image: ?r - rover ?p - waypoint ?o - objective ?i - camera ?m - mode
      pre: (and (at ?r ?p) (calibrated ?i ?r) (equipped_for_imaging ?r) (on_board ?i ?r) (supports ?i ?m) (visible_from ?o ?p))
      eff: (and (have_image ?r ?o ?m) (not (calibrated ?i ?r)))
