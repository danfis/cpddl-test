    sample_soil: ?x:1 ?s:3 ?p:2
        pre: (and (R:equipped_for_soil_analysis ?x) (R:store_of ?s ?x) (RW:at ?x ?p) (RW:empty ?s) (RW:at_soil_sample ?p))
