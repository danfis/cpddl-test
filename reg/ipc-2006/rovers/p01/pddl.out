    sample_rock: ?x:1 ?s:3 ?p:2
        pre: (and (R:equipped_for_rock_analysis ?x) (R:store_of ?s ?x) (RW:at ?x ?p) (RW:empty ?s) (RW:at_rock_sample ?p))
        eff: (and (N:RW:empty ?s) (RW:have_rock_analysis ?x ?p) (RW:full ?s) (N:RW:at_rock_sample ?p))
    drop: ?x:1 ?y:3
        pre: (and (R:store_of ?y ?x) (RW:full ?y))
        eff: (and (RW:empty ?y) (N:RW:full ?y))
    calibrate: ?r:1 ?i:4 ?t:7 ?w:2
        pre: (and (R:equipped_for_imaging ?r) (R:visible_from ?t ?w) (R:calibration_target ?i ?t) (R:on_board ?i ?r) (RW:at ?r ?w))
        eff: (and (RW:calibrated ?i ?r))
    take_image: ?r:1 ?p:2 ?o:7 ?i:4 ?m:5
        pre: (and (R:equipped_for_imaging ?r) (R:supports ?i ?m) (R:visible_from ?o ?p) (R:on_board ?i ?r) (RW:at ?r ?p) (RW:calibrated ?i ?r))
        eff: (and (N:RW:calibrated ?i ?r) (RW:have_image ?r ?o ?m))
    communicate_soil_data: ?r:1 ?l:6 ?p:2 ?x:2 ?y:2
        pre: (and (R:at_lander ?l ?y) (R:visible ?x ?y) (RW:at ?r ?x) (RW:have_soil_analysis ?r ?p) (RW:available ?r) (RW:channel_free ?l))
        eff: (and (RW:available ?r) (W:communicated_soil_data ?p) (RW:channel_free ?l))
    communicate_rock_data: ?r:1 ?l:6 ?p:2 ?x:2 ?y:2
        pre: (and (R:at_lander ?l ?y) (R:visible ?x ?y) (RW:at ?r ?x) (RW:have_rock_analysis ?r ?p) (RW:available ?r) (RW:channel_free ?l))
        eff: (and (RW:available ?r) (W:communicated_rock_data ?p) (RW:channel_free ?l))
    communicate_image_data: ?r:1 ?l:6 ?o:7 ?m:5 ?x:2 ?y:2
        pre: (and (R:at_lander ?l ?y) (R:visible ?x ?y) (RW:at ?r ?x) (RW:available ?r) (RW:have_image ?r ?o ?m) (RW:channel_free ?l))
        eff: (and (RW:available ?r) (W:communicated_image_data ?o ?m) (RW:channel_free ?l))
