Predicate:
  (= object object) :eq
  (NOT-chosen simple) neg-of (chosen)
  (association-reaction molecule molecule complex)
  (available molecule)
  (catalyzed-association-reaction molecule molecule complex)
  (chosen simple) neg-of (NOT-chosen)
  (goal1)
  (next level level)
  (num-subs level)
  (possible molecule)
Function:
Action:
  associate-with-catalyze: ?x1 - molecule ?x2 - molecule ?x3 - complex
      pre: (and (available ?x1) (available ?x2) (catalyzed-association-reaction ?x1 ?x2 ?x3))
      eff: (and (available ?x3) (not (available ?x1)))
  associate: ?x1 - molecule ?x2 - molecule ?x3 - complex
      pre: (and (association-reaction ?x1 ?x2 ?x3) (available ?x1) (available ?x2))
      eff: (and (available ?x3) (not (available ?x1)) (not (available ?x2)))
  choose: ?x - simple ?l1 - level ?l2 - level
      pre: (and (NOT-chosen ?x) (next ?l1 ?l2) (num-subs ?l2) (possible ?x))
      eff: (and (chosen ?x) (not (NOT-chosen ?x)) (not (num-subs ?l2)) (num-subs ?l1))
  dummy-action-1:
      pre: (and (available pcaf-p300))
      eff: (and (goal1))
  dummy-action-1:
      pre: (and (available prbp1p2-ap2))
      eff: (and (goal1))
  initialize: ?x - simple
      pre: (and (chosen ?x))
      eff: (and (available ?x))
