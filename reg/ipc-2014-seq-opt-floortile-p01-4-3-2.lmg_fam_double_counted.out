< {robot-at V0:robot C1:tile, robot-at V0:robot C2:tile}:=1
, {robot-has V0:robot C1:color, robot-has V0:robot C2:color}:=1
, {robot-at C1:robot V0:tile, clear V0:tile, robot-at C2:robot V0:tile}
, {robot-at C1:robot V0:tile, clear V0:tile, painted V0:tile C2:color, robot-at C3:robot V0:tile, painted V0:tile C4:color}:=1
, {robot-at C2:robot V0:tile, clear V0:tile, painted V0:tile V1:color, robot-at C3:robot V0:tile}
>
