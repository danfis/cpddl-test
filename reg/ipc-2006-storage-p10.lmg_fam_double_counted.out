< {in V0:storearea container0}:=1:S
, {in V0:storearea C1:place, in V0:storearea C2:place}:=1:S
, {at hoist0 C0:area, at hoist0 C1:area}:=1
, {available hoist0, lifting hoist0 C0:crate, lifting hoist0 C1:crate}:=1
, {lifting hoist0 V0:crate, on V0:crate C1:storearea, on V0:crate C2:storearea}:=1
, {clear V0:storearea, at hoist0 V0:storearea, on C1:crate V0:storearea, on C2:crate V0:storearea}:=1
>
