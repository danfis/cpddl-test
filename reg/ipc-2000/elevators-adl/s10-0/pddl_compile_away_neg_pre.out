Require:
  - :negative-preconditions
Predicate:
  + (NOT-served passenger) neg-of (served)
  - (served passenger)
  + (served passenger) neg-of (NOT-served)
Action:
  - stop: ?f - floor
      pre: (and (lift-at ?f))
      eff: (and (when (and (boarded p0) (destin p0 ?f)) (and (not (boarded p0)) (served p0))) (when (and (boarded p1) (destin p1 ?f)) (and (not (boarded p1)) (served p1))) (when (and (boarded p2) (destin p2 ?f)) (and (not (boarded p2)) (served p2))) (when (and (boarded p3) (destin p3 ?f)) (and (not (boarded p3)) (served p3))) (when (and (boarded p4) (destin p4 ?f)) (and (not (boarded p4)) (served p4))) (when (and (boarded p5) (destin p5 ?f)) (and (not (boarded p5)) (served p5))) (when (and (boarded p6) (destin p6 ?f)) (and (not (boarded p6)) (served p6))) (when (and (boarded p7) (destin p7 ?f)) (and (not (boarded p7)) (served p7))) (when (and (boarded p8) (destin p8 ?f)) (and (not (boarded p8)) (served p8))) (when (and (boarded p9) (destin p9 ?f)) (and (not (boarded p9)) (served p9))) (when (and (not (served p0)) (origin p0 ?f)) (boarded p0)) (when (and (not (served p1)) (origin p1 ?f)) (boarded p1)) (when (and (not (served p2)) (origin p2 ?f)) (boarded p2)) (when (and (not (served p3)) (origin p3 ?f)) (boarded p3)) (when (and (not (served p4)) (origin p4 ?f)) (boarded p4)) (when (and (not (served p5)) (origin p5 ?f)) (boarded p5)) (when (and (not (served p6)) (origin p6 ?f)) (boarded p6)) (when (and (not (served p7)) (origin p7 ?f)) (boarded p7)) (when (and (not (served p8)) (origin p8 ?f)) (boarded p8)) (when (and (not (served p9)) (origin p9 ?f)) (boarded p9)))
  + stop: ?f - floor
      pre: (and (lift-at ?f))
      eff: (and (when (and (NOT-served p0) (origin p0 ?f)) (boarded p0)) (when (and (NOT-served p1) (origin p1 ?f)) (boarded p1)) (when (and (NOT-served p2) (origin p2 ?f)) (boarded p2)) (when (and (NOT-served p3) (origin p3 ?f)) (boarded p3)) (when (and (NOT-served p4) (origin p4 ?f)) (boarded p4)) (when (and (NOT-served p5) (origin p5 ?f)) (boarded p5)) (when (and (NOT-served p6) (origin p6 ?f)) (boarded p6)) (when (and (NOT-served p7) (origin p7 ?f)) (boarded p7)) (when (and (NOT-served p8) (origin p8 ?f)) (boarded p8)) (when (and (NOT-served p9) (origin p9 ?f)) (boarded p9)) (when (and (boarded p0) (destin p0 ?f)) (and (not (NOT-served p0)) (not (boarded p0)) (served p0))) (when (and (boarded p1) (destin p1 ?f)) (and (not (NOT-served p1)) (not (boarded p1)) (served p1))) (when (and (boarded p2) (destin p2 ?f)) (and (not (NOT-served p2)) (not (boarded p2)) (served p2))) (when (and (boarded p3) (destin p3 ?f)) (and (not (NOT-served p3)) (not (boarded p3)) (served p3))) (when (and (boarded p4) (destin p4 ?f)) (and (not (NOT-served p4)) (not (boarded p4)) (served p4))) (when (and (boarded p5) (destin p5 ?f)) (and (not (NOT-served p5)) (not (boarded p5)) (served p5))) (when (and (boarded p6) (destin p6 ?f)) (and (not (NOT-served p6)) (not (boarded p6)) (served p6))) (when (and (boarded p7) (destin p7 ?f)) (and (not (NOT-served p7)) (not (boarded p7)) (served p7))) (when (and (boarded p8) (destin p8 ?f)) (and (not (NOT-served p8)) (not (boarded p8)) (served p8))) (when (and (boarded p9) (destin p9 ?f)) (and (not (NOT-served p9)) (not (boarded p9)) (served p9))))
Init:
  + (NOT-served p0)
  + (NOT-served p1)
  + (NOT-served p2)
  + (NOT-served p3)
  + (NOT-served p4)
  + (NOT-served p5)
  + (NOT-served p6)
  + (NOT-served p7)
  + (NOT-served p8)
  + (NOT-served p9)
Pred prop:
  + (NOT-served passenger): in_init in_pre in_eff
  - (served passenger): in_pre in_pre_neg in_goal in_eff
  + (served passenger): in_goal in_eff
