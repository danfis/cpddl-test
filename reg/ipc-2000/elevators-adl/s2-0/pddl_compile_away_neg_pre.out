Require:
  - :negative-preconditions
Predicate:
  + (NOT-served passenger) neg-of (served)
  - (served passenger)
  + (served passenger) neg-of (NOT-served)
Action:
  - stop: ?f - floor
      pre: (and (lift-at ?f))
      eff: (and (when (and (boarded p0) (destin p0 ?f)) (and (not (boarded p0)) (served p0))) (when (and (boarded p1) (destin p1 ?f)) (and (not (boarded p1)) (served p1))) (when (and (not (served p0)) (origin p0 ?f)) (boarded p0)) (when (and (not (served p1)) (origin p1 ?f)) (boarded p1)))
  + stop: ?f - floor
      pre: (and (lift-at ?f))
      eff: (and (when (and (NOT-served p0) (origin p0 ?f)) (boarded p0)) (when (and (NOT-served p1) (origin p1 ?f)) (boarded p1)) (when (and (boarded p0) (destin p0 ?f)) (and (not (NOT-served p0)) (not (boarded p0)) (served p0))) (when (and (boarded p1) (destin p1 ?f)) (and (not (NOT-served p1)) (not (boarded p1)) (served p1))))
Init:
  + (NOT-served p0)
  + (NOT-served p1)
Pred prop:
  + (NOT-served passenger): in_init in_pre in_eff
  - (served passenger): in_pre in_goal in_eff
  + (served passenger): in_goal in_eff
