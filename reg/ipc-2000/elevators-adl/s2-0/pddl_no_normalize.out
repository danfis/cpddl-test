    stop: ?f:2
        pre: (RW:lift-at ?f)
        eff: (and (forall (?p:1 I[0]:?f:2) (when (and (RW:boarded ?p) (R:destin ?p ?f)) (and (N:RW:boarded ?p) (RW:served ?p)))) (forall (?p:1 I[0]:?f:2) (when (and (R:origin ?p ?f) (N:RW:served ?p)) (RW:boarded ?p))))
    up: ?f1:2 ?f2:2
        pre: (and (R:above ?f1 ?f2) (RW:lift-at ?f1))
        eff: (and (N:RW:lift-at ?f1) (RW:lift-at ?f2))
    down: ?f1:2 ?f2:2
