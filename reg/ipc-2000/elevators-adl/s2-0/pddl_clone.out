Predicate[8]:
    =: 0 0 :: read: 0, write: 0, in-init: 0
    origin: 1 2 :: read: 1, write: 0, in-init: 1
    destin: 1 2 :: read: 1, write: 0, in-init: 1
    above: 2 2 :: read: 1, write: 0, in-init: 1
    boarded: 1 :: read: 1, write: 1, in-init: 0
    served: 1 :: read: 1, write: 1, in-init: 0, neg-of: NOT-served
