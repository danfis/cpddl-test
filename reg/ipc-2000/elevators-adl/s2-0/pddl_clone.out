Function[0]:
Action[3]:
    stop: ?f:2
        pre: (and (RW:lift-at ?f))
        eff: (and (when (and (RW:boarded p0) (R:destin p0 ?f)) (and (N:RW:boarded p0) (RW:served p0) (N:RW:NOT-served p0))) (when (and (RW:boarded p1) (R:destin p1 ?f)) (and (N:RW:boarded p1) (RW:served p1) (N:RW:NOT-served p1))) (when (and (R:origin p0 ?f) (RW:NOT-served p0)) (RW:boarded p0)) (when (and (R:origin p1 ?f) (RW:NOT-served p1)) (RW:boarded p1)))
    up: ?f1:2 ?f2:2
        pre: (and (R:above ?f1 ?f2) (RW:lift-at ?f1))
        eff: (and (N:RW:lift-at ?f1) (RW:lift-at ?f2))
    down: ?f1:2 ?f2:2
        pre: (and (R:above ?f2 ?f1) (RW:lift-at ?f1))
        eff: (and (N:RW:lift-at ?f1) (RW:lift-at ?f2))
