Action[21]:
    begin-cut: ?x:0 ?y:0
        pre: (and (RW:idle) (RW:cw ?x ?y))
        eff: (and (N:RW:idle) (RW:cutting) (RW:cut-point-1 ?x) (RW:last-cut-point ?x) (RW:s-first ?y) (RW:s-last ?y))
    continue-cut: ?x:0 ?y:0
        pre: (and (RW:cutting) (RW:s-last ?x) (RW:cw ?x ?y))
        eff: (and (RW:s-next ?x ?y) (RW:s-last ?y))
    end-cut-1: ?x:0 ?y:0
        pre: (and (RW:cutting) (RW:s-last ?x) (RW:cw ?x ?y))
        eff: (and (RW:cut-point-2 ?y))
    end-cut-2: ?x:0 ?y:0
        pre: (and (RW:cutting) (RW:cut-point-1 ?x) (RW:cut-point-2 ?y))
        eff: (and (N:RW:cutting) (RW:have-cut) (RW:cw ?x ?y))
    begin-transpose-splice: ?x:0 ?y:0
        pre: (and (RW:have-cut) (RW:cw ?x ?y))
        eff: (and (N:RW:have-cut) (RW:splicing) (RW:splice-point-1 ?x) (RW:splice-point-2 ?y) (increase (total-cost) 2))
    continue-splice-1: ?x:0 ?y:0
        pre: (and (RW:splicing) (RW:s-first ?x) (RW:s-next ?x ?y))
        eff: (and (N:RW:splicing) (RW:s-first ?y) (RW:splice-next ?x))
    continue-splice-2: ?x:0 ?y:0
        pre: (and (RW:splice-next ?x) (RW:splice-point-1 ?y))
        eff: (and (RW:cw ?y ?x) (RW:splice-point-1 ?x) (RW:splicing))
    end-splice-1: ?x:0 ?y:0
        pre: (and (RW:splicing) (RW:splice-point-1 ?y) (RW:s-first ?x) (RW:s-last ?x))
        eff: (and (N:RW:splicing) (RW:splicing-last) (RW:cw ?y ?x) (RW:splice-point-1 ?x))
    end-splice-2: ?x:0 ?y:0
        pre: (and (RW:splicing-last) (RW:splice-point-1 ?x) (RW:splice-point-2 ?y))
        eff: (and (N:RW:splicing-last) (RW:finished) (RW:cw ?x ?y))
    begin-transverse-splice: ?x:0 ?y:0
        pre: (and (RW:have-cut) (RW:cw ?x ?y))
        eff: (and (N:RW:have-cut) (RW:inverse-splicing) (RW:splice-point-1 ?x) (RW:splice-point-2 ?y) (increase (total-cost) 2))
    begin-inverse-splice: ?x:0 ?y:0
        pre: (and (RW:have-cut) (RW:cw ?x ?y) (RW:last-cut-point ?x))
        eff: (and (N:RW:have-cut) (RW:inverse-splicing) (RW:splice-point-1 ?x) (RW:splice-point-2 ?y) (increase (total-cost) 1))
    begin-inverse-splice-special-case: ?x:0
        pre: (and (RW:have-cut) (RW:cw ?x ?x) (RW:last-cut-point ?x))
        eff: (and (N:RW:have-cut) (RW:inverse-splicing) (RW:splice-point-1 ?x) (RW:splice-point-2 ?x) (increase (total-cost) 1))
    continue-inverse-splice-1a: ?x:0 ?y:0
        pre: (and (RW:inverse-splicing) (RW:normal ?x) (RW:s-last ?x) (RW:s-next ?y ?x))
        eff: (and (RW:s-last ?y) (N:RW:inverse-splicing) (RW:inverse-splice-next ?x) (RW:inverted ?x))
    continue-inverse-splice-1b: ?x:0 ?y:0
        pre: (and (RW:inverse-splicing) (RW:inverted ?x) (RW:s-last ?x) (RW:s-next ?y ?x))
        eff: (and (RW:s-last ?y) (N:RW:inverse-splicing) (RW:inverse-splice-next ?x) (RW:normal ?x))
    continue-inverse-splice-2: ?x:0 ?y:0
        pre: (and (RW:inverse-splice-next ?x) (RW:splice-point-1 ?y))
        eff: (and (RW:inverse-splicing) (RW:cw ?y ?x) (RW:splice-point-1 ?x))
    end-inverse-splice-1a: ?x:0 ?y:0
        pre: (and (RW:inverse-splicing) (RW:normal ?x) (RW:splice-point-1 ?y) (RW:s-first ?x) (RW:s-last ?x))
        eff: (and (N:RW:inverse-splicing) (RW:inverse-splicing-last) (RW:cw ?y ?x) (RW:splice-point-1 ?x) (RW:inverted ?x))
    end-inverse-splice-1b: ?x:0 ?y:0
        pre: (and (RW:inverse-splicing) (RW:inverted ?x) (RW:splice-point-1 ?y) (RW:s-first ?x) (RW:s-last ?x))
        eff: (and (N:RW:inverse-splicing) (RW:inverse-splicing-last) (RW:cw ?y ?x) (RW:splice-point-1 ?x) (RW:normal ?x))
    end-inverse-splice-2: ?x:0 ?y:0
        pre: (and (RW:inverse-splicing-last) (RW:splice-point-1 ?x) (RW:splice-point-2 ?y))
        eff: (and (N:RW:inverse-splicing-last) (RW:finished) (RW:cw ?x ?y))
    invert-single-gene-a: ?x:0
        pre: (and (RW:idle) (RW:normal ?x))
        eff: (and (RW:inverted ?x) (increase (total-cost) 1))
    invert-single-gene-b: ?x:0
        pre: (and (RW:idle) (RW:inverted ?x))
        eff: (and (RW:normal ?x) (increase (total-cost) 1))
    reset-1: ?x:0
