Function:
Action:
  calibrate: ?s - object ?i - object ?d - object
      pre: (and (calibration_target ?i ?d) (direction ?d) (instrument ?i) (on_board ?i ?s) (pointing ?s ?d) (power_on ?i) (satellite ?s))
      eff: (calibrated ?i)
  switch_off: ?i - object ?s - object
      pre: (and (instrument ?i) (on_board ?i ?s) (power_on ?i) (satellite ?s))
      eff: (and (not (power_on ?i)) (power_avail ?s))
  switch_on: ?i - object ?s - object
      pre: (and (instrument ?i) (on_board ?i ?s) (power_avail ?s) (satellite ?s))
      eff: (and (not (calibrated ?i)) (not (power_avail ?s)) (power_on ?i))
  take_image: ?s - object ?d - object ?i - object ?m - object
      pre: (and (calibrated ?i) (direction ?d) (instrument ?i) (mode ?m) (on_board ?i ?s) (pointing ?s ?d) (power_on ?i) (power_on ?i) (satellite ?s) (supports ?i ?m))
      eff: (have_image ?d ?m)
  turn_to: ?s - object ?d_new - object ?d_prev - object
      pre: (and (direction ?d_new) (direction ?d_prev) (pointing ?s ?d_prev) (satellite ?s))
      eff: (and (not (pointing ?s ?d_prev)) (pointing ?s ?d_new))
