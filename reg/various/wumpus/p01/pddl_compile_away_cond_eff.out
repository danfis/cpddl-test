Require:
  + :equality
  + :negative-preconditions
Predicate:
  + (NOT-alive object) neg-of (alive)
  + (NOT-at object object) neg-of (at)
  - (alive object)
  + (alive object) neg-of (NOT-alive)
  - (at object object)
  + (at object object) neg-of (NOT-at)
Action:
  - move: ?who - agent ?from - square ?to - square
      pre: (and (adj ?from ?to) (alive ?who) (at ?who ?from))
      eff: (and (at ?who ?to) (not (at ?who ?from)) (when (and (alive wumpus-1) (at wumpus-1 ?to)) (not (alive ?who))) (when (pit ?to) (not (alive ?who))))
  + move: ?who - agent ?from - square ?to - square
      pre: (and (NOT-alive wumpus-1) (adj ?from ?to) (alive ?who) (at ?who ?from))
      eff: (and (at ?who ?to) (not (NOT-at ?who ?to)) (not (at ?who ?from)) (when (not (= ?from ?to)) (NOT-at ?who ?from)) (when (pit ?to) (and (NOT-alive ?who) (not (alive ?who)))))
  + move: ?who - agent ?from - square ?to - square
      pre: (and (NOT-at wumpus-1 ?to) (adj ?from ?to) (alive ?who) (at ?who ?from))
      eff: (and (at ?who ?to) (not (NOT-at ?who ?to)) (not (at ?who ?from)) (when (not (= ?from ?to)) (NOT-at ?who ?from)) (when (pit ?to) (and (NOT-alive ?who) (not (alive ?who)))))
  + move: ?who - agent ?from - square ?to - square
      pre: (and (adj ?from ?to) (alive ?who) (alive wumpus-1) (at ?who ?from) (at wumpus-1 ?to))
      eff: (and (NOT-alive ?who) (at ?who ?to) (not (NOT-at ?who ?to)) (not (alive ?who)) (not (at ?who ?from)) (when (not (= ?from ?to)) (NOT-at ?who ?from)) (when (pit ?to) (and (NOT-alive ?who) (not (alive ?who)))))
  - shoot: ?who - agent ?where - square ?with-arrow - arrow ?victim - wumpus ?where-victim - square
      pre: (and (adj ?where ?where-victim) (alive ?victim) (alive ?who) (at ?victim ?where-victim) (at ?who ?where) (have ?who ?with-arrow))
      eff: (and (not (alive ?victim)) (not (at ?victim ?where-victim)) (not (have ?who ?with-arrow)))
  + shoot: ?who - agent ?where - square ?with-arrow - arrow ?victim - wumpus ?where-victim - square
      pre: (and (adj ?where ?where-victim) (alive ?victim) (alive ?who) (at ?victim ?where-victim) (at ?who ?where) (have ?who ?with-arrow))
      eff: (and (NOT-alive ?victim) (NOT-at ?victim ?where-victim) (not (alive ?victim)) (not (at ?victim ?where-victim)) (not (have ?who ?with-arrow)))
  - take: ?who - agent ?where - square ?what - object
      pre: (and (alive ?who) (at ?what ?where) (at ?who ?where))
      eff: (and (have ?who ?what) (not (at ?what ?where)))
  + take: ?who - agent ?where - square ?what - object
      pre: (and (alive ?who) (at ?what ?where) (at ?who ?where))
      eff: (and (NOT-at ?what ?where) (have ?who ?what) (not (at ?what ?where)))
Init:
  + (NOT-at agent-1 s-1-2)
  + (NOT-at agent-1 s-1-3)
  + (NOT-at agent-1 s-2-1)
  + (NOT-at agent-1 s-2-2)
  + (NOT-at agent-1 s-2-3)
  + (NOT-at arrow-1 s-1-1)
  + (NOT-at arrow-1 s-1-2)
  + (NOT-at arrow-1 s-1-3)
  + (NOT-at arrow-1 s-2-1)
  + (NOT-at arrow-1 s-2-2)
  + (NOT-at arrow-1 s-2-3)
  + (NOT-at gold-1 s-1-1)
  + (NOT-at gold-1 s-1-2)
  + (NOT-at gold-1 s-2-1)
  + (NOT-at gold-1 s-2-2)
  + (NOT-at gold-1 s-2-3)
  + (NOT-at s-1-1 s-1-1)
  + (NOT-at s-1-1 s-1-2)
  + (NOT-at s-1-1 s-1-3)
  + (NOT-at s-1-1 s-2-1)
  + (NOT-at s-1-1 s-2-2)
  + (NOT-at s-1-1 s-2-3)
  + (NOT-at s-1-2 s-1-1)
  + (NOT-at s-1-2 s-1-2)
  + (NOT-at s-1-2 s-1-3)
  + (NOT-at s-1-2 s-2-1)
  + (NOT-at s-1-2 s-2-2)
  + (NOT-at s-1-2 s-2-3)
  + (NOT-at s-1-3 s-1-1)
  + (NOT-at s-1-3 s-1-2)
  + (NOT-at s-1-3 s-1-3)
  + (NOT-at s-1-3 s-2-1)
  + (NOT-at s-1-3 s-2-2)
  + (NOT-at s-1-3 s-2-3)
  + (NOT-at s-2-1 s-1-1)
  + (NOT-at s-2-1 s-1-2)
  + (NOT-at s-2-1 s-1-3)
  + (NOT-at s-2-1 s-2-1)
  + (NOT-at s-2-1 s-2-2)
  + (NOT-at s-2-1 s-2-3)
  + (NOT-at s-2-2 s-1-1)
  + (NOT-at s-2-2 s-1-2)
  + (NOT-at s-2-2 s-1-3)
  + (NOT-at s-2-2 s-2-1)
  + (NOT-at s-2-2 s-2-2)
  + (NOT-at s-2-2 s-2-3)
  + (NOT-at s-2-3 s-1-1)
  + (NOT-at s-2-3 s-1-2)
  + (NOT-at s-2-3 s-1-3)
  + (NOT-at s-2-3 s-2-1)
  + (NOT-at s-2-3 s-2-2)
  + (NOT-at s-2-3 s-2-3)
  + (NOT-at wumpus-1 s-1-1)
  + (NOT-at wumpus-1 s-1-2)
  + (NOT-at wumpus-1 s-1-3)
  + (NOT-at wumpus-1 s-2-1)
  + (NOT-at wumpus-1 s-2-2)
Pred prop:
  + (= object object): in_pre in_pre_neg
  + (NOT-alive object): in_pre in_eff
  + (NOT-at object object): in_init in_pre in_eff
