Require:
  - :equality
Predicate:
  + (equal object object)
Action:
  - take: ?who - agent ?where - square ?what - object
      pre: (and (= ?who agent-1) (alive agent-1) (at ?what ?where) (at agent-1 ?where) (not (= ?what agent-1)) (not (= ?what arrow-1)) (not (= ?what s-1-1)) (not (= ?what s-1-2)) (not (= ?what s-1-3)) (not (= ?what s-2-1)) (not (= ?what s-2-2)) (not (= ?what s-2-3)))
      eff: (and (have agent-1 ?what) (not (at ?what ?where)))
  - take: ?who - agent ?where - square ?what - object
      pre: (and (alive ?who) (at ?what ?where) (at ?who ?where) (not (= ?what agent-1)) (not (= ?what arrow-1)) (not (= ?what gold-1)) (not (= ?what s-1-1)) (not (= ?what s-1-2)) (not (= ?what s-1-3)) (not (= ?what s-2-1)) (not (= ?what s-2-2)) (not (= ?what s-2-3)))
      eff: (and (have ?who ?what) (not (at ?what ?where)))
  + take: ?who - agent ?where - square ?what - object
      pre: (and (alive ?who) (at ?what ?where) (at ?who ?where) (not (equal ?what agent-1)) (not (equal ?what arrow-1)) (not (equal ?what gold-1)) (not (equal ?what s-1-1)) (not (equal ?what s-1-2)) (not (equal ?what s-1-3)) (not (equal ?what s-2-1)) (not (equal ?what s-2-2)) (not (equal ?what s-2-3)))
      eff: (and (have ?who ?what) (not (at ?what ?where)))
  + take: ?who - agent ?where - square ?what - object
      pre: (and (alive agent-1) (at ?what ?where) (at agent-1 ?where) (equal ?who agent-1) (not (equal ?what agent-1)) (not (equal ?what arrow-1)) (not (equal ?what s-1-1)) (not (equal ?what s-1-2)) (not (equal ?what s-1-3)) (not (equal ?what s-2-1)) (not (equal ?what s-2-2)) (not (equal ?what s-2-3)))
      eff: (and (have agent-1 ?what) (not (at ?what ?where)))
Init:
  + (equal agent-1 agent-1)
  + (equal arrow-1 arrow-1)
  + (equal gold-1 gold-1)
  + (equal s-1-1 s-1-1)
  + (equal s-1-2 s-1-2)
  + (equal s-1-3 s-1-3)
  + (equal s-2-1 s-2-1)
  + (equal s-2-2 s-2-2)
  + (equal s-2-3 s-2-3)
  + (equal wumpus-1 wumpus-1)
Pred prop:
  - (= object object): in_pre in_pre_neg
  + (equal object object): in_init in_pre in_pre_neg
