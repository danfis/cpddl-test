Domain: wumpus-adl
Problem: wumpus-adl-1
Require:
  :conditional-effects
  :disjunctive-preconditions
  :equality
  :existential-preconditions
  :negative-preconditions
  :strips
  :typing
  :universal-preconditions
Type:
  agent - object
  arrow - object
  gold - object
  object
  square - object
  wumpus - object
Obj:
  agent-1 - agent
  arrow-1 - arrow
  gold-1 - gold
  s-1-1 - square
  s-1-2 - square
  s-1-3 - square
  s-2-1 - square
  s-2-2 - square
  s-2-3 - square
  wumpus-1 - wumpus
Predicate:
  (= object object) :eq
  (adj object object)
  (alive object)
  (at object object)
  (have object object)
  (pit object)
Function:
Action:
  move: ?who - agent ?from - square ?to - square
      pre: (and (adj ?from ?to) (alive ?who) (at ?who ?from))
      eff: (and (at ?who ?to) (not (at ?who ?from)) (when (exists (?w - wumpus) (and (alive ?w) (at ?w ?to))) (and (not (alive ?who)))) (when (pit ?to) (and (not (alive ?who)))))
  shoot: ?who - agent ?where - square ?with-arrow - arrow ?victim - wumpus ?where-victim - square
      pre: (and (adj ?where ?where-victim) (alive ?victim) (alive ?who) (at ?victim ?where-victim) (at ?who ?where) (have ?who ?with-arrow))
      eff: (and (not (alive ?victim)) (not (at ?victim ?where-victim)) (not (have ?who ?with-arrow)))
  take: ?who - agent ?where - square ?what - object
      pre: (and (alive ?who) (at ?what ?where) (at ?who ?where))
      eff: (and (have ?who ?what) (not (at ?what ?where)))
Init:
  (adj s-1-1 s-1-2)
  (adj s-1-1 s-2-1)
  (adj s-1-2 s-1-1)
  (adj s-1-2 s-1-3)
  (adj s-1-2 s-2-2)
  (adj s-1-3 s-1-2)
  (adj s-1-3 s-2-3)
  (adj s-2-1 s-1-1)
  (adj s-2-1 s-2-2)
  (adj s-2-2 s-1-2)
  (adj s-2-2 s-2-1)
  (adj s-2-2 s-2-3)
  (adj s-2-3 s-1-3)
  (adj s-2-3 s-2-2)
  (alive agent-1)
  (alive wumpus-1)
  (at agent-1 s-1-1)
  (at gold-1 s-1-3)
  (at wumpus-1 s-2-3)
  (have agent-1 arrow-1)
  (pit s-1-2)
Goal:
  (and (alive agent-1) (at agent-1 s-1-1) (have agent-1 gold-1))
Metric:
Pred prop:
  (adj object object): in_init in_pre
  (alive object): in_init in_pre in_goal in_eff
  (at object object): in_init in_pre in_goal in_eff
  (have object object): in_init in_pre in_goal in_eff
  (pit object): in_init in_pre
Func prop:
Global prop:
  has_cond_eff
  is_unit_cost
