Domain: neg-cond-unify
Problem: neg-cond-unify-p01
Require:
  :conditional-effects
  :disjunctive-preconditions
  :equality
  :existential-preconditions
  :negative-preconditions
  :strips
  :typing
  :universal-preconditions
Type:
  obj - object
  object
Obj:
  o1 - obj
  o2 - obj
Predicate:
  (= object object) :eq
  (p obj)
  (q obj)
  (r obj)
Function:
Action:
  check: ?x - obj
      pre: (not (p ?x))
      eff: (r ?x)
  cond-add-diff: ?x - obj ?y - obj
      pre: (p ?x)
      eff: (and (not (p ?x)) (when (and (not (= ?x ?y)) (q ?y)) (p ?y)))
  cond-add: ?x - obj ?y - obj
      pre: (p ?x)
      eff: (and (not (p ?x)) (when (q ?y) (p ?y)))
  move-diff: ?x - obj ?y - obj
      pre: (and (not (= ?x ?y)) (p ?x))
      eff: (and (not (p ?x)) (p ?y))
  move: ?x - obj ?y - obj
      pre: (p ?x)
      eff: (and (not (p ?x)) (p ?y))
  refresh: ?x - obj
      pre: (p ?x)
      eff: (and (p ?x) (when (q ?x) (not (p ?x))))
  set-q: ?x - obj
      pre: (r ?x)
      eff: (q ?x)
Init:
  (p o1)
  (p o2)
Goal:
  (and (p o1) (p o2) (r o1))
Metric:
Pred prop:
  (= object object): in_pre in_pre_neg
  (p obj): in_init in_pre in_pre_neg in_goal in_eff
  (q obj): in_pre in_eff
  (r obj): in_pre in_goal in_eff
Func prop:
Global prop:
  has_cond_eff
  has_eq_pred
  has_non_static_neg_cond
  is_unit_cost
