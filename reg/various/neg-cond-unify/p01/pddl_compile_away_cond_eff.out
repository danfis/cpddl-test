Action:
  - cond-add-diff: ?x - obj ?y - obj
      pre: (and (p ?x))
      eff: (and (NOT-p ?x) (not (p ?x)) (when (and (not (= ?x ?y)) (q ?y)) (and (not (NOT-p ?y)) (p ?y))))
  + cond-add-diff: ?x - obj ?y - obj
      pre: (and (NOT-q ?y) (p ?x))
      eff: (and (NOT-p ?x) (not (p ?x)))
  + cond-add-diff: ?x - obj ?y - obj
      pre: (and (p ?x) (q ?y))
      eff: (and (NOT-p ?x) (not (p ?x)) (when (not (= ?x ?y)) (and (not (NOT-p ?y)) (p ?y))))
  - cond-add: ?x - obj ?y - obj
      pre: (and (p ?x))
      eff: (and (not (p ?x)) (when (NOT-q ?y) (NOT-p ?x)) (when (not (= ?x ?y)) (NOT-p ?x)) (when (q ?y) (and (not (NOT-p ?y)) (p ?y))))
  + cond-add: ?x - obj ?y - obj
      pre: (and (NOT-q ?y) (p ?x))
      eff: (and (NOT-p ?x) (not (p ?x)) (when (not (= ?x ?y)) (NOT-p ?x)))
  + cond-add: ?x - obj ?y - obj
      pre: (and (p ?x) (q ?y))
      eff: (and (not (NOT-p ?y)) (not (p ?x)) (p ?y) (when (not (= ?x ?y)) (NOT-p ?x)))
  - refresh: ?x - obj
      pre: (and (p ?x))
      eff: (and (not (NOT-p ?x)) (p ?x) (when (q ?x) (not (p ?x))))
  + refresh: ?x - obj
      pre: (and (NOT-q ?x) (p ?x))
      eff: (and (not (NOT-p ?x)) (p ?x))
  + refresh: ?x - obj
      pre: (and (p ?x) (q ?x))
      eff: (and (not (NOT-p ?x)) (p ?x))
