Predicate:
  + (equal object object)
Action:
  - cond-add-diff: ?x - obj ?y - obj
      pre: (and (p ?x))
      eff: (and (NOT-p ?x) (not (p ?x)) (when (and (not (= ?x ?y)) (q ?y)) (and (not (NOT-p ?y)) (p ?y))))
  + cond-add-diff: ?x - obj ?y - obj
      pre: (and (p ?x))
      eff: (and (NOT-p ?x) (not (p ?x)) (when (and (not (equal ?x ?y)) (q ?y)) (and (not (NOT-p ?y)) (p ?y))))
  - cond-add: ?x - obj ?y - obj
      pre: (and (p ?x))
      eff: (and (not (p ?x)) (when (NOT-q ?y) (NOT-p ?x)) (when (not (= ?x ?y)) (NOT-p ?x)) (when (q ?y) (and (not (NOT-p ?y)) (p ?y))))
  + cond-add: ?x - obj ?y - obj
      pre: (and (p ?x))
      eff: (and (not (p ?x)) (when (NOT-q ?y) (NOT-p ?x)) (when (not (equal ?x ?y)) (NOT-p ?x)) (when (q ?y) (and (not (NOT-p ?y)) (p ?y))))
  - move-diff: ?x - obj ?y - obj
      pre: (and (not (= ?x ?y)) (p ?x))
      eff: (and (NOT-p ?x) (not (NOT-p ?y)) (not (p ?x)) (p ?y))
  + move-diff: ?x - obj ?y - obj
      pre: (and (not (equal ?x ?y)) (p ?x))
      eff: (and (NOT-p ?x) (not (NOT-p ?y)) (not (p ?x)) (p ?y))
  - move: ?x - obj ?y - obj
      pre: (and (p ?x))
      eff: (and (not (NOT-p ?y)) (not (p ?x)) (p ?y) (when (not (= ?x ?y)) (NOT-p ?x)))
  + move: ?x - obj ?y - obj
      pre: (and (p ?x))
      eff: (and (not (NOT-p ?y)) (not (p ?x)) (p ?y) (when (not (equal ?x ?y)) (NOT-p ?x)))
Init:
  + (equal o1 o1)
  + (equal o2 o2)
Pred prop:
  - (= object object): in_pre
  + (equal object object): in_init in_pre
