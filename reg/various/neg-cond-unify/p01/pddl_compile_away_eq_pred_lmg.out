Domain: neg-cond-unify
Problem: neg-cond-unify-p01
Require: 97
Type[2]:
    [0]: object, parent: -1
    [1]: obj, parent: 0
Obj-by-Type:
    [0]: 0 1
    [1]: 0 1
Obj[2]:
    [0]: o1, type: 1, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [1]: o2, type: 1, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
Predicate[7]:
    =: 0 0 :: read: 0, write: 0, in-init: 0
    p: 1 :: read: 1, write: 1, in-init: 1, neg-of: NOT-p
    q: 1 :: read: 1, write: 1, in-init: 0, neg-of: NOT-q
    r: 1 :: read: 1, write: 1, in-init: 0
    NOT-p: 1 :: read: 1, write: 1, in-init: 0, neg-of: p
    NOT-q: 1 :: read: 1, write: 1, in-init: 1, neg-of: q
    equal: 0 0 :: read: 1, write: 0, in-init: 1
Function[0]:
Action[7]:
    move: ?x:1 ?y:1
        pre: (and (RW:p ?x))
        eff: (and (N:RW:p ?x) (RW:p ?y) (N:RW:NOT-p ?y) (when (N:R:equal ?x ?y) (RW:NOT-p ?x)))
    cond-add: ?x:1 ?y:1
        pre: (and (RW:p ?x))
        eff: (and (N:RW:p ?x) (when (RW:q ?y) (and (RW:p ?y) (N:RW:NOT-p ?y))) (when (N:R:equal ?x ?y) (RW:NOT-p ?x)) (when (RW:NOT-q ?y) (RW:NOT-p ?x)))
    move-diff: ?x:1 ?y:1
        pre: (and (N:R:equal ?x ?y) (RW:p ?x))
        eff: (and (N:RW:p ?x) (RW:p ?y) (RW:NOT-p ?x) (N:RW:NOT-p ?y))
    cond-add-diff: ?x:1 ?y:1
        pre: (and (RW:p ?x))
        eff: (and (N:RW:p ?x) (RW:NOT-p ?x) (when (and (RW:q ?y) (N:R:equal ?x ?y)) (and (RW:p ?y) (N:RW:NOT-p ?y))))
    refresh: ?x:1
        pre: (and (RW:p ?x))
        eff: (and (RW:p ?x) (N:RW:NOT-p ?x) (when (RW:q ?x) (N:RW:p ?x)))
    set-q: ?x:1
        pre: (and (RW:r ?x))
        eff: (and (RW:q ?x) (N:RW:NOT-q ?x))
    check: ?x:1
        pre: (and (RW:NOT-p ?x))
        eff: (and (RW:r ?x))
Init[6]:
  S:(equal o1 o1)
  S:(equal o2 o2)
  (p o1)
  (p o2)
  (NOT-q o1)
  (NOT-q o2)
Init[0]:
Goal: (and (RW:p o1) (RW:p o2) (RW:r o1))
Metric: no-metric
