Domain: neg-cond-unify
Problem: neg-cond-unify-p01
Require:
  :conditional-effects
  :equality
  :negative-preconditions
  :strips
  :typing
Type:
  obj - object
  object
Obj:
  o1 - obj
  o2 - obj
Predicate:
  (= object object) :eq
  (NOT-p obj) neg-of (p)
  (NOT-q obj) neg-of (q)
  (p obj) neg-of (NOT-p)
  (q obj) neg-of (NOT-q)
  (r obj)
Function:
Action:
  check: ?x - obj
      pre: (and (NOT-p ?x))
      eff: (and (r ?x))
  cond-add-diff: ?x - obj ?y - obj
      pre: (and (p ?x))
      eff: (and (NOT-p ?x) (not (p ?x)) (when (and (not (= ?x ?y)) (q ?y)) (and (not (NOT-p ?y)) (p ?y))))
  cond-add: ?x - obj ?y - obj
      pre: (and (p ?x))
      eff: (and (not (p ?x)) (when (NOT-q ?y) (NOT-p ?x)) (when (not (= ?x ?y)) (NOT-p ?x)) (when (q ?y) (and (not (NOT-p ?y)) (p ?y))))
  move-diff: ?x - obj ?y - obj
      pre: (and (not (= ?x ?y)) (p ?x))
      eff: (and (NOT-p ?x) (not (NOT-p ?y)) (not (p ?x)) (p ?y))
  move: ?x - obj ?y - obj
      pre: (and (p ?x))
      eff: (and (not (NOT-p ?y)) (not (p ?x)) (p ?y) (when (not (= ?x ?y)) (NOT-p ?x)))
  refresh: ?x - obj
      pre: (and (p ?x))
      eff: (and (not (NOT-p ?x)) (p ?x) (when (q ?x) (not (p ?x))))
  set-q: ?x - obj
      pre: (and (r ?x))
      eff: (and (not (NOT-q ?x)) (q ?x))
Init:
  (NOT-q o1)
  (NOT-q o2)
  (p o1)
  (p o2)
Goal:
  (and (p o1) (p o2) (r o1))
Metric:
Pred prop:
  (= object object): in_pre in_pre_neg
  (NOT-p obj): in_pre in_eff
  (NOT-q obj): in_init in_pre in_eff
  (p obj): in_init in_pre in_goal in_eff
  (q obj): in_pre in_eff
  (r obj): in_pre in_goal in_eff
Func prop:
Global prop:
  has_cond_eff
  has_eq_pred
  is_unit_cost
