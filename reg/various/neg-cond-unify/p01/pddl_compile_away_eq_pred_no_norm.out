Require:
  - :disjunctive-preconditions
  - :equality
  - :existential-preconditions
  - :universal-preconditions
Predicate:
  + (equal object object)
Action:
  - cond-add-diff: ?x - obj ?y - obj
      pre: (p ?x)
      eff: (and (not (p ?x)) (when (and (not (= ?x ?y)) (q ?y)) (p ?y)))
  + cond-add-diff: ?x - obj ?y - obj
      pre: (p ?x)
      eff: (and (not (p ?x)) (when (and (not (equal ?x ?y)) (q ?y)) (p ?y)))
  - move-diff: ?x - obj ?y - obj
      pre: (and (not (= ?x ?y)) (p ?x))
      eff: (and (not (p ?x)) (p ?y))
  + move-diff: ?x - obj ?y - obj
      pre: (and (not (equal ?x ?y)) (p ?x))
      eff: (and (not (p ?x)) (p ?y))
Init:
  + (equal o1 o1)
  + (equal o2 o2)
Pred prop:
  - (= object object): in_pre
  + (equal object object): in_init in_pre
