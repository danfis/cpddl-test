Domain: neg-cond-unify
Problem: neg-cond-unify-p01
Require: ff
Type[2]:
    [0]: object, parent: -1
    [1]: obj, parent: 0
Obj-by-Type:
    [0]: 0 1
    [1]: 0 1
Obj[2]:
    [0]: o1, type: 1, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [1]: o2, type: 1, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
Predicate[5]:
    =: 0 0 :: read: 0, write: 0, in-init: 0
    p: 1 :: read: 1, write: 1, in-init: 1
    q: 1 :: read: 1, write: 1, in-init: 0
    r: 1 :: read: 1, write: 1, in-init: 0
    equal: 0 0 :: read: 1, write: 0, in-init: 1
Function[0]:
Action[7]:
    move: ?x:1 ?y:1
        pre: (RW:p ?x)
        eff: (and (N:RW:p ?x) (RW:p ?y))
    cond-add: ?x:1 ?y:1
        pre: (RW:p ?x)
        eff: (and (N:RW:p ?x) (when (RW:q ?y) (RW:p ?y)))
    move-diff: ?x:1 ?y:1
        pre: (and (N:R:equal ?x ?y) (RW:p ?x))
        eff: (and (N:RW:p ?x) (RW:p ?y))
    cond-add-diff: ?x:1 ?y:1
        pre: (RW:p ?x)
        eff: (and (N:RW:p ?x) (when (and (RW:q ?y) (N:R:equal ?x ?y)) (RW:p ?y)))
    refresh: ?x:1
        pre: (RW:p ?x)
        eff: (and (RW:p ?x) (when (RW:q ?x) (N:RW:p ?x)))
    set-q: ?x:1
        pre: (RW:r ?x)
        eff: (RW:q ?x)
    check: ?x:1
        pre: (N:RW:p ?x)
        eff: (RW:r ?x)
Init[4]:
  S:(equal o1 o1)
  S:(equal o2 o2)
  (p o1)
  (p o2)
Init[0]:
Goal: (and (RW:p o1) (RW:p o2) (RW:r o1))
Metric: no-metric
