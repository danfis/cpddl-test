Require:
  - :negative-preconditions
Predicate:
  + (NOT-white row column) neg-of (white)
  - (white row column)
  + (white row column) neg-of (NOT-white)
Action:
  - flip_column: ?c - column
      pre: (and)
      eff: (and (when (not (white r1 ?c)) (white r1 ?c)) (when (not (white r2 ?c)) (white r2 ?c)) (when (not (white r3 ?c)) (white r3 ?c)) (when (white r1 ?c) (not (white r1 ?c))) (when (white r2 ?c) (not (white r2 ?c))) (when (white r3 ?c) (not (white r3 ?c))))
  + flip_column: ?c - column
      pre: (and)
      eff: (and (when (NOT-white r1 ?c) (and (not (NOT-white r1 ?c)) (white r1 ?c))) (when (NOT-white r2 ?c) (and (not (NOT-white r2 ?c)) (white r2 ?c))) (when (NOT-white r3 ?c) (and (not (NOT-white r3 ?c)) (white r3 ?c))) (when (white r1 ?c) (and (NOT-white r1 ?c) (not (white r1 ?c)))) (when (white r2 ?c) (and (NOT-white r2 ?c) (not (white r2 ?c)))) (when (white r3 ?c) (and (NOT-white r3 ?c) (not (white r3 ?c)))))
  - flip_row: ?r - row
      pre: (and)
      eff: (and (when (not (white ?r c1)) (white ?r c1)) (when (not (white ?r c2)) (white ?r c2)) (when (not (white ?r c3)) (white ?r c3)) (when (white ?r c1) (not (white ?r c1))) (when (white ?r c2) (not (white ?r c2))) (when (white ?r c3) (not (white ?r c3))))
  + flip_row: ?r - row
      pre: (and)
      eff: (and (when (NOT-white ?r c1) (and (not (NOT-white ?r c1)) (white ?r c1))) (when (NOT-white ?r c2) (and (not (NOT-white ?r c2)) (white ?r c2))) (when (NOT-white ?r c3) (and (not (NOT-white ?r c3)) (white ?r c3))) (when (white ?r c1) (and (NOT-white ?r c1) (not (white ?r c1)))) (when (white ?r c2) (and (NOT-white ?r c2) (not (white ?r c2)))) (when (white ?r c3) (and (NOT-white ?r c3) (not (white ?r c3)))))
Init:
  + (NOT-white r1 c1)
  + (NOT-white r1 c2)
  + (NOT-white r1 c3)
  + (NOT-white r2 c2)
  + (NOT-white r2 c3)
  + (NOT-white r3 c1)
  + (NOT-white r3 c2)
  + (NOT-white r3 c3)
Pred prop:
  + (NOT-white row column): in_init in_pre in_eff
  - (white row column): in_init in_pre in_pre_neg in_goal in_eff
  + (white row column): in_init in_pre in_goal in_eff
