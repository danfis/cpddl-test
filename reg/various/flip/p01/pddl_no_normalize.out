Domain: flip
Problem: flip1
Require:
  :conditional-effects
  :negative-preconditions
  :strips
  :typing
  :universal-preconditions
Type:
  column - object
  object
  row - object
Obj:
  c1 - column
  c2 - column
  c3 - column
  r1 - row
  r2 - row
  r3 - row
Predicate:
  (= object object) :eq
  (white row column)
Function:
Action:
  flip_column: ?c - column
      pre: (and)
      eff: (forall (?r - row) (and (when (not (white ?r ?c)) (white ?r ?c)) (when (white ?r ?c) (not (white ?r ?c)))))
  flip_row: ?r - row
      pre: (and)
      eff: (forall (?c - column) (and (when (not (white ?r ?c)) (white ?r ?c)) (when (white ?r ?c) (not (white ?r ?c)))))
Init:
  (white r2 c1)
Goal:
  (forall (?r - row ?c - column) (white ?r ?c))
Metric:
Pred prop:
  (white row column): in_init in_pre in_pre_neg in_goal in_eff
Func prop:
Global prop:
  has_cond_eff
  has_non_static_neg_cond
  is_unit_cost
