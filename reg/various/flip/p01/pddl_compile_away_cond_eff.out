Require:
  - :conditional-effects
Action:
  - flip_column: ?c - column
      pre: (and)
      eff: (and (when (NOT-white r1 ?c) (and (not (NOT-white r1 ?c)) (white r1 ?c))) (when (NOT-white r2 ?c) (and (not (NOT-white r2 ?c)) (white r2 ?c))) (when (NOT-white r3 ?c) (and (not (NOT-white r3 ?c)) (white r3 ?c))) (when (white r1 ?c) (and (NOT-white r1 ?c) (not (white r1 ?c)))) (when (white r2 ?c) (and (NOT-white r2 ?c) (not (white r2 ?c)))) (when (white r3 ?c) (and (NOT-white r3 ?c) (not (white r3 ?c)))))
  + flip_column: ?c - column
      pre: (and (NOT-white r1 ?c) (NOT-white r2 ?c) (NOT-white r3 ?c))
      eff: (and (not (NOT-white r1 ?c)) (not (NOT-white r2 ?c)) (not (NOT-white r3 ?c)) (white r1 ?c) (white r2 ?c) (white r3 ?c))
  + flip_column: ?c - column
      pre: (and (NOT-white r1 ?c) (NOT-white r2 ?c) (white r3 ?c))
      eff: (and (NOT-white r3 ?c) (not (NOT-white r1 ?c)) (not (NOT-white r2 ?c)) (not (white r3 ?c)) (white r1 ?c) (white r2 ?c))
  + flip_column: ?c - column
      pre: (and (NOT-white r1 ?c) (NOT-white r3 ?c) (white r2 ?c))
      eff: (and (NOT-white r2 ?c) (not (NOT-white r1 ?c)) (not (NOT-white r3 ?c)) (not (white r2 ?c)) (white r1 ?c) (white r3 ?c))
  + flip_column: ?c - column
      pre: (and (NOT-white r1 ?c) (white r2 ?c) (white r3 ?c))
      eff: (and (NOT-white r2 ?c) (NOT-white r3 ?c) (not (NOT-white r1 ?c)) (not (white r2 ?c)) (not (white r3 ?c)) (white r1 ?c))
  + flip_column: ?c - column
      pre: (and (NOT-white r2 ?c) (NOT-white r3 ?c) (white r1 ?c))
      eff: (and (NOT-white r1 ?c) (not (NOT-white r2 ?c)) (not (NOT-white r3 ?c)) (not (white r1 ?c)) (white r2 ?c) (white r3 ?c))
  + flip_column: ?c - column
      pre: (and (NOT-white r2 ?c) (white r1 ?c) (white r3 ?c))
      eff: (and (NOT-white r1 ?c) (NOT-white r3 ?c) (not (NOT-white r2 ?c)) (not (white r1 ?c)) (not (white r3 ?c)) (white r2 ?c))
  + flip_column: ?c - column
      pre: (and (NOT-white r3 ?c) (white r1 ?c) (white r2 ?c))
      eff: (and (NOT-white r1 ?c) (NOT-white r2 ?c) (not (NOT-white r3 ?c)) (not (white r1 ?c)) (not (white r2 ?c)) (white r3 ?c))
  + flip_column: ?c - column
      pre: (and (white r1 ?c) (white r2 ?c) (white r3 ?c))
      eff: (and (NOT-white r1 ?c) (NOT-white r2 ?c) (NOT-white r3 ?c) (not (white r1 ?c)) (not (white r2 ?c)) (not (white r3 ?c)))
  - flip_row: ?r - row
      pre: (and)
      eff: (and (when (NOT-white ?r c1) (and (not (NOT-white ?r c1)) (white ?r c1))) (when (NOT-white ?r c2) (and (not (NOT-white ?r c2)) (white ?r c2))) (when (NOT-white ?r c3) (and (not (NOT-white ?r c3)) (white ?r c3))) (when (white ?r c1) (and (NOT-white ?r c1) (not (white ?r c1)))) (when (white ?r c2) (and (NOT-white ?r c2) (not (white ?r c2)))) (when (white ?r c3) (and (NOT-white ?r c3) (not (white ?r c3)))))
  + flip_row: ?r - row
      pre: (and (NOT-white ?r c1) (NOT-white ?r c2) (NOT-white ?r c3))
      eff: (and (not (NOT-white ?r c1)) (not (NOT-white ?r c2)) (not (NOT-white ?r c3)) (white ?r c1) (white ?r c2) (white ?r c3))
  + flip_row: ?r - row
      pre: (and (NOT-white ?r c1) (NOT-white ?r c2) (white ?r c3))
      eff: (and (NOT-white ?r c3) (not (NOT-white ?r c1)) (not (NOT-white ?r c2)) (not (white ?r c3)) (white ?r c1) (white ?r c2))
  + flip_row: ?r - row
      pre: (and (NOT-white ?r c1) (NOT-white ?r c3) (white ?r c2))
      eff: (and (NOT-white ?r c2) (not (NOT-white ?r c1)) (not (NOT-white ?r c3)) (not (white ?r c2)) (white ?r c1) (white ?r c3))
  + flip_row: ?r - row
      pre: (and (NOT-white ?r c1) (white ?r c2) (white ?r c3))
      eff: (and (NOT-white ?r c2) (NOT-white ?r c3) (not (NOT-white ?r c1)) (not (white ?r c2)) (not (white ?r c3)) (white ?r c1))
  + flip_row: ?r - row
      pre: (and (NOT-white ?r c2) (NOT-white ?r c3) (white ?r c1))
      eff: (and (NOT-white ?r c1) (not (NOT-white ?r c2)) (not (NOT-white ?r c3)) (not (white ?r c1)) (white ?r c2) (white ?r c3))
  + flip_row: ?r - row
      pre: (and (NOT-white ?r c2) (white ?r c1) (white ?r c3))
      eff: (and (NOT-white ?r c1) (NOT-white ?r c3) (not (NOT-white ?r c2)) (not (white ?r c1)) (not (white ?r c3)) (white ?r c2))
  + flip_row: ?r - row
      pre: (and (NOT-white ?r c3) (white ?r c1) (white ?r c2))
      eff: (and (NOT-white ?r c1) (NOT-white ?r c2) (not (NOT-white ?r c3)) (not (white ?r c1)) (not (white ?r c2)) (white ?r c3))
  + flip_row: ?r - row
      pre: (and (white ?r c1) (white ?r c2) (white ?r c3))
      eff: (and (NOT-white ?r c1) (NOT-white ?r c2) (NOT-white ?r c3) (not (white ?r c1)) (not (white ?r c2)) (not (white ?r c3)))
