Action:
  - move: ?f1 - farm ?f2 - farm
      pre: (and (>= (x ?f1) 1) (adj ?f1 ?f2))
      eff: (and (decrease (x ?f1) 1) (increase (x ?f2) 4))
  + move: ?f1 - farm ?f2 - farm
      pre: (and (>= (x ?f1) 10) (adj ?f1 ?f2))
      eff: (and (decrease (x ?f1) 10) (increase (x ?f2) 40))
Init:
  - (= (x f0) 2.5)
  - (= (x f1) 1)
  + (= (x f0) 25)
  + (= (x f1) 10)
Goal:
  - (>= (+ (x f0) (* 1.7 (x f1))) 8.4)
  + (>= (+ (* 10 (x f0)) (* 17 (x f1))) 840)
