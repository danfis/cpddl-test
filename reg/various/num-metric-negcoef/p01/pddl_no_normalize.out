Domain: num-metric-negcoef
Problem: num-metric-negcoef-01
Require:
  :conditional-effects
  :disjunctive-preconditions
  :equality
  :existential-preconditions
  :negative-preconditions
  :numeric-fluents
  :strips
  :typing
  :universal-preconditions
Type:
  loc - object
  object
Obj:
  l1 - loc
  l2 - loc
  l3 - loc
Predicate:
  (= object object) :eq
  (at loc)
  (conn loc loc)
Function:
  (f)
  (g loc)
Action:
  move: ?a - loc ?b - loc
      pre: (and (at ?a) (conn ?a ?b))
      eff: (and (at ?b) (decrease (f) (g ?b)) (not (at ?a)))
Init:
  (= (f) 0)
  (= (g l1) -1)
  (= (g l2) -2)
  (= (g l3) 0)
  (at l1)
  (conn l1 l2)
  (conn l2 l3)
Goal:
  (at l3)
Metric:
  (f)
Pred prop:
  (at loc): in_init in_pre in_goal in_eff
  (conn loc loc): in_init in_pre
Func prop:
  (f): in_init init_all_nonneg init_all_nonpos init_all_int in_metric is_metric_alone in_eff rhs_funcs:(g) write_delta_nonneg write_delta_nonneg_int
  (g loc): in_init init_all_nonpos init_all_int on_num_op_rhs write_delta_nonneg write_delta_nonneg_int
Global prop:
  action_cost_func:(f)
  has_int_action_cost_func
