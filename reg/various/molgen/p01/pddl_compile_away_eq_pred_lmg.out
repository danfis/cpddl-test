Action[8]:
    reverse-transcribe: ?x:0
        pre: (and (R:mrna ?x))
        eff: (and (RW:connected-cdna-mrna ?x))
    separate: ?x:0
        pre: (and (RW:connected-cdna-mrna ?x))
        eff: (and (N:RW:connected-cdna-mrna ?x) (RW:single-strand ?x))
    polymerize: ?x:0
        pre: (and (RW:single-strand ?x))
        eff: (and (N:RW:single-strand ?x) (RW:hair-pin ?x))
    digest: ?x:0
        pre: (and (RW:hair-pin ?x))
        eff: (and (N:RW:hair-pin ?x) (RW:double-strand ?x))
    ligate: ?x:0 ?y:0
        pre: (and (N:R:equal ?x ?y))
        eff: (and (when (and (RW:double-strand ?y) (R:equal ?x linker)) (RW:cleavable ?y)) (when (and (RW:cleaved ?x) (RW:cleaved ?y) (N:R:equal ?x linker)) (and (RW:contains ?x ?y) (RW:cleavable ?y) (N:RW:cleaved ?x) (N:RW:cleaved ?y))))
    cleave: ?x:0
        pre: (and (RW:cleavable ?x))
        eff: (and (N:RW:cleavable ?x) (RW:cleaved ?x))
    transform: ?x:0 ?y:0
        pre: (and (R:bacterium ?y) (R:accepts ?x ?y) (N:R:equal ?x ?y) (RW:cleavable ?x))
        eff: (and (N:RW:cleavable ?x) (RW:contains ?x ?y))
    screen: ?x:0 ?y:0 ?z:0
        pre: (and (R:bacterium ?x) (R:antibiotic ?z) (R:resists ?z ?y) (N:R:equal ?x ?y) (N:R:equal ?x ?z) (N:R:equal ?y ?z) (RW:contains ?y ?x))
        eff: (and (W:pure ?x))
