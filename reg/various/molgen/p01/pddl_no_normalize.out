Domain: molgen-adl
Problem: rat-insulin-adl
Require:
  :conditional-effects
  :disjunctive-preconditions
  :equality
  :existential-preconditions
  :negative-preconditions
  :strips
  :typing
  :universal-preconditions
Type:
  object
Obj:
  antibiotic-1 - object
  e-coli - object
  e-coli-exosome - object
  insulin-gene - object
  junk - object
  junk-exosome - object
  linker - object :constant
Predicate:
  (= object object) :eq
  (accepts object object)
  (antibiotic object)
  (bacterium object)
  (cleavable object)
  (cleaved object)
  (connected-cdna-mrna object)
  (contains object object)
  (double-strand object)
  (hair-pin object)
  (molecule object)
  (mrna object)
  (pure object)
  (resists object object)
  (single-strand object)
Function:
Action:
  cleave: ?x - object
      pre: (cleavable ?x)
      eff: (and (cleaved ?x) (not (cleavable ?x)))
  digest: ?x - object
      pre: (hair-pin ?x)
      eff: (and (double-strand ?x) (not (hair-pin ?x)))
  ligate: ?x - object ?y - object
      pre: (not (= ?x ?y))
      eff: (and (when (and (= ?x linker) (double-strand ?y)) (cleavable ?y)) (when (and (cleaved ?x) (cleaved ?y) (not (= ?x linker))) (and (cleavable ?y) (contains ?x ?y) (not (cleaved ?x)) (not (cleaved ?y)))))
  polymerize: ?x - object
      pre: (single-strand ?x)
      eff: (and (hair-pin ?x) (not (single-strand ?x)))
  reverse-transcribe: ?x - object
      pre: (mrna ?x)
      eff: (connected-cdna-mrna ?x)
  screen: ?x - object ?y - object ?z - object
      pre: (and (antibiotic ?z) (bacterium ?x) (contains ?y ?x) (not (= ?x ?y)) (not (= ?x ?z)) (not (= ?y ?z)) (resists ?z ?y))
      eff: (pure ?x)
  separate: ?x - object
      pre: (connected-cdna-mrna ?x)
      eff: (and (not (connected-cdna-mrna ?x)) (single-strand ?x))
  transform: ?x - object ?y - object
      pre: (and (accepts ?x ?y) (bacterium ?y) (cleavable ?x) (not (= ?x ?y)))
      eff: (and (contains ?x ?y) (not (cleavable ?x)))
Init:
  (accepts e-coli-exosome e-coli)
  (accepts junk-exosome junk)
  (antibiotic antibiotic-1)
  (bacterium e-coli)
  (bacterium junk)
  (cleavable e-coli-exosome)
  (cleavable junk-exosome)
  (molecule e-coli-exosome)
  (molecule insulin-gene)
  (molecule junk-exosome)
  (molecule linker)
  (mrna insulin-gene)
  (resists antibiotic-1 e-coli-exosome)
Goal:
  (and (contains e-coli-exosome e-coli) (contains insulin-gene e-coli-exosome) (pure e-coli))
Metric:
Pred prop:
  (= object object): in_pre in_pre_neg
  (accepts object object): in_init in_pre
  (antibiotic object): in_init in_pre
  (bacterium object): in_init in_pre
  (cleavable object): in_init in_pre in_eff
  (cleaved object): in_pre in_eff
  (connected-cdna-mrna object): in_pre in_eff
  (contains object object): in_pre in_goal in_eff
  (double-strand object): in_pre in_eff
  (hair-pin object): in_pre in_eff
  (molecule object): in_init
  (mrna object): in_init in_pre
  (pure object): in_goal in_eff
  (resists object object): in_init in_pre
  (single-strand object): in_pre in_eff
Func prop:
Global prop:
  has_cond_eff
  has_eq_pred
  is_unit_cost
