    [0]: 0 1 2 3 4 5 6
Obj[7]:
    [0]: linker, type: 0, is-constant: 1, is-private: 0, owner: -1, is-agent: 0
    [1]: insulin-gene, type: 0, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [2]: e-coli-exosome, type: 0, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [3]: junk-exosome, type: 0, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [4]: e-coli, type: 0, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [5]: junk, type: 0, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
    [6]: antibiotic-1, type: 0, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
Predicate[16]:
    =: 0 0 :: read: 1, write: 0, in-init: 0
    mrna: 0 :: read: 1, write: 0, in-init: 1
    connected-cdna-mrna: 0 :: read: 1, write: 1, in-init: 0
    single-strand: 0 :: read: 1, write: 1, in-init: 0
    hair-pin: 0 :: read: 1, write: 1, in-init: 0
    double-strand: 0 :: read: 1, write: 1, in-init: 0, neg-of: NOT-double-strand
    cleavable: 0 :: read: 1, write: 1, in-init: 1
    cleaved: 0 :: read: 1, write: 1, in-init: 0, neg-of: NOT-cleaved
    bacterium: 0 :: read: 1, write: 0, in-init: 1
    accepts: 0 0 :: read: 1, write: 0, in-init: 1
    contains: 0 0 :: read: 1, write: 1, in-init: 0
    antibiotic: 0 :: read: 1, write: 0, in-init: 1
    pure: 0 :: read: 1, write: 1, in-init: 0
    resists: 0 0 :: read: 1, write: 0, in-init: 1
    NOT-double-strand: 0 :: read: 1, write: 1, in-init: 1, neg-of: double-strand
    NOT-cleaved: 0 :: read: 1, write: 1, in-init: 1, neg-of: cleaved
Function[0]:
Action[11]:
    reverse-transcribe: ?x:0
        pre: (and (R:mrna ?x))
        eff: (and (RW:connected-cdna-mrna ?x))
    separate: ?x:0
        pre: (and (RW:connected-cdna-mrna ?x))
        eff: (and (N:RW:connected-cdna-mrna ?x) (RW:single-strand ?x))
    polymerize: ?x:0
        pre: (and (RW:single-strand ?x))
        eff: (and (N:RW:single-strand ?x) (RW:hair-pin ?x))
    digest: ?x:0
        pre: (and (RW:hair-pin ?x))
        eff: (and (N:RW:hair-pin ?x) (RW:double-strand ?x) (N:RW:NOT-double-strand ?x))
    cleave: ?x:0
        pre: (and (RW:cleavable ?x))
        eff: (and (N:RW:cleavable ?x) (RW:cleaved ?x) (N:RW:NOT-cleaved ?x))
    transform: ?x:0 ?y:0
        pre: (and (N:R:= ?x ?y) (R:bacterium ?y) (R:accepts ?x ?y) (RW:cleavable ?x))
        eff: (and (N:RW:cleavable ?x) (RW:contains ?x ?y))
    screen: ?x:0 ?y:0 ?z:0
        pre: (and (N:R:= ?x ?y) (N:R:= ?x ?z) (N:R:= ?y ?z) (R:bacterium ?x) (R:antibiotic ?z) (R:resists ?z ?y) (RW:contains ?y ?x))
        eff: (and (RW:pure ?x))
    ligate: ?x:0 ?y:0
        pre: (and (N:R:= ?x ?y) (RW:double-strand ?y) (RW:NOT-cleaved ?x))
        eff: (and (when (R:= ?x linker) (RW:cleavable ?y)))
    ligate: ?x:0 ?y:0
        pre: (and (N:R:= ?x ?y) (RW:cleaved ?x) (RW:cleaved ?y) (RW:NOT-double-strand ?y))
        eff: (and (when (N:R:= ?x linker) (and (RW:contains ?x ?y) (RW:cleavable ?y) (N:RW:cleaved ?x) (N:RW:cleaved ?y) (RW:NOT-cleaved ?x) (RW:NOT-cleaved ?y))))
    ligate: ?x:0 ?y:0
        pre: (and (N:R:= ?x ?y) (RW:double-strand ?y) (RW:cleaved ?x) (RW:cleaved ?y))
        eff: (and (when (R:= ?x linker) (RW:cleavable ?y)) (when (N:R:= ?x linker) (and (RW:contains ?x ?y) (RW:cleavable ?y) (N:RW:cleaved ?x) (N:RW:cleaved ?y) (RW:NOT-cleaved ?x) (RW:NOT-cleaved ?y))))
    ligate: ?x:0 ?y:0
        pre: (and (N:R:= ?x ?y) (RW:double-strand ?y) (RW:NOT-cleaved ?y))
        eff: (and (when (R:= ?x linker) (RW:cleavable ?y)))
