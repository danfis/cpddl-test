Require:
  - :equality
Predicate:
  + (equal object object)
Action:
  - ligate: ?x - object ?y - object
      pre: (not (= ?x ?y))
      eff: (and (when (and (= ?x linker) (double-strand ?y)) (cleavable ?y)) (when (and (cleaved ?x) (cleaved ?y) (not (= ?x linker))) (and (cleavable ?y) (contains ?x ?y) (not (cleaved ?x)) (not (cleaved ?y)))))
  + ligate: ?x - object ?y - object
      pre: (not (equal ?x ?y))
      eff: (and (when (and (cleaved ?x) (cleaved ?y) (not (equal ?x linker))) (and (cleavable ?y) (contains ?x ?y) (not (cleaved ?x)) (not (cleaved ?y)))) (when (and (double-strand ?y) (equal ?x linker)) (cleavable ?y)))
  - screen: ?x - object ?y - object ?z - object
      pre: (and (antibiotic ?z) (bacterium ?x) (contains ?y ?x) (not (= ?x ?y)) (not (= ?x ?z)) (not (= ?y ?z)) (resists ?z ?y))
      eff: (pure ?x)
  + screen: ?x - object ?y - object ?z - object
      pre: (and (antibiotic ?z) (bacterium ?x) (contains ?y ?x) (not (equal ?x ?y)) (not (equal ?x ?z)) (not (equal ?y ?z)) (resists ?z ?y))
      eff: (pure ?x)
  - transform: ?x - object ?y - object
      pre: (and (accepts ?x ?y) (bacterium ?y) (cleavable ?x) (not (= ?x ?y)))
      eff: (and (contains ?x ?y) (not (cleavable ?x)))
  + transform: ?x - object ?y - object
      pre: (and (accepts ?x ?y) (bacterium ?y) (cleavable ?x) (not (equal ?x ?y)))
      eff: (and (contains ?x ?y) (not (cleavable ?x)))
Init:
  + (equal antibiotic-1 antibiotic-1)
  + (equal e-coli e-coli)
  + (equal e-coli-exosome e-coli-exosome)
  + (equal insulin-gene insulin-gene)
  + (equal junk junk)
  + (equal junk-exosome junk-exosome)
  + (equal linker linker)
Pred prop:
  - (= object object): in_pre in_pre_neg
  + (equal object object): in_init in_pre in_pre_neg
Global prop:
  - has_eq_pred
