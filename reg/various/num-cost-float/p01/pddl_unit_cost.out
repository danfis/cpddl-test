Domain: num-cost-float
Problem: num-cost-float-01
Require:
  :strips
  :typing
Type:
  loc - object
  object
Obj:
  l1 - loc
  l2 - loc
  l3 - loc
Predicate:
  (= object object) :eq
  (at loc)
  (conn loc loc)
Function:
Action:
  move: ?a - loc ?b - loc
      pre: (and (at ?a) (conn ?a ?b))
      eff: (and (at ?b) (not (at ?a)))
Init:
  (at l1)
  (conn l1 l2)
  (conn l2 l3)
Goal:
  (at l3)
Metric:
Pred prop:
  (at loc): in_init in_pre in_goal in_eff
  (conn loc loc): in_init in_pre
Func prop:
Global prop:
  is_unit_cost
