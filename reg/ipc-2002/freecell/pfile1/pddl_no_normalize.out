  sendtohome-b: ?card - object ?suit - object ?vcard - object ?homecard - object ?vhomecard - object ?cols - object ?ncols - object
      pre: (and (bottomcol ?card) (clear ?card) (colspace ?cols) (home ?homecard) (successor ?ncols ?cols) (successor ?vcard ?vhomecard) (suit ?card ?suit) (suit ?homecard ?suit) (value ?card ?vcard) (value ?homecard ?vhomecard))
      eff: (and (colspace ?ncols) (home ?card) (not (bottomcol ?card)) (not (clear ?card)) (not (colspace ?cols)) (not (home ?homecard)))
  sendtohome: ?card - object ?oldcard - object ?suit - object ?vcard - object ?homecard - object ?vhomecard - object
      pre: (and (clear ?card) (home ?homecard) (on ?card ?oldcard) (successor ?vcard ?vhomecard) (suit ?card ?suit) (suit ?homecard ?suit) (value ?card ?vcard) (value ?homecard ?vhomecard))
      eff: (and (clear ?oldcard) (home ?card) (not (clear ?card)) (not (home ?homecard)) (not (on ?card ?oldcard)))
