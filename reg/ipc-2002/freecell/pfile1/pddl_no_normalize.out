  sendtofree-b: ?card - object ?cells - object ?ncells - object ?cols - object ?ncols - object
      pre: (and (bottomcol ?card) (cellspace ?cells) (clear ?card) (colspace ?cols) (successor ?cells ?ncells) (successor ?ncols ?cols))
