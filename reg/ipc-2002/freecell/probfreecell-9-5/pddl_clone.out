    sendtohome: ?card:0 ?oldcard:0 ?suit:0 ?vcard:0 ?homecard:0 ?vhomecard:0
        pre: (and (R:suit ?card ?suit) (R:suit ?homecard ?suit) (R:value ?card ?vcard) (R:value ?homecard ?vhomecard) (R:successor ?vcard ?vhomecard) (RW:on ?card ?oldcard) (RW:clear ?card) (RW:home ?homecard))
        eff: (and (N:RW:on ?card ?oldcard) (N:RW:clear ?card) (RW:clear ?oldcard) (RW:home ?card) (N:RW:home ?homecard))
    sendtohome-b: ?card:0 ?suit:0 ?vcard:0 ?homecard:0 ?vhomecard:0 ?cols:0 ?ncols:0
        pre: (and (R:suit ?card ?suit) (R:suit ?homecard ?suit) (R:value ?card ?vcard) (R:value ?homecard ?vhomecard) (R:successor ?vcard ?vhomecard) (R:successor ?ncols ?cols) (RW:clear ?card) (RW:colspace ?cols) (RW:home ?homecard) (RW:bottomcol ?card))
        eff: (and (N:RW:clear ?card) (N:RW:colspace ?cols) (RW:colspace ?ncols) (RW:home ?card) (N:RW:home ?homecard) (N:RW:bottomcol ?card))
    homefromfreecell: ?card:0 ?suit:0 ?vcard:0 ?homecard:0 ?vhomecard:0 ?cells:0 ?ncells:0
        pre: (and (R:suit ?card ?suit) (R:suit ?homecard ?suit) (R:value ?card ?vcard) (R:value ?homecard ?vhomecard) (R:successor ?vcard ?vhomecard) (R:successor ?ncells ?cells) (RW:incell ?card) (RW:cellspace ?cells) (RW:home ?homecard))
        eff: (and (N:RW:incell ?card) (N:RW:cellspace ?cells) (RW:cellspace ?ncells) (RW:home ?card) (N:RW:home ?homecard))
    colfromfreecell: ?card:0 ?newcard:0 ?cells:0 ?ncells:0
