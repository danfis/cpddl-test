Require:
  + :equality
  + :negative-preconditions
Action:
  - debark: ?p - object ?a - object ?c - object
      pre: (and (aircraft ?a) (at ?a ?c) (city ?c) (in ?p ?a) (person ?p))
      eff: (and (at ?p ?c) (not (in ?p ?a)))
  + debark: ?p - object ?a - object ?c - object
      pre: (and (aircraft ?a) (at ?a ?c) (city ?c) (in ?p ?a) (not (= ?p ?a)) (person ?p))
      eff: (and (at ?p ?c) (not (in ?p ?a)))
Pred prop:
  + (= object object): in_pre in_pre_neg
Global prop:
  + has_eq_pred
