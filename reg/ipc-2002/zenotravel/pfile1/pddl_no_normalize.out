Domain: zeno-travel
Problem: ztravel-1-2
Require:
  :conditional-effects
  :disjunctive-preconditions
  :equality
  :existential-preconditions
  :negative-preconditions
  :strips
  :typing
  :universal-preconditions
Type:
  object
Obj:
  city0 - object
  city1 - object
  city2 - object
  fl0 - object
  fl1 - object
  fl2 - object
  fl3 - object
  fl4 - object
  fl5 - object
  fl6 - object
  person1 - object
  person2 - object
  plane1 - object
Predicate:
  (= object object) :eq
  (aircraft object)
  (at object object)
  (city object)
  (flevel object)
  (fuel-level object object)
  (in object object)
  (next object object)
  (person object)
Function:
Action:
  board: ?p - object ?a - object ?c - object
      pre: (and (aircraft ?a) (at ?a ?c) (at ?p ?c) (city ?c) (person ?p))
      eff: (and (in ?p ?a) (not (at ?p ?c)))
  debark: ?p - object ?a - object ?c - object
      pre: (and (aircraft ?a) (at ?a ?c) (city ?c) (in ?p ?a) (person ?p))
      eff: (and (at ?p ?c) (not (in ?p ?a)))
  fly: ?a - object ?c1 - object ?c2 - object ?l1 - object ?l2 - object
      pre: (and (aircraft ?a) (at ?a ?c1) (city ?c1) (city ?c2) (flevel ?l1) (flevel ?l2) (fuel-level ?a ?l1) (next ?l2 ?l1))
      eff: (and (at ?a ?c2) (fuel-level ?a ?l2) (not (at ?a ?c1)) (not (fuel-level ?a ?l1)))
  refuel: ?a - object ?c - object ?l - object ?l1 - object
      pre: (and (aircraft ?a) (at ?a ?c) (city ?c) (flevel ?l) (flevel ?l1) (fuel-level ?a ?l) (next ?l ?l1))
      eff: (and (fuel-level ?a ?l1) (not (fuel-level ?a ?l)))
  zoom: ?a - object ?c1 - object ?c2 - object ?l1 - object ?l2 - object ?l3 - object
      pre: (and (aircraft ?a) (at ?a ?c1) (city ?c1) (city ?c2) (flevel ?l1) (flevel ?l2) (flevel ?l3) (fuel-level ?a ?l1) (next ?l2 ?l1) (next ?l3 ?l2))
      eff: (and (at ?a ?c2) (fuel-level ?a ?l3) (not (at ?a ?c1)) (not (fuel-level ?a ?l1)))
Init:
  (aircraft plane1)
  (at person1 city0)
  (at person2 city2)
  (at plane1 city0)
  (city city0)
  (city city1)
  (city city2)
  (flevel fl0)
  (flevel fl1)
  (flevel fl2)
  (flevel fl3)
  (flevel fl4)
  (flevel fl5)
  (flevel fl6)
  (fuel-level plane1 fl1)
  (next fl0 fl1)
  (next fl1 fl2)
  (next fl2 fl3)
  (next fl3 fl4)
  (next fl4 fl5)
  (next fl5 fl6)
  (person person1)
  (person person2)
Goal:
  (and (at person1 city0) (at person2 city2) (at plane1 city1))
Metric:
Pred prop:
  (aircraft object): in_init in_pre
  (at object object): in_init in_pre in_goal in_eff
  (city object): in_init in_pre
  (flevel object): in_init in_pre
  (fuel-level object object): in_init in_pre in_eff
  (in object object): in_pre in_eff
  (next object object): in_init in_pre
  (person object): in_init in_pre
Func prop:
Global prop:
  is_unit_cost
