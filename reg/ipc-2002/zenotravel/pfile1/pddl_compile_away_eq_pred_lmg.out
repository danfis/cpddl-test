Action[5]:
    board: ?p:0 ?a:0 ?c:0
        pre: (and (R:aircraft ?a) (R:person ?p) (R:city ?c) (RW:at ?p ?c) (RW:at ?a ?c))
        eff: (and (N:RW:at ?p ?c) (RW:in ?p ?a))
    debark: ?p:0 ?a:0 ?c:0
        pre: (and (R:aircraft ?a) (R:person ?p) (R:city ?c) (N:R:equal ?p ?a) (RW:at ?a ?c) (RW:in ?p ?a))
        eff: (and (RW:at ?p ?c) (N:RW:in ?p ?a))
    fly: ?a:0 ?c1:0 ?c2:0 ?l1:0 ?l2:0
        pre: (and (R:next ?l2 ?l1) (R:aircraft ?a) (R:city ?c1) (R:city ?c2) (R:flevel ?l1) (R:flevel ?l2) (RW:at ?a ?c1) (RW:fuel-level ?a ?l1))
        eff: (and (N:RW:at ?a ?c1) (RW:at ?a ?c2) (N:RW:fuel-level ?a ?l1) (RW:fuel-level ?a ?l2))
    zoom: ?a:0 ?c1:0 ?c2:0 ?l1:0 ?l2:0 ?l3:0
        pre: (and (R:next ?l2 ?l1) (R:next ?l3 ?l2) (R:aircraft ?a) (R:city ?c1) (R:city ?c2) (R:flevel ?l1) (R:flevel ?l2) (R:flevel ?l3) (RW:at ?a ?c1) (RW:fuel-level ?a ?l1))
        eff: (and (N:RW:at ?a ?c1) (RW:at ?a ?c2) (N:RW:fuel-level ?a ?l1) (RW:fuel-level ?a ?l3))
    refuel: ?a:0 ?c:0 ?l:0 ?l1:0
        pre: (and (R:next ?l ?l1) (R:aircraft ?a) (R:city ?c) (R:flevel ?l) (R:flevel ?l1) (RW:at ?a ?c) (RW:fuel-level ?a ?l))
        eff: (and (N:RW:fuel-level ?a ?l) (RW:fuel-level ?a ?l1))
