      eff: (and (available ?r) (channel_free ?l) (communicated_soil_data ?p) (not (available ?r)) (not (channel_free ?l)))
  drop: ?x - object ?y - object
      pre: (and (full ?y) (rover ?x) (store ?y) (store_of ?y ?x))
      eff: (and (empty ?y) (not (full ?y)))
  navigate: ?x - object ?y - object ?z - object
      pre: (and (at ?x ?y) (available ?x) (can_traverse ?x ?y ?z) (rover ?x) (visible ?y ?z) (waypoint ?y) (waypoint ?z))
      eff: (and (at ?x ?z) (not (at ?x ?y)))
  sample_rock: ?x - object ?s - object ?p - object
      pre: (and (at ?x ?p) (at_rock_sample ?p) (empty ?s) (equipped_for_rock_analysis ?x) (rover ?x) (store ?s) (store_of ?s ?x) (waypoint ?p))
