Domain: depot
Problem: depotprob1818
Require:
  :strips
Type:
  object
Obj:
  crate0 - object
  crate1 - object
  depot0 - object
  distributor0 - object
  distributor1 - object
  hoist0 - object
  hoist1 - object
  hoist2 - object
  pallet0 - object
  pallet1 - object
  pallet2 - object
  truck0 - object
  truck1 - object
Predicate:
  (= object object) :eq
  (at object object)
  (available object)
  (clear object)
  (crate object)
  (hoist object)
  (in object object)
  (lifting object object)
  (on object object)
  (place object)
  (surface object)
  (truck object)
Function:
Action:
  drive: ?x - object ?y - object ?z - object
      pre: (and (at ?x ?y) (place ?y) (place ?z) (truck ?x))
      eff: (and (at ?x ?z) (not (at ?x ?y)))
  drop: ?x - object ?y - object ?z - object ?p - object
      pre: (and (at ?x ?p) (at ?z ?p) (clear ?z) (crate ?y) (hoist ?x) (lifting ?x ?y) (place ?p) (surface ?z))
      eff: (and (at ?y ?p) (available ?x) (clear ?y) (not (clear ?z)) (not (lifting ?x ?y)) (on ?y ?z))
  lift: ?x - object ?y - object ?z - object ?p - object
      pre: (and (at ?x ?p) (at ?y ?p) (available ?x) (clear ?y) (crate ?y) (hoist ?x) (on ?y ?z) (place ?p) (surface ?z))
      eff: (and (clear ?z) (lifting ?x ?y) (not (at ?y ?p)) (not (available ?x)) (not (clear ?y)) (not (on ?y ?z)))
  load: ?x - object ?y - object ?z - object ?p - object
      pre: (and (at ?x ?p) (at ?z ?p) (crate ?y) (hoist ?x) (lifting ?x ?y) (place ?p) (truck ?z))
      eff: (and (available ?x) (in ?y ?z) (not (lifting ?x ?y)))
  unload: ?x - object ?y - object ?z - object ?p - object
      pre: (and (at ?x ?p) (at ?z ?p) (available ?x) (crate ?y) (hoist ?x) (in ?y ?z) (place ?p) (truck ?z))
      eff: (and (lifting ?x ?y) (not (available ?x)) (not (in ?y ?z)))
Init:
  (at crate0 distributor0)
  (at crate1 depot0)
  (at hoist0 depot0)
  (at hoist1 distributor0)
  (at hoist2 distributor1)
  (at pallet0 depot0)
  (at pallet1 distributor0)
  (at pallet2 distributor1)
  (at truck0 distributor1)
  (at truck1 depot0)
  (available hoist0)
  (available hoist1)
  (available hoist2)
  (clear crate0)
  (clear crate1)
  (clear pallet2)
  (crate crate0)
  (crate crate1)
  (hoist hoist0)
  (hoist hoist1)
  (hoist hoist2)
  (on crate0 pallet1)
  (on crate1 pallet0)
  (place depot0)
  (place distributor0)
  (place distributor1)
  (surface crate0)
  (surface crate1)
  (surface pallet0)
  (surface pallet1)
  (surface pallet2)
  (truck truck0)
  (truck truck1)
Goal:
  (and (on crate0 pallet2) (on crate1 pallet1))
Metric:
Pred prop:
  (at object object): in_init in_pre in_eff
  (available object): in_init in_pre in_eff
  (clear object): in_init in_pre in_eff
  (crate object): in_init in_pre
  (hoist object): in_init in_pre
  (in object object): in_pre in_eff
  (lifting object object): in_pre in_eff
  (on object object): in_init in_pre in_goal in_eff
  (place object): in_init in_pre
  (surface object): in_init in_pre
  (truck object): in_init in_pre
Func prop:
Global prop:
  is_unit_cost
