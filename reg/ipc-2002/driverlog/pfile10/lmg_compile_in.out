Require:
  + :equality
  + :negative-preconditions
Action:
  - disembark-truck: ?driver - object ?truck - object ?loc - object
      pre: (and (at ?truck ?loc) (driver ?driver) (driving ?driver ?truck) (location ?loc) (truck ?truck))
      eff: (and (at ?driver ?loc) (empty ?truck) (not (driving ?driver ?truck)))
  + disembark-truck: ?driver - object ?truck - object ?loc - object
      pre: (and (at ?truck ?loc) (driver ?driver) (driving ?driver ?truck) (location ?loc) (not (= ?driver ?truck)) (truck ?truck))
      eff: (and (at ?driver ?loc) (empty ?truck) (not (driving ?driver ?truck)))
  - drive-truck: ?truck - object ?loc-from - object ?loc-to - object ?driver - object
      pre: (and (at ?truck ?loc-from) (driver ?driver) (driving ?driver ?truck) (link ?loc-from ?loc-to) (location ?loc-from) (location ?loc-to) (truck ?truck))
      eff: (and (at ?truck ?loc-to) (not (at ?truck ?loc-from)))
  + drive-truck: ?truck - object ?loc-from - object ?loc-to - object ?driver - object
      pre: (and (at ?truck ?loc-from) (driver ?driver) (driving ?driver ?truck) (link ?loc-from ?loc-to) (location ?loc-from) (location ?loc-to) (not (= ?truck ?driver)) (truck ?truck))
      eff: (and (at ?truck ?loc-to) (not (at ?truck ?loc-from)))
  - unload-truck: ?obj - object ?truck - object ?loc - object
      pre: (and (at ?truck ?loc) (in ?obj ?truck) (location ?loc) (obj ?obj) (truck ?truck))
      eff: (and (at ?obj ?loc) (not (in ?obj ?truck)))
  + unload-truck: ?obj - object ?truck - object ?loc - object
      pre: (and (at ?truck ?loc) (in ?obj ?truck) (location ?loc) (not (= ?obj ?truck)) (obj ?obj) (truck ?truck))
      eff: (and (at ?obj ?loc) (not (in ?obj ?truck)))
Pred prop:
  + (= object object): in_pre in_pre_neg
Global prop:
  + has_eq_pred
