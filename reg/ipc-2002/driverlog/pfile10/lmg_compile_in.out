Action[6]:
    load-truck: ?obj:0 ?truck:0 ?loc:0
        pre: (and (R:obj ?obj) (R:truck ?truck) (R:location ?loc) (RW:at ?obj ?loc) (RW:at ?truck ?loc))
        eff: (and (N:RW:at ?obj ?loc) (RW:in ?obj ?truck))
    unload-truck: ?obj:0 ?truck:0 ?loc:0
        pre: (and (N:R:= ?obj ?truck) (R:obj ?obj) (R:truck ?truck) (R:location ?loc) (RW:at ?truck ?loc) (RW:in ?obj ?truck))
        eff: (and (RW:at ?obj ?loc) (N:RW:in ?obj ?truck))
    board-truck: ?driver:0 ?truck:0 ?loc:0
        pre: (and (R:truck ?truck) (R:location ?loc) (R:driver ?driver) (RW:at ?driver ?loc) (RW:at ?truck ?loc) (RW:empty ?truck))
        eff: (and (N:RW:at ?driver ?loc) (RW:driving ?driver ?truck) (N:RW:empty ?truck))
    disembark-truck: ?driver:0 ?truck:0 ?loc:0
        pre: (and (N:R:= ?driver ?truck) (R:truck ?truck) (R:location ?loc) (R:driver ?driver) (RW:at ?truck ?loc) (RW:driving ?driver ?truck))
        eff: (and (RW:at ?driver ?loc) (N:RW:driving ?driver ?truck) (RW:empty ?truck))
    drive-truck: ?truck:0 ?loc-from:0 ?loc-to:0 ?driver:0
        pre: (and (N:R:= ?truck ?driver) (R:truck ?truck) (R:location ?loc-from) (R:location ?loc-to) (R:driver ?driver) (R:link ?loc-from ?loc-to) (RW:at ?truck ?loc-from) (RW:driving ?driver ?truck))
        eff: (and (N:RW:at ?truck ?loc-from) (RW:at ?truck ?loc-to))
    walk: ?driver:0 ?loc-from:0 ?loc-to:0
        pre: (and (R:location ?loc-from) (R:location ?loc-to) (R:driver ?driver) (R:path ?loc-from ?loc-to) (RW:at ?driver ?loc-from))
        eff: (and (N:RW:at ?driver ?loc-from) (RW:at ?driver ?loc-to))
