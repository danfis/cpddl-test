Predicate:
  (= object object) :eq
  (above count count)
  (boarded passenger elevator)
  (can-hold elevator count)
  (lift-at elevator count)
  (next count count)
  (passenger-at passenger count)
  (passengers elevator count)
  (reachable-floor elevator count)
Function:
  (total-cost) :total-cost
  (travel-fast count count)
  (travel-slow count count)
Action:
  board: ?p - passenger ?lift - elevator ?f - count ?n1 - count ?n2 - count
      pre: (and (can-hold ?lift ?n2) (lift-at ?lift ?f) (next ?n1 ?n2) (passenger-at ?p ?f) (passengers ?lift ?n1))
      eff: (and (boarded ?p ?lift) (not (passenger-at ?p ?f)) (not (passengers ?lift ?n1)) (passengers ?lift ?n2))
  leave: ?p - passenger ?lift - elevator ?f - count ?n1 - count ?n2 - count
      pre: (and (boarded ?p ?lift) (lift-at ?lift ?f) (next ?n2 ?n1) (passengers ?lift ?n1))
      eff: (and (not (boarded ?p ?lift)) (not (passengers ?lift ?n1)) (passenger-at ?p ?f) (passengers ?lift ?n2))
  move-down-fast: ?lift - fast-elevator ?f1 - count ?f2 - count
      pre: (and (above ?f2 ?f1) (lift-at ?lift ?f1) (reachable-floor ?lift ?f2))
      eff: (and (increase (total-cost) (travel-fast ?f2 ?f1)) (lift-at ?lift ?f2) (not (lift-at ?lift ?f1)))
  move-down-slow: ?lift - slow-elevator ?f1 - count ?f2 - count
      pre: (and (above ?f2 ?f1) (lift-at ?lift ?f1) (reachable-floor ?lift ?f2))
      eff: (and (increase (total-cost) (travel-slow ?f2 ?f1)) (lift-at ?lift ?f2) (not (lift-at ?lift ?f1)))
  move-up-fast: ?lift - fast-elevator ?f1 - count ?f2 - count
      pre: (and (above ?f1 ?f2) (lift-at ?lift ?f1) (reachable-floor ?lift ?f2))
      eff: (and (increase (total-cost) (travel-fast ?f1 ?f2)) (lift-at ?lift ?f2) (not (lift-at ?lift ?f1)))
  move-up-slow: ?lift - slow-elevator ?f1 - count ?f2 - count
      pre: (and (above ?f1 ?f2) (lift-at ?lift ?f1) (reachable-floor ?lift ?f2))
      eff: (and (increase (total-cost) (travel-slow ?f1 ?f2)) (lift-at ?lift ?f2) (not (lift-at ?lift ?f1)))
