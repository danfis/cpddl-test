Require:
  + :equality
  + :negative-preconditions
Action:
  - load: ?p - package ?t - truck ?l - location
      pre: (and (at ?p ?l) (at ?t ?l))
      eff: (and (in ?p ?t) (increase (total-cost) 1) (not (at ?p ?l)))
  + load: ?p - package ?t - truck ?l - location
      pre: (and (= ?t t0) (at ?p ?l) (at t0 ?l))
      eff: (and (in ?p t0) (increase (total-cost) 1) (not (at ?p ?l)))
  + load: ?p - package ?t - truck ?l - location
      pre: (and (at ?p ?l) (at ?t ?l) (not (= ?p p0)) (not (= ?p p1)) (not (= ?p p10)) (not (= ?p p11)) (not (= ?p p2)) (not (= ?p p3)) (not (= ?p p4)) (not (= ?p p5)) (not (= ?p p6)) (not (= ?p p7)) (not (= ?p p8)) (not (= ?p p9)))
      eff: (and (in ?p ?t) (increase (total-cost) 1) (not (at ?p ?l)))
Pred prop:
  + (= object object): in_pre
