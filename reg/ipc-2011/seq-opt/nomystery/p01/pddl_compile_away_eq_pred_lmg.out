Require:
  - :equality
Predicate:
  + (equal object object)
Action:
  - load: ?p - package ?t - truck ?l - location
      pre: (and (= ?t t0) (at ?p ?l) (at t0 ?l))
      eff: (and (in ?p t0) (increase (total-cost) 1) (not (at ?p ?l)))
  - load: ?p - package ?t - truck ?l - location
      pre: (and (at ?p ?l) (at ?t ?l) (not (= ?p p0)) (not (= ?p p1)) (not (= ?p p2)))
      eff: (and (in ?p ?t) (increase (total-cost) 1) (not (at ?p ?l)))
  + load: ?p - package ?t - truck ?l - location
      pre: (and (at ?p ?l) (at ?t ?l) (not (equal ?p p0)) (not (equal ?p p1)) (not (equal ?p p2)))
      eff: (and (in ?p ?t) (increase (total-cost) 1) (not (at ?p ?l)))
  + load: ?p - package ?t - truck ?l - location
      pre: (and (at ?p ?l) (at t0 ?l) (equal ?t t0))
      eff: (and (in ?p t0) (increase (total-cost) 1) (not (at ?p ?l)))
Init:
  + (equal p0 p0)
  + (equal p1 p1)
  + (equal p2 p2)
  + (equal t0 t0)
Pred prop:
  - (= object object): in_pre
  + (equal object object): in_init in_pre
