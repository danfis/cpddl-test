Domain: openstacks-sequencedstrips-nonadl-nonnegated
Problem: os-sequencedstrips-p10_1
Require:
  :action-costs
  :conditional-effects
  :disjunctive-preconditions
  :equality
  :existential-preconditions
  :negative-preconditions
  :strips
  :typing
  :universal-preconditions
Type:
  count - object
  object
  order - object
  product - object
Obj:
  n0 - count
  n1 - count
  n10 - count
  n2 - count
  n3 - count
  n4 - count
  n5 - count
  n6 - count
  n7 - count
  n8 - count
  n9 - count
  o1 - order :constant
  o10 - order :constant
  o2 - order :constant
  o3 - order :constant
  o4 - order :constant
  o5 - order :constant
  o6 - order :constant
  o7 - order :constant
  o8 - order :constant
  o9 - order :constant
  p1 - product :constant
  p10 - product :constant
  p2 - product :constant
  p3 - product :constant
  p4 - product :constant
  p5 - product :constant
  p6 - product :constant
  p7 - product :constant
  p8 - product :constant
  p9 - product :constant
Predicate:
  (= object object) :eq
  (includes order product)
  (made product)
  (next-count count count)
  (not-made product)
  (shipped order)
  (stacks-avail count)
  (started order)
  (waiting order)
Function:
  (total-cost) :total-cost
Action:
  make-product-p10:
      pre: (and (not-made p10) (started o1) (started o2))
      eff: (and (made p10) (not (not-made p10)))
  make-product-p1:
      pre: (and (not-made p1) (started o3) (started o9))
      eff: (and (made p1) (not (not-made p1)))
  make-product-p2:
      pre: (and (not-made p2) (started o2))
      eff: (and (made p2) (not (not-made p2)))
  make-product-p3:
      pre: (and (not-made p3) (started o5) (started o8))
      eff: (and (made p3) (not (not-made p3)))
  make-product-p4:
      pre: (and (not-made p4) (started o4))
      eff: (and (made p4) (not (not-made p4)))
  make-product-p5:
      pre: (and (not-made p5) (started o6) (started o7))
      eff: (and (made p5) (not (not-made p5)))
  make-product-p6:
      pre: (and (not-made p6) (started o1))
      eff: (and (made p6) (not (not-made p6)))
  make-product-p7:
      pre: (and (not-made p7) (started o3))
      eff: (and (made p7) (not (not-made p7)))
  make-product-p8:
      pre: (and (not-made p8) (started o3))
      eff: (and (made p8) (not (not-made p8)))
  make-product-p9:
      pre: (and (not-made p9) (started o1) (started o10))
      eff: (and (made p9) (not (not-made p9)))
  open-new-stack: ?open - count ?new-open - count
      pre: (and (next-count ?open ?new-open) (stacks-avail ?open))
      eff: (and (increase (total-cost) 1) (not (stacks-avail ?open)) (stacks-avail ?new-open))
  ship-order-o10: ?avail - count ?new-avail - count
      pre: (and (made p9) (next-count ?avail ?new-avail) (stacks-avail ?avail) (started o10))
      eff: (and (not (stacks-avail ?avail)) (not (started o10)) (shipped o10) (stacks-avail ?new-avail))
  ship-order-o1: ?avail - count ?new-avail - count
      pre: (and (made p10) (made p6) (made p9) (next-count ?avail ?new-avail) (stacks-avail ?avail) (started o1))
      eff: (and (not (stacks-avail ?avail)) (not (started o1)) (shipped o1) (stacks-avail ?new-avail))
  ship-order-o2: ?avail - count ?new-avail - count
      pre: (and (made p10) (made p2) (next-count ?avail ?new-avail) (stacks-avail ?avail) (started o2))
      eff: (and (not (stacks-avail ?avail)) (not (started o2)) (shipped o2) (stacks-avail ?new-avail))
  ship-order-o3: ?avail - count ?new-avail - count
      pre: (and (made p1) (made p7) (made p8) (next-count ?avail ?new-avail) (stacks-avail ?avail) (started o3))
      eff: (and (not (stacks-avail ?avail)) (not (started o3)) (shipped o3) (stacks-avail ?new-avail))
  ship-order-o4: ?avail - count ?new-avail - count
      pre: (and (made p4) (next-count ?avail ?new-avail) (stacks-avail ?avail) (started o4))
      eff: (and (not (stacks-avail ?avail)) (not (started o4)) (shipped o4) (stacks-avail ?new-avail))
  ship-order-o5: ?avail - count ?new-avail - count
      pre: (and (made p3) (next-count ?avail ?new-avail) (stacks-avail ?avail) (started o5))
      eff: (and (not (stacks-avail ?avail)) (not (started o5)) (shipped o5) (stacks-avail ?new-avail))
  ship-order-o6: ?avail - count ?new-avail - count
      pre: (and (made p5) (next-count ?avail ?new-avail) (stacks-avail ?avail) (started o6))
      eff: (and (not (stacks-avail ?avail)) (not (started o6)) (shipped o6) (stacks-avail ?new-avail))
  ship-order-o7: ?avail - count ?new-avail - count
      pre: (and (made p5) (next-count ?avail ?new-avail) (stacks-avail ?avail) (started o7))
      eff: (and (not (stacks-avail ?avail)) (not (started o7)) (shipped o7) (stacks-avail ?new-avail))
  ship-order-o8: ?avail - count ?new-avail - count
      pre: (and (made p3) (next-count ?avail ?new-avail) (stacks-avail ?avail) (started o8))
      eff: (and (not (stacks-avail ?avail)) (not (started o8)) (shipped o8) (stacks-avail ?new-avail))
  ship-order-o9: ?avail - count ?new-avail - count
      pre: (and (made p1) (next-count ?avail ?new-avail) (stacks-avail ?avail) (started o9))
      eff: (and (not (stacks-avail ?avail)) (not (started o9)) (shipped o9) (stacks-avail ?new-avail))
  start-order: ?o - order ?avail - count ?new-avail - count
      pre: (and (next-count ?new-avail ?avail) (stacks-avail ?avail) (waiting ?o))
      eff: (and (not (stacks-avail ?avail)) (not (waiting ?o)) (stacks-avail ?new-avail) (started ?o))
Init:
  (= (total-cost) 0)
  (includes o1 p10)
  (includes o1 p6)
  (includes o1 p9)
  (includes o10 p9)
  (includes o2 p10)
  (includes o2 p2)
  (includes o3 p1)
  (includes o3 p7)
  (includes o3 p8)
  (includes o4 p4)
  (includes o5 p3)
  (includes o6 p5)
  (includes o7 p5)
  (includes o8 p3)
  (includes o9 p1)
  (next-count n0 n1)
  (next-count n1 n2)
  (next-count n2 n3)
  (next-count n3 n4)
  (next-count n4 n5)
  (next-count n5 n6)
  (next-count n6 n7)
  (next-count n7 n8)
  (next-count n8 n9)
  (next-count n9 n10)
  (not-made p1)
  (not-made p10)
  (not-made p2)
  (not-made p3)
  (not-made p4)
  (not-made p5)
  (not-made p6)
  (not-made p7)
