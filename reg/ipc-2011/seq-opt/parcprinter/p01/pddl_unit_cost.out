    uc1-invertfromime-letter: ?sheet:7 ?face:3 ?otherface:3
        pre: (and (R:sheetsize ?sheet letter) (R:oppositeside ?face ?otherface) (RW:location ?sheet uime_exit-uc1_entryfromime) (RW:sideup ?sheet ?face) (RW:available uc1-rsrc))
