        pre: (and (RW:uninitialized))
        eff: (and (RW:available fe1-rsrc) (RW:available hw1-rsrc) (RW:available uc1-rsrc) (RW:available uime-rsrc) (RW:available lc1-rsrc) (RW:available lime-rsrc) (RW:available sys-rsrc) (N:RW:uninitialized))
    fe1-feedmsi-letter: ?sheet:7
        pre: (and (R:sheetsize ?sheet letter) (RW:location ?sheet some_feeder_tray) (RW:available fe1-rsrc))
        eff: (and (N:RW:location ?sheet some_feeder_tray) (RW:location ?sheet fe1_exit-hw1_leftentry) (RW:sideup ?sheet back) (RW:available fe1-rsrc))
