        pre: (and (R:sheetsize ?sheet letter) (RW:location ?sheet hw1_toprightentry-uc1_exit) (RW:available hw1-rsrc))
        eff: (and (RW:location ?sheet hw1_rightexit-sys_entry) (N:RW:location ?sheet hw1_toprightentry-uc1_exit) (RW:available hw1-rsrc))
    hw1-bottomrightentrytorightexit-letter: ?sheet:7
