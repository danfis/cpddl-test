    uime-simplex-letter: ?sheet:7 ?face:3 ?image:5
        pre: (and (R:sheetsize ?sheet letter) (R:imagecolor ?image black) (RW:location ?sheet uc1_exittoime-uime_entry) (RW:sideup ?sheet ?face) (RW:notprintedwith ?sheet ?face black) (RW:available uime-rsrc))
        eff: (and (N:RW:location ?sheet uc1_exittoime-uime_entry) (RW:location ?sheet uime_exit-uc1_entryfromime) (W:hasimage ?sheet ?face ?image) (N:RW:notprintedwith ?sheet ?face black) (RW:available uime-rsrc))
    lc1-toime-letter: ?sheet:7
        pre: (and (R:sheetsize ?sheet letter) (RW:location ?sheet lc1_entry-hw1_bottomleftexit) (RW:available lc1-rsrc))
        eff: (and (N:RW:location ?sheet lc1_entry-hw1_bottomleftexit) (RW:location ?sheet lime_entry-lc1_exittoime) (RW:available lc1-rsrc))
