        pre: (and (R:sheetsize ?sheet letter) (RW:location ?sheet uc1_entry-hw1_topleftexit) (RW:available uc1-rsrc))
        eff: (and (N:RW:location ?sheet uc1_entry-hw1_topleftexit) (RW:location ?sheet uc1_exittoime-uime_entry) (RW:available uc1-rsrc))
    uc1-inverttoime-letter: ?sheet:7 ?face:3 ?otherface:3
        pre: (and (R:sheetsize ?sheet letter) (R:oppositeside ?face ?otherface) (RW:location ?sheet uc1_entry-hw1_topleftexit) (RW:sideup ?sheet ?face) (RW:available uc1-rsrc))
        eff: (and (N:RW:location ?sheet uc1_entry-hw1_topleftexit) (RW:location ?sheet uc1_exittoime-uime_entry) (N:RW:sideup ?sheet ?face) (RW:sideup ?sheet ?otherface) (RW:available uc1-rsrc))
    uc1-fromime-letter: ?sheet:7
