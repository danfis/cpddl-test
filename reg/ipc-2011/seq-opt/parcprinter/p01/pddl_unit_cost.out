    lc1-invertfromime-letter: ?sheet:7 ?face:3 ?otherface:3
        pre: (and (R:sheetsize ?sheet letter) (R:oppositeside ?face ?otherface) (RW:location ?sheet lc1_entryfromime-lime_exit) (RW:sideup ?sheet ?face) (RW:available lc1-rsrc))
        eff: (and (RW:location ?sheet lc1_exit-hw1_bottomrightentry) (N:RW:location ?sheet lc1_entryfromime-lime_exit) (N:RW:sideup ?sheet ?face) (RW:sideup ?sheet ?otherface) (RW:available lc1-rsrc))
    lime-simplex-letter: ?sheet:7 ?face:3 ?image:5
        pre: (and (R:sheetsize ?sheet letter) (R:imagecolor ?image color) (RW:location ?sheet lime_entry-lc1_exittoime) (RW:sideup ?sheet ?face) (RW:notprintedwith ?sheet ?face color) (RW:available lime-rsrc))
        eff: (and (N:RW:location ?sheet lime_entry-lc1_exittoime) (RW:location ?sheet lc1_entryfromime-lime_exit) (W:hasimage ?sheet ?face ?image) (N:RW:notprintedwith ?sheet ?face color) (RW:available lime-rsrc))
    lime-simplexmono-letter: ?sheet:7 ?face:3 ?image:5
        pre: (and (R:sheetsize ?sheet letter) (R:imagecolor ?image black) (RW:location ?sheet lime_entry-lc1_exittoime) (RW:sideup ?sheet ?face) (RW:notprintedwith ?sheet ?face black) (RW:available lime-rsrc))
        eff: (and (N:RW:location ?sheet lime_entry-lc1_exittoime) (RW:location ?sheet lc1_entryfromime-lime_exit) (W:hasimage ?sheet ?face ?image) (N:RW:notprintedwith ?sheet ?face black) (RW:available lime-rsrc))
    sys-stack-letter: ?sheet:7 ?prevsheet:7
        pre: (and (R:sheetsize ?sheet letter) (R:prevsheet ?sheet ?prevsheet) (RW:location ?sheet hw1_rightexit-sys_entry) (RW:location ?prevsheet some_finisher_tray) (RW:available sys-rsrc))
        eff: (and (RW:location ?sheet some_finisher_tray) (N:RW:location ?sheet hw1_rightexit-sys_entry) (W:stackedin ?sheet sys_outputtray) (RW:available sys-rsrc))
Init[20]:
  S:(sheetsize sheet1 letter)
  S:(sheetsize sheet2 letter)
  S:(imagecolor image-1 color)
  S:(imagecolor image-2 black)
  S:(oppositeside front back)
  S:(oppositeside back front)
  S:(prevsheet sheet1 dummy-sheet)
  S:(prevsheet sheet2 sheet1)
  (location dummy-sheet some_finisher_tray)
  (location sheet1 some_feeder_tray)
  (location sheet2 some_feeder_tray)
  (notprintedwith sheet1 front black)
  (notprintedwith sheet1 front color)
  (notprintedwith sheet1 back black)
  (notprintedwith sheet1 back color)
  (notprintedwith sheet2 front black)
  (notprintedwith sheet2 front color)
  (notprintedwith sheet2 back black)
  (notprintedwith sheet2 back color)
  (uninitialized)
