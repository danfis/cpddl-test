    drop: ?v:4 ?l:1 ?p:5 ?s1:6 ?s2:6
        pre: (and (R:capacity-predecessor ?s1 ?s2) (RW:at ?v ?l) (RW:in ?p ?v) (RW:capacity ?v ?s1))
