    total-cost: :: is-private: 0, owner-param: -1, read: 0, write: 1
Action[7]:
    change-color: ?r:1 ?c:3 ?c2:3
        pre: (and (R:available-color ?c2) (RW:robot-has ?r ?c))
        eff: (and (N:RW:robot-has ?r ?c) (RW:robot-has ?r ?c2))
    paint-up: ?r:1 ?y:2 ?x:2 ?c:3
        pre: (and (R:up ?y ?x) (RW:robot-at ?r ?x) (RW:clear ?y) (RW:robot-has ?r ?c))
        eff: (and (N:RW:clear ?y) (W:painted ?y ?c))
    paint-down: ?r:1 ?y:2 ?x:2 ?c:3
        pre: (and (R:down ?y ?x) (RW:robot-at ?r ?x) (RW:clear ?y) (RW:robot-has ?r ?c))
        eff: (and (N:RW:clear ?y) (W:painted ?y ?c))
    up: ?r:1 ?x:2 ?y:2
        pre: (and (R:up ?y ?x) (RW:robot-at ?r ?x) (RW:clear ?y))
        eff: (and (N:RW:robot-at ?r ?x) (RW:robot-at ?r ?y) (RW:clear ?x) (N:RW:clear ?y))
    down: ?r:1 ?x:2 ?y:2
        pre: (and (R:down ?y ?x) (RW:robot-at ?r ?x) (RW:clear ?y))
        eff: (and (N:RW:robot-at ?r ?x) (RW:robot-at ?r ?y) (RW:clear ?x) (N:RW:clear ?y))
    right: ?r:1 ?x:2 ?y:2
        pre: (and (R:right ?y ?x) (RW:robot-at ?r ?x) (RW:clear ?y))
        eff: (and (N:RW:robot-at ?r ?x) (RW:robot-at ?r ?y) (RW:clear ?x) (N:RW:clear ?y))
    left: ?r:1 ?x:2 ?y:2
        pre: (and (R:left ?y ?x) (RW:robot-at ?r ?x) (RW:clear ?y))
        eff: (and (N:RW:robot-at ?r ?x) (RW:robot-at ?r ?y) (RW:clear ?x) (N:RW:clear ?y))
