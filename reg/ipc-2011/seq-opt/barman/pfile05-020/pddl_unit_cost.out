Predicate:
  (= object object) :eq
  (clean container)
  (cocktail-part1 cocktail ingredient)
  (cocktail-part2 cocktail ingredient)
  (contains container beverage)
  (dispenses dispenser ingredient)
  (empty container)
  (handempty hand)
  (holding hand container)
  (next level level)
  (ontable container)
  (shaked shaker)
  (shaker-empty-level shaker level)
  (shaker-level shaker level)
  (unshaked shaker)
  (used container beverage)
Function:
Action:
  clean-shaker: ?h1 - hand ?h2 - hand ?s - shaker
      pre: (and (empty ?s) (handempty ?h2) (holding ?h1 ?s))
      eff: (and (clean ?s))
  clean-shot: ?s - shot ?b - beverage ?h1 - hand ?h2 - hand
      pre: (and (empty ?s) (handempty ?h2) (holding ?h1 ?s) (used ?s ?b))
      eff: (and (clean ?s) (not (used ?s ?b)))
  empty-shaker: ?h - hand ?s - shaker ?b - cocktail ?l - level ?l1 - level
      pre: (and (contains ?s ?b) (holding ?h ?s) (shaked ?s) (shaker-empty-level ?s ?l1) (shaker-level ?s ?l))
      eff: (and (empty ?s) (not (contains ?s ?b)) (not (shaked ?s)) (not (shaker-level ?s ?l)) (shaker-level ?s ?l1))
  empty-shot: ?h - hand ?p - shot ?b - beverage
      pre: (and (contains ?p ?b) (holding ?h ?p))
      eff: (and (empty ?p) (not (contains ?p ?b)))
  fill-shot: ?s - shot ?i - ingredient ?h1 - hand ?h2 - hand ?d - dispenser
      pre: (and (clean ?s) (dispenses ?d ?i) (empty ?s) (handempty ?h2) (holding ?h1 ?s))
      eff: (and (contains ?s ?i) (not (clean ?s)) (not (empty ?s)) (used ?s ?i))
  grasp: ?h - hand ?c - container
      pre: (and (handempty ?h) (ontable ?c))
      eff: (and (holding ?h ?c) (not (handempty ?h)) (not (ontable ?c)))
  leave: ?h - hand ?c - container
      pre: (and (holding ?h ?c))
      eff: (and (handempty ?h) (not (holding ?h ?c)) (ontable ?c))
  pour-shaker-to-shot: ?b - beverage ?d - shot ?h - hand ?s - shaker ?l - level ?l1 - level
      pre: (and (clean ?d) (contains ?s ?b) (empty ?d) (holding ?h ?s) (next ?l1 ?l) (shaked ?s) (shaker-level ?s ?l))
      eff: (and (contains ?d ?b) (not (clean ?d)) (not (empty ?d)) (not (shaker-level ?s ?l)) (shaker-level ?s ?l1))
  pour-shot-to-clean-shaker: ?s - shot ?i - ingredient ?d - shaker ?h1 - hand ?l - level ?l1 - level
      pre: (and (clean ?d) (contains ?s ?i) (empty ?d) (holding ?h1 ?s) (next ?l ?l1) (shaker-level ?d ?l))
      eff: (and (contains ?d ?i) (empty ?s) (not (clean ?d)) (not (contains ?s ?i)) (not (empty ?d)) (not (shaker-level ?d ?l)) (shaker-level ?d ?l1) (unshaked ?d))
  pour-shot-to-used-shaker: ?s - shot ?i - ingredient ?d - shaker ?h1 - hand ?l - level ?l1 - level
      pre: (and (contains ?s ?i) (holding ?h1 ?s) (next ?l ?l1) (shaker-level ?d ?l) (unshaked ?d))
      eff: (and (contains ?d ?i) (empty ?s) (not (contains ?s ?i)) (not (shaker-level ?d ?l)) (shaker-level ?d ?l1))
  refill-shot: ?s - shot ?i - ingredient ?h1 - hand ?h2 - hand ?d - dispenser
      pre: (and (dispenses ?d ?i) (empty ?s) (handempty ?h2) (holding ?h1 ?s) (used ?s ?i))
      eff: (and (contains ?s ?i) (not (empty ?s)))
  shake: ?b - cocktail ?d1 - ingredient ?d2 - ingredient ?s - shaker ?h1 - hand ?h2 - hand
      pre: (and (cocktail-part1 ?b ?d1) (cocktail-part2 ?b ?d2) (contains ?s ?d1) (contains ?s ?d2) (handempty ?h2) (holding ?h1 ?s) (unshaked ?s))
      eff: (and (contains ?s ?b) (not (contains ?s ?d1)) (not (contains ?s ?d2)) (not (unshaked ?s)) (shaked ?s))
