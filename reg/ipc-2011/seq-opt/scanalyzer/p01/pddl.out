Domain: scanalyzer3d
Problem: scanalyzer3d-52
Require:
  :action-costs
  :strips
  :typing
Type:
  car - object
  object
  segment - object
Obj:
  car-in-1a - car
  car-in-1b - car
  car-out-1a - car
  car-out-1b - car
  seg-in-1a - segment
  seg-in-1b - segment
  seg-out-1a - segment
  seg-out-1b - segment
Predicate:
  (= object object) :eq
  (analyzed car)
  (cycle-4 segment segment segment segment)
  (cycle-4-with-analysis segment segment segment segment)
  (on car segment)
Function:
  (total-cost) :total-cost
Action:
  analyze-4: ?s1 - segment ?s2 - segment ?s3 - segment ?s4 - segment ?c1 - car ?c2 - car ?c3 - car ?c4 - car
      pre: (and (cycle-4-with-analysis ?s1 ?s2 ?s3 ?s4) (on ?c1 ?s1) (on ?c2 ?s2) (on ?c3 ?s3) (on ?c4 ?s4))
      eff: (and (analyzed ?c1) (increase (total-cost) 3) (not (on ?c1 ?s1)) (not (on ?c2 ?s2)) (not (on ?c3 ?s3)) (not (on ?c4 ?s4)) (on ?c1 ?s4) (on ?c2 ?s1) (on ?c3 ?s2) (on ?c4 ?s3))
  rotate-4: ?s1 - segment ?s2 - segment ?s3 - segment ?s4 - segment ?c1 - car ?c2 - car ?c3 - car ?c4 - car
      pre: (and (cycle-4 ?s1 ?s2 ?s3 ?s4) (on ?c1 ?s1) (on ?c2 ?s2) (on ?c3 ?s3) (on ?c4 ?s4))
      eff: (and (increase (total-cost) 1) (not (on ?c1 ?s1)) (not (on ?c2 ?s2)) (not (on ?c3 ?s3)) (not (on ?c4 ?s4)) (on ?c1 ?s4) (on ?c2 ?s1) (on ?c3 ?s2) (on ?c4 ?s3))
Init:
  (= (total-cost) 0)
  (cycle-4 seg-in-1a seg-in-1b seg-out-1a seg-out-1b)
  (cycle-4-with-analysis seg-in-1a seg-in-1b seg-out-1a seg-out-1b)
  (on car-in-1a seg-in-1a)
  (on car-in-1b seg-in-1b)
  (on car-out-1a seg-out-1a)
  (on car-out-1b seg-out-1b)
Goal:
  (and (analyzed car-in-1a) (analyzed car-in-1b) (analyzed car-out-1a) (analyzed car-out-1b) (on car-in-1a seg-out-1b) (on car-in-1b seg-in-1a) (on car-out-1a seg-in-1b) (on car-out-1b seg-out-1a))
Metric:
  (total-cost)
Pred prop:
  (analyzed car): in_goal in_eff
  (cycle-4 segment segment segment segment): in_init in_pre
  (cycle-4-with-analysis segment segment segment segment): in_init in_pre
  (on car segment): in_init in_pre in_goal in_eff
Func prop:
  (total-cost): in_init init_all_nonneg init_all_nonpos init_all_int in_metric is_metric_alone in_eff write_delta_nonneg write_delta_nonneg_int
Global prop:
  action_cost_func:(total-cost)
  has_int_action_cost_func
