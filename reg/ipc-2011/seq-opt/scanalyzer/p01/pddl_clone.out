    [7]: seg-out-1b, type: 1, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
Predicate[7]:
    =: 0 0 :: read: 0, write: 0, in-init: 0
    on: 2 1 :: read: 1, write: 1, in-init: 1
    analyzed: 2 :: read: 0, write: 1, in-init: 0
    cycle-2: 1 1 :: read: 0, write: 0, in-init: 0
    cycle-4: 1 1 1 1 :: read: 1, write: 0, in-init: 1
    cycle-2-with-analysis: 1 1 :: read: 0, write: 0, in-init: 0
