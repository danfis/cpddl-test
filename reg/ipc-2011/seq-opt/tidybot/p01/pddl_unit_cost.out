Domain: tidybot
Problem: test
Require:
  :conditional-effects
  :equality
  :negative-preconditions
  :strips
  :typing
Type:
  cart - object
  object
  robot - object
  xc - object
  xrel - object
  yc - object
  yrel - object
Obj:
  cart - cart
  object0 - object
  object1 - object
  object2 - object
  object3 - object
  pr2 - robot
  x0 - xc
  x1 - xc
  x2 - xc
  x3 - xc
  x4 - xc
  xrel-1 - xrel
  xrel0 - xrel
  xrel1 - xrel
  y0 - yc
  y1 - yc
  y2 - yc
  y3 - yc
  y4 - yc
  yrel-1 - yrel
  yrel0 - yrel
  yrel1 - yrel
Predicate:
  (= object object) :eq
  (NOT-base-obstacle xc yc)
  (NOT-gripper-obstacle xc yc)
  (NOT-object-done object) neg-of (object-done)
  (NOT-parked robot) neg-of (parked)
  (above yc yc)
  (above-rel yrel yrel)
  (base-pos robot xc yc)
  (cart-pos cart xc yc)
  (gripper-empty robot)
  (gripper-rel robot xrel yrel)
  (holding robot object)
  (leftof xc xc)
  (leftof-rel xrel xrel)
  (not-pushed cart)
  (not-pushing robot)
  (object-done object) neg-of (NOT-object-done)
  (object-goal object xc yc)
  (object-pos object xc yc)
  (on-cart object cart)
  (parked robot) neg-of (NOT-parked)
  (pushing robot cart)
  (sum-x xc xrel xc)
  (sum-y yc yrel yc)
  (surface xc yc)
  (zerox-rel xrel)
  (zeroy-rel yrel)
Function:
Action:
  base-cart-down: ?r - robot ?c - cart ?x - xc ?y1 - yc ?y2 - yc ?cx - xc ?cy1 - yc ?cy2 - yc
      pre: (and (NOT-base-obstacle ?cx ?cy2) (NOT-base-obstacle ?x ?y2) (above ?cy1 ?cy2) (above ?y1 ?y2) (base-pos ?r ?x ?y1) (cart-pos ?c ?cx ?cy1) (pushing ?r ?c))
      eff: (and (base-pos ?r ?x ?y2) (cart-pos ?c ?cx ?cy2) (not (NOT-base-obstacle ?cx ?cy2)) (not (NOT-base-obstacle ?x ?y2)) (not (base-pos ?r ?x ?y1)) (not (cart-pos ?c ?cx ?cy1)) (when (and (not (= ?x ?cx)) (not (= ?y1 ?y2))) (NOT-base-obstacle ?x ?y1)) (when (and (not (= ?y1 ?cy2)) (not (= ?y1 ?y2))) (NOT-base-obstacle ?x ?y1)))
  base-cart-left: ?r - robot ?c - cart ?x1 - xc ?x2 - xc ?y - yc ?cx1 - xc ?cx2 - xc ?cy - yc
      pre: (and (NOT-base-obstacle ?cx2 ?cy) (NOT-base-obstacle ?x2 ?y) (base-pos ?r ?x1 ?y) (cart-pos ?c ?cx1 ?cy) (leftof ?cx2 ?cx1) (leftof ?x2 ?x1) (pushing ?r ?c))
      eff: (and (base-pos ?r ?x2 ?y) (cart-pos ?c ?cx2 ?cy) (not (NOT-base-obstacle ?cx2 ?cy)) (not (NOT-base-obstacle ?x2 ?y)) (not (base-pos ?r ?x1 ?y)) (not (cart-pos ?c ?cx1 ?cy)) (when (and (not (= ?cx1 ?cx2)) (not (= ?x2 ?cx1))) (NOT-base-obstacle ?cx1 ?cy)) (when (and (not (= ?cx1 ?cx2)) (not (= ?y ?cy))) (NOT-base-obstacle ?cx1 ?cy)) (when (and (not (= ?x1 ?cx2)) (not (= ?x1 ?x2))) (NOT-base-obstacle ?x1 ?y)) (when (and (not (= ?x1 ?x2)) (not (= ?y ?cy))) (NOT-base-obstacle ?x1 ?y)))
  base-cart-right: ?r - robot ?c - cart ?x1 - xc ?x2 - xc ?y - yc ?cx1 - xc ?cx2 - xc ?cy - yc
      pre: (and (NOT-base-obstacle ?cx2 ?cy) (NOT-base-obstacle ?x2 ?y) (base-pos ?r ?x1 ?y) (cart-pos ?c ?cx1 ?cy) (leftof ?cx1 ?cx2) (leftof ?x1 ?x2) (pushing ?r ?c))
      eff: (and (base-pos ?r ?x2 ?y) (cart-pos ?c ?cx2 ?cy) (not (NOT-base-obstacle ?cx2 ?cy)) (not (NOT-base-obstacle ?x2 ?y)) (not (base-pos ?r ?x1 ?y)) (not (cart-pos ?c ?cx1 ?cy)) (when (and (not (= ?cx1 ?cx2)) (not (= ?x2 ?cx1))) (NOT-base-obstacle ?cx1 ?cy)) (when (and (not (= ?cx1 ?cx2)) (not (= ?y ?cy))) (NOT-base-obstacle ?cx1 ?cy)) (when (and (not (= ?x1 ?cx2)) (not (= ?x1 ?x2))) (NOT-base-obstacle ?x1 ?y)) (when (and (not (= ?x1 ?x2)) (not (= ?y ?cy))) (NOT-base-obstacle ?x1 ?y)))
  base-cart-up: ?r - robot ?c - cart ?x - xc ?y1 - yc ?y2 - yc ?cx - xc ?cy1 - yc ?cy2 - yc
      pre: (and (NOT-base-obstacle ?cx ?cy2) (NOT-base-obstacle ?x ?y2) (above ?cy2 ?cy1) (above ?y2 ?y1) (base-pos ?r ?x ?y1) (cart-pos ?c ?cx ?cy1) (pushing ?r ?c))
      eff: (and (base-pos ?r ?x ?y2) (cart-pos ?c ?cx ?cy2) (not (NOT-base-obstacle ?cx ?cy2)) (not (NOT-base-obstacle ?x ?y2)) (not (base-pos ?r ?x ?y1)) (not (cart-pos ?c ?cx ?cy1)) (when (and (not (= ?x ?cx)) (not (= ?y1 ?y2))) (NOT-base-obstacle ?x ?y1)) (when (and (not (= ?y1 ?cy2)) (not (= ?y1 ?y2))) (NOT-base-obstacle ?x ?y1)))
  base-down: ?r - robot ?x - xc ?cy - yc ?dy - yc
      pre: (and (NOT-base-obstacle ?x ?dy) (NOT-parked ?r) (above ?cy ?dy) (base-pos ?r ?x ?cy) (not-pushing ?r))
      eff: (and (base-pos ?r ?x ?dy) (not (NOT-base-obstacle ?x ?dy)) (not (base-pos ?r ?x ?cy)) (when (not (= ?cy ?dy)) (NOT-base-obstacle ?x ?cy)))
  base-left: ?r - robot ?cx - xc ?dx - xc ?y - yc
      pre: (and (NOT-base-obstacle ?dx ?y) (NOT-parked ?r) (base-pos ?r ?cx ?y) (leftof ?dx ?cx) (not-pushing ?r))
      eff: (and (base-pos ?r ?dx ?y) (not (NOT-base-obstacle ?dx ?y)) (not (base-pos ?r ?cx ?y)) (when (not (= ?cx ?dx)) (NOT-base-obstacle ?cx ?y)))
  base-right: ?r - robot ?cx - xc ?dx - xc ?y - yc
      pre: (and (NOT-base-obstacle ?dx ?y) (NOT-parked ?r) (base-pos ?r ?cx ?y) (leftof ?cx ?dx) (not-pushing ?r))
      eff: (and (base-pos ?r ?dx ?y) (not (NOT-base-obstacle ?dx ?y)) (not (base-pos ?r ?cx ?y)) (when (not (= ?cx ?dx)) (NOT-base-obstacle ?cx ?y)))
  base-up: ?r - robot ?x - xc ?cy - yc ?dy - yc
      pre: (and (NOT-base-obstacle ?x ?dy) (NOT-parked ?r) (above ?dy ?cy) (base-pos ?r ?x ?cy) (not-pushing ?r))
      eff: (and (base-pos ?r ?x ?dy) (not (NOT-base-obstacle ?x ?dy)) (not (base-pos ?r ?x ?cy)) (when (not (= ?cy ?dy)) (NOT-base-obstacle ?x ?cy)))
  finish-object: ?o - object ?x - xc ?y - yc
      pre: (and (NOT-object-done ?o) (object-goal ?o ?x ?y) (object-pos ?o ?x ?y))
      eff: (and (not (NOT-object-done ?o)) (object-done ?o))
  get-down: ?r - robot ?basex - xc ?basey - yc ?gxrel - xrel ?gxabs - xc ?gyrel - yrel ?gyabs - yc ?o - object ?oy - yc
      pre: (and (NOT-object-done ?o) (above ?gyabs ?oy) (base-pos ?r ?basex ?basey) (gripper-empty ?r) (gripper-rel ?r ?gxrel ?gyrel) (object-pos ?o ?gxabs ?oy) (parked ?r) (sum-x ?basex ?gxrel ?gxabs) (sum-y ?basey ?gyrel ?gyabs))
      eff: (and (NOT-gripper-obstacle ?gxabs ?oy) (holding ?r ?o) (not (gripper-empty ?r)) (not (object-pos ?o ?gxabs ?oy)))
  get-from-cart: ?r - robot ?x - xc ?y - yc ?gxrel - xrel ?gyrel - yrel ?o - object ?c - cart ?cx - xc ?cy - yc
      pre: (and (base-pos ?r ?x ?y) (cart-pos ?c ?cx ?cy) (gripper-empty ?r) (gripper-rel ?r ?gxrel ?gyrel) (on-cart ?o ?c) (parked ?r) (sum-x ?x ?gxrel ?cx) (sum-y ?y ?gyrel ?cy))
      eff: (and (holding ?r ?o) (not (gripper-empty ?r)) (not (on-cart ?o ?c)))
  get-left: ?r - robot ?basex - xc ?basey - yc ?gxrel - xrel ?gxabs - xc ?gyrel - yrel ?gyabs - yc ?o - object ?ox - xc
      pre: (and (NOT-object-done ?o) (base-pos ?r ?basex ?basey) (gripper-empty ?r) (gripper-rel ?r ?gxrel ?gyrel) (leftof ?ox ?gxabs) (object-pos ?o ?ox ?gyabs) (parked ?r) (sum-x ?basex ?gxrel ?gxabs) (sum-y ?basey ?gyrel ?gyabs))
      eff: (and (NOT-gripper-obstacle ?ox ?gyabs) (holding ?r ?o) (not (gripper-empty ?r)) (not (object-pos ?o ?ox ?gyabs)))
  get-right: ?r - robot ?basex - xc ?basey - yc ?gxrel - xrel ?gxabs - xc ?gyrel - yrel ?gyabs - yc ?o - object ?ox - xc
      pre: (and (NOT-object-done ?o) (base-pos ?r ?basex ?basey) (gripper-empty ?r) (gripper-rel ?r ?gxrel ?gyrel) (leftof ?gxabs ?ox) (object-pos ?o ?ox ?gyabs) (parked ?r) (sum-x ?basex ?gxrel ?gxabs) (sum-y ?basey ?gyrel ?gyabs))
      eff: (and (NOT-gripper-obstacle ?ox ?gyabs) (holding ?r ?o) (not (gripper-empty ?r)) (not (object-pos ?o ?ox ?gyabs)))
  get-up: ?r - robot ?basex - xc ?basey - yc ?gxrel - xrel ?gxabs - xc ?gyrel - yrel ?gyabs - yc ?o - object ?oy - yc
      pre: (and (NOT-object-done ?o) (above ?oy ?gyabs) (base-pos ?r ?basex ?basey) (gripper-empty ?r) (gripper-rel ?r ?gxrel ?gyrel) (object-pos ?o ?gxabs ?oy) (parked ?r) (sum-x ?basex ?gxrel ?gxabs) (sum-y ?basey ?gyrel ?gyabs))
      eff: (and (NOT-gripper-obstacle ?gxabs ?oy) (holding ?r ?o) (not (gripper-empty ?r)) (not (object-pos ?o ?gxabs ?oy)))
  grasp-cart-above: ?r - robot ?c - cart ?x - xc ?y - yc ?cy - yc
      pre: (and (NOT-parked ?r) (above ?cy ?y) (base-pos ?r ?x ?y) (cart-pos ?c ?x ?cy) (not-pushed ?c) (not-pushing ?r))
      eff: (and (not (not-pushed ?c)) (not (not-pushing ?r)) (pushing ?r ?c))
  grasp-cart-below: ?r - robot ?c - cart ?x - xc ?y - yc ?cy - yc
      pre: (and (NOT-parked ?r) (above ?y ?cy) (base-pos ?r ?x ?y) (cart-pos ?c ?x ?cy) (not-pushed ?c) (not-pushing ?r))
      eff: (and (not (not-pushed ?c)) (not (not-pushing ?r)) (pushing ?r ?c))
  grasp-cart-left: ?r - robot ?c - cart ?x - xc ?y - yc ?cx - xc
      pre: (and (NOT-parked ?r) (base-pos ?r ?x ?y) (cart-pos ?c ?cx ?y) (leftof ?cx ?x) (not-pushed ?c) (not-pushing ?r))
      eff: (and (not (not-pushed ?c)) (not (not-pushing ?r)) (pushing ?r ?c))
  grasp-cart-right: ?r - robot ?c - cart ?x - xc ?y - yc ?cx - xc
      pre: (and (NOT-parked ?r) (base-pos ?r ?x ?y) (cart-pos ?c ?cx ?y) (leftof ?x ?cx) (not-pushed ?c) (not-pushing ?r))
      eff: (and (not (not-pushed ?c)) (not (not-pushing ?r)) (pushing ?r ?c))
  gripper-down: ?r - robot ?basex - xc ?basey - yc ?gxrel - xrel ?gxabs - xc ?cgyrel - yrel ?dgyrel - yrel ?cgyabs - yc ?dgyabs - yc
      pre: (and (NOT-gripper-obstacle ?gxabs ?dgyabs) (above-rel ?cgyrel ?dgyrel) (base-pos ?r ?basex ?basey) (gripper-rel ?r ?gxrel ?cgyrel) (parked ?r) (sum-x ?basex ?gxrel ?gxabs) (sum-y ?basey ?cgyrel ?cgyabs) (sum-y ?basey ?dgyrel ?dgyabs))
      eff: (and (gripper-rel ?r ?gxrel ?dgyrel) (not (NOT-gripper-obstacle ?gxabs ?dgyabs)) (not (gripper-rel ?r ?gxrel ?cgyrel)) (when (not (= ?cgyabs ?dgyabs)) (NOT-gripper-obstacle ?gxabs ?cgyabs)))
  gripper-left: ?r - robot ?basex - xc ?basey - yc ?cgxrel - xrel ?dgxrel - xrel ?cgxabs - xc ?dgxabs - xc ?gyrel - yrel ?gyabs - yc
      pre: (and (NOT-gripper-obstacle ?dgxabs ?gyabs) (base-pos ?r ?basex ?basey) (gripper-rel ?r ?cgxrel ?gyrel) (leftof-rel ?dgxrel ?cgxrel) (parked ?r) (sum-x ?basex ?cgxrel ?cgxabs) (sum-x ?basex ?dgxrel ?dgxabs) (sum-y ?basey ?gyrel ?gyabs))
      eff: (and (gripper-rel ?r ?dgxrel ?gyrel) (not (NOT-gripper-obstacle ?dgxabs ?gyabs)) (not (gripper-rel ?r ?cgxrel ?gyrel)) (when (not (= ?cgxabs ?dgxabs)) (NOT-gripper-obstacle ?cgxabs ?gyabs)))
  gripper-right: ?r - robot ?basex - xc ?basey - yc ?cgxrel - xrel ?dgxrel - xrel ?cgxabs - xc ?dgxabs - xc ?gyrel - yrel ?gyabs - yc
      pre: (and (NOT-gripper-obstacle ?dgxabs ?gyabs) (base-pos ?r ?basex ?basey) (gripper-rel ?r ?cgxrel ?gyrel) (leftof-rel ?cgxrel ?dgxrel) (parked ?r) (sum-x ?basex ?cgxrel ?cgxabs) (sum-x ?basex ?dgxrel ?dgxabs) (sum-y ?basey ?gyrel ?gyabs))
      eff: (and (gripper-rel ?r ?dgxrel ?gyrel) (not (NOT-gripper-obstacle ?dgxabs ?gyabs)) (not (gripper-rel ?r ?cgxrel ?gyrel)) (when (not (= ?cgxabs ?dgxabs)) (NOT-gripper-obstacle ?cgxabs ?gyabs)))
  gripper-up: ?r - robot ?basex - xc ?basey - yc ?gxrel - xrel ?gxabs - xc ?cgyrel - yrel ?dgyrel - yrel ?cgyabs - yc ?dgyabs - yc
      pre: (and (NOT-gripper-obstacle ?gxabs ?dgyabs) (above-rel ?dgyrel ?cgyrel) (base-pos ?r ?basex ?basey) (gripper-rel ?r ?gxrel ?cgyrel) (parked ?r) (sum-x ?basex ?gxrel ?gxabs) (sum-y ?basey ?cgyrel ?cgyabs) (sum-y ?basey ?dgyrel ?dgyabs))
      eff: (and (gripper-rel ?r ?gxrel ?dgyrel) (not (NOT-gripper-obstacle ?gxabs ?dgyabs)) (not (gripper-rel ?r ?gxrel ?cgyrel)) (when (not (= ?cgyabs ?dgyabs)) (NOT-gripper-obstacle ?gxabs ?cgyabs)))
  park: ?r - robot
      pre: (and (NOT-parked ?r) (not-pushing ?r))
      eff: (and (not (NOT-parked ?r)) (parked ?r))
  put-down: ?r - robot ?basex - xc ?basey - yc ?gxrel - xrel ?gxabs - xc ?gyrel - yrel ?gyabs - yc ?o - object ?oy - yc
      pre: (and (NOT-gripper-obstacle ?gxabs ?oy) (above ?gyabs ?oy) (base-pos ?r ?basex ?basey) (gripper-rel ?r ?gxrel ?gyrel) (holding ?r ?o) (parked ?r) (sum-x ?basex ?gxrel ?gxabs) (sum-y ?basey ?gyrel ?gyabs) (surface ?gxabs ?oy))
      eff: (and (gripper-empty ?r) (not (NOT-gripper-obstacle ?gxabs ?oy)) (not (holding ?r ?o)) (object-pos ?o ?gxabs ?oy))
  put-left: ?r - robot ?basex - xc ?basey - yc ?gxrel - xrel ?gxabs - xc ?gyrel - yrel ?gyabs - yc ?o - object ?ox - xc
      pre: (and (NOT-gripper-obstacle ?ox ?gyabs) (base-pos ?r ?basex ?basey) (gripper-rel ?r ?gxrel ?gyrel) (holding ?r ?o) (leftof ?ox ?gxabs) (parked ?r) (sum-x ?basex ?gxrel ?gxabs) (sum-y ?basey ?gyrel ?gyabs) (surface ?ox ?gyabs))
      eff: (and (gripper-empty ?r) (not (NOT-gripper-obstacle ?ox ?gyabs)) (not (holding ?r ?o)) (object-pos ?o ?ox ?gyabs))
