  put-right: ?r - robot ?basex - xc ?basey - yc ?gxrel - xrel ?gxabs - xc ?gyrel - yrel ?gyabs - yc ?o - object ?ox - xc
      pre: (and (NOT-gripper-obstacle ?ox ?gyabs) (base-pos ?r ?basex ?basey) (gripper-rel ?r ?gxrel ?gyrel) (holding ?r ?o) (leftof ?gxabs ?ox) (parked ?r) (sum-x ?basex ?gxrel ?gxabs) (sum-y ?basey ?gyrel ?gyabs) (surface ?ox ?gyabs))
      eff: (and (gripper-empty ?r) (not (NOT-gripper-obstacle ?ox ?gyabs)) (not (holding ?r ?o)) (object-pos ?o ?ox ?gyabs))
