      pre: (and (NOT-gripper-obstacle ?gxabs ?oy) (above ?oy ?gyabs) (base-pos ?r ?basex ?basey) (gripper-rel ?r ?gxrel ?gyrel) (holding ?r ?o) (parked ?r) (sum-x ?basex ?gxrel ?gxabs) (sum-y ?basey ?gyrel ?gyabs) (surface ?gxabs ?oy))
      eff: (and (gripper-empty ?r) (not (NOT-gripper-obstacle ?gxabs ?oy)) (not (holding ?r ?o)) (object-pos ?o ?gxabs ?oy))
  ungrasp-cart: ?r - robot ?c - cart
      pre: (and (pushing ?r ?c))
      eff: (and (not (pushing ?r ?c)) (not-pushed ?c) (not-pushing ?r))
  unpark: ?r - robot ?x - xrel ?y - yrel
      pre: (and (gripper-rel ?r ?x ?y) (parked ?r) (zerox-rel ?x) (zeroy-rel ?y))
      eff: (and (NOT-parked ?r) (not (parked ?r)))
