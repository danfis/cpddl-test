  curb_9 - curb
Predicate:
  (= object object) :eq
  (at-curb car)
  (at-curb-num car curb)
  (behind-car car car)
  (car-clear car)
  (curb-clear curb)
Function:
  (total-cost) :total-cost
Action:
  move-car-to-car: ?car - car ?carsrc - car ?cardest - car
      pre: (and (at-curb ?cardest) (behind-car ?car ?carsrc) (car-clear ?car) (car-clear ?cardest))
      eff: (and (behind-car ?car ?cardest) (car-clear ?carsrc) (increase (total-cost) 1) (not (behind-car ?car ?carsrc)) (not (car-clear ?cardest)))
  move-car-to-curb: ?car - car ?carsrc - car ?curbdest - curb
      pre: (and (behind-car ?car ?carsrc) (car-clear ?car) (curb-clear ?curbdest))
      eff: (and (at-curb ?car) (at-curb-num ?car ?curbdest) (car-clear ?carsrc) (increase (total-cost) 1) (not (behind-car ?car ?carsrc)) (not (curb-clear ?curbdest)))
  move-curb-to-car: ?car - car ?curbsrc - curb ?cardest - car
      pre: (and (at-curb ?cardest) (at-curb-num ?car ?curbsrc) (car-clear ?car) (car-clear ?cardest))
      eff: (and (behind-car ?car ?cardest) (curb-clear ?curbsrc) (increase (total-cost) 1) (not (at-curb ?car)) (not (at-curb-num ?car ?curbsrc)) (not (car-clear ?cardest)))
  move-curb-to-curb: ?car - car ?curbsrc - curb ?curbdest - curb
      pre: (and (at-curb-num ?car ?curbsrc) (car-clear ?car) (curb-clear ?curbdest))
      eff: (and (at-curb-num ?car ?curbdest) (curb-clear ?curbsrc) (increase (total-cost) 1) (not (at-curb-num ?car ?curbsrc)) (not (curb-clear ?curbdest)))
