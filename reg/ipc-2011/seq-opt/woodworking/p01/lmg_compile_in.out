        eff: (and (N:RW:unused ?p) (RW:available ?p) (RW:surface-condition ?p ?surface) (RW:treatment ?p untreated) (RW:colour ?p natural) (RW:wood ?p teak) (RW:boardsize ?b ?size_after) (increase (total-cost) 10))
