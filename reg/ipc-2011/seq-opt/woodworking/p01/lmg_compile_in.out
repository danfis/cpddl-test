Action[25]:
    do-immersion-varnish: ?x:17 ?m:12 ?newcolour:1 ?surface:5
        pre: (and (R:has-colour ?m ?newcolour) (R:is-smooth ?surface) (RW:available ?x) (RW:surface-condition ?x ?surface) (RW:treatment ?x untreated))
        eff: (and (RW:treatment ?x varnished) (N:RW:treatment ?x untreated) (N:RW:colour ?x natural) (RW:colour ?x ?newcolour) (increase (total-cost) 10))
    do-spray-varnish: ?x:17 ?m:15 ?newcolour:1 ?surface:5
        pre: (and (R:has-colour ?m ?newcolour) (R:is-smooth ?surface) (RW:available ?x) (RW:surface-condition ?x ?surface) (RW:treatment ?x untreated))
        eff: (and (RW:treatment ?x varnished) (N:RW:treatment ?x untreated) (N:RW:colour ?x natural) (RW:colour ?x ?newcolour) (increase (total-cost) (spray-varnish-cost ?x)))
    do-glaze: ?x:17 ?m:10 ?newcolour:1
        pre: (and (R:has-colour ?m ?newcolour) (RW:available ?x) (RW:treatment ?x untreated))
        eff: (and (RW:treatment ?x glazed) (N:RW:treatment ?x untreated) (N:RW:colour ?x natural) (RW:colour ?x ?newcolour) (increase (total-cost) (glaze-cost ?x)))
    do-grind: ?x:17 ?m:11 ?oldsurface:5 ?oldcolour:1 ?oldtreatment:6 ?newtreatment:6
        pre: (and (R:grind-treatment-change ?oldtreatment ?newtreatment) (R:is-smooth ?oldsurface) (RW:available ?x) (RW:surface-condition ?x ?oldsurface) (RW:treatment ?x ?oldtreatment) (RW:colour ?x ?oldcolour))
        eff: (and (RW:surface-condition ?x verysmooth) (N:RW:surface-condition ?x ?oldsurface) (N:RW:treatment ?x ?oldtreatment) (RW:treatment ?x ?newtreatment) (RW:colour ?x natural) (N:RW:colour ?x ?oldcolour) (increase (total-cost) (grind-cost ?x)))
    do-plane: ?x:17 ?m:13 ?oldsurface:5 ?oldcolour:1 ?oldtreatment:6
        pre: (and (RW:available ?x) (RW:surface-condition ?x ?oldsurface) (RW:treatment ?x ?oldtreatment) (RW:colour ?x ?oldcolour))
        eff: (and (RW:surface-condition ?x smooth) (N:RW:surface-condition ?x ?oldsurface) (RW:treatment ?x untreated) (N:RW:treatment ?x ?oldtreatment) (RW:colour ?x natural) (N:RW:colour ?x ?oldcolour) (increase (total-cost) (plane-cost ?x)))
    load-highspeed-saw: ?b:16 ?m:9
        pre: (and (RW:available ?b) (RW:empty ?m))
        eff: (and (N:RW:available ?b) (RW:in-highspeed-saw ?b ?m) (N:RW:empty ?m) (increase (total-cost) 30))
    unload-highspeed-saw: ?b:16 ?m:9
        pre: (and (RW:in-highspeed-saw ?b ?m))
        eff: (and (RW:available ?b) (N:RW:in-highspeed-saw ?b ?m) (RW:empty ?m) (increase (total-cost) 10))
