Action[13]:
    do-immersion-varnish: ?x:17 ?m:12 ?newcolour:1 ?surface:5
        pre: (and (RW:available ?x) (R:has-colour ?m ?newcolour) (RW:surface-condition ?x ?surface) (R:is-smooth ?surface) (RW:treatment ?x untreated))
        eff: (and (increase (total-cost) 10) (N:RW:treatment ?x untreated) (RW:treatment ?x varnished) (N:RW:colour ?x natural) (RW:colour ?x ?newcolour))
    do-spray-varnish: ?x:17 ?m:15 ?newcolour:1 ?surface:5
        pre: (and (RW:available ?x) (R:has-colour ?m ?newcolour) (RW:surface-condition ?x ?surface) (R:is-smooth ?surface) (RW:treatment ?x untreated))
        eff: (and (increase (total-cost) (spray-varnish-cost ?x)) (N:RW:treatment ?x untreated) (RW:treatment ?x varnished) (N:RW:colour ?x natural) (RW:colour ?x ?newcolour))
    do-glaze: ?x:17 ?m:10 ?newcolour:1
        pre: (and (RW:available ?x) (R:has-colour ?m ?newcolour) (RW:treatment ?x untreated))
        eff: (and (increase (total-cost) (glaze-cost ?x)) (N:RW:treatment ?x untreated) (RW:treatment ?x glazed) (N:RW:colour ?x natural) (RW:colour ?x ?newcolour))
    do-grind: ?x:17 ?m:11 ?oldsurface:5 ?oldcolour:1 ?oldtreatment:6 ?newtreatment:6
        pre: (and (RW:available ?x) (RW:surface-condition ?x ?oldsurface) (R:is-smooth ?oldsurface) (RW:colour ?x ?oldcolour) (RW:treatment ?x ?oldtreatment) (R:grind-treatment-change ?oldtreatment ?newtreatment))
        eff: (and (increase (total-cost) (grind-cost ?x)) (N:RW:surface-condition ?x ?oldsurface) (RW:surface-condition ?x verysmooth) (N:RW:treatment ?x ?oldtreatment) (RW:treatment ?x ?newtreatment) (N:RW:colour ?x ?oldcolour) (RW:colour ?x natural))
    do-plane: ?x:17 ?m:13 ?oldsurface:5 ?oldcolour:1 ?oldtreatment:6
        pre: (and (RW:available ?x) (RW:surface-condition ?x ?oldsurface) (RW:treatment ?x ?oldtreatment) (RW:colour ?x ?oldcolour))
        eff: (and (increase (total-cost) (plane-cost ?x)) (N:RW:surface-condition ?x ?oldsurface) (RW:surface-condition ?x smooth) (N:RW:treatment ?x ?oldtreatment) (RW:treatment ?x untreated) (N:RW:colour ?x ?oldcolour) (RW:colour ?x natural))
    load-highspeed-saw: ?b:16 ?m:9
        pre: (and (RW:empty ?m) (RW:available ?b))
        eff: (and (increase (total-cost) 30) (N:RW:available ?b) (N:RW:empty ?m) (RW:in-highspeed-saw ?b ?m))
    unload-highspeed-saw: ?b:16 ?m:9
        pre: (RW:in-highspeed-saw ?b ?m)
        eff: (and (increase (total-cost) 10) (RW:available ?b) (N:RW:in-highspeed-saw ?b ?m) (RW:empty ?m))
    cut-board-small: ?b:16 ?p:17 ?m:9 ?w:2 ?surface:5 ?size_before:7 ?size_after:7
        pre: (and (RW:unused ?p) (R:goalsize ?p small) (RW:in-highspeed-saw ?b ?m) (RW:wood ?b ?w) (RW:surface-condition ?b ?surface) (RW:boardsize ?b ?size_before) (R:boardsize-successor ?size_after ?size_before))
        eff: (and (increase (total-cost) 10) (N:RW:unused ?p) (RW:available ?p) (RW:wood ?p ?w) (RW:surface-condition ?p ?surface) (RW:colour ?p natural) (RW:treatment ?p untreated) (RW:boardsize ?b ?size_after))
    cut-board-medium: ?b:16 ?p:17 ?m:9 ?w:2 ?surface:5 ?size_before:7 ?s1:7 ?size_after:7
        pre: (and (RW:unused ?p) (R:goalsize ?p medium) (RW:in-highspeed-saw ?b ?m) (RW:wood ?b ?w) (RW:surface-condition ?b ?surface) (RW:boardsize ?b ?size_before) (R:boardsize-successor ?size_after ?s1) (R:boardsize-successor ?s1 ?size_before))
        eff: (and (increase (total-cost) 10) (N:RW:unused ?p) (RW:available ?p) (RW:wood ?p ?w) (RW:surface-condition ?p ?surface) (RW:colour ?p natural) (RW:treatment ?p untreated) (RW:boardsize ?b ?size_after))
    cut-board-large: ?b:16 ?p:17 ?m:9 ?w:2 ?surface:5 ?size_before:7 ?s1:7 ?s2:7 ?size_after:7
        pre: (and (RW:unused ?p) (R:goalsize ?p large) (RW:in-highspeed-saw ?b ?m) (RW:wood ?b ?w) (RW:surface-condition ?b ?surface) (RW:boardsize ?b ?size_before) (R:boardsize-successor ?size_after ?s1) (R:boardsize-successor ?s1 ?s2) (R:boardsize-successor ?s2 ?size_before))
        eff: (and (increase (total-cost) 10) (N:RW:unused ?p) (RW:available ?p) (RW:wood ?p ?w) (RW:surface-condition ?p ?surface) (RW:colour ?p natural) (RW:treatment ?p untreated) (RW:boardsize ?b ?size_after))
    do-saw-small: ?b:16 ?p:17 ?m:14 ?w:2 ?surface:5 ?size_before:7 ?size_after:7
        pre: (and (RW:unused ?p) (R:goalsize ?p small) (RW:available ?b) (RW:wood ?b ?w) (RW:surface-condition ?b ?surface) (RW:boardsize ?b ?size_before) (R:boardsize-successor ?size_after ?size_before))
        eff: (and (increase (total-cost) 30) (N:RW:unused ?p) (RW:available ?p) (RW:wood ?p ?w) (RW:surface-condition ?p ?surface) (RW:colour ?p natural) (RW:treatment ?p untreated) (RW:boardsize ?b ?size_after))
    do-saw-medium: ?b:16 ?p:17 ?m:14 ?w:2 ?surface:5 ?size_before:7 ?s1:7 ?size_after:7
        pre: (and (RW:unused ?p) (R:goalsize ?p medium) (RW:available ?b) (RW:wood ?b ?w) (RW:surface-condition ?b ?surface) (RW:boardsize ?b ?size_before) (R:boardsize-successor ?size_after ?s1) (R:boardsize-successor ?s1 ?size_before))
        eff: (and (increase (total-cost) 30) (N:RW:unused ?p) (RW:available ?p) (RW:wood ?p ?w) (RW:surface-condition ?p ?surface) (RW:colour ?p natural) (RW:treatment ?p untreated) (RW:boardsize ?b ?size_after))
    do-saw-large: ?b:16 ?p:17 ?m:14 ?w:2 ?surface:5 ?size_before:7 ?s1:7 ?s2:7 ?size_after:7
        pre: (and (RW:unused ?p) (R:goalsize ?p large) (RW:available ?b) (RW:wood ?b ?w) (RW:surface-condition ?b ?surface) (RW:boardsize ?b ?size_before) (R:boardsize-successor ?size_after ?s1) (R:boardsize-successor ?s1 ?s2) (R:boardsize-successor ?s2 ?size_before))
        eff: (and (increase (total-cost) 30) (N:RW:unused ?p) (RW:available ?p) (RW:wood ?p ?w) (RW:surface-condition ?p ?surface) (RW:colour ?p natural) (RW:treatment ?p untreated) (RW:boardsize ?b ?size_after))
