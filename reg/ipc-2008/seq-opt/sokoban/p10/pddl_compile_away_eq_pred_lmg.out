Predicate:
  + (equal object object)
Action:
  - move: ?p - player ?from - location ?to - location ?dir - direction
      pre: (and (at ?p ?from) (clear ?to) (move-dir ?from ?to ?dir) (not (= ?from ?to)))
      eff: (and (at ?p ?to) (clear ?from) (not (at ?p ?from)) (not (clear ?to)))
  + move: ?p - player ?from - location ?to - location ?dir - direction
      pre: (and (at ?p ?from) (clear ?to) (move-dir ?from ?to ?dir) (not (equal ?from ?to)))
      eff: (and (at ?p ?to) (clear ?from) (not (at ?p ?from)) (not (clear ?to)))
  - push-to-goal: ?p - player ?s - stone ?ppos - location ?from - location ?to - location ?dir - direction
      pre: (and (at ?p ?ppos) (at ?s ?from) (clear ?to) (is-goal ?to) (move-dir ?from ?to ?dir) (move-dir ?ppos ?from ?dir) (not (= ?from ?to)) (not (= ?ppos ?from)) (not (= ?ppos ?to)))
      eff: (and (at ?p ?from) (at ?s ?to) (at-goal ?s) (clear ?ppos) (increase (total-cost) 1) (not (at ?p ?ppos)) (not (at ?s ?from)) (not (clear ?to)))
  + push-to-goal: ?p - player ?s - stone ?ppos - location ?from - location ?to - location ?dir - direction
      pre: (and (at ?p ?ppos) (at ?s ?from) (clear ?to) (is-goal ?to) (move-dir ?from ?to ?dir) (move-dir ?ppos ?from ?dir) (not (equal ?from ?to)) (not (equal ?ppos ?from)) (not (equal ?ppos ?to)))
      eff: (and (at ?p ?from) (at ?s ?to) (at-goal ?s) (clear ?ppos) (increase (total-cost) 1) (not (at ?p ?ppos)) (not (at ?s ?from)) (not (clear ?to)))
  - push-to-nongoal: ?p - player ?s - stone ?ppos - location ?from - location ?to - location ?dir - direction
      pre: (and (at ?p ?ppos) (at ?s ?from) (clear ?to) (is-nongoal ?to) (move-dir ?from ?to ?dir) (move-dir ?ppos ?from ?dir) (not (= ?from ?to)) (not (= ?ppos ?from)) (not (= ?ppos ?to)))
      eff: (and (at ?p ?from) (at ?s ?to) (clear ?ppos) (increase (total-cost) 1) (not (at ?p ?ppos)) (not (at ?s ?from)) (not (at-goal ?s)) (not (clear ?to)))
  + push-to-nongoal: ?p - player ?s - stone ?ppos - location ?from - location ?to - location ?dir - direction
      pre: (and (at ?p ?ppos) (at ?s ?from) (clear ?to) (is-nongoal ?to) (move-dir ?from ?to ?dir) (move-dir ?ppos ?from ?dir) (not (equal ?from ?to)) (not (equal ?ppos ?from)) (not (equal ?ppos ?to)))
      eff: (and (at ?p ?from) (at ?s ?to) (clear ?ppos) (increase (total-cost) 1) (not (at ?p ?ppos)) (not (at ?s ?from)) (not (at-goal ?s)) (not (clear ?to)))
