Action[4]:
    analyze-2: ?s1:1 ?s2:1 ?c1:2 ?c2:2
        pre: (and (N:R:= ?s1 ?s2) (N:R:= ?c1 ?c2) (R:cycle-2-with-analysis ?s1 ?s2) (RW:on ?c1 ?s1) (RW:on ?c2 ?s2))
        eff: (and (N:RW:on ?c1 ?s1) (RW:on ?c1 ?s2) (RW:on ?c2 ?s1) (N:RW:on ?c2 ?s2) (RW:analyzed ?c1) (increase (total-cost) 3))
    rotate-2: ?s1:1 ?s2:1 ?c1:2 ?c2:2
        pre: (and (N:R:= ?s1 ?s2) (N:R:= ?c1 ?c2) (R:cycle-2 ?s1 ?s2) (RW:on ?c1 ?s1) (RW:on ?c2 ?s2))
        eff: (and (N:RW:on ?c1 ?s1) (RW:on ?c1 ?s2) (RW:on ?c2 ?s1) (N:RW:on ?c2 ?s2) (increase (total-cost) 1))
    analyze-2: ?s1:1 ?s2:1 ?c1:2 ?c2:2
        pre: (and (R:= ?s1 ?s2) (R:= ?c1 ?c2) (R:cycle-2-with-analysis ?s1 ?s2) (RW:on ?c1 ?s1) (RW:on ?c2 ?s2))
        eff: (and (N:RW:on ?c1 ?s1) (RW:on ?c1 ?s2) (RW:on ?c2 ?s1) (N:RW:on ?c2 ?s2) (RW:analyzed ?c1) (increase (total-cost) 3))
    rotate-2: ?s1:1 ?s2:1 ?c1:2 ?c2:2
        pre: (and (R:= ?s1 ?s2) (R:= ?c1 ?c2) (R:cycle-2 ?s1 ?s2) (RW:on ?c1 ?s1) (RW:on ?c2 ?s2))
        eff: (and (N:RW:on ?c1 ?s1) (RW:on ?c1 ?s2) (RW:on ?c2 ?s1) (N:RW:on ?c2 ?s2) (increase (total-cost) 1))
