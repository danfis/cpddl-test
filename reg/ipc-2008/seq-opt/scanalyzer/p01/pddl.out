Domain: scanalyzer3d
Problem: scanalyzer3d-14
Require:
  :action-costs
  :strips
  :typing
Type:
  car - object
  object
  segment - object
Obj:
  car-in-1 - car
  car-in-2 - car
  car-in-3 - car
  car-out-1 - car
  car-out-2 - car
  car-out-3 - car
  seg-in-1 - segment
  seg-in-2 - segment
  seg-in-3 - segment
  seg-out-1 - segment
  seg-out-2 - segment
  seg-out-3 - segment
Predicate:
  (= object object) :eq
  (analyzed car)
  (cycle-2 segment segment)
  (cycle-2-with-analysis segment segment)
  (on car segment)
Function:
  (total-cost)
Action:
  analyze-2: ?s1 - segment ?s2 - segment ?c1 - car ?c2 - car
      pre: (and (cycle-2-with-analysis ?s1 ?s2) (on ?c1 ?s1) (on ?c2 ?s2))
      eff: (and (analyzed ?c1) (increase (total-cost) 3) (not (on ?c1 ?s1)) (not (on ?c2 ?s2)) (on ?c1 ?s2) (on ?c2 ?s1))
  rotate-2: ?s1 - segment ?s2 - segment ?c1 - car ?c2 - car
      pre: (and (cycle-2 ?s1 ?s2) (on ?c1 ?s1) (on ?c2 ?s2))
      eff: (and (increase (total-cost) 1) (not (on ?c1 ?s1)) (not (on ?c2 ?s2)) (on ?c1 ?s2) (on ?c2 ?s1))
Init:
  (= (total-cost) 0)
  (cycle-2 seg-in-1 seg-out-1)
  (cycle-2 seg-in-1 seg-out-2)
  (cycle-2 seg-in-1 seg-out-3)
  (cycle-2 seg-in-2 seg-out-1)
  (cycle-2 seg-in-2 seg-out-2)
  (cycle-2 seg-in-2 seg-out-3)
  (cycle-2 seg-in-3 seg-out-1)
  (cycle-2 seg-in-3 seg-out-2)
  (cycle-2 seg-in-3 seg-out-3)
  (cycle-2-with-analysis seg-in-1 seg-out-1)
  (cycle-2-with-analysis seg-in-1 seg-out-2)
  (cycle-2-with-analysis seg-in-1 seg-out-3)
  (cycle-2-with-analysis seg-in-2 seg-out-1)
  (cycle-2-with-analysis seg-in-2 seg-out-2)
  (cycle-2-with-analysis seg-in-2 seg-out-3)
  (cycle-2-with-analysis seg-in-3 seg-out-1)
  (cycle-2-with-analysis seg-in-3 seg-out-2)
  (cycle-2-with-analysis seg-in-3 seg-out-3)
  (on car-in-1 seg-in-1)
  (on car-in-2 seg-in-2)
  (on car-in-3 seg-in-3)
  (on car-out-1 seg-out-1)
  (on car-out-2 seg-out-2)
  (on car-out-3 seg-out-3)
Goal:
  (and (analyzed car-in-1) (analyzed car-in-2) (analyzed car-in-3) (analyzed car-out-1) (analyzed car-out-2) (analyzed car-out-3) (on car-in-1 seg-in-1) (on car-in-2 seg-in-2) (on car-in-3 seg-in-3) (on car-out-1 seg-out-1) (on car-out-2 seg-out-2) (on car-out-3 seg-out-3))
Metric:
  (total-cost)
Pred prop:
  (analyzed car): in_goal in_eff
  (cycle-2 segment segment): in_init in_pre
  (cycle-2-with-analysis segment segment): in_init in_pre
  (on car segment): in_init in_pre in_goal in_eff
Func prop:
  (total-cost): in_init init_all_nonneg init_all_nonpos init_all_int in_metric is_metric_alone in_eff write_delta_nonneg write_delta_nonneg_int
Global prop:
  action_cost_func:(total-cost)
  has_int_action_cost_func
