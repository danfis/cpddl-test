Require:
  + :equality
  + :negative-preconditions
Action:
  - analyze-2: ?s1 - segment ?s2 - segment ?c1 - car ?c2 - car
      pre: (and (cycle-2-with-analysis ?s1 ?s2) (on ?c1 ?s1) (on ?c2 ?s2))
      eff: (and (analyzed ?c1) (increase (total-cost) 3) (not (on ?c1 ?s1)) (not (on ?c2 ?s2)) (on ?c1 ?s2) (on ?c2 ?s1))
  + analyze-2: ?s1 - segment ?s2 - segment ?c1 - car ?c2 - car
      pre: (and (= ?c1 ?c2) (= ?s1 ?s2) (cycle-2-with-analysis ?s1 ?s2) (on ?c1 ?s1) (on ?c2 ?s2))
      eff: (and (analyzed ?c1) (increase (total-cost) 3) (not (on ?c1 ?s1)) (not (on ?c2 ?s2)) (on ?c1 ?s2) (on ?c2 ?s1))
  + analyze-2: ?s1 - segment ?s2 - segment ?c1 - car ?c2 - car
      pre: (and (cycle-2-with-analysis ?s1 ?s2) (not (= ?c1 ?c2)) (not (= ?s1 ?s2)) (on ?c1 ?s1) (on ?c2 ?s2))
      eff: (and (analyzed ?c1) (increase (total-cost) 3) (not (on ?c1 ?s1)) (not (on ?c2 ?s2)) (on ?c1 ?s2) (on ?c2 ?s1))
  - rotate-2: ?s1 - segment ?s2 - segment ?c1 - car ?c2 - car
      pre: (and (cycle-2 ?s1 ?s2) (on ?c1 ?s1) (on ?c2 ?s2))
      eff: (and (increase (total-cost) 1) (not (on ?c1 ?s1)) (not (on ?c2 ?s2)) (on ?c1 ?s2) (on ?c2 ?s1))
  + rotate-2: ?s1 - segment ?s2 - segment ?c1 - car ?c2 - car
      pre: (and (= ?c1 ?c2) (= ?s1 ?s2) (cycle-2 ?s1 ?s2) (on ?c1 ?s1) (on ?c2 ?s2))
      eff: (and (increase (total-cost) 1) (not (on ?c1 ?s1)) (not (on ?c2 ?s2)) (on ?c1 ?s2) (on ?c2 ?s1))
  + rotate-2: ?s1 - segment ?s2 - segment ?c1 - car ?c2 - car
      pre: (and (cycle-2 ?s1 ?s2) (not (= ?c1 ?c2)) (not (= ?s1 ?s2)) (on ?c1 ?s1) (on ?c2 ?s2))
      eff: (and (increase (total-cost) 1) (not (on ?c1 ?s1)) (not (on ?c2 ?s2)) (on ?c1 ?s2) (on ?c2 ?s1))
Pred prop:
  + (= object object): in_pre in_pre_neg
Global prop:
  + has_eq_pred
