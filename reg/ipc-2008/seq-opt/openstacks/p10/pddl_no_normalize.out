Predicate[8]:
    =: 0 0 :: read: 0, write: 0, in-init: 0
    includes: 1 2 :: read: 1, write: 0, in-init: 1
    waiting: 1 :: read: 1, write: 1, in-init: 1
    started: 1 :: read: 1, write: 1, in-init: 0
    shipped: 1 :: read: 0, write: 1, in-init: 0
    made: 2 :: read: 1, write: 1, in-init: 0
    stacks-avail: 3 :: read: 1, write: 1, in-init: 1
    next-count: 3 3 :: read: 1, write: 0, in-init: 1
Function[1]:
    total-cost: :: read: 0, write: 1, in-init: 1
Action[4]:
    make-product: ?p:2
        pre: (and (N:RW:made ?p) (forall (?o:1 I[0]:?p:2) (imply (R:includes ?o ?p) (RW:started ?o))))
        eff: (RW:made ?p)
    start-order: ?o:1 ?avail:3 ?new-avail:3
        pre: (and (R:next-count ?new-avail ?avail) (RW:waiting ?o) (RW:stacks-avail ?avail))
        eff: (and (N:RW:waiting ?o) (RW:started ?o) (N:RW:stacks-avail ?avail) (RW:stacks-avail ?new-avail))
    ship-order: ?o:1 ?avail:3 ?new-avail:3
        pre: (and (R:next-count ?avail ?new-avail) (RW:started ?o) (RW:stacks-avail ?avail) (forall (?p:2 I[0]:?o:1 I[1]:?avail:3 I[2]:?new-avail:3) (imply (R:includes ?o ?p) (RW:made ?p))))
        eff: (and (N:RW:started ?o) (W:shipped ?o) (N:RW:stacks-avail ?avail) (RW:stacks-avail ?new-avail))
    open-new-stack: ?open:3 ?new-open:3
        pre: (and (R:next-count ?open ?new-open) (RW:stacks-avail ?open))
        eff: (and (N:RW:stacks-avail ?open) (RW:stacks-avail ?new-open) (increase (total-cost) 1))
