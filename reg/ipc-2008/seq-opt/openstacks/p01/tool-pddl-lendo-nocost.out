
-------- domain.pddl --------

(define (domain openstacks-sequencedstrips-adl)
(:requirements
    :strips
    :typing
    :equality
    :action-costs
)
(:types
    order - object
    product - object
    count - object
)
(:constants
    o1 - order
    o2 - order
    o3 - order
    o4 - order
    o5 - order
    p1 - product
    p2 - product
    p3 - product
    p4 - product
    p5 - product
)
(:predicates
    (waiting ?x0 - order)
    (started ?x0 - order)
    (shipped ?x0 - order)
    (made ?x0 - product)
    (stacks-avail ?x0 - count)
    (next-count ?x0 - count ?x1 - count)
    (NOT-made ?x0 - product)
)
(:functions
    (total-cost)
)
(:action make-product
    :parameters (?p - product)
    :precondition (and (= ?p p1) (NOT-made p1) (started o2))
    :effect (and (made p1) (not (NOT-made p1)))
)

(:action start-order
    :parameters (?o - order ?avail - count ?new-avail - count)
    :precondition (and (waiting ?o) (stacks-avail ?avail) (next-count ?new-avail ?avail))
    :effect (and (not (waiting ?o)) (started ?o) (not (stacks-avail ?avail)) (stacks-avail ?new-avail))
)

(:action ship-order
    :parameters (?o - order ?avail - count ?new-avail - count)
    :precondition (and (= ?o o1) (started o1) (made p2) (stacks-avail ?avail) (next-count ?avail ?new-avail))
    :effect (and (not (started o1)) (shipped o1) (not (stacks-avail ?avail)) (stacks-avail ?new-avail))
)

(:action open-new-stack
    :parameters (?open - count ?new-open - count)
    :precondition (and (stacks-avail ?open) (next-count ?open ?new-open))
    :effect (and (not (stacks-avail ?open)) (stacks-avail ?new-open) (increase (total-cost) 1))
)

(:action make-product
    :parameters (?p - product)
    :precondition (and (= ?p p2) (NOT-made p2) (started o1) (started o2))
    :effect (and (made p2) (not (NOT-made p2)))
)

(:action make-product
    :parameters (?p - product)
    :precondition (and (= ?p p3) (NOT-made p3) (started o3) (started o4))
    :effect (and (made p3) (not (NOT-made p3)))
)

(:action make-product
    :parameters (?p - product)
    :precondition (and (= ?p p4) (NOT-made p4) (started o4))
    :effect (and (made p4) (not (NOT-made p4)))
)

(:action make-product
    :parameters (?p - product)
    :precondition (and (= ?p p5) (NOT-made p5) (started o5))
    :effect (and (made p5) (not (NOT-made p5)))
)

(:action ship-order
    :parameters (?o - order ?avail - count ?new-avail - count)
    :precondition (and (= ?o o2) (started o2) (stacks-avail ?avail) (next-count ?avail ?new-avail) (made p1) (made p2))
    :effect (and (not (started o2)) (shipped o2) (not (stacks-avail ?avail)) (stacks-avail ?new-avail))
)

(:action ship-order
    :parameters (?o - order ?avail - count ?new-avail - count)
    :precondition (and (= ?o o3) (started o3) (made p3) (stacks-avail ?avail) (next-count ?avail ?new-avail))
    :effect (and (not (started o3)) (shipped o3) (not (stacks-avail ?avail)) (stacks-avail ?new-avail))
)

(:action ship-order
    :parameters (?o - order ?avail - count ?new-avail - count)
    :precondition (and (= ?o o4) (started o4) (stacks-avail ?avail) (next-count ?avail ?new-avail) (made p3) (made p4))
    :effect (and (not (started o4)) (shipped o4) (not (stacks-avail ?avail)) (stacks-avail ?new-avail))
)

(:action ship-order
    :parameters (?o - order ?avail - count ?new-avail - count)
    :precondition (and (= ?o o5) (started o5) (made p5) (stacks-avail ?avail) (next-count ?avail ?new-avail))
    :effect (and (not (started o5)) (shipped o5) (not (stacks-avail ?avail)) (stacks-avail ?new-avail))
)

)


-------- problem.pddl --------

(define (problem os-sequencedstrips-p5_1) (:domain openstacks-sequencedstrips-adl)
(:objects
    n0 - count
    n1 - count
    n2 - count
    n3 - count
    n4 - count
    n5 - count
)
(:init
  (next-count n0 n1)
  (next-count n1 n2)
  (next-count n2 n3)
  (next-count n3 n4)
  (next-count n4 n5)
  (stacks-avail n0)
  (waiting o1)
  (waiting o2)
  (waiting o3)
  (waiting o4)
  (waiting o5)
  (= (total-cost) 0)
  (NOT-made p1)
  (NOT-made p2)
  (NOT-made p3)
  (NOT-made p4)
  (NOT-made p5)
)
(:goal (and (shipped o1) (shipped o2) (shipped o3) (shipped o4) (shipped o5)))
(:metric minimize (total-cost))
)

