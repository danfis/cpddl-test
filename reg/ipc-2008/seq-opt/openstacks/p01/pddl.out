Domain: openstacks-sequencedstrips-adl
Problem: os-sequencedstrips-p5_1
Require:
  :action-costs
  :equality
  :strips
  :typing
Type:
  count - object
  object
  order - object
  product - object
Obj:
  n0 - count
  n1 - count
  n2 - count
  n3 - count
  n4 - count
  n5 - count
  o1 - order
  o2 - order
  o3 - order
  o4 - order
  o5 - order
  p1 - product
  p2 - product
  p3 - product
  p4 - product
  p5 - product
Predicate:
  (= object object) :eq
  (NOT-made product) neg-of (made)
  (made product) neg-of (NOT-made)
  (next-count count count)
  (shipped order)
  (stacks-avail count)
  (started order)
  (waiting order)
Function:
  (total-cost)
Action:
  make-product: ?p - product
      pre: (and (= ?p p1) (NOT-made p1) (started o2))
      eff: (and (made p1) (not (NOT-made p1)))
  make-product: ?p - product
      pre: (and (= ?p p2) (NOT-made p2) (started o1) (started o2))
      eff: (and (made p2) (not (NOT-made p2)))
  make-product: ?p - product
      pre: (and (= ?p p3) (NOT-made p3) (started o3) (started o4))
      eff: (and (made p3) (not (NOT-made p3)))
  make-product: ?p - product
      pre: (and (= ?p p4) (NOT-made p4) (started o4))
      eff: (and (made p4) (not (NOT-made p4)))
  make-product: ?p - product
      pre: (and (= ?p p5) (NOT-made p5) (started o5))
      eff: (and (made p5) (not (NOT-made p5)))
  open-new-stack: ?open - count ?new-open - count
      pre: (and (next-count ?open ?new-open) (stacks-avail ?open))
      eff: (and (increase (total-cost) 1) (not (stacks-avail ?open)) (stacks-avail ?new-open))
  ship-order: ?o - order ?avail - count ?new-avail - count
      pre: (and (= ?o o1) (made p2) (next-count ?avail ?new-avail) (stacks-avail ?avail) (started o1))
      eff: (and (not (stacks-avail ?avail)) (not (started o1)) (shipped o1) (stacks-avail ?new-avail))
  ship-order: ?o - order ?avail - count ?new-avail - count
      pre: (and (= ?o o2) (made p1) (made p2) (next-count ?avail ?new-avail) (stacks-avail ?avail) (started o2))
      eff: (and (not (stacks-avail ?avail)) (not (started o2)) (shipped o2) (stacks-avail ?new-avail))
  ship-order: ?o - order ?avail - count ?new-avail - count
      pre: (and (= ?o o3) (made p3) (next-count ?avail ?new-avail) (stacks-avail ?avail) (started o3))
      eff: (and (not (stacks-avail ?avail)) (not (started o3)) (shipped o3) (stacks-avail ?new-avail))
  ship-order: ?o - order ?avail - count ?new-avail - count
      pre: (and (= ?o o4) (made p3) (made p4) (next-count ?avail ?new-avail) (stacks-avail ?avail) (started o4))
      eff: (and (not (stacks-avail ?avail)) (not (started o4)) (shipped o4) (stacks-avail ?new-avail))
  ship-order: ?o - order ?avail - count ?new-avail - count
      pre: (and (= ?o o5) (made p5) (next-count ?avail ?new-avail) (stacks-avail ?avail) (started o5))
      eff: (and (not (stacks-avail ?avail)) (not (started o5)) (shipped o5) (stacks-avail ?new-avail))
  start-order: ?o - order ?avail - count ?new-avail - count
      pre: (and (next-count ?new-avail ?avail) (stacks-avail ?avail) (waiting ?o))
      eff: (and (not (stacks-avail ?avail)) (not (waiting ?o)) (stacks-avail ?new-avail) (started ?o))
Init:
  (= (total-cost) 0)
  (NOT-made p1)
  (NOT-made p2)
  (NOT-made p3)
  (NOT-made p4)
  (NOT-made p5)
  (next-count n0 n1)
  (next-count n1 n2)
  (next-count n2 n3)
  (next-count n3 n4)
  (next-count n4 n5)
  (stacks-avail n0)
  (waiting o1)
  (waiting o2)
  (waiting o3)
  (waiting o4)
  (waiting o5)
Goal:
  (and (shipped o1) (shipped o2) (shipped o3) (shipped o4) (shipped o5))
Metric:
  (total-cost)
Pred prop:
  (= object object): in_pre
  (NOT-made product): in_init in_pre in_eff
  (made product): in_pre in_eff
  (next-count count count): in_init in_pre
  (shipped order): in_goal in_eff
  (stacks-avail count): in_init in_pre in_eff
  (started order): in_pre in_eff
  (waiting order): in_init in_pre in_eff
Func prop:
  (total-cost): in_init init_all_nonneg init_all_nonpos init_all_int in_metric is_metric_alone in_eff write_delta_nonneg write_delta_nonneg_int
Global prop:
  action_cost_func:(total-cost)
  has_eq_pred
  has_int_action_cost_func
