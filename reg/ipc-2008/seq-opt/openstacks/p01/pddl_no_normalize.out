Domain: openstacks-sequencedstrips-adl
Problem: os-sequencedstrips-p5_1
Require:
  :action-costs
  :negative-preconditions
  :strips
  :typing
  :universal-preconditions
Type:
  count - object
  object
  order - object
  product - object
Obj:
  n0 - count
  n1 - count
  n2 - count
  n3 - count
  n4 - count
  n5 - count
  o1 - order
  o2 - order
  o3 - order
  o4 - order
  o5 - order
  p1 - product
  p2 - product
  p3 - product
  p4 - product
  p5 - product
Predicate:
  (= object object) :eq
  (includes order product)
  (made product)
  (next-count count count)
  (shipped order)
  (stacks-avail count)
  (started order)
  (waiting order)
Function:
  (total-cost)
Action:
  make-product: ?p - product
      pre: (and (forall (?o - order) (imply (includes ?o ?p) (started ?o))) (not (made ?p)))
      eff: (made ?p)
  open-new-stack: ?open - count ?new-open - count
      pre: (and (next-count ?open ?new-open) (stacks-avail ?open))
      eff: (and (increase (total-cost) 1) (not (stacks-avail ?open)) (stacks-avail ?new-open))
  ship-order: ?o - order ?avail - count ?new-avail - count
      pre: (and (forall (?p - product) (imply (includes ?o ?p) (made ?p))) (next-count ?avail ?new-avail) (stacks-avail ?avail) (started ?o))
      eff: (and (not (stacks-avail ?avail)) (not (started ?o)) (shipped ?o) (stacks-avail ?new-avail))
  start-order: ?o - order ?avail - count ?new-avail - count
      pre: (and (next-count ?new-avail ?avail) (stacks-avail ?avail) (waiting ?o))
      eff: (and (not (stacks-avail ?avail)) (not (waiting ?o)) (stacks-avail ?new-avail) (started ?o))
Init:
  (= (total-cost) 0)
  (includes o1 p2)
  (includes o2 p1)
  (includes o2 p2)
  (includes o3 p3)
  (includes o4 p3)
  (includes o4 p4)
  (includes o5 p5)
  (next-count n0 n1)
  (next-count n1 n2)
  (next-count n2 n3)
  (next-count n3 n4)
  (next-count n4 n5)
  (stacks-avail n0)
  (waiting o1)
  (waiting o2)
  (waiting o3)
  (waiting o4)
  (waiting o5)
Goal:
  (and (shipped o1) (shipped o2) (shipped o3) (shipped o4) (shipped o5))
Metric:
  (total-cost)
Pred prop:
  (includes order product): in_init in_pre
  (made product): in_pre in_pre_neg in_eff
  (next-count count count): in_init in_pre
  (shipped order): in_goal in_eff
  (stacks-avail count): in_init in_pre in_eff
  (started order): in_pre in_eff
  (waiting order): in_init in_pre in_eff
Func prop:
  (total-cost): in_init init_all_nonneg init_all_nonpos init_all_int in_metric is_metric_alone in_eff write_delta_nonneg write_delta_nonneg_int
Global prop:
  action_cost_func:(total-cost)
  has_int_action_cost_func
  has_non_static_neg_cond
