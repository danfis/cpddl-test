Action:
  cut-board-large: ?b - board ?p - part ?m - highspeed-saw ?w - awood ?surface - surface ?size_before - aboardsize ?s1 - aboardsize ?s2 - aboardsize ?size_after - aboardsize
      pre: (and (boardsize ?b ?size_before) (boardsize-successor ?s1 ?s2) (boardsize-successor ?s2 ?size_before) (boardsize-successor ?size_after ?s1) (goalsize ?p large) (in-highspeed-saw ?b ?m) (surface-condition ?b ?surface) (unused ?p) (wood ?b ?w))
      eff: (and (available ?p) (boardsize ?b ?size_after) (colour ?p natural) (increase (total-cost) 10) (not (unused ?p)) (surface-condition ?p ?surface) (treatment ?p untreated) (wood ?p ?w))
  cut-board-medium: ?b - board ?p - part ?m - highspeed-saw ?w - awood ?surface - surface ?size_before - aboardsize ?s1 - aboardsize ?size_after - aboardsize
      pre: (and (boardsize ?b ?size_before) (boardsize-successor ?s1 ?size_before) (boardsize-successor ?size_after ?s1) (goalsize ?p medium) (in-highspeed-saw ?b ?m) (surface-condition ?b ?surface) (unused ?p) (wood ?b ?w))
      eff: (and (available ?p) (boardsize ?b ?size_after) (colour ?p natural) (increase (total-cost) 10) (not (unused ?p)) (surface-condition ?p ?surface) (treatment ?p untreated) (wood ?p ?w))
  cut-board-small: ?b - board ?p - part ?m - highspeed-saw ?w - awood ?surface - surface ?size_before - aboardsize ?size_after - aboardsize
      pre: (and (boardsize ?b ?size_before) (boardsize-successor ?size_after ?size_before) (goalsize ?p small) (in-highspeed-saw ?b ?m) (surface-condition ?b ?surface) (unused ?p) (wood ?b ?w))
      eff: (and (available ?p) (boardsize ?b ?size_after) (colour ?p natural) (increase (total-cost) 10) (not (unused ?p)) (surface-condition ?p ?surface) (treatment ?p untreated) (wood ?p ?w))
  do-glaze: ?x - part ?m - glazer ?newcolour - acolour
      pre: (and (available ?x) (has-colour ?m ?newcolour) (treatment ?x untreated))
      eff: (and (colour ?x ?newcolour) (increase (total-cost) (glaze-cost ?x)) (not (colour ?x natural)) (not (treatment ?x untreated)) (treatment ?x glazed))
  do-grind: ?x - part ?m - grinder ?oldsurface - surface ?oldcolour - acolour ?oldtreatment - treatmentstatus ?newtreatment - treatmentstatus
      pre: (and (available ?x) (colour ?x ?oldcolour) (grind-treatment-change ?oldtreatment ?newtreatment) (is-smooth ?oldsurface) (surface-condition ?x ?oldsurface) (treatment ?x ?oldtreatment))
      eff: (and (colour ?x natural) (increase (total-cost) (grind-cost ?x)) (not (colour ?x ?oldcolour)) (not (surface-condition ?x ?oldsurface)) (not (treatment ?x ?oldtreatment)) (surface-condition ?x verysmooth) (treatment ?x ?newtreatment))
  do-immersion-varnish: ?x - part ?m - immersion-varnisher ?newcolour - acolour ?surface - surface
      pre: (and (available ?x) (has-colour ?m ?newcolour) (is-smooth ?surface) (surface-condition ?x ?surface) (treatment ?x untreated))
      eff: (and (colour ?x ?newcolour) (increase (total-cost) 10) (not (colour ?x natural)) (not (treatment ?x untreated)) (treatment ?x varnished))
  do-plane: ?x - part ?m - planer ?oldsurface - surface ?oldcolour - acolour ?oldtreatment - treatmentstatus
      pre: (and (available ?x) (colour ?x ?oldcolour) (surface-condition ?x ?oldsurface) (treatment ?x ?oldtreatment))
      eff: (and (colour ?x natural) (increase (total-cost) (plane-cost ?x)) (not (colour ?x ?oldcolour)) (not (surface-condition ?x ?oldsurface)) (not (treatment ?x ?oldtreatment)) (surface-condition ?x smooth) (treatment ?x untreated))
  do-saw-large: ?b - board ?p - part ?m - saw ?w - awood ?surface - surface ?size_before - aboardsize ?s1 - aboardsize ?s2 - aboardsize ?size_after - aboardsize
      pre: (and (available ?b) (boardsize ?b ?size_before) (boardsize-successor ?s1 ?s2) (boardsize-successor ?s2 ?size_before) (boardsize-successor ?size_after ?s1) (goalsize ?p large) (surface-condition ?b ?surface) (unused ?p) (wood ?b ?w))
      eff: (and (available ?p) (boardsize ?b ?size_after) (colour ?p natural) (increase (total-cost) 30) (not (unused ?p)) (surface-condition ?p ?surface) (treatment ?p untreated) (wood ?p ?w))
  do-saw-medium: ?b - board ?p - part ?m - saw ?w - awood ?surface - surface ?size_before - aboardsize ?s1 - aboardsize ?size_after - aboardsize
      pre: (and (available ?b) (boardsize ?b ?size_before) (boardsize-successor ?s1 ?size_before) (boardsize-successor ?size_after ?s1) (goalsize ?p medium) (surface-condition ?b ?surface) (unused ?p) (wood ?b ?w))
      eff: (and (available ?p) (boardsize ?b ?size_after) (colour ?p natural) (increase (total-cost) 30) (not (unused ?p)) (surface-condition ?p ?surface) (treatment ?p untreated) (wood ?p ?w))
  do-saw-small: ?b - board ?p - part ?m - saw ?w - awood ?surface - surface ?size_before - aboardsize ?size_after - aboardsize
      pre: (and (available ?b) (boardsize ?b ?size_before) (boardsize-successor ?size_after ?size_before) (goalsize ?p small) (surface-condition ?b ?surface) (unused ?p) (wood ?b ?w))
      eff: (and (available ?p) (boardsize ?b ?size_after) (colour ?p natural) (increase (total-cost) 30) (not (unused ?p)) (surface-condition ?p ?surface) (treatment ?p untreated) (wood ?p ?w))
  do-spray-varnish: ?x - part ?m - spray-varnisher ?newcolour - acolour ?surface - surface
      pre: (and (available ?x) (has-colour ?m ?newcolour) (is-smooth ?surface) (surface-condition ?x ?surface) (treatment ?x untreated))
      eff: (and (colour ?x ?newcolour) (increase (total-cost) (spray-varnish-cost ?x)) (not (colour ?x natural)) (not (treatment ?x untreated)) (treatment ?x varnished))
  load-highspeed-saw: ?b - board ?m - highspeed-saw
      pre: (and (available ?b) (empty ?m))
      eff: (and (in-highspeed-saw ?b ?m) (increase (total-cost) 30) (not (available ?b)) (not (empty ?m)))
  unload-highspeed-saw: ?b - board ?m - highspeed-saw
      pre: (in-highspeed-saw ?b ?m)
      eff: (and (available ?b) (empty ?m) (increase (total-cost) 10) (not (in-highspeed-saw ?b ?m)))
