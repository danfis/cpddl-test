Action[13]:
    do-immersion-varnish: ?x:17 ?m:12 ?newcolour:1 ?surface:5
        pre: (and (R:has-colour ?m ?newcolour) (R:is-smooth ?surface) (RW:available ?x) (RW:surface-condition ?x ?surface) (RW:treatment ?x untreated))
        eff: (and (RW:treatment ?x varnished) (N:RW:treatment ?x untreated) (N:RW:colour ?x natural) (RW:colour ?x ?newcolour) (increase (total-cost) 10))
    do-spray-varnish: ?x:17 ?m:15 ?newcolour:1 ?surface:5
        pre: (and (R:has-colour ?m ?newcolour) (R:is-smooth ?surface) (RW:available ?x) (RW:surface-condition ?x ?surface) (RW:treatment ?x untreated))
        eff: (and (RW:treatment ?x varnished) (N:RW:treatment ?x untreated) (N:RW:colour ?x natural) (RW:colour ?x ?newcolour) (increase (total-cost) (spray-varnish-cost ?x)))
    do-glaze: ?x:17 ?m:10 ?newcolour:1
        pre: (and (R:has-colour ?m ?newcolour) (RW:available ?x) (RW:treatment ?x untreated))
        eff: (and (RW:treatment ?x glazed) (N:RW:treatment ?x untreated) (N:RW:colour ?x natural) (RW:colour ?x ?newcolour) (increase (total-cost) (glaze-cost ?x)))
    do-grind: ?x:17 ?m:11 ?oldsurface:5 ?oldcolour:1 ?oldtreatment:6 ?newtreatment:6
        pre: (and (R:grind-treatment-change ?oldtreatment ?newtreatment) (R:is-smooth ?oldsurface) (RW:available ?x) (RW:surface-condition ?x ?oldsurface) (RW:treatment ?x ?oldtreatment) (RW:colour ?x ?oldcolour))
        eff: (and (RW:surface-condition ?x verysmooth) (N:RW:surface-condition ?x ?oldsurface) (N:RW:treatment ?x ?oldtreatment) (RW:treatment ?x ?newtreatment) (RW:colour ?x natural) (N:RW:colour ?x ?oldcolour) (increase (total-cost) (grind-cost ?x)))
    do-plane: ?x:17 ?m:13 ?oldsurface:5 ?oldcolour:1 ?oldtreatment:6
        pre: (and (RW:available ?x) (RW:surface-condition ?x ?oldsurface) (RW:treatment ?x ?oldtreatment) (RW:colour ?x ?oldcolour))
        eff: (and (RW:surface-condition ?x smooth) (N:RW:surface-condition ?x ?oldsurface) (RW:treatment ?x untreated) (N:RW:treatment ?x ?oldtreatment) (RW:colour ?x natural) (N:RW:colour ?x ?oldcolour) (increase (total-cost) (plane-cost ?x)))
    load-highspeed-saw: ?b:16 ?m:9
        pre: (and (RW:available ?b) (RW:empty ?m))
        eff: (and (N:RW:available ?b) (RW:in-highspeed-saw ?b ?m) (N:RW:empty ?m) (increase (total-cost) 30))
    unload-highspeed-saw: ?b:16 ?m:9
        pre: (and (RW:in-highspeed-saw ?b ?m))
        eff: (and (RW:available ?b) (N:RW:in-highspeed-saw ?b ?m) (RW:empty ?m) (increase (total-cost) 10))
    cut-board-small: ?b:16 ?p:17 ?m:9 ?w:2 ?surface:5 ?size_before:7 ?size_after:7
        pre: (and (R:goalsize ?p small) (R:boardsize-successor ?size_after ?size_before) (RW:unused ?p) (RW:surface-condition ?b ?surface) (RW:wood ?b ?w) (RW:boardsize ?b ?size_before) (RW:in-highspeed-saw ?b ?m))
        eff: (and (N:RW:unused ?p) (RW:available ?p) (RW:surface-condition ?p ?surface) (RW:treatment ?p untreated) (RW:colour ?p natural) (RW:wood ?p ?w) (RW:boardsize ?b ?size_after) (increase (total-cost) 10))
    cut-board-medium: ?b:16 ?p:17 ?m:9 ?w:2 ?surface:5 ?size_before:7 ?s1:7 ?size_after:7
        pre: (and (R:goalsize ?p medium) (R:boardsize-successor ?s1 ?size_before) (R:boardsize-successor ?size_after ?s1) (RW:unused ?p) (RW:surface-condition ?b ?surface) (RW:wood ?b ?w) (RW:boardsize ?b ?size_before) (RW:in-highspeed-saw ?b ?m))
        eff: (and (N:RW:unused ?p) (RW:available ?p) (RW:surface-condition ?p ?surface) (RW:treatment ?p untreated) (RW:colour ?p natural) (RW:wood ?p ?w) (RW:boardsize ?b ?size_after) (increase (total-cost) 10))
    cut-board-large: ?b:16 ?p:17 ?m:9 ?w:2 ?surface:5 ?size_before:7 ?s1:7 ?s2:7 ?size_after:7
        pre: (and (R:goalsize ?p large) (R:boardsize-successor ?s1 ?s2) (R:boardsize-successor ?s2 ?size_before) (R:boardsize-successor ?size_after ?s1) (RW:unused ?p) (RW:surface-condition ?b ?surface) (RW:wood ?b ?w) (RW:boardsize ?b ?size_before) (RW:in-highspeed-saw ?b ?m))
        eff: (and (N:RW:unused ?p) (RW:available ?p) (RW:surface-condition ?p ?surface) (RW:treatment ?p untreated) (RW:colour ?p natural) (RW:wood ?p ?w) (RW:boardsize ?b ?size_after) (increase (total-cost) 10))
    do-saw-small: ?b:16 ?p:17 ?m:14 ?w:2 ?surface:5 ?size_before:7 ?size_after:7
        pre: (and (R:goalsize ?p small) (R:boardsize-successor ?size_after ?size_before) (RW:unused ?p) (RW:available ?b) (RW:surface-condition ?b ?surface) (RW:wood ?b ?w) (RW:boardsize ?b ?size_before))
        eff: (and (N:RW:unused ?p) (RW:available ?p) (RW:surface-condition ?p ?surface) (RW:treatment ?p untreated) (RW:colour ?p natural) (RW:wood ?p ?w) (RW:boardsize ?b ?size_after) (increase (total-cost) 30))
    do-saw-medium: ?b:16 ?p:17 ?m:14 ?w:2 ?surface:5 ?size_before:7 ?s1:7 ?size_after:7
        pre: (and (R:goalsize ?p medium) (R:boardsize-successor ?s1 ?size_before) (R:boardsize-successor ?size_after ?s1) (RW:unused ?p) (RW:available ?b) (RW:surface-condition ?b ?surface) (RW:wood ?b ?w) (RW:boardsize ?b ?size_before))
        eff: (and (N:RW:unused ?p) (RW:available ?p) (RW:surface-condition ?p ?surface) (RW:treatment ?p untreated) (RW:colour ?p natural) (RW:wood ?p ?w) (RW:boardsize ?b ?size_after) (increase (total-cost) 30))
    do-saw-large: ?b:16 ?p:17 ?m:14 ?w:2 ?surface:5 ?size_before:7 ?s1:7 ?s2:7 ?size_after:7
        pre: (and (R:goalsize ?p large) (R:boardsize-successor ?s1 ?s2) (R:boardsize-successor ?s2 ?size_before) (R:boardsize-successor ?size_after ?s1) (RW:unused ?p) (RW:available ?b) (RW:surface-condition ?b ?surface) (RW:wood ?b ?w) (RW:boardsize ?b ?size_before))
        eff: (and (N:RW:unused ?p) (RW:available ?p) (RW:surface-condition ?p ?surface) (RW:treatment ?p untreated) (RW:colour ?p natural) (RW:wood ?p ?w) (RW:boardsize ?b ?size_after) (increase (total-cost) 30))
