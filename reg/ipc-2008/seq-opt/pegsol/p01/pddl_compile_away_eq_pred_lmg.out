Predicate:
  + (equal object object)
Action:
  - jump-continue-move: ?from - location ?over - location ?to - location
      pre: (and (free ?to) (in-line ?from ?over ?to) (last-visited ?from) (not (= ?from ?to)) (not (= ?over ?to)) (occupied ?from) (occupied ?over))
      eff: (and (free ?from) (free ?over) (last-visited ?to) (not (free ?to)) (not (last-visited ?from)) (not (occupied ?from)) (not (occupied ?over)) (occupied ?to))
  + jump-continue-move: ?from - location ?over - location ?to - location
      pre: (and (free ?to) (in-line ?from ?over ?to) (last-visited ?from) (not (equal ?from ?to)) (not (equal ?over ?to)) (occupied ?from) (occupied ?over))
      eff: (and (free ?from) (free ?over) (last-visited ?to) (not (free ?to)) (not (last-visited ?from)) (not (occupied ?from)) (not (occupied ?over)) (occupied ?to))
  - jump-new-move: ?from - location ?over - location ?to - location
      pre: (and (free ?to) (in-line ?from ?over ?to) (move-ended) (not (= ?from ?to)) (not (= ?over ?to)) (occupied ?from) (occupied ?over))
      eff: (and (free ?from) (free ?over) (increase (total-cost) 1) (last-visited ?to) (not (free ?to)) (not (move-ended)) (not (occupied ?from)) (not (occupied ?over)) (occupied ?to))
  + jump-new-move: ?from - location ?over - location ?to - location
      pre: (and (free ?to) (in-line ?from ?over ?to) (move-ended) (not (equal ?from ?to)) (not (equal ?over ?to)) (occupied ?from) (occupied ?over))
      eff: (and (free ?from) (free ?over) (increase (total-cost) 1) (last-visited ?to) (not (free ?to)) (not (move-ended)) (not (occupied ?from)) (not (occupied ?over)) (occupied ?to))
