Domain: transport
Problem: transport-city-sequential-3nodes-1000size-2degree-100mindistance-2trucks-2packages-2008seed
Require:
  :action-costs
  :strips
  :typing
Type:
  capacity-number - object
  locatable - object
  location - object
  object
  package - locatable
  vehicle - locatable
Obj:
  capacity-0 - capacity-number
  capacity-1 - capacity-number
  capacity-2 - capacity-number
  capacity-3 - capacity-number
  capacity-4 - capacity-number
  city-loc-1 - location
  city-loc-2 - location
  city-loc-3 - location
  package-1 - package
  package-2 - package
  truck-1 - vehicle
  truck-2 - vehicle
Predicate:
  (= object object) :eq
  (at locatable location)
  (capacity vehicle capacity-number)
  (capacity-predecessor capacity-number capacity-number)
  (in package vehicle)
  (road location location)
Function:
  (road-length location location)
  (total-cost)
Action:
  drive: ?v - vehicle ?l1 - location ?l2 - location
      pre: (and (at ?v ?l1) (road ?l1 ?l2))
      eff: (and (at ?v ?l2) (increase (total-cost) (road-length ?l1 ?l2)) (not (at ?v ?l1)))
  drop: ?v - vehicle ?l - location ?p - package ?s1 - capacity-number ?s2 - capacity-number
      pre: (and (at ?v ?l) (capacity ?v ?s1) (capacity-predecessor ?s1 ?s2) (in ?p ?v))
      eff: (and (at ?p ?l) (capacity ?v ?s2) (increase (total-cost) 1) (not (capacity ?v ?s1)) (not (in ?p ?v)))
  pick-up: ?v - vehicle ?l - location ?p - package ?s1 - capacity-number ?s2 - capacity-number
      pre: (and (at ?p ?l) (at ?v ?l) (capacity ?v ?s2) (capacity-predecessor ?s1 ?s2))
      eff: (and (capacity ?v ?s1) (in ?p ?v) (increase (total-cost) 1) (not (at ?p ?l)) (not (capacity ?v ?s2)))
Init:
  (= (road-length city-loc-1 city-loc-3) 22)
  (= (road-length city-loc-2 city-loc-3) 50)
  (= (road-length city-loc-3 city-loc-1) 22)
  (= (road-length city-loc-3 city-loc-2) 50)
  (= (total-cost) 0)
  (at package-1 city-loc-3)
  (at package-2 city-loc-3)
  (at truck-1 city-loc-3)
  (at truck-2 city-loc-1)
  (capacity truck-1 capacity-4)
  (capacity truck-2 capacity-3)
  (capacity-predecessor capacity-0 capacity-1)
  (capacity-predecessor capacity-1 capacity-2)
  (capacity-predecessor capacity-2 capacity-3)
  (capacity-predecessor capacity-3 capacity-4)
  (road city-loc-1 city-loc-3)
  (road city-loc-2 city-loc-3)
  (road city-loc-3 city-loc-1)
  (road city-loc-3 city-loc-2)
Goal:
  (and (at package-1 city-loc-2) (at package-2 city-loc-2))
Metric:
  (total-cost)
Pred prop:
  (at locatable location): in_init in_pre in_goal in_eff
  (capacity vehicle capacity-number): in_init in_pre in_eff
  (capacity-predecessor capacity-number capacity-number): in_init in_pre
  (in package vehicle): in_pre in_eff
  (road location location): in_init in_pre
Func prop:
  (road-length location location): in_init init_all_nonneg init_all_int on_num_op_rhs write_delta_nonneg write_delta_nonneg_int
  (total-cost): in_init init_all_nonneg init_all_nonpos init_all_int in_metric is_metric_alone in_eff rhs_funcs:(road-length) write_delta_nonneg write_delta_nonneg_int
Global prop:
  action_cost_func:(total-cost)
  has_int_action_cost_func
