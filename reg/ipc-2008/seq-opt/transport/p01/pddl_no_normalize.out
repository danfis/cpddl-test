    [11]: capacity-4, type: 6, is-constant: 0, is-private: 0, owner: -1, is-agent: 0
Predicate[6]:
    =: 0 0 :: read: 0, write: 0, in-init: 0
    road: 1 1 :: read: 1, write: 0, in-init: 1
    at: 3 1 :: read: 1, write: 1, in-init: 1
    in: 5 4 :: read: 1, write: 1, in-init: 0
    capacity: 4 6 :: read: 1, write: 1, in-init: 1
    capacity-predecessor: 6 6 :: read: 1, write: 0, in-init: 1
Function[2]:
    road-length: 1 1 :: read: 1, write: 0, in-init: 1
    total-cost: :: read: 0, write: 1, in-init: 1
Action[3]:
    drive: ?v:4 ?l1:1 ?l2:1
        pre: (and (R:road ?l1 ?l2) (RW:at ?v ?l1))
        eff: (and (N:RW:at ?v ?l1) (RW:at ?v ?l2) (increase (total-cost) (road-length ?l1 ?l2)))
    pick-up: ?v:4 ?l:1 ?p:5 ?s1:6 ?s2:6
        pre: (and (R:capacity-predecessor ?s1 ?s2) (RW:at ?v ?l) (RW:at ?p ?l) (RW:capacity ?v ?s2))
        eff: (and (N:RW:at ?p ?l) (RW:in ?p ?v) (RW:capacity ?v ?s1) (N:RW:capacity ?v ?s2) (increase (total-cost) 1))
    drop: ?v:4 ?l:1 ?p:5 ?s1:6 ?s2:6
        pre: (and (R:capacity-predecessor ?s1 ?s2) (RW:at ?v ?l) (RW:in ?p ?v) (RW:capacity ?v ?s1))
        eff: (and (RW:at ?p ?l) (N:RW:in ?p ?v) (N:RW:capacity ?v ?s1) (RW:capacity ?v ?s2) (increase (total-cost) 1))
Init[14]:
  S:(road city-loc-1 city-loc-3)
  S:(road city-loc-2 city-loc-3)
  S:(road city-loc-3 city-loc-1)
  S:(road city-loc-3 city-loc-2)
  S:(capacity-predecessor capacity-0 capacity-1)
  S:(capacity-predecessor capacity-1 capacity-2)
  S:(capacity-predecessor capacity-2 capacity-3)
  S:(capacity-predecessor capacity-3 capacity-4)
  (at truck-1 city-loc-3)
  (at truck-2 city-loc-1)
  (at package-1 city-loc-3)
  (at package-2 city-loc-3)
  (capacity truck-1 capacity-4)
  (capacity truck-2 capacity-3)
Init[5]:
  (= (total-cost) 0)
  (= (road-length city-loc-3 city-loc-1) 22)
  (= (road-length city-loc-1 city-loc-3) 22)
  (= (road-length city-loc-3 city-loc-2) 50)
  (= (road-length city-loc-2 city-loc-3) 50)
Goal: (and (RW:at package-1 city-loc-2) (RW:at package-2 city-loc-2))
Metric: (total-cost)
