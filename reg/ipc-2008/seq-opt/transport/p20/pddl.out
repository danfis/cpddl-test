Predicate[6]:
    =: 0 0 :: read: 0, write: 0, in-init: 0
    road: 1 1 :: read: 1, write: 0, in-init: 1
    at: 2 1 :: read: 1, write: 1, in-init: 1
    in: 4 3 :: read: 1, write: 1, in-init: 0
    capacity: 3 5 :: read: 1, write: 1, in-init: 1
    capacity-predecessor: 5 5 :: read: 1, write: 0, in-init: 1
Function[2]:
    road-length: 1 1 :: read: 1, write: 0, in-init: 1
    total-cost: :: read: 1, write: 1, in-init: 1
Action[3]:
    drive: ?v:3 ?l1:1 ?l2:1
        pre: (and (R:road ?l1 ?l2) (RW:at ?v ?l1))
        eff: (and (N:RW:at ?v ?l1) (RW:at ?v ?l2) (increase (total-cost) (road-length ?l1 ?l2)))
    pick-up: ?v:3 ?l:1 ?p:4 ?s1:5 ?s2:5
        pre: (and (R:capacity-predecessor ?s1 ?s2) (RW:at ?v ?l) (RW:at ?p ?l) (RW:capacity ?v ?s2))
        eff: (and (N:RW:at ?p ?l) (RW:in ?p ?v) (RW:capacity ?v ?s1) (N:RW:capacity ?v ?s2) (increase (total-cost) 1))
    drop: ?v:3 ?l:1 ?p:4 ?s1:5 ?s2:5
        pre: (and (R:capacity-predecessor ?s1 ?s2) (RW:at ?v ?l) (RW:in ?p ?v) (RW:capacity ?v ?s1))
        eff: (and (RW:at ?p ?l) (N:RW:in ?p ?v) (N:RW:capacity ?v ?s1) (RW:capacity ?v ?s2) (increase (total-cost) 1))
