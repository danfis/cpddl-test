Predicate[9]:
    =: 0 0 :: read: 0, write: 0, in-init: 0
    passenger-at: 4 5 :: read: 1, write: 1, in-init: 1
    boarded: 4 1 :: read: 1, write: 1, in-init: 0
    lift-at: 1 5 :: read: 1, write: 1, in-init: 1
    reachable-floor: 1 5 :: read: 1, write: 0, in-init: 1
    above: 5 5 :: read: 1, write: 0, in-init: 1
    passengers: 1 5 :: read: 1, write: 1, in-init: 1
    can-hold: 1 5 :: read: 1, write: 0, in-init: 1
    next: 5 5 :: read: 1, write: 0, in-init: 1
Function[3]:
    total-cost: :: read: 1, write: 1, in-init: 1
    travel-slow: 5 5 :: read: 1, write: 0, in-init: 1
    travel-fast: 5 5 :: read: 1, write: 0, in-init: 1
Action[6]:
    move-up-slow: ?lift:2 ?f1:5 ?f2:5
        pre: (and (R:reachable-floor ?lift ?f2) (R:above ?f1 ?f2) (RW:lift-at ?lift ?f1))
        eff: (and (N:RW:lift-at ?lift ?f1) (RW:lift-at ?lift ?f2) (increase (total-cost) (travel-slow ?f1 ?f2)))
    move-down-slow: ?lift:2 ?f1:5 ?f2:5
        pre: (and (R:reachable-floor ?lift ?f2) (R:above ?f2 ?f1) (RW:lift-at ?lift ?f1))
        eff: (and (N:RW:lift-at ?lift ?f1) (RW:lift-at ?lift ?f2) (increase (total-cost) (travel-slow ?f2 ?f1)))
    move-up-fast: ?lift:3 ?f1:5 ?f2:5
        pre: (and (R:reachable-floor ?lift ?f2) (R:above ?f1 ?f2) (RW:lift-at ?lift ?f1))
        eff: (and (N:RW:lift-at ?lift ?f1) (RW:lift-at ?lift ?f2) (increase (total-cost) (travel-fast ?f1 ?f2)))
    move-down-fast: ?lift:3 ?f1:5 ?f2:5
        pre: (and (R:reachable-floor ?lift ?f2) (R:above ?f2 ?f1) (RW:lift-at ?lift ?f1))
        eff: (and (N:RW:lift-at ?lift ?f1) (RW:lift-at ?lift ?f2) (increase (total-cost) (travel-fast ?f2 ?f1)))
    board: ?p:4 ?lift:1 ?f:5 ?n1:5 ?n2:5
        pre: (and (R:can-hold ?lift ?n2) (R:next ?n1 ?n2) (RW:passenger-at ?p ?f) (RW:lift-at ?lift ?f) (RW:passengers ?lift ?n1))
        eff: (and (N:RW:passenger-at ?p ?f) (RW:boarded ?p ?lift) (N:RW:passengers ?lift ?n1) (RW:passengers ?lift ?n2))
    leave: ?p:4 ?lift:1 ?f:5 ?n1:5 ?n2:5
        pre: (and (R:next ?n2 ?n1) (RW:boarded ?p ?lift) (RW:lift-at ?lift ?f) (RW:passengers ?lift ?n1))
        eff: (and (RW:passenger-at ?p ?f) (N:RW:boarded ?p ?lift) (N:RW:passengers ?lift ?n1) (RW:passengers ?lift ?n2))
