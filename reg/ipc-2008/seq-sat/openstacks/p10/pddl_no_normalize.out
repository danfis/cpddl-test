    includes: 1 2 :: is-private: 0, owner-param: -1, read: 1, write: 0
    waiting: 1 :: is-private: 0, owner-param: -1, read: 1, write: 1
    started: 1 :: is-private: 0, owner-param: -1, read: 1, write: 1
