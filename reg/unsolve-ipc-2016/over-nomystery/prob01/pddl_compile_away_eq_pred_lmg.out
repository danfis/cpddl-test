Require:
  - :equality
Predicate:
  + (equal object object)
Action:
  - load: ?p - package ?t - truck ?l - location
      pre: (and (= ?t t0) (at ?p ?l) (at t0 ?l))
      eff: (and (in ?p t0) (not (at ?p ?l)))
  - load: ?p - package ?t - truck ?l - location
      pre: (and (at ?p ?l) (at ?t ?l) (not (= ?p p0)) (not (= ?p p1)) (not (= ?p p2)) (not (= ?p p3)) (not (= ?p p4)) (not (= ?p p5)) (not (= ?p p6)) (not (= ?p p7)))
      eff: (and (in ?p ?t) (not (at ?p ?l)))
  + load: ?p - package ?t - truck ?l - location
      pre: (and (at ?p ?l) (at ?t ?l) (not (equal ?p p0)) (not (equal ?p p1)) (not (equal ?p p2)) (not (equal ?p p3)) (not (equal ?p p4)) (not (equal ?p p5)) (not (equal ?p p6)) (not (equal ?p p7)))
      eff: (and (in ?p ?t) (not (at ?p ?l)))
  + load: ?p - package ?t - truck ?l - location
      pre: (and (at ?p ?l) (at t0 ?l) (equal ?t t0))
      eff: (and (in ?p t0) (not (at ?p ?l)))
Init:
  + (equal p0 p0)
  + (equal p1 p1)
  + (equal p2 p2)
  + (equal p3 p3)
  + (equal p4 p4)
  + (equal p5 p5)
  + (equal p6 p6)
  + (equal p7 p7)
  + (equal t0 t0)
Pred prop:
  - (= object object): in_pre in_pre_neg
  + (equal object object): in_init in_pre in_pre_neg
Global prop:
  - has_eq_pred
