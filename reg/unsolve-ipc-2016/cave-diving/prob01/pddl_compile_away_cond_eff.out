  S:(connected l2 l1)
  S:(next-quantity zero one)
  S:(next-quantity one two)
  S:(next-quantity two three)
  S:(next-quantity three four)
  (in-storage t0)
  (available d0)
  (available d1)
  (capacity d0 four)
  (capacity d1 four)
