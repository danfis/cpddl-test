Domain: cave-diving-strips
Problem: cave-diving-strips-satprob02
Require:
  :conditional-effects
  :disjunctive-preconditions
  :equality
  :existential-preconditions
  :negative-preconditions
  :strips
  :typing
  :universal-preconditions
Type:
  diver - object
  location - object
  object
  quantity - object
  tank - object
Obj:
  d0 - diver :constant
  d1 - diver :constant
  d2 - diver :constant
  d3 - diver :constant
  dummy - tank
  four - quantity
  l0 - location
  l1 - location
  l2 - location
  l3 - location
  l4 - location
  one - quantity
  t0 - tank
  t1 - tank
  t10 - tank
  t11 - tank
  t12 - tank
  t13 - tank
  t14 - tank
  t2 - tank
  t3 - tank
  t4 - tank
  t5 - tank
  t6 - tank
  t7 - tank
  t8 - tank
  t9 - tank
  three - quantity
  two - quantity
  zero - quantity
Predicate:
  (= object object) :eq
  (at-diver diver location)
  (at-surface diver)
  (at-tank tank location)
  (available diver)
  (capacity diver quantity)
  (cave-entrance location)
  (connected location location)
  (decompressing diver)
  (full tank)
  (have-photo location)
  (holding diver tank)
  (in-storage tank)
  (in-water)
  (next-quantity quantity quantity)
  (next-tank tank tank)
Function:
Action:
  decompress: ?d - diver ?l - location
      pre: (and (at-diver ?d ?l) (cave-entrance ?l))
      eff: (and (decompressing ?d) (not (at-diver ?d ?l)) (not (in-water)))
  drop-tank: ?d - diver ?t - tank ?l - location ?q1 - quantity ?q2 - quantity
      pre: (and (at-diver ?d ?l) (capacity ?d ?q1) (holding ?d ?t) (next-quantity ?q1 ?q2))
      eff: (and (at-tank ?t ?l) (capacity ?d ?q2) (not (capacity ?d ?q1)) (not (holding ?d ?t)))
  enter-water: ?d - diver ?l - location
      pre: (and (at-surface ?d) (cave-entrance ?l))
      eff: (and (at-diver ?d ?l) (not (at-surface ?d)))
  hire-diver-d0:
      pre: (and (available d0))
      eff: (and (at-surface d0) (not (available d0)))
  hire-diver-d1:
      pre: (and (available d1))
      eff: (and (at-surface d1) (not (available d1)))
  hire-diver-d2:
      pre: (and (available d2))
      eff: (and (at-surface d2) (not (available d2)))
  hire-diver-d3:
      pre: (and (available d3))
      eff: (and (at-surface d3) (not (available d3)))
  photograph: ?d - diver ?l - location ?t - tank
      pre: (and (at-diver ?d ?l) (full ?t) (holding ?d ?t))
      eff: (and (have-photo ?l) (not (full ?t)))
  pickup-tank: ?d - diver ?t - tank ?l - location ?q1 - quantity ?q2 - quantity
      pre: (and (at-diver ?d ?l) (at-tank ?t ?l) (capacity ?d ?q2) (next-quantity ?q1 ?q2))
      eff: (and (capacity ?d ?q1) (holding ?d ?t) (not (at-tank ?t ?l)) (not (capacity ?d ?q2)))
  prepare-tank: ?d - diver ?t1 - tank ?t2 - tank ?q1 - quantity ?q2 - quantity
      pre: (and (at-surface ?d) (capacity ?d ?q2) (in-storage ?t1) (next-quantity ?q1 ?q2) (next-tank ?t1 ?t2))
      eff: (and (capacity ?d ?q1) (full ?t1) (holding ?d ?t1) (in-storage ?t2) (not (capacity ?d ?q2)) (not (in-storage ?t1)))
  swim: ?d - diver ?t - tank ?l1 - location ?l2 - location
      pre: (and (at-diver ?d ?l1) (connected ?l1 ?l2) (full ?t) (holding ?d ?t))
      eff: (and (at-diver ?d ?l2) (not (at-diver ?d ?l1)) (not (full ?t)))
Init:
  (available d0)
  (available d1)
  (available d2)
  (available d3)
  (capacity d0 four)
  (capacity d1 four)
  (capacity d2 four)
  (capacity d3 four)
  (cave-entrance l0)
  (connected l0 l1)
  (connected l0 l3)
  (connected l1 l0)
  (connected l1 l2)
  (connected l2 l1)
  (connected l3 l0)
  (connected l3 l4)
  (connected l4 l3)
  (in-storage t0)
  (next-quantity one two)
  (next-quantity three four)
  (next-quantity two three)
  (next-quantity zero one)
  (next-tank t0 t1)
  (next-tank t1 t2)
  (next-tank t10 t11)
  (next-tank t11 t12)
  (next-tank t12 t13)
  (next-tank t13 t14)
  (next-tank t14 dummy)
  (next-tank t2 t3)
  (next-tank t3 t4)
  (next-tank t4 t5)
  (next-tank t5 t6)
  (next-tank t6 t7)
  (next-tank t7 t8)
  (next-tank t8 t9)
  (next-tank t9 t10)
Goal:
  (and (decompressing d0) (decompressing d1) (decompressing d2) (decompressing d3) (have-photo l2) (have-photo l4))
Metric:
Pred prop:
  (at-diver diver location): in_pre in_eff
  (at-surface diver): in_pre in_eff
  (at-tank tank location): in_pre in_eff
  (available diver): in_init in_pre in_eff
  (capacity diver quantity): in_init in_pre in_eff
  (cave-entrance location): in_init in_pre
  (connected location location): in_init in_pre
  (decompressing diver): in_goal in_eff
  (full tank): in_pre in_eff
  (have-photo location): in_goal in_eff
  (holding diver tank): in_pre in_eff
  (in-storage tank): in_init in_pre in_eff
  (in-water): in_eff
  (next-quantity quantity quantity): in_init in_pre
  (next-tank tank tank): in_init in_pre
Func prop:
Global prop:
  is_unit_cost
