Function[0]:
Action[11]:
    hire-diver-d2: 
        pre: (and (RW:available d2))
        eff: (and (N:RW:available d2) (RW:at-surface d2))
    hire-diver-d3: 
        pre: (and (RW:available d3))
        eff: (and (N:RW:available d3) (RW:at-surface d3))
    hire-diver-d1: 
        pre: (and (RW:available d1))
        eff: (and (N:RW:available d1) (RW:at-surface d1))
    hire-diver-d0: 
        pre: (and (RW:available d0))
        eff: (and (N:RW:available d0) (RW:at-surface d0))
    prepare-tank: ?d:2 ?t1:3 ?t2:3 ?q1:4 ?q2:4
        pre: (and (R:next-tank ?t1 ?t2) (R:next-quantity ?q1 ?q2) (RW:in-storage ?t1) (RW:at-surface ?d) (RW:capacity ?d ?q2))
        eff: (and (N:RW:in-storage ?t1) (RW:in-storage ?t2) (RW:full ?t1) (RW:holding ?d ?t1) (RW:capacity ?d ?q1) (N:RW:capacity ?d ?q2))
    enter-water: ?d:2 ?l:1
        pre: (and (R:cave-entrance ?l) (RW:at-surface ?d))
        eff: (and (RW:at-diver ?d ?l) (N:RW:at-surface ?d))
    pickup-tank: ?d:2 ?t:3 ?l:1 ?q1:4 ?q2:4
        pre: (and (R:next-quantity ?q1 ?q2) (RW:at-tank ?t ?l) (RW:at-diver ?d ?l) (RW:capacity ?d ?q2))
        eff: (and (N:RW:at-tank ?t ?l) (RW:holding ?d ?t) (RW:capacity ?d ?q1) (N:RW:capacity ?d ?q2))
    drop-tank: ?d:2 ?t:3 ?l:1 ?q1:4 ?q2:4
        pre: (and (R:next-quantity ?q1 ?q2) (RW:at-diver ?d ?l) (RW:holding ?d ?t) (RW:capacity ?d ?q1))
        eff: (and (RW:at-tank ?t ?l) (N:RW:holding ?d ?t) (N:RW:capacity ?d ?q1) (RW:capacity ?d ?q2))
    swim: ?d:2 ?t:3 ?l1:1 ?l2:1
        pre: (and (R:connected ?l1 ?l2) (RW:full ?t) (RW:at-diver ?d ?l1) (RW:holding ?d ?t))
        eff: (and (N:RW:full ?t) (N:RW:at-diver ?d ?l1) (RW:at-diver ?d ?l2))
    photograph: ?d:2 ?l:1 ?t:3
        pre: (and (RW:full ?t) (RW:at-diver ?d ?l) (RW:holding ?d ?t))
        eff: (and (N:RW:full ?t) (RW:have-photo ?l))
    decompress: ?d:2 ?l:1
        pre: (and (R:cave-entrance ?l) (RW:at-diver ?d ?l))
        eff: (and (N:RW:at-diver ?d ?l) (RW:decompressing ?d) (N:W:in-water))
