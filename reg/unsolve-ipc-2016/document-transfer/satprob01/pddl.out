Function:
Action:
  deposit-documents: ?l - location ?d - document
      pre: (and (in-train ?d) (train-at ?l))
      eff: (and (at ?d ?l) (not (in-train ?d)))
  drive: ?l1 - location ?l2 - location ?g - document
      pre: (and (in-train ?g) (track ?l1 ?l2) (train-at ?l1))
      eff: (and (not (in-train ?g)) (not (train-at ?l1)) (train-at ?l2))
  pickup-documents: ?l - location ?d - document
      pre: (and (at ?d ?l) (train-at ?l))
      eff: (and (in-train ?d) (not (at ?d ?l)))
