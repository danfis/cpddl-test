Require:
  + :equality
  + :negative-preconditions
Action:
  - move: ?from - location ?xsucc - location ?ysucc - location
      pre: (and (free ?xsucc) (free ?ysucc) (occupied ?from) (x-succ ?from ?xsucc) (y-succ ?from ?ysucc))
      eff: (and (free ?from) (not (free ?xsucc)) (not (free ?ysucc)) (not (occupied ?from)) (occupied ?xsucc) (occupied ?ysucc))
  + move: ?from - location ?xsucc - location ?ysucc - location
      pre: (and (free ?xsucc) (free ?ysucc) (not (= ?from ?xsucc)) (not (= ?from ?ysucc)) (occupied ?from) (x-succ ?from ?xsucc) (y-succ ?from ?ysucc))
      eff: (and (free ?from) (not (free ?xsucc)) (not (free ?ysucc)) (not (occupied ?from)) (occupied ?xsucc) (occupied ?ysucc))
Pred prop:
  + (= object object): in_pre in_pre_neg
Global prop:
  + has_eq_pred
