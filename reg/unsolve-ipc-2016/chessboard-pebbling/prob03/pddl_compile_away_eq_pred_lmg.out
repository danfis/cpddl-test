Require:
  - :equality
Predicate:
  + (equal object object)
Action:
  - move: ?from - location ?xsucc - location ?ysucc - location
      pre: (and (free ?xsucc) (free ?ysucc) (not (= ?from ?xsucc)) (not (= ?from ?ysucc)) (occupied ?from) (x-succ ?from ?xsucc) (y-succ ?from ?ysucc))
      eff: (and (free ?from) (not (free ?xsucc)) (not (free ?ysucc)) (not (occupied ?from)) (occupied ?xsucc) (occupied ?ysucc))
  + move: ?from - location ?xsucc - location ?ysucc - location
      pre: (and (free ?xsucc) (free ?ysucc) (not (equal ?from ?xsucc)) (not (equal ?from ?ysucc)) (occupied ?from) (x-succ ?from ?xsucc) (y-succ ?from ?ysucc))
      eff: (and (free ?from) (not (free ?xsucc)) (not (free ?ysucc)) (not (occupied ?from)) (occupied ?xsucc) (occupied ?ysucc))
Init:
  + (equal pos-0-0 pos-0-0)
  + (equal pos-0-1 pos-0-1)
  + (equal pos-0-2 pos-0-2)
  + (equal pos-0-3 pos-0-3)
  + (equal pos-0-4 pos-0-4)
  + (equal pos-1-0 pos-1-0)
  + (equal pos-1-1 pos-1-1)
  + (equal pos-1-2 pos-1-2)
  + (equal pos-1-3 pos-1-3)
  + (equal pos-1-4 pos-1-4)
  + (equal pos-2-0 pos-2-0)
  + (equal pos-2-1 pos-2-1)
  + (equal pos-2-2 pos-2-2)
  + (equal pos-2-3 pos-2-3)
  + (equal pos-2-4 pos-2-4)
  + (equal pos-3-0 pos-3-0)
  + (equal pos-3-1 pos-3-1)
  + (equal pos-3-2 pos-3-2)
  + (equal pos-3-3 pos-3-3)
  + (equal pos-3-4 pos-3-4)
  + (equal pos-4-0 pos-4-0)
  + (equal pos-4-1 pos-4-1)
  + (equal pos-4-2 pos-4-2)
  + (equal pos-4-3 pos-4-3)
  + (equal pos-4-4 pos-4-4)
Pred prop:
  - (= object object): in_pre
  + (equal object object): in_init in_pre
