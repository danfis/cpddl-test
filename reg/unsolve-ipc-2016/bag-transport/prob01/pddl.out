Action:
  drive: ?v - vehicle ?l1 - location ?l2 - location
      pre: (and (at-vehicle ?v ?l1) (road ?l1 ?l2))
      eff: (and (at-vehicle ?v ?l2) (increase (total-cost) (road-length ?l1 ?l2)) (not (at-vehicle ?v ?l1)))
  drop: ?v - vehicle ?l - location ?p - package ?s1 - capacity-number ?s2 - capacity-number ?n1 - pnum ?n0 - pnum ?n2 - pnum ?n3 - pnum ?p-size - pnum
      pre: (and (at-vehicle ?v ?l) (capacity ?v ?s1) (capacity-predecessor ?s1 ?s2) (count-package ?p ?l ?n2) (count-package ?p ?v ?n1) (package-bag-size ?p ?p-size) (package-less ?n0 ?n1) (package-less ?n2 ?n3) (package-lte-sum ?n1 ?n2 ?p-size))
      eff: (and (capacity ?v ?s2) (count-package ?p ?l ?n3) (count-package ?p ?v ?n0) (increase (total-cost) 1) (not (capacity ?v ?s1)) (not (count-package ?p ?l ?n2)) (not (count-package ?p ?v ?n1)))
  pick-up: ?v - vehicle ?l - location ?p - package ?s1 - capacity-number ?s2 - capacity-number ?n1 - pnum ?n0 - pnum ?n2 - pnum ?n3 - pnum ?p-size - pnum
      pre: (and (at-vehicle ?v ?l) (capacity ?v ?s2) (capacity-predecessor ?s1 ?s2) (count-package ?p ?l ?n1) (count-package ?p ?v ?n2) (package-bag-size ?p ?p-size) (package-less ?n0 ?n1) (package-less ?n2 ?n3) (package-lte-sum ?n1 ?n2 ?p-size))
      eff: (and (capacity ?v ?s1) (count-package ?p ?l ?n0) (count-package ?p ?v ?n3) (increase (total-cost) 1) (not (capacity ?v ?s2)) (not (count-package ?p ?l ?n1)) (not (count-package ?p ?v ?n2)))
