Function[0]:
Action[4]:
    drive: ?t:7 ?from:3 ?to:3 ?moneypre:2 ?moneydelta:2 ?moneypost:2
        pre: (and (R:connected ?from ?to) (R:drive-cost ?from ?to ?moneydelta) (R:sum ?moneypost ?moneydelta ?moneypre) (RW:at ?t ?from) (RW:money ?moneypre))
        eff: (and (N:RW:at ?t ?from) (RW:at ?t ?to) (N:RW:money ?moneypre) (RW:money ?moneypost))
    buy: ?t:7 ?g:8 ?m:5 ?moneypre:2 ?moneydelta:2 ?moneypost:2
        pre: (and (R:price ?g ?m ?moneydelta) (R:sum ?moneypost ?moneydelta ?moneypre) (RW:on-sale ?g ?m) (RW:money ?moneypre))
        eff: (and (N:RW:on-sale ?g ?m) (RW:available ?g ?m) (N:RW:money ?moneypre) (RW:money ?moneypost))
    load: ?g:8 ?t:7 ?m:5
        pre: (and (RW:at ?t ?m) (RW:available ?g ?m))
        eff: (and (N:RW:available ?g ?m) (RW:loaded ?g ?t))
    unload: ?t:7 ?g:8 ?d:4
        pre: (and (RW:at ?t ?d) (RW:loaded ?g ?t))
        eff: (and (N:RW:loaded ?g ?t) (RW:stored ?g))
