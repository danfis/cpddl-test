  handempty-true - hand-property1 :constant
  hnum0 - hnum :constant
  hnum1 - hnum :constant
  hnum2 - hnum :constant
  ingredient1 - ingredient :constant
  ingredient2 - ingredient :constant
  ingredient3 - ingredient :constant
  l0 - level :constant
  l1 - level :constant
  l2 - level :constant
  ontable-true - shot-property1 :constant
  shaker1 - shaker :constant
  shot-bag1 - shot :constant
  shot-property2-none - shot-property2 :constant
  snum0 - snum :constant
  snum1 - snum :constant
  snum2 - snum :constant
  snum3 - snum :constant
  snum4 - snum :constant
Predicate:
  (= object object) :eq
  (clean-shaker shaker)
  (cocktail-part1 cocktail ingredient)
  (cocktail-part2 cocktail ingredient)
  (contains-shaker shaker beverage)
  (count-hand hand object hnum)
  (count-shot shot object object object snum)
  (count-shot-goal shot object snum)
  (count-shot-goal-desired-count shot object snum)
  (count-shot-goal-satisfied shot object)
  (dispenses dispenser ingredient)
  (empty-shaker shaker)
  (hand-bag-size hand hnum)
  (hand-less hnum hnum)
  (hand-lte-sum hnum hnum hnum)
  (next level level)
  (ontable container)
  (shaked shaker)
  (shaker-empty-level shaker level)
  (shaker-level shaker level)
  (shot-bag-size shot snum)
  (shot-less snum snum)
  (shot-lte-sum snum snum snum)
  (unshaked shaker)
Function:
  (total-cost) :total-cost
