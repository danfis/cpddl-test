Domain: barman
Problem: prob
Require:
  :action-costs
  :equality
  :negative-preconditions
  :strips
  :typing
Type:
  beverage - object
  cocktail - beverage
  container - object
  dispenser - object
  hand - object
  hand-property1 - object
  hnum - object
  ingredient - beverage
  level - object
  object
  shaker - container
  shot - container
  shot-property1 - object
  shot-property2 - object
  shot-property3 - object
  snum - object
Obj:
  clean-shot-true - shot-property2 :constant
  cocktail1 - cocktail :constant
  cocktail2 - cocktail :constant
  cocktail3 - cocktail :constant
  dispenser1 - dispenser :constant
  dispenser2 - dispenser :constant
  dispenser3 - dispenser :constant
  empty-shot-true - shot-property3 :constant
