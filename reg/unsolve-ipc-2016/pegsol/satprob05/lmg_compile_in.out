Require:
  + :equality
  + :negative-preconditions
Action:
  - jump: ?from - location ?over - location ?to - location
      pre: (and (free ?to) (in-line ?from ?over ?to) (occupied ?from) (occupied ?over))
      eff: (and (free ?from) (free ?over) (not (free ?to)) (not (occupied ?from)) (not (occupied ?over)) (occupied ?to))
  + jump: ?from - location ?over - location ?to - location
      pre: (and (free ?to) (in-line ?from ?over ?to) (not (= ?from ?to)) (not (= ?over ?to)) (occupied ?from) (occupied ?over))
      eff: (and (free ?from) (free ?over) (not (free ?to)) (not (occupied ?from)) (not (occupied ?over)) (occupied ?to))
Pred prop:
  + (= object object): in_pre
