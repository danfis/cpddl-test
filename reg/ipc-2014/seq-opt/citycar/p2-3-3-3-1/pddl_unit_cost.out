Domain: citycar
Problem: citycar-2-3-3
Require:
  :conditional-effects
  :strips
  :typing
Type:
  car - object
  garage - object
  junction - object
  object
  road - object
Obj:
  car0 - car
  car1 - car
  car2 - car
  garage0 - garage
  garage1 - garage
  garage2 - garage
  junction0-0 - junction
  junction0-1 - junction
  junction0-2 - junction
  junction1-0 - junction
  junction1-1 - junction
  junction1-2 - junction
  road0 - road
  road1 - road
  road2 - road
  road3 - road
Predicate:
  (= object object) :eq
  (NOT-in_place road) neg-of (in_place)
  (arrived car junction)
  (at_car_jun car junction)
  (at_car_road car road)
  (at_garage garage junction)
  (clear junction)
  (diagonal junction junction)
  (in_place road) neg-of (NOT-in_place)
  (road_connect road junction junction)
  (same_line junction junction)
  (starting car garage)
Function:
Action:
  build_diagonal_oneway: ?xy_initial - junction ?xy_final - junction ?r1 - road
      pre: (and (NOT-in_place ?r1) (clear ?xy_final) (diagonal ?xy_initial ?xy_final))
      eff: (and (in_place ?r1) (not (NOT-in_place ?r1)) (road_connect ?r1 ?xy_initial ?xy_final))
  build_straight_oneway: ?xy_initial - junction ?xy_final - junction ?r1 - road
      pre: (and (NOT-in_place ?r1) (clear ?xy_final) (same_line ?xy_initial ?xy_final))
      eff: (and (in_place ?r1) (not (NOT-in_place ?r1)) (road_connect ?r1 ?xy_initial ?xy_final))
  car_arrived: ?xy_final - junction ?machine - car
      pre: (and (at_car_jun ?machine ?xy_final))
      eff: (and (arrived ?machine ?xy_final) (clear ?xy_final) (not (at_car_jun ?machine ?xy_final)))
  car_start: ?xy_final - junction ?machine - car ?g - garage
      pre: (and (at_garage ?g ?xy_final) (clear ?xy_final) (starting ?machine ?g))
      eff: (and (at_car_jun ?machine ?xy_final) (not (clear ?xy_final)) (not (starting ?machine ?g)))
  destroy_road: ?xy_initial - junction ?xy_final - junction ?r1 - road
      pre: (and (in_place ?r1) (road_connect ?r1 ?xy_initial ?xy_final))
      eff: (and (NOT-in_place ?r1) (not (in_place ?r1)) (not (road_connect ?r1 ?xy_initial ?xy_final)) (when (at_car_road car0 ?r1) (and (at_car_jun car0 ?xy_initial) (not (at_car_road car0 ?r1)))) (when (at_car_road car1 ?r1) (and (at_car_jun car1 ?xy_initial) (not (at_car_road car1 ?r1)))) (when (at_car_road car2 ?r1) (and (at_car_jun car2 ?xy_initial) (not (at_car_road car2 ?r1)))))
  move_car_in_road: ?xy_initial - junction ?xy_final - junction ?machine - car ?r1 - road
      pre: (and (at_car_jun ?machine ?xy_initial) (in_place ?r1) (road_connect ?r1 ?xy_initial ?xy_final))
      eff: (and (at_car_road ?machine ?r1) (clear ?xy_initial) (not (at_car_jun ?machine ?xy_initial)))
  move_car_out_road: ?xy_initial - junction ?xy_final - junction ?machine - car ?r1 - road
      pre: (and (at_car_road ?machine ?r1) (clear ?xy_final) (in_place ?r1) (road_connect ?r1 ?xy_initial ?xy_final))
      eff: (and (at_car_jun ?machine ?xy_final) (not (at_car_road ?machine ?r1)) (not (clear ?xy_final)))
Init:
  (NOT-in_place road0)
  (NOT-in_place road1)
  (NOT-in_place road2)
  (NOT-in_place road3)
  (at_garage garage0 junction0-2)
  (at_garage garage1 junction0-0)
  (at_garage garage2 junction0-2)
  (clear junction0-0)
  (clear junction0-1)
  (clear junction0-2)
  (clear junction1-0)
  (clear junction1-1)
  (clear junction1-2)
  (diagonal junction0-0 junction1-1)
  (diagonal junction0-1 junction1-0)
  (diagonal junction0-1 junction1-2)
  (diagonal junction0-2 junction1-1)
  (diagonal junction1-0 junction0-1)
  (diagonal junction1-1 junction0-0)
  (diagonal junction1-1 junction0-2)
  (diagonal junction1-2 junction0-1)
  (same_line junction0-0 junction0-1)
  (same_line junction0-0 junction1-0)
  (same_line junction0-1 junction0-0)
  (same_line junction0-1 junction0-2)
  (same_line junction0-1 junction1-1)
  (same_line junction0-2 junction0-1)
  (same_line junction0-2 junction1-2)
  (same_line junction1-0 junction0-0)
  (same_line junction1-0 junction1-1)
  (same_line junction1-1 junction0-1)
  (same_line junction1-1 junction1-0)
  (same_line junction1-1 junction1-2)
  (same_line junction1-2 junction0-2)
  (same_line junction1-2 junction1-1)
  (starting car0 garage2)
  (starting car1 garage1)
  (starting car2 garage1)
Goal:
  (and (arrived car0 junction1-1) (arrived car1 junction1-1) (arrived car2 junction1-0))
Metric:
Pred prop:
  (NOT-in_place road): in_init in_pre in_eff
  (arrived car junction): in_goal in_eff
  (at_car_jun car junction): in_pre in_eff
  (at_car_road car road): in_pre in_eff
  (at_garage garage junction): in_init in_pre
  (clear junction): in_init in_pre in_eff
  (diagonal junction junction): in_init in_pre
  (in_place road): in_pre in_eff
  (road_connect road junction junction): in_pre in_eff
  (same_line junction junction): in_init in_pre
  (starting car garage): in_init in_pre in_eff
Func prop:
Global prop:
