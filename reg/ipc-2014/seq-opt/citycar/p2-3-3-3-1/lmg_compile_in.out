Action[9]:
    move_car_in_road: ?xy_initial:2 ?xy_final:2 ?machine:1 ?r1:4
        pre: (and (RW:at_car_jun ?machine ?xy_initial) (RW:road_connect ?r1 ?xy_initial ?xy_final) (RW:in_place ?r1))
        eff: (and (N:RW:at_car_jun ?machine ?xy_initial) (RW:at_car_road ?machine ?r1) (RW:clear ?xy_initial) (increase (total-cost) 1))
    move_car_out_road: ?xy_initial:2 ?xy_final:2 ?machine:1 ?r1:4
        pre: (and (RW:at_car_road ?machine ?r1) (RW:road_connect ?r1 ?xy_initial ?xy_final) (RW:clear ?xy_final) (RW:in_place ?r1))
        eff: (and (RW:at_car_jun ?machine ?xy_final) (N:RW:at_car_road ?machine ?r1) (N:RW:clear ?xy_final) (increase (total-cost) 1))
    car_arrived: ?xy_final:2 ?machine:1
        pre: (and (R:= ?xy_final junction1-1) (N:R:= ?machine car2) (RW:at_car_jun ?machine junction1-1))
        eff: (and (N:RW:at_car_jun ?machine junction1-1) (W:arrived ?machine junction1-1) (RW:clear junction1-1))
    car_start: ?xy_final:2 ?machine:1 ?g:3
        pre: (and (R:at_garage ?g ?xy_final) (RW:starting ?machine ?g) (RW:clear ?xy_final))
        eff: (and (RW:at_car_jun ?machine ?xy_final) (N:RW:starting ?machine ?g) (N:RW:clear ?xy_final))
    build_diagonal_oneway: ?xy_initial:2 ?xy_final:2 ?r1:4
        pre: (and (R:diagonal ?xy_initial ?xy_final) (RW:clear ?xy_final) (RW:NOT-in_place ?r1))
        eff: (and (RW:road_connect ?r1 ?xy_initial ?xy_final) (RW:in_place ?r1) (N:RW:NOT-in_place ?r1) (increase (total-cost) 30))
    build_straight_oneway: ?xy_initial:2 ?xy_final:2 ?r1:4
        pre: (and (R:same_line ?xy_initial ?xy_final) (RW:clear ?xy_final) (RW:NOT-in_place ?r1))
        eff: (and (RW:road_connect ?r1 ?xy_initial ?xy_final) (RW:in_place ?r1) (N:RW:NOT-in_place ?r1) (increase (total-cost) 20))
    destroy_road: ?xy_initial:2 ?xy_final:2 ?r1:4
        pre: (and (RW:road_connect ?r1 ?xy_initial ?xy_final) (RW:in_place ?r1))
        eff: (and (N:RW:road_connect ?r1 ?xy_initial ?xy_final) (N:RW:in_place ?r1) (RW:NOT-in_place ?r1) (increase (total-cost) 10) (when (RW:at_car_road car0 ?r1) (and (N:RW:at_car_road car0 ?r1) (RW:at_car_jun car0 ?xy_initial))) (when (RW:at_car_road car1 ?r1) (and (N:RW:at_car_road car1 ?r1) (RW:at_car_jun car1 ?xy_initial))) (when (RW:at_car_road car2 ?r1) (and (N:RW:at_car_road car2 ?r1) (RW:at_car_jun car2 ?xy_initial))))
    car_arrived: ?xy_final:2 ?machine:1
        pre: (and (R:= ?xy_final junction1-0) (N:R:= ?machine car0) (N:R:= ?machine car1) (RW:at_car_jun ?machine junction1-0))
        eff: (and (N:RW:at_car_jun ?machine junction1-0) (W:arrived ?machine junction1-0) (RW:clear junction1-0))
    car_arrived: ?xy_final:2 ?machine:1
        pre: (and (N:R:= ?machine car0) (N:R:= ?machine car1) (N:R:= ?machine car2) (RW:at_car_jun ?machine ?xy_final))
        eff: (and (N:RW:at_car_jun ?machine ?xy_final) (W:arrived ?machine ?xy_final) (RW:clear ?xy_final))
