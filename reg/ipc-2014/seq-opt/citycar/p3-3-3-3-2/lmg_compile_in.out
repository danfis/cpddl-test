Require:
  + :equality
  + :negative-preconditions
Action:
  - car_arrived: ?xy_final - junction ?machine - car
      pre: (and (at_car_jun ?machine ?xy_final))
      eff: (and (arrived ?machine ?xy_final) (clear ?xy_final) (not (at_car_jun ?machine ?xy_final)))
  + car_arrived: ?xy_final - junction ?machine - car
      pre: (and (= ?xy_final junction2-0) (at_car_jun ?machine junction2-0) (not (= ?machine car0)))
      eff: (and (arrived ?machine junction2-0) (clear junction2-0) (not (at_car_jun ?machine junction2-0)))
  + car_arrived: ?xy_final - junction ?machine - car
      pre: (and (= ?xy_final junction2-1) (at_car_jun ?machine junction2-1) (not (= ?machine car1)) (not (= ?machine car2)))
      eff: (and (arrived ?machine junction2-1) (clear junction2-1) (not (at_car_jun ?machine junction2-1)))
  + car_arrived: ?xy_final - junction ?machine - car
      pre: (and (at_car_jun ?machine ?xy_final) (not (= ?machine car0)) (not (= ?machine car1)) (not (= ?machine car2)))
      eff: (and (arrived ?machine ?xy_final) (clear ?xy_final) (not (at_car_jun ?machine ?xy_final)))
Pred prop:
  + (= object object): in_pre in_pre_neg
Global prop:
  + has_eq_pred
