Predicate[12]:
    =: 0 0 :: read: 0, write: 0, in-init: 0
    same_line: 2 2 :: read: 1, write: 0, in-init: 1
    diagonal: 2 2 :: read: 1, write: 0, in-init: 1
    at_car_jun: 1 2 :: read: 1, write: 1, in-init: 0
    at_car_road: 1 4 :: read: 1, write: 1, in-init: 0
    starting: 1 3 :: read: 1, write: 1, in-init: 1
    arrived: 1 2 :: read: 1, write: 1, in-init: 0
    road_connect: 4 2 2 :: read: 1, write: 1, in-init: 0
    clear: 2 :: read: 1, write: 1, in-init: 1
    in_place: 4 :: read: 1, write: 1, in-init: 0, neg-of: NOT-in_place
    at_garage: 3 2 :: read: 1, write: 0, in-init: 1
    NOT-in_place: 4 :: read: 1, write: 1, in-init: 1, neg-of: in_place
Function[1]:
    total-cost: :: read: 1, write: 1, in-init: 1
Action[7]:
    move_car_in_road: ?xy_initial:2 ?xy_final:2 ?machine:1 ?r1:4
        pre: (and (RW:at_car_jun ?machine ?xy_initial) (RW:road_connect ?r1 ?xy_initial ?xy_final) (RW:in_place ?r1))
        eff: (and (N:RW:at_car_jun ?machine ?xy_initial) (RW:at_car_road ?machine ?r1) (RW:clear ?xy_initial))
    move_car_out_road: ?xy_initial:2 ?xy_final:2 ?machine:1 ?r1:4
        pre: (and (RW:at_car_road ?machine ?r1) (RW:road_connect ?r1 ?xy_initial ?xy_final) (RW:clear ?xy_final) (RW:in_place ?r1))
        eff: (and (RW:at_car_jun ?machine ?xy_final) (N:RW:at_car_road ?machine ?r1) (N:RW:clear ?xy_final))
    car_arrived: ?xy_final:2 ?machine:1
        pre: (and (RW:at_car_jun ?machine ?xy_final))
        eff: (and (N:RW:at_car_jun ?machine ?xy_final) (RW:arrived ?machine ?xy_final) (RW:clear ?xy_final))
    car_start: ?xy_final:2 ?machine:1 ?g:3
        pre: (and (R:at_garage ?g ?xy_final) (RW:starting ?machine ?g) (RW:clear ?xy_final))
        eff: (and (RW:at_car_jun ?machine ?xy_final) (N:RW:starting ?machine ?g) (N:RW:clear ?xy_final))
    build_diagonal_oneway: ?xy_initial:2 ?xy_final:2 ?r1:4
        pre: (and (R:diagonal ?xy_initial ?xy_final) (RW:clear ?xy_final) (RW:NOT-in_place ?r1))
        eff: (and (RW:road_connect ?r1 ?xy_initial ?xy_final) (RW:in_place ?r1) (N:RW:NOT-in_place ?r1))
    build_straight_oneway: ?xy_initial:2 ?xy_final:2 ?r1:4
        pre: (and (R:same_line ?xy_initial ?xy_final) (RW:clear ?xy_final) (RW:NOT-in_place ?r1))
        eff: (and (RW:road_connect ?r1 ?xy_initial ?xy_final) (RW:in_place ?r1) (N:RW:NOT-in_place ?r1))
    destroy_road: ?xy_initial:2 ?xy_final:2 ?r1:4
        pre: (and (RW:road_connect ?r1 ?xy_initial ?xy_final) (RW:in_place ?r1))
        eff: (and (N:RW:road_connect ?r1 ?xy_initial ?xy_final) (N:RW:in_place ?r1) (RW:NOT-in_place ?r1) (when (RW:at_car_road car0 ?r1) (and (N:RW:at_car_road car0 ?r1) (RW:at_car_jun car0 ?xy_initial))) (when (RW:at_car_road car1 ?r1) (and (N:RW:at_car_road car1 ?r1) (RW:at_car_jun car1 ?xy_initial))) (when (RW:at_car_road car2 ?r1) (and (N:RW:at_car_road car2 ?r1) (RW:at_car_jun car2 ?xy_initial))))
