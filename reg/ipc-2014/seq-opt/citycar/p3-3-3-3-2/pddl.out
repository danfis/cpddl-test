  road4 - road
Predicate:
  (= object object) :eq
  (NOT-in_place road) neg-of (in_place)
  (arrived car junction)
  (at_car_jun car junction)
  (at_car_road car road)
  (at_garage garage junction)
  (clear junction)
  (diagonal junction junction)
  (in_place road) neg-of (NOT-in_place)
  (road_connect road junction junction)
  (same_line junction junction)
  (starting car garage)
Function:
  (total-cost)
Action:
  build_diagonal_oneway: ?xy_initial - junction ?xy_final - junction ?r1 - road
      pre: (and (NOT-in_place ?r1) (clear ?xy_final) (diagonal ?xy_initial ?xy_final))
      eff: (and (in_place ?r1) (increase (total-cost) 30) (not (NOT-in_place ?r1)) (road_connect ?r1 ?xy_initial ?xy_final))
  build_straight_oneway: ?xy_initial - junction ?xy_final - junction ?r1 - road
      pre: (and (NOT-in_place ?r1) (clear ?xy_final) (same_line ?xy_initial ?xy_final))
      eff: (and (in_place ?r1) (increase (total-cost) 20) (not (NOT-in_place ?r1)) (road_connect ?r1 ?xy_initial ?xy_final))
  car_arrived: ?xy_final - junction ?machine - car
      pre: (and (at_car_jun ?machine ?xy_final))
      eff: (and (arrived ?machine ?xy_final) (clear ?xy_final) (not (at_car_jun ?machine ?xy_final)))
  car_start: ?xy_final - junction ?machine - car ?g - garage
      pre: (and (at_garage ?g ?xy_final) (clear ?xy_final) (starting ?machine ?g))
      eff: (and (at_car_jun ?machine ?xy_final) (not (clear ?xy_final)) (not (starting ?machine ?g)))
  destroy_road: ?xy_initial - junction ?xy_final - junction ?r1 - road
      pre: (and (in_place ?r1) (road_connect ?r1 ?xy_initial ?xy_final))
      eff: (and (NOT-in_place ?r1) (increase (total-cost) 10) (not (in_place ?r1)) (not (road_connect ?r1 ?xy_initial ?xy_final)) (when (at_car_road car0 ?r1) (and (at_car_jun car0 ?xy_initial) (not (at_car_road car0 ?r1)))) (when (at_car_road car1 ?r1) (and (at_car_jun car1 ?xy_initial) (not (at_car_road car1 ?r1)))) (when (at_car_road car2 ?r1) (and (at_car_jun car2 ?xy_initial) (not (at_car_road car2 ?r1)))))
  move_car_in_road: ?xy_initial - junction ?xy_final - junction ?machine - car ?r1 - road
      pre: (and (at_car_jun ?machine ?xy_initial) (in_place ?r1) (road_connect ?r1 ?xy_initial ?xy_final))
      eff: (and (at_car_road ?machine ?r1) (clear ?xy_initial) (increase (total-cost) 1) (not (at_car_jun ?machine ?xy_initial)))
  move_car_out_road: ?xy_initial - junction ?xy_final - junction ?machine - car ?r1 - road
      pre: (and (at_car_road ?machine ?r1) (clear ?xy_final) (in_place ?r1) (road_connect ?r1 ?xy_initial ?xy_final))
      eff: (and (at_car_jun ?machine ?xy_final) (increase (total-cost) 1) (not (at_car_road ?machine ?r1)) (not (clear ?xy_final)))
