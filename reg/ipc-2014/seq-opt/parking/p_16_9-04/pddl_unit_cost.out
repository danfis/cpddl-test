      pre: (and (at-curb ?cardest) (at-curb-num ?car ?curbsrc) (car-clear ?car) (car-clear ?cardest))
      eff: (and (behind-car ?car ?cardest) (curb-clear ?curbsrc) (not (at-curb ?car)) (not (at-curb-num ?car ?curbsrc)) (not (car-clear ?cardest)))
