Predicate:
  (= object object) :eq
  (NOT-in-water)
  (at-diver diver location)
  (at-surface diver)
  (at-tank tank location)
  (available diver)
  (capacity diver quantity)
  (cave-entrance location)
  (connected location location)
  (decompressing diver)
  (full tank)
  (have-photo location)
  (holding diver tank)
  (in-storage tank)
  (next-quantity quantity quantity)
  (next-tank tank tank)
  (precludes diver diver)
Function:
  (hiring-cost diver)
  (other-cost)
  (total-cost) :total-cost
Action:
  decompress: ?d - diver ?l - location
      pre: (and (at-diver ?d ?l) (cave-entrance ?l))
      eff: (and (NOT-in-water) (decompressing ?d) (increase (total-cost) (other-cost)) (not (at-diver ?d ?l)))
  drop-tank: ?d - diver ?t - tank ?l - location ?q1 - quantity ?q2 - quantity
      pre: (and (at-diver ?d ?l) (capacity ?d ?q1) (holding ?d ?t) (next-quantity ?q1 ?q2))
      eff: (and (at-tank ?t ?l) (capacity ?d ?q2) (increase (total-cost) (other-cost)) (not (capacity ?d ?q1)) (not (holding ?d ?t)))
  enter-water: ?d - diver ?l - location
      pre: (and (at-surface ?d) (cave-entrance ?l))
      eff: (and (at-diver ?d ?l) (increase (total-cost) (other-cost)) (not (at-surface ?d)))
  hire-diver: ?d1 - diver
      pre: (and (NOT-in-water) (available ?d1))
      eff: (and (at-surface ?d1) (increase (total-cost) (hiring-cost ?d1)) (not (NOT-in-water)) (not (available ?d1)) (when (precludes ?d1 d0) (not (available d0))) (when (precludes ?d1 d1) (not (available d1))) (when (precludes ?d1 d2) (not (available d2))) (when (precludes ?d1 d3) (not (available d3))) (when (precludes ?d1 d4) (not (available d4))) (when (precludes ?d1 d5) (not (available d5))) (when (precludes ?d1 d6) (not (available d6))) (when (precludes ?d1 d7) (not (available d7))))
  photograph: ?d - diver ?l - location ?t - tank
      pre: (and (at-diver ?d ?l) (full ?t) (holding ?d ?t))
      eff: (and (have-photo ?l) (increase (total-cost) (other-cost)) (not (full ?t)))
  pickup-tank: ?d - diver ?t - tank ?l - location ?q1 - quantity ?q2 - quantity
      pre: (and (at-diver ?d ?l) (at-tank ?t ?l) (capacity ?d ?q2) (next-quantity ?q1 ?q2))
      eff: (and (capacity ?d ?q1) (holding ?d ?t) (increase (total-cost) (other-cost)) (not (at-tank ?t ?l)) (not (capacity ?d ?q2)))
  prepare-tank: ?d - diver ?t1 - tank ?t2 - tank ?q1 - quantity ?q2 - quantity
      pre: (and (at-surface ?d) (capacity ?d ?q2) (in-storage ?t1) (next-quantity ?q1 ?q2) (next-tank ?t1 ?t2))
      eff: (and (capacity ?d ?q1) (full ?t1) (holding ?d ?t1) (in-storage ?t2) (increase (total-cost) (other-cost)) (not (capacity ?d ?q2)) (not (in-storage ?t1)))
  swim: ?d - diver ?t - tank ?l1 - location ?l2 - location
      pre: (and (at-diver ?d ?l1) (connected ?l1 ?l2) (full ?t) (holding ?d ?t))
      eff: (and (at-diver ?d ?l2) (increase (total-cost) (other-cost)) (not (at-diver ?d ?l1)) (not (full ?t)))
