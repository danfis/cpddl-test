Action[8]:
    hire-diver: ?d1:2
        pre: (and (RW:available ?d1) (RW:NOT-in-water))
        eff: (and (RW:at-surface ?d1) (N:RW:available ?d1) (increase (total-cost) (hiring-cost ?d1)) (when (R:precludes ?d1 d0) (N:RW:available d0)) (when (R:precludes ?d1 d1) (N:RW:available d1)) (when (R:precludes ?d1 d2) (N:RW:available d2)) (when (R:precludes ?d1 d3) (N:RW:available d3)) (when (R:precludes ?d1 d4) (N:RW:available d4)) (when (R:precludes ?d1 d5) (N:RW:available d5)) (when (R:precludes ?d1 d6) (N:RW:available d6)) (when (R:precludes ?d1 d7) (N:RW:available d7)) (W:in-water) (N:RW:NOT-in-water))
    prepare-tank: ?d:2 ?t1:3 ?t2:3 ?q1:4 ?q2:4
        pre: (and (RW:at-surface ?d) (RW:in-storage ?t1) (R:next-quantity ?q1 ?q2) (RW:capacity ?d ?q2) (R:next-tank ?t1 ?t2))
        eff: (and (RW:in-storage ?t2) (RW:full ?t1) (RW:capacity ?d ?q1) (RW:holding ?d ?t1) (increase (total-cost) (other-cost)))
    enter-water: ?d:2 ?l:1
        pre: (and (RW:at-surface ?d) (R:cave-entrance ?l))
        eff: (and (N:RW:at-surface ?d) (RW:at-diver ?d ?l) (increase (total-cost) (other-cost)))
    pickup-tank: ?d:2 ?t:3 ?l:1 ?q1:4 ?q2:4
        pre: (and (RW:at-diver ?d ?l) (RW:at-tank ?t ?l) (R:next-quantity ?q1 ?q2) (RW:capacity ?d ?q2))
        eff: (and (RW:holding ?d ?t) (RW:capacity ?d ?q1) (increase (total-cost) (other-cost)))
    drop-tank: ?d:2 ?t:3 ?l:1 ?q1:4 ?q2:4
        pre: (and (RW:at-diver ?d ?l) (RW:holding ?d ?t) (R:next-quantity ?q1 ?q2) (RW:capacity ?d ?q1))
        eff: (and (RW:at-tank ?t ?l) (RW:capacity ?d ?q2) (increase (total-cost) (other-cost)))
    swim: ?d:2 ?t:3 ?l1:1 ?l2:1
        pre: (and (RW:at-diver ?d ?l1) (RW:holding ?d ?t) (RW:full ?t) (R:connected ?l1 ?l2))
        eff: (and (RW:at-diver ?d ?l2) (increase (total-cost) (other-cost)))
    photograph: ?d:2 ?l:1 ?t:3
        pre: (and (RW:at-diver ?d ?l) (RW:holding ?d ?t) (RW:full ?t))
        eff: (and (W:have-photo ?l) (increase (total-cost) (other-cost)))
    decompress: ?d:2 ?l:1
        pre: (and (RW:at-diver ?d ?l) (R:cave-entrance ?l))
        eff: (and (W:decompressing ?d) (increase (total-cost) (other-cost)) (N:W:in-water) (RW:NOT-in-water))
