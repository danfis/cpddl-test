Require:
  - :negative-preconditions
Predicate:
  + (NOT-in-water)
  - (in-water)
Action:
  - decompress: ?d - diver ?l - location
      pre: (and (at-diver ?d ?l) (cave-entrance ?l))
      eff: (and (decompressing ?d) (increase (total-cost) (other-cost)) (not (at-diver ?d ?l)) (not (in-water)))
  + decompress: ?d - diver ?l - location
      pre: (and (at-diver ?d ?l) (cave-entrance ?l))
      eff: (and (NOT-in-water) (decompressing ?d) (increase (total-cost) (other-cost)) (not (at-diver ?d ?l)))
  - hire-diver: ?d1 - diver
      pre: (and (available ?d1) (not (in-water)))
      eff: (and (at-surface ?d1) (in-water) (increase (total-cost) (hiring-cost ?d1)) (not (available ?d1)) (when (precludes ?d1 d0) (not (available d0))) (when (precludes ?d1 d1) (not (available d1))) (when (precludes ?d1 d2) (not (available d2))) (when (precludes ?d1 d3) (not (available d3))) (when (precludes ?d1 d4) (not (available d4))) (when (precludes ?d1 d5) (not (available d5))) (when (precludes ?d1 d6) (not (available d6))) (when (precludes ?d1 d7) (not (available d7))))
  + hire-diver: ?d1 - diver
      pre: (and (NOT-in-water) (available ?d1))
      eff: (and (at-surface ?d1) (increase (total-cost) (hiring-cost ?d1)) (not (NOT-in-water)) (not (available ?d1)) (when (precludes ?d1 d0) (not (available d0))) (when (precludes ?d1 d1) (not (available d1))) (when (precludes ?d1 d2) (not (available d2))) (when (precludes ?d1 d3) (not (available d3))) (when (precludes ?d1 d4) (not (available d4))) (when (precludes ?d1 d5) (not (available d5))) (when (precludes ?d1 d6) (not (available d6))) (when (precludes ?d1 d7) (not (available d7))))
Init:
  + (NOT-in-water)
Pred prop:
  + (NOT-in-water): in_init in_pre in_eff
  - (in-water): in_pre in_pre_neg in_eff
Global prop:
  - has_non_static_neg_cond
