Predicate[17]:
    =: 0 0 :: read: 0, write: 0, in-init: 0
    at-tank: 3 1 :: read: 1, write: 1, in-init: 0
    in-storage: 3 :: read: 1, write: 1, in-init: 1
    full: 3 :: read: 1, write: 1, in-init: 0
    next-tank: 3 3 :: read: 1, write: 0, in-init: 1
    at-diver: 2 1 :: read: 1, write: 1, in-init: 0
    available: 2 :: read: 1, write: 1, in-init: 1
    at-surface: 2 :: read: 1, write: 1, in-init: 0
    decompressing: 2 :: read: 0, write: 1, in-init: 0
    precludes: 2 2 :: read: 1, write: 0, in-init: 1
    cave-entrance: 1 :: read: 1, write: 0, in-init: 1
    connected: 1 1 :: read: 1, write: 0, in-init: 1
    next-quantity: 4 4 :: read: 1, write: 0, in-init: 1
    holding: 2 3 :: read: 1, write: 1, in-init: 0
    capacity: 2 4 :: read: 1, write: 1, in-init: 1
    have-photo: 1 :: read: 0, write: 1, in-init: 0
    in-water: :: read: 1, write: 1, in-init: 0
Function[3]:
    hiring-cost: 2 :: read: 1, write: 0, in-init: 1
    other-cost: :: read: 1, write: 0, in-init: 1
    total-cost: :: read: 0, write: 1, in-init: 1
Action[8]:
    hire-diver: ?d1:2
        pre: (and (RW:available ?d1) (N:RW:in-water))
        eff: (and (N:RW:available ?d1) (RW:at-surface ?d1) (RW:in-water) (forall (?d2:2 I[0]:?d1:2) (when (R:precludes ?d1 ?d2) (N:RW:available ?d2))) (increase (total-cost) (hiring-cost ?d1)))
    prepare-tank: ?d:2 ?t1:3 ?t2:3 ?q1:4 ?q2:4
        pre: (and (R:next-tank ?t1 ?t2) (R:next-quantity ?q1 ?q2) (RW:in-storage ?t1) (RW:at-surface ?d) (RW:capacity ?d ?q2))
        eff: (and (N:RW:in-storage ?t1) (RW:in-storage ?t2) (RW:full ?t1) (RW:holding ?d ?t1) (RW:capacity ?d ?q1) (N:RW:capacity ?d ?q2) (increase (total-cost) (other-cost)))
    enter-water: ?d:2 ?l:1
        pre: (and (R:cave-entrance ?l) (RW:at-surface ?d))
        eff: (and (RW:at-diver ?d ?l) (N:RW:at-surface ?d) (increase (total-cost) (other-cost)))
    pickup-tank: ?d:2 ?t:3 ?l:1 ?q1:4 ?q2:4
        pre: (and (R:next-quantity ?q1 ?q2) (RW:at-tank ?t ?l) (RW:at-diver ?d ?l) (RW:capacity ?d ?q2))
        eff: (and (N:RW:at-tank ?t ?l) (RW:holding ?d ?t) (RW:capacity ?d ?q1) (N:RW:capacity ?d ?q2) (increase (total-cost) (other-cost)))
    drop-tank: ?d:2 ?t:3 ?l:1 ?q1:4 ?q2:4
        pre: (and (R:next-quantity ?q1 ?q2) (RW:at-diver ?d ?l) (RW:holding ?d ?t) (RW:capacity ?d ?q1))
        eff: (and (RW:at-tank ?t ?l) (N:RW:holding ?d ?t) (N:RW:capacity ?d ?q1) (RW:capacity ?d ?q2) (increase (total-cost) (other-cost)))
    swim: ?d:2 ?t:3 ?l1:1 ?l2:1
        pre: (and (R:connected ?l1 ?l2) (RW:full ?t) (RW:at-diver ?d ?l1) (RW:holding ?d ?t))
        eff: (and (N:RW:full ?t) (N:RW:at-diver ?d ?l1) (RW:at-diver ?d ?l2) (increase (total-cost) (other-cost)))
    photograph: ?d:2 ?l:1 ?t:3
        pre: (and (RW:full ?t) (RW:at-diver ?d ?l) (RW:holding ?d ?t))
        eff: (and (N:RW:full ?t) (W:have-photo ?l) (increase (total-cost) (other-cost)))
    decompress: ?d:2 ?l:1
        pre: (and (R:cave-entrance ?l) (RW:at-diver ?d ?l))
        eff: (and (N:RW:at-diver ?d ?l) (W:decompressing ?d) (N:RW:in-water) (increase (total-cost) (other-cost)))
