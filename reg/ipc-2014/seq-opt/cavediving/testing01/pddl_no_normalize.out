Domain: cave-diving-adl
Problem: cave-diving-adl-p01
Require:
  :action-costs
  :conditional-effects
  :disjunctive-preconditions
  :equality
  :existential-preconditions
  :negative-preconditions
  :strips
  :typing
  :universal-preconditions
Type:
  diver - object
  location - object
  object
  quantity - object
  tank - object
Obj:
  d0 - diver
  d1 - diver
  d2 - diver
  d3 - diver
  dummy - tank
  four - quantity
  l0 - location
  l1 - location
  l2 - location
  l3 - location
  l4 - location
  l5 - location
  one - quantity
  t0 - tank
  t1 - tank
  t10 - tank
  t11 - tank
  t12 - tank
  t13 - tank
  t14 - tank
  t2 - tank
  t3 - tank
  t4 - tank
  t5 - tank
  t6 - tank
  t7 - tank
  t8 - tank
  t9 - tank
  three - quantity
  two - quantity
  zero - quantity
Predicate:
  (= object object) :eq
  (at-diver diver location)
  (at-surface diver)
  (at-tank tank location)
  (available diver)
  (capacity diver quantity)
  (cave-entrance location)
  (connected location location)
  (decompressing diver)
  (full tank)
  (have-photo location)
  (holding diver tank)
  (in-storage tank)
  (in-water)
  (next-quantity quantity quantity)
  (next-tank tank tank)
  (precludes diver diver)
Function:
  (hiring-cost diver)
  (other-cost)
  (total-cost) :total-cost
Action:
  decompress: ?d - diver ?l - location
      pre: (and (at-diver ?d ?l) (cave-entrance ?l))
      eff: (and (decompressing ?d) (increase (total-cost) (other-cost)) (not (at-diver ?d ?l)) (not (in-water)))
  drop-tank: ?d - diver ?t - tank ?l - location ?q1 - quantity ?q2 - quantity
      pre: (and (at-diver ?d ?l) (capacity ?d ?q1) (holding ?d ?t) (next-quantity ?q1 ?q2))
      eff: (and (at-tank ?t ?l) (capacity ?d ?q2) (increase (total-cost) (other-cost)) (not (capacity ?d ?q1)) (not (holding ?d ?t)))
  enter-water: ?d - diver ?l - location
      pre: (and (at-surface ?d) (cave-entrance ?l))
      eff: (and (at-diver ?d ?l) (increase (total-cost) (other-cost)) (not (at-surface ?d)))
  hire-diver: ?d1 - diver
      pre: (and (available ?d1) (not (in-water)))
      eff: (and (at-surface ?d1) (forall (?d2 - diver) (when (precludes ?d1 ?d2) (not (available ?d2)))) (in-water) (increase (total-cost) (hiring-cost ?d1)) (not (available ?d1)))
  photograph: ?d - diver ?l - location ?t - tank
      pre: (and (at-diver ?d ?l) (full ?t) (holding ?d ?t))
      eff: (and (have-photo ?l) (increase (total-cost) (other-cost)) (not (full ?t)))
  pickup-tank: ?d - diver ?t - tank ?l - location ?q1 - quantity ?q2 - quantity
      pre: (and (at-diver ?d ?l) (at-tank ?t ?l) (capacity ?d ?q2) (next-quantity ?q1 ?q2))
      eff: (and (capacity ?d ?q1) (holding ?d ?t) (increase (total-cost) (other-cost)) (not (at-tank ?t ?l)) (not (capacity ?d ?q2)))
  prepare-tank: ?d - diver ?t1 - tank ?t2 - tank ?q1 - quantity ?q2 - quantity
      pre: (and (at-surface ?d) (capacity ?d ?q2) (in-storage ?t1) (next-quantity ?q1 ?q2) (next-tank ?t1 ?t2))
      eff: (and (capacity ?d ?q1) (full ?t1) (holding ?d ?t1) (in-storage ?t2) (increase (total-cost) (other-cost)) (not (capacity ?d ?q2)) (not (in-storage ?t1)))
  swim: ?d - diver ?t - tank ?l1 - location ?l2 - location
      pre: (and (at-diver ?d ?l1) (connected ?l1 ?l2) (full ?t) (holding ?d ?t))
      eff: (and (at-diver ?d ?l2) (increase (total-cost) (other-cost)) (not (at-diver ?d ?l1)) (not (full ?t)))
Init:
  (= (hiring-cost d0) 60)
  (= (hiring-cost d1) 10)
  (= (hiring-cost d2) 10)
  (= (hiring-cost d3) 58)
  (= (other-cost) 1)
  (= (total-cost) 0)
  (available d0)
  (available d1)
  (available d2)
  (available d3)
  (capacity d0 four)
  (capacity d1 four)
  (capacity d2 four)
  (capacity d3 four)
  (cave-entrance l0)
  (connected l0 l1)
  (connected l1 l0)
  (connected l1 l2)
  (connected l1 l4)
  (connected l1 l5)
  (connected l2 l1)
  (connected l2 l3)
  (connected l3 l2)
  (connected l4 l1)
  (connected l5 l1)
  (in-storage t0)
  (next-quantity one two)
  (next-quantity three four)
  (next-quantity two three)
  (next-quantity zero one)
  (next-tank t0 t1)
  (next-tank t1 t2)
  (next-tank t10 t11)
  (next-tank t11 t12)
  (next-tank t12 t13)
  (next-tank t13 t14)
  (next-tank t14 dummy)
  (next-tank t2 t3)
  (next-tank t3 t4)
  (next-tank t4 t5)
  (next-tank t5 t6)
  (next-tank t6 t7)
  (next-tank t7 t8)
  (next-tank t8 t9)
  (next-tank t9 t10)
  (precludes d1 d3)
  (precludes d2 d3)
Goal:
  (and (decompressing d0) (decompressing d1) (decompressing d2) (decompressing d3) (have-photo l4) (have-photo l5))
Metric:
  (total-cost)
Pred prop:
  (at-diver diver location): in_pre in_eff
  (at-surface diver): in_pre in_eff
  (at-tank tank location): in_pre in_eff
  (available diver): in_init in_pre in_eff
  (capacity diver quantity): in_init in_pre in_eff
  (cave-entrance location): in_init in_pre
  (connected location location): in_init in_pre
  (decompressing diver): in_goal in_eff
  (full tank): in_pre in_eff
  (have-photo location): in_goal in_eff
  (holding diver tank): in_pre in_eff
  (in-storage tank): in_init in_pre in_eff
  (in-water): in_pre in_pre_neg in_eff
  (next-quantity quantity quantity): in_init in_pre
  (next-tank tank tank): in_init in_pre
  (precludes diver diver): in_init in_pre
Func prop:
  (hiring-cost diver): in_init init_all_nonneg init_all_int on_num_op_rhs write_delta_nonneg write_delta_nonneg_int
  (other-cost): in_init init_all_nonneg init_all_int on_num_op_rhs write_delta_nonneg write_delta_nonneg_int
  (total-cost): in_init init_all_nonneg init_all_nonpos init_all_int in_metric is_metric_alone in_eff rhs_funcs:(hiring-cost other-cost) write_delta_nonneg write_delta_nonneg_int
Global prop:
  action_cost_func:(total-cost)
  has_cond_eff
  has_int_action_cost_func
  has_non_static_neg_cond
