Function:
Action:
  make_sandwich: ?s - sandwich ?b - bread-portion ?c - content-portion
      pre: (and (at_kitchen_bread ?b) (at_kitchen_content ?c) (notexist ?s))
      eff: (and (at_kitchen_sandwich ?s) (not (at_kitchen_bread ?b)) (not (at_kitchen_content ?c)) (not (notexist ?s)))
  make_sandwich_no_gluten: ?s - sandwich ?b - bread-portion ?c - content-portion
      pre: (and (at_kitchen_bread ?b) (at_kitchen_content ?c) (no_gluten_bread ?b) (no_gluten_content ?c) (notexist ?s))
      eff: (and (at_kitchen_sandwich ?s) (no_gluten_sandwich ?s) (not (at_kitchen_bread ?b)) (not (at_kitchen_content ?c)) (not (notexist ?s)))
  move_tray: ?t - tray ?p1 - place ?p2 - place
      pre: (and (at ?t ?p1))
      eff: (and (at ?t ?p2) (not (at ?t ?p1)))
  put_on_tray: ?s - sandwich ?t - tray
      pre: (and (at ?t kitchen) (at_kitchen_sandwich ?s))
      eff: (and (not (at_kitchen_sandwich ?s)) (ontray ?s ?t))
  serve_sandwich: ?s - sandwich ?c - child ?t - tray ?p - place
      pre: (and (at ?t ?p) (not_allergic_gluten ?c) (ontray ?s ?t) (waiting ?c ?p))
      eff: (and (not (ontray ?s ?t)) (served ?c))
  serve_sandwich_no_gluten: ?s - sandwich ?c - child ?t - tray ?p - place
      pre: (and (allergic_gluten ?c) (at ?t ?p) (no_gluten_sandwich ?s) (ontray ?s ?t) (waiting ?c ?p))
      eff: (and (not (ontray ?s ?t)) (served ?c))
