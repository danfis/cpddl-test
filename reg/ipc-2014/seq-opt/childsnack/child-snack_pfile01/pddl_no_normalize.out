Predicate:
  (= object object) :eq
  (allergic_gluten child)
  (at tray place)
  (at_kitchen_bread bread-portion)
  (at_kitchen_content content-portion)
  (at_kitchen_sandwich sandwich)
  (no_gluten_bread bread-portion)
