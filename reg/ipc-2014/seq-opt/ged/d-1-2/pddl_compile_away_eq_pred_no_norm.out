Require:
  - :conditional-effects
  - :disjunctive-preconditions
  - :equality
  - :existential-preconditions
  - :typing
  - :universal-preconditions
Predicate:
  + (equal object object)
Action:
  - begin-cut: ?x - object ?y - object
      pre: (and (cw ?x ?y) (idle) (not (= ?x ?y)))
      eff: (and (cut-point-1 ?x) (cutting) (last-cut-point ?x) (not (cw ?x ?y)) (not (idle)) (s-first ?y) (s-last ?y))
  + begin-cut: ?x - object ?y - object
      pre: (and (cw ?x ?y) (idle) (not (equal ?x ?y)))
      eff: (and (cut-point-1 ?x) (cutting) (last-cut-point ?x) (not (cw ?x ?y)) (not (idle)) (s-first ?y) (s-last ?y))
  - begin-inverse-splice: ?x - object ?y - object
      pre: (and (cw ?x ?y) (have-cut) (last-cut-point ?x) (not (= ?x ?y)))
      eff: (and (increase (total-cost) 1) (inverse-splicing) (not (cw ?x ?y)) (not (have-cut)) (splice-point-1 ?x) (splice-point-2 ?y))
  + begin-inverse-splice: ?x - object ?y - object
      pre: (and (cw ?x ?y) (have-cut) (last-cut-point ?x) (not (equal ?x ?y)))
      eff: (and (increase (total-cost) 1) (inverse-splicing) (not (cw ?x ?y)) (not (have-cut)) (splice-point-1 ?x) (splice-point-2 ?y))
  - begin-transpose-splice: ?x - object ?y - object
      pre: (and (cw ?x ?y) (have-cut) (not (= ?x ?y)))
      eff: (and (increase (total-cost) 2) (not (cw ?x ?y)) (not (have-cut)) (splice-point-1 ?x) (splice-point-2 ?y) (splicing))
  + begin-transpose-splice: ?x - object ?y - object
      pre: (and (cw ?x ?y) (have-cut) (not (equal ?x ?y)))
      eff: (and (increase (total-cost) 2) (not (cw ?x ?y)) (not (have-cut)) (splice-point-1 ?x) (splice-point-2 ?y) (splicing))
  - begin-transverse-splice: ?x - object ?y - object
      pre: (and (cw ?x ?y) (have-cut) (not (= ?x ?y)))
      eff: (and (increase (total-cost) 2) (inverse-splicing) (not (cw ?x ?y)) (not (have-cut)) (splice-point-1 ?x) (splice-point-2 ?y))
  + begin-transverse-splice: ?x - object ?y - object
      pre: (and (cw ?x ?y) (have-cut) (not (equal ?x ?y)))
      eff: (and (increase (total-cost) 2) (inverse-splicing) (not (cw ?x ?y)) (not (have-cut)) (splice-point-1 ?x) (splice-point-2 ?y))
  - continue-cut: ?x - object ?y - object
      pre: (and (cutting) (cw ?x ?y) (not (= ?x ?y)) (s-last ?x))
      eff: (and (not (cw ?x ?y)) (not (s-last ?x)) (s-last ?y) (s-next ?x ?y))
  + continue-cut: ?x - object ?y - object
      pre: (and (cutting) (cw ?x ?y) (not (equal ?x ?y)) (s-last ?x))
      eff: (and (not (cw ?x ?y)) (not (s-last ?x)) (s-last ?y) (s-next ?x ?y))
  - end-cut-1: ?x - object ?y - object
      pre: (and (cutting) (cw ?x ?y) (not (= ?x ?y)) (s-last ?x))
      eff: (and (cut-point-2 ?y) (not (cw ?x ?y)))
  + end-cut-1: ?x - object ?y - object
      pre: (and (cutting) (cw ?x ?y) (not (equal ?x ?y)) (s-last ?x))
      eff: (and (cut-point-2 ?y) (not (cw ?x ?y)))
Init:
  + (equal sub1 sub1)
  + (equal sub2 sub2)
  + (equal sub3 sub3)
Pred prop:
  - (= object object): in_pre in_pre_neg
  + (equal object object): in_init in_pre in_pre_neg
