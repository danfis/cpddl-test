Domain: genome-edit-distance
Problem: trachelium-to-campanula
Require:
  :action-costs
  :equality
  :negative-preconditions
  :strips
Type:
  object
Obj:
  sub1 - object
  sub2 - object
  sub3 - object
Predicate:
  (= object object) :eq
  (cut-point-1 object)
  (cut-point-2 object)
  (cutting)
  (cw object object)
  (finished)
  (have-cut)
  (idle)
  (inverse-splice-next object)
  (inverse-splicing)
  (inverse-splicing-last)
  (inverted object)
  (last-cut-point object)
  (normal object)
  (s-first object)
  (s-last object)
  (s-next object object)
  (splice-next object)
  (splice-point-1 object)
  (splice-point-2 object)
  (splicing)
  (splicing-last)
Function:
  (total-cost) :total-cost
Action:
  begin-cut: ?x - object ?y - object
      pre: (and (cw ?x ?y) (idle) (not (= ?x ?y)))
      eff: (and (cut-point-1 ?x) (cutting) (last-cut-point ?x) (not (cw ?x ?y)) (not (idle)) (s-first ?y) (s-last ?y))
  begin-inverse-splice-special-case: ?x - object
      pre: (and (cw ?x ?x) (have-cut) (last-cut-point ?x))
      eff: (and (increase (total-cost) 1) (inverse-splicing) (not (cw ?x ?x)) (not (have-cut)) (splice-point-1 ?x) (splice-point-2 ?x))
  begin-inverse-splice: ?x - object ?y - object
      pre: (and (cw ?x ?y) (have-cut) (last-cut-point ?x) (not (= ?x ?y)))
      eff: (and (increase (total-cost) 1) (inverse-splicing) (not (cw ?x ?y)) (not (have-cut)) (splice-point-1 ?x) (splice-point-2 ?y))
  begin-transpose-splice: ?x - object ?y - object
      pre: (and (cw ?x ?y) (have-cut) (not (= ?x ?y)))
      eff: (and (increase (total-cost) 2) (not (cw ?x ?y)) (not (have-cut)) (splice-point-1 ?x) (splice-point-2 ?y) (splicing))
  begin-transverse-splice: ?x - object ?y - object
      pre: (and (cw ?x ?y) (have-cut) (not (= ?x ?y)))
      eff: (and (increase (total-cost) 2) (inverse-splicing) (not (cw ?x ?y)) (not (have-cut)) (splice-point-1 ?x) (splice-point-2 ?y))
  continue-cut: ?x - object ?y - object
      pre: (and (cutting) (cw ?x ?y) (not (= ?x ?y)) (s-last ?x))
      eff: (and (not (cw ?x ?y)) (not (s-last ?x)) (s-last ?y) (s-next ?x ?y))
  continue-inverse-splice-1a: ?x - object ?y - object
      pre: (and (inverse-splicing) (normal ?x) (s-last ?x) (s-next ?y ?x))
      eff: (and (inverse-splice-next ?x) (inverted ?x) (not (inverse-splicing)) (not (normal ?x)) (not (s-last ?x)) (not (s-next ?y ?x)) (s-last ?y))
  continue-inverse-splice-1b: ?x - object ?y - object
      pre: (and (inverse-splicing) (inverted ?x) (s-last ?x) (s-next ?y ?x))
      eff: (and (inverse-splice-next ?x) (normal ?x) (not (inverse-splicing)) (not (inverted ?x)) (not (s-last ?x)) (not (s-next ?y ?x)) (s-last ?y))
  continue-inverse-splice-2: ?x - object ?y - object
      pre: (and (inverse-splice-next ?x) (splice-point-1 ?y))
      eff: (and (cw ?y ?x) (inverse-splicing) (not (inverse-splice-next ?x)) (not (splice-point-1 ?y)) (splice-point-1 ?x))
  continue-splice-1: ?x - object ?y - object
      pre: (and (s-first ?x) (s-next ?x ?y) (splicing))
      eff: (and (not (s-first ?x)) (not (s-next ?x ?y)) (not (splicing)) (s-first ?y) (splice-next ?x))
  continue-splice-2: ?x - object ?y - object
      pre: (and (splice-next ?x) (splice-point-1 ?y))
      eff: (and (cw ?y ?x) (not (splice-next ?x)) (not (splice-point-1 ?y)) (splice-point-1 ?x) (splicing))
  end-cut-1: ?x - object ?y - object
      pre: (and (cutting) (cw ?x ?y) (not (= ?x ?y)) (s-last ?x))
      eff: (and (cut-point-2 ?y) (not (cw ?x ?y)))
  end-cut-2: ?x - object ?y - object
      pre: (and (cut-point-1 ?x) (cut-point-2 ?y) (cutting))
      eff: (and (cw ?x ?y) (have-cut) (not (cut-point-1 ?x)) (not (cut-point-2 ?y)) (not (cutting)))
  end-inverse-splice-1a: ?x - object ?y - object
      pre: (and (inverse-splicing) (normal ?x) (s-first ?x) (s-last ?x) (splice-point-1 ?y))
      eff: (and (cw ?y ?x) (inverse-splicing-last) (inverted ?x) (not (inverse-splicing)) (not (normal ?x)) (not (s-first ?x)) (not (s-last ?x)) (not (splice-point-1 ?y)) (splice-point-1 ?x))
  end-inverse-splice-1b: ?x - object ?y - object
      pre: (and (inverse-splicing) (inverted ?x) (s-first ?x) (s-last ?x) (splice-point-1 ?y))
      eff: (and (cw ?y ?x) (inverse-splicing-last) (normal ?x) (not (inverse-splicing)) (not (inverted ?x)) (not (s-first ?x)) (not (s-last ?x)) (not (splice-point-1 ?y)) (splice-point-1 ?x))
  end-inverse-splice-2: ?x - object ?y - object
      pre: (and (inverse-splicing-last) (splice-point-1 ?x) (splice-point-2 ?y))
      eff: (and (cw ?x ?y) (finished) (not (inverse-splicing-last)) (not (splice-point-1 ?x)) (not (splice-point-2 ?y)))
  end-splice-1: ?x - object ?y - object
      pre: (and (s-first ?x) (s-last ?x) (splice-point-1 ?y) (splicing))
      eff: (and (cw ?y ?x) (not (s-first ?x)) (not (s-last ?x)) (not (splice-point-1 ?y)) (not (splicing)) (splice-point-1 ?x) (splicing-last))
  end-splice-2: ?x - object ?y - object
      pre: (and (splice-point-1 ?x) (splice-point-2 ?y) (splicing-last))
      eff: (and (cw ?x ?y) (finished) (not (splice-point-1 ?x)) (not (splice-point-2 ?y)) (not (splicing-last)))
  invert-single-gene-a: ?x - object
      pre: (and (idle) (normal ?x))
      eff: (and (increase (total-cost) 1) (inverted ?x) (not (normal ?x)))
  invert-single-gene-b: ?x - object
      pre: (and (idle) (inverted ?x))
      eff: (and (increase (total-cost) 1) (normal ?x) (not (inverted ?x)))
  reset-1: ?x - object
      pre: (and (finished) (last-cut-point ?x))
      eff: (and (idle) (not (finished)) (not (last-cut-point ?x)))
Init:
  (= (total-cost) 0)
  (cw sub1 sub2)
  (cw sub2 sub3)
  (cw sub3 sub1)
  (idle)
  (normal sub1)
  (normal sub2)
  (normal sub3)
Goal:
  (and (cw sub1 sub2) (cw sub2 sub3) (cw sub3 sub1) (inverted sub3) (normal sub1) (normal sub2))
Metric:
  (total-cost)
Pred prop:
  (= object object): in_pre in_pre_neg
  (cut-point-1 object): in_pre in_eff
  (cut-point-2 object): in_pre in_eff
  (cutting): in_pre in_eff
  (cw object object): in_init in_pre in_goal in_eff
  (finished): in_pre in_eff
  (have-cut): in_pre in_eff
  (idle): in_init in_pre in_eff
  (inverse-splice-next object): in_pre in_eff
  (inverse-splicing): in_pre in_eff
  (inverse-splicing-last): in_pre in_eff
  (inverted object): in_pre in_goal in_eff
  (last-cut-point object): in_pre in_eff
  (normal object): in_init in_pre in_goal in_eff
  (s-first object): in_pre in_eff
  (s-last object): in_pre in_eff
  (s-next object object): in_pre in_eff
  (splice-next object): in_pre in_eff
  (splice-point-1 object): in_pre in_eff
  (splice-point-2 object): in_pre in_eff
  (splicing): in_pre in_eff
  (splicing-last): in_pre in_eff
Func prop:
  (total-cost): in_init init_all_nonneg init_all_nonpos init_all_int in_metric is_metric_alone in_eff write_delta_nonneg write_delta_nonneg_int
Global prop:
  action_cost_func:(total-cost)
  has_eq_pred
  has_int_action_cost_func
