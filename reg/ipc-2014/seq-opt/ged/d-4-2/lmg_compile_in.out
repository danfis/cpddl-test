Action:
  - continue-inverse-splice-1a: ?x - object ?y - object
      pre: (and (inverse-splicing) (normal ?x) (s-last ?x) (s-next ?y ?x))
      eff: (and (inverse-splice-next ?x) (inverted ?x) (not (inverse-splicing)) (not (normal ?x)) (not (s-last ?x)) (not (s-next ?y ?x)) (s-last ?y))
  + continue-inverse-splice-1a: ?x - object ?y - object
      pre: (and (inverse-splicing) (normal ?x) (not (= ?x ?y)) (s-last ?x) (s-next ?y ?x))
      eff: (and (inverse-splice-next ?x) (inverted ?x) (not (inverse-splicing)) (not (normal ?x)) (not (s-last ?x)) (not (s-next ?y ?x)) (s-last ?y))
  - continue-inverse-splice-1b: ?x - object ?y - object
      pre: (and (inverse-splicing) (inverted ?x) (s-last ?x) (s-next ?y ?x))
      eff: (and (inverse-splice-next ?x) (normal ?x) (not (inverse-splicing)) (not (inverted ?x)) (not (s-last ?x)) (not (s-next ?y ?x)) (s-last ?y))
  + continue-inverse-splice-1b: ?x - object ?y - object
      pre: (and (inverse-splicing) (inverted ?x) (not (= ?x ?y)) (s-last ?x) (s-next ?y ?x))
      eff: (and (inverse-splice-next ?x) (normal ?x) (not (inverse-splicing)) (not (inverted ?x)) (not (s-last ?x)) (not (s-next ?y ?x)) (s-last ?y))
  - continue-splice-1: ?x - object ?y - object
      pre: (and (s-first ?x) (s-next ?x ?y) (splicing))
      eff: (and (not (s-first ?x)) (not (s-next ?x ?y)) (not (splicing)) (s-first ?y) (splice-next ?x))
  + continue-splice-1: ?x - object ?y - object
      pre: (and (not (= ?x ?y)) (s-first ?x) (s-next ?x ?y) (splicing))
      eff: (and (not (s-first ?x)) (not (s-next ?x ?y)) (not (splicing)) (s-first ?y) (splice-next ?x))
