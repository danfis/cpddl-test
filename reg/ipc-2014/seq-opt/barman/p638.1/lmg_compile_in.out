Require:
  + :equality
  + :negative-preconditions
Action:
  - clean-shaker: ?h1 - hand ?h2 - hand ?s - shaker
      pre: (and (empty ?s) (handempty ?h2) (holding ?h1 ?s))
      eff: (and (clean ?s))
  + clean-shaker: ?h1 - hand ?h2 - hand ?s - shaker
      pre: (and (empty ?s) (handempty ?h2) (holding ?h1 ?s) (not (= ?h1 ?h2)))
      eff: (and (clean ?s))
  - clean-shot: ?s - shot ?b - beverage ?h1 - hand ?h2 - hand
      pre: (and (empty ?s) (handempty ?h2) (holding ?h1 ?s) (used ?s ?b))
      eff: (and (clean ?s) (not (used ?s ?b)))
  + clean-shot: ?s - shot ?b - beverage ?h1 - hand ?h2 - hand
      pre: (and (empty ?s) (handempty ?h2) (holding ?h1 ?s) (not (= ?h1 ?h2)) (used ?s ?b))
      eff: (and (clean ?s) (not (used ?s ?b)))
  - empty-shot: ?h - hand ?p - shot ?b - beverage
      pre: (and (contains ?p ?b) (holding ?h ?p))
      eff: (and (empty ?p) (not (contains ?p ?b)))
  + empty-shot: ?h - hand ?p - shot ?b - beverage
      pre: (and (contains ?p ?b) (holding ?h ?p) (not (= ?b cocktail1)) (not (= ?b cocktail2)) (not (= ?b cocktail3)) (not (= ?b cocktail4)) (not (= ?b cocktail5)) (not (= ?b cocktail6)))
      eff: (and (empty ?p) (not (contains ?p ?b)))
  + empty-shot: ?h - hand ?p - shot ?b - beverage
      pre: (and (contains ?p ?b) (holding ?h ?p) (not (= ?p shot1)) (not (= ?p shot2)) (not (= ?p shot3)) (not (= ?p shot4)) (not (= ?p shot5)) (not (= ?p shot6)))
      eff: (and (empty ?p) (not (contains ?p ?b)))
  - fill-shot: ?s - shot ?i - ingredient ?h1 - hand ?h2 - hand ?d - dispenser
      pre: (and (clean ?s) (dispenses ?d ?i) (empty ?s) (handempty ?h2) (holding ?h1 ?s))
      eff: (and (contains ?s ?i) (not (clean ?s)) (not (empty ?s)) (used ?s ?i))
  + fill-shot: ?s - shot ?i - ingredient ?h1 - hand ?h2 - hand ?d - dispenser
      pre: (and (clean ?s) (dispenses ?d ?i) (empty ?s) (handempty ?h2) (holding ?h1 ?s) (not (= ?h1 ?h2)))
      eff: (and (contains ?s ?i) (not (clean ?s)) (not (empty ?s)) (used ?s ?i))
  - pour-shaker-to-shot: ?b - beverage ?d - shot ?h - hand ?s - shaker ?l - level ?l1 - level
      pre: (and (clean ?d) (contains ?s ?b) (empty ?d) (holding ?h ?s) (next ?l1 ?l) (shaked ?s) (shaker-level ?s ?l))
      eff: (and (contains ?d ?b) (not (clean ?d)) (not (empty ?d)) (not (shaker-level ?s ?l)) (shaker-level ?s ?l1))
  + pour-shaker-to-shot: ?b - beverage ?d - shot ?h - hand ?s - shaker ?l - level ?l1 - level
      pre: (and (= ?b cocktail1) (clean ?d) (contains ?s cocktail1) (empty ?d) (holding ?h ?s) (next ?l1 ?l) (not (= ?d shot1)) (not (= ?d shot2)) (not (= ?d shot3)) (not (= ?d shot5)) (not (= ?d shot6)) (shaked ?s) (shaker-level ?s ?l))
      eff: (and (contains ?d cocktail1) (not (clean ?d)) (not (empty ?d)) (not (shaker-level ?s ?l)) (shaker-level ?s ?l1))
  + pour-shaker-to-shot: ?b - beverage ?d - shot ?h - hand ?s - shaker ?l - level ?l1 - level
      pre: (and (= ?b cocktail2) (clean ?d) (contains ?s cocktail2) (empty ?d) (holding ?h ?s) (next ?l1 ?l) (not (= ?d shot1)) (not (= ?d shot2)) (not (= ?d shot3)) (not (= ?d shot4)) (not (= ?d shot5)) (shaked ?s) (shaker-level ?s ?l))
      eff: (and (contains ?d cocktail2) (not (clean ?d)) (not (empty ?d)) (not (shaker-level ?s ?l)) (shaker-level ?s ?l1))
  + pour-shaker-to-shot: ?b - beverage ?d - shot ?h - hand ?s - shaker ?l - level ?l1 - level
      pre: (and (= ?b cocktail3) (clean ?d) (contains ?s cocktail3) (empty ?d) (holding ?h ?s) (next ?l1 ?l) (not (= ?d shot1)) (not (= ?d shot2)) (not (= ?d shot3)) (not (= ?d shot4)) (not (= ?d shot6)) (shaked ?s) (shaker-level ?s ?l))
      eff: (and (contains ?d cocktail3) (not (clean ?d)) (not (empty ?d)) (not (shaker-level ?s ?l)) (shaker-level ?s ?l1))
  + pour-shaker-to-shot: ?b - beverage ?d - shot ?h - hand ?s - shaker ?l - level ?l1 - level
      pre: (and (= ?b cocktail4) (clean ?d) (contains ?s cocktail4) (empty ?d) (holding ?h ?s) (next ?l1 ?l) (not (= ?d shot1)) (not (= ?d shot2)) (not (= ?d shot4)) (not (= ?d shot5)) (not (= ?d shot6)) (shaked ?s) (shaker-level ?s ?l))
      eff: (and (contains ?d cocktail4) (not (clean ?d)) (not (empty ?d)) (not (shaker-level ?s ?l)) (shaker-level ?s ?l1))
  + pour-shaker-to-shot: ?b - beverage ?d - shot ?h - hand ?s - shaker ?l - level ?l1 - level
      pre: (and (= ?b cocktail5) (clean ?d) (contains ?s cocktail5) (empty ?d) (holding ?h ?s) (next ?l1 ?l) (not (= ?d shot2)) (not (= ?d shot3)) (not (= ?d shot4)) (not (= ?d shot5)) (not (= ?d shot6)) (shaked ?s) (shaker-level ?s ?l))
      eff: (and (contains ?d cocktail5) (not (clean ?d)) (not (empty ?d)) (not (shaker-level ?s ?l)) (shaker-level ?s ?l1))
  + pour-shaker-to-shot: ?b - beverage ?d - shot ?h - hand ?s - shaker ?l - level ?l1 - level
      pre: (and (= ?b cocktail6) (clean ?d) (contains ?s cocktail6) (empty ?d) (holding ?h ?s) (next ?l1 ?l) (not (= ?d shot1)) (not (= ?d shot3)) (not (= ?d shot4)) (not (= ?d shot5)) (not (= ?d shot6)) (shaked ?s) (shaker-level ?s ?l))
      eff: (and (contains ?d cocktail6) (not (clean ?d)) (not (empty ?d)) (not (shaker-level ?s ?l)) (shaker-level ?s ?l1))
  + pour-shaker-to-shot: ?b - beverage ?d - shot ?h - hand ?s - shaker ?l - level ?l1 - level
      pre: (and (clean ?d) (contains ?s ?b) (empty ?d) (holding ?h ?s) (next ?l1 ?l) (not (= ?d shot1)) (not (= ?d shot2)) (not (= ?d shot3)) (not (= ?d shot4)) (not (= ?d shot5)) (not (= ?d shot6)) (shaked ?s) (shaker-level ?s ?l))
      eff: (and (contains ?d ?b) (not (clean ?d)) (not (empty ?d)) (not (shaker-level ?s ?l)) (shaker-level ?s ?l1))
  - refill-shot: ?s - shot ?i - ingredient ?h1 - hand ?h2 - hand ?d - dispenser
      pre: (and (dispenses ?d ?i) (empty ?s) (handempty ?h2) (holding ?h1 ?s) (used ?s ?i))
      eff: (and (contains ?s ?i) (not (empty ?s)))
  + refill-shot: ?s - shot ?i - ingredient ?h1 - hand ?h2 - hand ?d - dispenser
      pre: (and (dispenses ?d ?i) (empty ?s) (handempty ?h2) (holding ?h1 ?s) (not (= ?h1 ?h2)) (used ?s ?i))
      eff: (and (contains ?s ?i) (not (empty ?s)))
  - shake: ?b - cocktail ?d1 - ingredient ?d2 - ingredient ?s - shaker ?h1 - hand ?h2 - hand
      pre: (and (cocktail-part1 ?b ?d1) (cocktail-part2 ?b ?d2) (contains ?s ?d1) (contains ?s ?d2) (handempty ?h2) (holding ?h1 ?s) (unshaked ?s))
      eff: (and (contains ?s ?b) (not (contains ?s ?d1)) (not (contains ?s ?d2)) (not (unshaked ?s)) (shaked ?s))
  + shake: ?b - cocktail ?d1 - ingredient ?d2 - ingredient ?s - shaker ?h1 - hand ?h2 - hand
      pre: (and (cocktail-part1 ?b ?d1) (cocktail-part2 ?b ?d2) (contains ?s ?d1) (contains ?s ?d2) (handempty ?h2) (holding ?h1 ?s) (not (= ?h1 ?h2)) (unshaked ?s))
      eff: (and (contains ?s ?b) (not (contains ?s ?d1)) (not (contains ?s ?d2)) (not (unshaked ?s)) (shaked ?s))
Pred prop:
  + (= object object): in_pre in_pre_neg
