  drop: ?v - vehicle ?l - location ?p - package ?s1 - capacity-number ?s2 - capacity-number
      pre: (and (at ?v ?l) (capacity ?v ?s1) (capacity-predecessor ?s1 ?s2) (in ?p ?v))
