  (next place1 place2)
  (next place2 place3)
  (next place3 place4)
  (next place4 place5)
  (next place5 place6)
  (partners couple0 guy0 girl0)
  (partners couple1 guy1 girl1)
  (walked couple0 place0)
  (walked couple1 place0)
Goal:
  (and (walked couple0 place6) (walked couple1 place6))
Metric:
Pred prop:
  (= object object): in_pre in_pre_neg
  (at_car car place): in_init in_pre in_eff
  (at_person person place): in_init in_pre in_eff
  (at_tent tent place): in_init in_pre in_eff
