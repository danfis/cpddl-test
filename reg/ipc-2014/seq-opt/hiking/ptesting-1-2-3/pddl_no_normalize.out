Domain: hiking
Problem: hiking-1-2
Require:
  :equality
  :negative-preconditions
  :strips
  :typing
Type:
  car - object
  couple - object
  object
  person - object
  place - object
  tent - object
Obj:
  car0 - car
  car1 - car
  couple0 - couple
  girl0 - person
  guy0 - person
  place0 - place
  place1 - place
  place2 - place
  tent0 - tent
Predicate:
  (= object object) :eq
  (at_car car place)
  (at_person person place)
  (at_tent tent place)
  (down tent)
  (next place place)
  (partners couple person person)
  (up tent)
  (walked couple place)
Function:
Action:
  drive: ?x1 - person ?x2 - place ?x3 - place ?x4 - car
      pre: (and (at_car ?x4 ?x2) (at_person ?x1 ?x2))
      eff: (and (at_car ?x4 ?x3) (at_person ?x1 ?x3) (not (at_car ?x4 ?x2)) (not (at_person ?x1 ?x2)))
  drive_passenger: ?x1 - person ?x2 - place ?x3 - place ?x4 - car ?x5 - person
      pre: (and (at_car ?x4 ?x2) (at_person ?x1 ?x2) (at_person ?x5 ?x2) (not (= ?x1 ?x5)))
      eff: (and (at_car ?x4 ?x3) (at_person ?x1 ?x3) (at_person ?x5 ?x3) (not (at_car ?x4 ?x2)) (not (at_person ?x1 ?x2)) (not (at_person ?x5 ?x2)))
  drive_tent: ?x1 - person ?x2 - place ?x3 - place ?x4 - car ?x5 - tent
      pre: (and (at_car ?x4 ?x2) (at_person ?x1 ?x2) (at_tent ?x5 ?x2) (down ?x5))
      eff: (and (at_car ?x4 ?x3) (at_person ?x1 ?x3) (at_tent ?x5 ?x3) (not (at_car ?x4 ?x2)) (not (at_person ?x1 ?x2)) (not (at_tent ?x5 ?x2)))
  drive_tent_passenger: ?x1 - person ?x2 - place ?x3 - place ?x4 - car ?x5 - tent ?x6 - person
      pre: (and (at_car ?x4 ?x2) (at_person ?x1 ?x2) (at_person ?x6 ?x2) (at_tent ?x5 ?x2) (down ?x5) (not (= ?x1 ?x6)))
      eff: (and (at_car ?x4 ?x3) (at_person ?x1 ?x3) (at_person ?x6 ?x3) (at_tent ?x5 ?x3) (not (at_car ?x4 ?x2)) (not (at_person ?x1 ?x2)) (not (at_person ?x6 ?x2)) (not (at_tent ?x5 ?x2)))
  put_down: ?x1 - person ?x2 - place ?x3 - tent
      pre: (and (at_person ?x1 ?x2) (at_tent ?x3 ?x2) (up ?x3))
      eff: (and (down ?x3) (not (up ?x3)))
  put_up: ?x1 - person ?x2 - place ?x3 - tent
      pre: (and (at_person ?x1 ?x2) (at_tent ?x3 ?x2) (down ?x3))
      eff: (and (not (down ?x3)) (up ?x3))
  walk_together: ?x1 - tent ?x2 - place ?x3 - person ?x4 - place ?x5 - person ?x6 - couple
      pre: (and (at_person ?x3 ?x4) (at_person ?x5 ?x4) (at_tent ?x1 ?x2) (next ?x4 ?x2) (not (= ?x3 ?x5)) (partners ?x6 ?x3 ?x5) (up ?x1) (walked ?x6 ?x4))
      eff: (and (at_person ?x3 ?x2) (at_person ?x5 ?x2) (not (at_person ?x3 ?x4)) (not (at_person ?x5 ?x4)) (not (walked ?x6 ?x4)) (walked ?x6 ?x2))
Init:
  (at_car car0 place0)
  (at_car car1 place0)
  (at_person girl0 place0)
  (at_person guy0 place0)
  (at_tent tent0 place0)
  (next place0 place1)
  (next place1 place2)
  (partners couple0 guy0 girl0)
  (up tent0)
  (walked couple0 place0)
Goal:
  (and (walked couple0 place2))
Metric:
Pred prop:
  (= object object): in_pre in_pre_neg
  (at_car car place): in_init in_pre in_eff
  (at_person person place): in_init in_pre in_eff
  (at_tent tent place): in_init in_pre in_eff
  (down tent): in_pre in_eff
  (next place place): in_init in_pre
  (partners couple person person): in_init in_pre
  (up tent): in_init in_pre in_eff
  (walked couple place): in_init in_pre in_goal in_eff
Func prop:
Global prop:
  has_eq_pred
  is_unit_cost
