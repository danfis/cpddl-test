Action[7]:
    put_down: ?x1:3 ?x2:5 ?x3:2
        pre: (and (RW:at_tent ?x3 ?x2) (RW:at_person ?x1 ?x2) (RW:up ?x3))
        eff: (and (N:RW:up ?x3) (RW:down ?x3))
    put_up: ?x1:3 ?x2:5 ?x3:2
        pre: (and (RW:at_tent ?x3 ?x2) (RW:at_person ?x1 ?x2) (RW:down ?x3))
        eff: (and (RW:up ?x3) (N:RW:down ?x3))
    drive_passenger: ?x1:3 ?x2:5 ?x3:5 ?x4:1 ?x5:3
        pre: (and (N:R:equal ?x1 ?x5) (RW:at_person ?x1 ?x2) (RW:at_person ?x5 ?x2) (RW:at_car ?x4 ?x2))
        eff: (and (N:RW:at_person ?x1 ?x2) (RW:at_person ?x1 ?x3) (N:RW:at_person ?x5 ?x2) (RW:at_person ?x5 ?x3) (N:RW:at_car ?x4 ?x2) (RW:at_car ?x4 ?x3))
    drive: ?x1:3 ?x2:5 ?x3:5 ?x4:1
        pre: (and (RW:at_person ?x1 ?x2) (RW:at_car ?x4 ?x2))
        eff: (and (N:RW:at_person ?x1 ?x2) (RW:at_person ?x1 ?x3) (N:RW:at_car ?x4 ?x2) (RW:at_car ?x4 ?x3))
    drive_tent: ?x1:3 ?x2:5 ?x3:5 ?x4:1 ?x5:2
        pre: (and (RW:at_tent ?x5 ?x2) (RW:at_person ?x1 ?x2) (RW:at_car ?x4 ?x2) (RW:down ?x5))
        eff: (and (N:RW:at_tent ?x5 ?x2) (RW:at_tent ?x5 ?x3) (N:RW:at_person ?x1 ?x2) (RW:at_person ?x1 ?x3) (N:RW:at_car ?x4 ?x2) (RW:at_car ?x4 ?x3))
    drive_tent_passenger: ?x1:3 ?x2:5 ?x3:5 ?x4:1 ?x5:2 ?x6:3
        pre: (and (N:R:equal ?x1 ?x6) (RW:at_tent ?x5 ?x2) (RW:at_person ?x1 ?x2) (RW:at_person ?x6 ?x2) (RW:at_car ?x4 ?x2) (RW:down ?x5))
        eff: (and (N:RW:at_tent ?x5 ?x2) (RW:at_tent ?x5 ?x3) (N:RW:at_person ?x1 ?x2) (RW:at_person ?x1 ?x3) (N:RW:at_person ?x6 ?x2) (RW:at_person ?x6 ?x3) (N:RW:at_car ?x4 ?x2) (RW:at_car ?x4 ?x3))
    walk_together: ?x1:2 ?x2:5 ?x3:3 ?x4:5 ?x5:3 ?x6:4
        pre: (and (R:partners ?x6 ?x3 ?x5) (R:next ?x4 ?x2) (N:R:equal ?x3 ?x5) (RW:at_tent ?x1 ?x2) (RW:at_person ?x3 ?x4) (RW:at_person ?x5 ?x4) (RW:up ?x1) (RW:walked ?x6 ?x4))
        eff: (and (RW:at_person ?x3 ?x2) (N:RW:at_person ?x3 ?x4) (RW:at_person ?x5 ?x2) (N:RW:at_person ?x5 ?x4) (RW:walked ?x6 ?x2) (N:RW:walked ?x6 ?x4))
