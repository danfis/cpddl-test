Domain: floor-tile
Problem: p01-432
Require:
  :action-costs
  :strips
  :typing
Type:
  color - object
  object
  robot - object
  tile - object
Obj:
  black - color
  robot1 - robot
  robot2 - robot
  tile_0-1 - tile
  tile_0-2 - tile
  tile_0-3 - tile
  tile_1-1 - tile
  tile_1-2 - tile
  tile_1-3 - tile
  tile_2-1 - tile
  tile_2-2 - tile
  tile_2-3 - tile
  tile_3-1 - tile
  tile_3-2 - tile
  tile_3-3 - tile
  tile_4-1 - tile
  tile_4-2 - tile
  tile_4-3 - tile
  white - color
Predicate:
  (= object object) :eq
  (available-color color)
  (clear tile)
  (down tile tile)
  (left tile tile)
  (painted tile color)
  (right tile tile)
  (robot-at robot tile)
  (robot-has robot color)
  (up tile tile)
Function:
  (total-cost) :total-cost
Action:
  change-color: ?r - robot ?c - color ?c2 - color
      pre: (and (available-color ?c2) (robot-has ?r ?c))
      eff: (and (increase (total-cost) 5) (not (robot-has ?r ?c)) (robot-has ?r ?c2))
  down: ?r - robot ?x - tile ?y - tile
      pre: (and (clear ?y) (down ?y ?x) (robot-at ?r ?x))
      eff: (and (clear ?x) (increase (total-cost) 1) (not (clear ?y)) (not (robot-at ?r ?x)) (robot-at ?r ?y))
  left: ?r - robot ?x - tile ?y - tile
      pre: (and (clear ?y) (left ?y ?x) (robot-at ?r ?x))
      eff: (and (clear ?x) (increase (total-cost) 1) (not (clear ?y)) (not (robot-at ?r ?x)) (robot-at ?r ?y))
  paint-down: ?r - robot ?y - tile ?x - tile ?c - color
      pre: (and (clear ?y) (down ?y ?x) (robot-at ?r ?x) (robot-has ?r ?c))
      eff: (and (increase (total-cost) 2) (not (clear ?y)) (painted ?y ?c))
  paint-up: ?r - robot ?y - tile ?x - tile ?c - color
      pre: (and (clear ?y) (robot-at ?r ?x) (robot-has ?r ?c) (up ?y ?x))
      eff: (and (increase (total-cost) 2) (not (clear ?y)) (painted ?y ?c))
  right: ?r - robot ?x - tile ?y - tile
      pre: (and (clear ?y) (right ?y ?x) (robot-at ?r ?x))
      eff: (and (clear ?x) (increase (total-cost) 1) (not (clear ?y)) (not (robot-at ?r ?x)) (robot-at ?r ?y))
  up: ?r - robot ?x - tile ?y - tile
      pre: (and (clear ?y) (robot-at ?r ?x) (up ?y ?x))
      eff: (and (clear ?x) (increase (total-cost) 3) (not (clear ?y)) (not (robot-at ?r ?x)) (robot-at ?r ?y))
Init:
  (= (total-cost) 0)
  (available-color black)
  (available-color white)
  (clear tile_0-2)
  (clear tile_0-3)
  (clear tile_1-1)
  (clear tile_1-2)
  (clear tile_1-3)
  (clear tile_2-1)
  (clear tile_2-3)
  (clear tile_3-1)
  (clear tile_3-2)
  (clear tile_3-3)
  (clear tile_4-1)
  (clear tile_4-2)
  (clear tile_4-3)
  (down tile_0-1 tile_1-1)
  (down tile_0-2 tile_1-2)
  (down tile_0-3 tile_1-3)
  (down tile_1-1 tile_2-1)
  (down tile_1-2 tile_2-2)
  (down tile_1-3 tile_2-3)
  (down tile_2-1 tile_3-1)
  (down tile_2-2 tile_3-2)
  (down tile_2-3 tile_3-3)
  (down tile_3-1 tile_4-1)
  (down tile_3-2 tile_4-2)
  (down tile_3-3 tile_4-3)
  (left tile_0-1 tile_0-2)
  (left tile_0-2 tile_0-3)
  (left tile_1-1 tile_1-2)
  (left tile_1-2 tile_1-3)
  (left tile_2-1 tile_2-2)
  (left tile_2-2 tile_2-3)
  (left tile_3-1 tile_3-2)
  (left tile_3-2 tile_3-3)
  (left tile_4-1 tile_4-2)
  (left tile_4-2 tile_4-3)
  (right tile_0-2 tile_0-1)
  (right tile_0-3 tile_0-2)
  (right tile_1-2 tile_1-1)
  (right tile_1-3 tile_1-2)
  (right tile_2-2 tile_2-1)
  (right tile_2-3 tile_2-2)
  (right tile_3-2 tile_3-1)
  (right tile_3-3 tile_3-2)
  (right tile_4-2 tile_4-1)
  (right tile_4-3 tile_4-2)
  (robot-at robot1 tile_0-1)
  (robot-at robot2 tile_2-2)
  (robot-has robot1 white)
  (robot-has robot2 black)
  (up tile_1-1 tile_0-1)
  (up tile_1-2 tile_0-2)
  (up tile_1-3 tile_0-3)
  (up tile_2-1 tile_1-1)
  (up tile_2-2 tile_1-2)
  (up tile_2-3 tile_1-3)
  (up tile_3-1 tile_2-1)
  (up tile_3-2 tile_2-2)
  (up tile_3-3 tile_2-3)
  (up tile_4-1 tile_3-1)
  (up tile_4-2 tile_3-2)
  (up tile_4-3 tile_3-3)
Goal:
  (and (painted tile_1-1 white) (painted tile_1-2 black) (painted tile_1-3 white) (painted tile_2-1 black) (painted tile_2-2 white) (painted tile_2-3 black) (painted tile_3-1 white) (painted tile_3-2 black) (painted tile_3-3 white) (painted tile_4-1 black) (painted tile_4-2 white) (painted tile_4-3 black))
Metric:
  (total-cost)
Pred prop:
  (available-color color): in_init in_pre
  (clear tile): in_init in_pre in_eff
  (down tile tile): in_init in_pre
  (left tile tile): in_init in_pre
  (painted tile color): in_goal in_eff
  (right tile tile): in_init in_pre
  (robot-at robot tile): in_init in_pre in_eff
  (robot-has robot color): in_init in_pre in_eff
  (up tile tile): in_init in_pre
Func prop:
  (total-cost): in_init init_all_nonneg init_all_nonpos init_all_int in_metric is_metric_alone in_eff write_delta_nonneg write_delta_nonneg_int
Global prop:
  action_cost_func:(total-cost)
  has_int_action_cost_func
