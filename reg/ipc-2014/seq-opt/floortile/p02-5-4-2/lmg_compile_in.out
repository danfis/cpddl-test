Action[11]:
    change-color: ?r:1 ?c:3 ?c2:3
        pre: (and (R:available-color ?c2) (RW:robot-has ?r ?c))
        eff: (and (N:RW:robot-has ?r ?c) (RW:robot-has ?r ?c2) (increase (total-cost) 5))
    paint-up: ?r:1 ?y:2 ?x:2 ?c:3
        pre: (and (N:R:= ?y tile_1-2) (N:R:= ?y tile_1-4) (N:R:= ?y tile_2-1) (N:R:= ?y tile_2-3) (N:R:= ?y tile_3-2) (N:R:= ?y tile_3-4) (N:R:= ?y tile_4-1) (N:R:= ?y tile_4-3) (N:R:= ?y tile_5-2) (N:R:= ?y tile_5-4) (N:R:= ?y ?x) (R:= ?c white) (R:up ?y ?x) (RW:robot-at ?r ?x) (RW:clear ?y) (RW:robot-has ?r white))
        eff: (and (N:RW:clear ?y) (RW:painted ?y white) (increase (total-cost) 2))
    paint-down: ?r:1 ?y:2 ?x:2 ?c:3
        pre: (and (N:R:= ?y tile_1-2) (N:R:= ?y tile_1-4) (N:R:= ?y tile_2-1) (N:R:= ?y tile_2-3) (N:R:= ?y tile_3-2) (N:R:= ?y tile_3-4) (N:R:= ?y tile_4-1) (N:R:= ?y tile_4-3) (N:R:= ?y tile_5-2) (N:R:= ?y tile_5-4) (N:R:= ?y ?x) (R:= ?c white) (R:down ?y ?x) (RW:robot-at ?r ?x) (RW:clear ?y) (RW:robot-has ?r white))
        eff: (and (N:RW:clear ?y) (RW:painted ?y white) (increase (total-cost) 2))
    up: ?r:1 ?x:2 ?y:2
