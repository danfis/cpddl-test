Require:
  - :equality
Predicate:
  + (equal object object)
Action:
  - move-and-eat-spawn: ?head - object ?newhead - object ?spawnpoint - object ?nextspawnpoint - object
      pre: (and (NOT-blocked ?newhead) (headsnake ?head) (isadjacent ?head ?newhead) (ispoint ?newhead) (nextspawn ?spawnpoint ?nextspawnpoint) (not (= ?spawnpoint dummypoint)) (spawn ?spawnpoint))
      eff: (and (headsnake ?newhead) (ispoint ?spawnpoint) (nextsnake ?newhead ?head) (not (NOT-blocked ?newhead)) (not (NOT-ispoint ?spawnpoint)) (not (headsnake ?head)) (not (ispoint ?newhead)) (not (spawn ?spawnpoint)) (spawn ?nextspawnpoint) (when (not (= ?newhead ?spawnpoint)) (NOT-ispoint ?newhead)))
  + move-and-eat-spawn: ?head - object ?newhead - object ?spawnpoint - object ?nextspawnpoint - object
      pre: (and (NOT-blocked ?newhead) (headsnake ?head) (isadjacent ?head ?newhead) (ispoint ?newhead) (nextspawn ?spawnpoint ?nextspawnpoint) (not (equal ?spawnpoint dummypoint)) (spawn ?spawnpoint))
      eff: (and (headsnake ?newhead) (ispoint ?spawnpoint) (nextsnake ?newhead ?head) (not (NOT-blocked ?newhead)) (not (NOT-ispoint ?spawnpoint)) (not (headsnake ?head)) (not (ispoint ?newhead)) (not (spawn ?spawnpoint)) (spawn ?nextspawnpoint) (when (not (equal ?newhead ?spawnpoint)) (NOT-ispoint ?newhead)))
  - move: ?head - object ?newhead - object ?tail - object ?newtail - object
      pre: (and (NOT-blocked ?newhead) (NOT-ispoint ?newhead) (headsnake ?head) (isadjacent ?head ?newhead) (nextsnake ?newtail ?tail) (tailsnake ?tail))
      eff: (and (headsnake ?newhead) (nextsnake ?newhead ?head) (not (NOT-blocked ?newhead)) (not (headsnake ?head)) (not (nextsnake ?newtail ?tail)) (not (tailsnake ?tail)) (tailsnake ?newtail) (when (not (= ?newhead ?tail)) (NOT-blocked ?tail)))
  + move: ?head - object ?newhead - object ?tail - object ?newtail - object
      pre: (and (NOT-blocked ?newhead) (NOT-ispoint ?newhead) (headsnake ?head) (isadjacent ?head ?newhead) (nextsnake ?newtail ?tail) (tailsnake ?tail))
      eff: (and (headsnake ?newhead) (nextsnake ?newhead ?head) (not (NOT-blocked ?newhead)) (not (headsnake ?head)) (not (nextsnake ?newtail ?tail)) (not (tailsnake ?tail)) (tailsnake ?newtail) (when (not (equal ?newhead ?tail)) (NOT-blocked ?tail)))
Init:
  + (equal dummypoint dummypoint)
  + (equal pos0-0 pos0-0)
  + (equal pos0-1 pos0-1)
  + (equal pos0-2 pos0-2)
  + (equal pos0-3 pos0-3)
  + (equal pos0-4 pos0-4)
  + (equal pos0-5 pos0-5)
  + (equal pos0-6 pos0-6)
  + (equal pos1-0 pos1-0)
  + (equal pos1-1 pos1-1)
  + (equal pos1-2 pos1-2)
  + (equal pos1-3 pos1-3)
  + (equal pos1-4 pos1-4)
  + (equal pos1-5 pos1-5)
  + (equal pos1-6 pos1-6)
  + (equal pos2-0 pos2-0)
  + (equal pos2-1 pos2-1)
  + (equal pos2-2 pos2-2)
  + (equal pos2-3 pos2-3)
  + (equal pos2-4 pos2-4)
  + (equal pos2-5 pos2-5)
  + (equal pos2-6 pos2-6)
  + (equal pos3-0 pos3-0)
  + (equal pos3-1 pos3-1)
  + (equal pos3-2 pos3-2)
  + (equal pos3-3 pos3-3)
  + (equal pos3-4 pos3-4)
  + (equal pos3-5 pos3-5)
  + (equal pos3-6 pos3-6)
  + (equal pos4-0 pos4-0)
  + (equal pos4-1 pos4-1)
  + (equal pos4-2 pos4-2)
  + (equal pos4-3 pos4-3)
  + (equal pos4-4 pos4-4)
  + (equal pos4-5 pos4-5)
  + (equal pos4-6 pos4-6)
  + (equal pos5-0 pos5-0)
  + (equal pos5-1 pos5-1)
  + (equal pos5-2 pos5-2)
  + (equal pos5-3 pos5-3)
  + (equal pos5-4 pos5-4)
  + (equal pos5-5 pos5-5)
  + (equal pos5-6 pos5-6)
Pred prop:
  - (= object object): in_pre
  + (equal object object): in_init in_pre
