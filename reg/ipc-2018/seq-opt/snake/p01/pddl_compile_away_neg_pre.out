Require:
  + :conditional-effects
Predicate:
  + (NOT-blocked object)
  + (NOT-ispoint object) neg-of (ispoint)
  - (blocked object)
  - (ispoint object)
  + (ispoint object) neg-of (NOT-ispoint)
Action:
  - move-and-eat-no-spawn: ?head - object ?newhead - object
      pre: (and (headsnake ?head) (isadjacent ?head ?newhead) (ispoint ?newhead) (not (blocked ?newhead)) (spawn dummypoint))
      eff: (and (blocked ?newhead) (headsnake ?newhead) (nextsnake ?newhead ?head) (not (headsnake ?head)) (not (ispoint ?newhead)))
  + move-and-eat-no-spawn: ?head - object ?newhead - object
      pre: (and (NOT-blocked ?newhead) (headsnake ?head) (isadjacent ?head ?newhead) (ispoint ?newhead) (spawn dummypoint))
      eff: (and (NOT-ispoint ?newhead) (headsnake ?newhead) (nextsnake ?newhead ?head) (not (NOT-blocked ?newhead)) (not (headsnake ?head)) (not (ispoint ?newhead)))
  - move-and-eat-spawn: ?head - object ?newhead - object ?spawnpoint - object ?nextspawnpoint - object
      pre: (and (headsnake ?head) (isadjacent ?head ?newhead) (ispoint ?newhead) (nextspawn ?spawnpoint ?nextspawnpoint) (not (= ?spawnpoint dummypoint)) (not (blocked ?newhead)) (spawn ?spawnpoint))
      eff: (and (blocked ?newhead) (headsnake ?newhead) (ispoint ?spawnpoint) (nextsnake ?newhead ?head) (not (headsnake ?head)) (not (ispoint ?newhead)) (not (spawn ?spawnpoint)) (spawn ?nextspawnpoint))
  + move-and-eat-spawn: ?head - object ?newhead - object ?spawnpoint - object ?nextspawnpoint - object
      pre: (and (NOT-blocked ?newhead) (headsnake ?head) (isadjacent ?head ?newhead) (ispoint ?newhead) (nextspawn ?spawnpoint ?nextspawnpoint) (not (= ?spawnpoint dummypoint)) (spawn ?spawnpoint))
      eff: (and (headsnake ?newhead) (ispoint ?spawnpoint) (nextsnake ?newhead ?head) (not (NOT-blocked ?newhead)) (not (NOT-ispoint ?spawnpoint)) (not (headsnake ?head)) (not (ispoint ?newhead)) (not (spawn ?spawnpoint)) (spawn ?nextspawnpoint) (when (not (= ?newhead ?spawnpoint)) (NOT-ispoint ?newhead)))
  - move: ?head - object ?newhead - object ?tail - object ?newtail - object
      pre: (and (headsnake ?head) (isadjacent ?head ?newhead) (nextsnake ?newtail ?tail) (not (blocked ?newhead)) (not (ispoint ?newhead)) (tailsnake ?tail))
      eff: (and (blocked ?newhead) (headsnake ?newhead) (nextsnake ?newhead ?head) (not (blocked ?tail)) (not (headsnake ?head)) (not (nextsnake ?newtail ?tail)) (not (tailsnake ?tail)) (tailsnake ?newtail))
  + move: ?head - object ?newhead - object ?tail - object ?newtail - object
      pre: (and (NOT-blocked ?newhead) (NOT-ispoint ?newhead) (headsnake ?head) (isadjacent ?head ?newhead) (nextsnake ?newtail ?tail) (tailsnake ?tail))
      eff: (and (headsnake ?newhead) (nextsnake ?newhead ?head) (not (NOT-blocked ?newhead)) (not (headsnake ?head)) (not (nextsnake ?newtail ?tail)) (not (tailsnake ?tail)) (tailsnake ?newtail) (when (not (= ?newhead ?tail)) (NOT-blocked ?tail)))
Init:
  + (NOT-blocked pos0-0)
  + (NOT-blocked pos0-1)
  + (NOT-blocked pos0-2)
  + (NOT-blocked pos0-3)
  + (NOT-blocked pos0-4)
  + (NOT-blocked pos1-0)
  + (NOT-blocked pos1-1)
  + (NOT-blocked pos1-2)
  + (NOT-blocked pos1-3)
  + (NOT-blocked pos1-4)
  + (NOT-blocked pos2-0)
  + (NOT-blocked pos2-1)
  + (NOT-blocked pos2-2)
  + (NOT-blocked pos2-3)
  + (NOT-blocked pos2-4)
  + (NOT-blocked pos3-1)
  + (NOT-blocked pos3-2)
  + (NOT-blocked pos3-3)
  + (NOT-blocked pos3-4)
  + (NOT-blocked pos4-1)
  + (NOT-blocked pos4-2)
  + (NOT-blocked pos4-3)
  + (NOT-blocked pos4-4)
  + (NOT-ispoint pos0-0)
  + (NOT-ispoint pos0-1)
  + (NOT-ispoint pos0-2)
  + (NOT-ispoint pos0-3)
  + (NOT-ispoint pos1-0)
  + (NOT-ispoint pos1-1)
  + (NOT-ispoint pos1-2)
  + (NOT-ispoint pos1-4)
  + (NOT-ispoint pos2-0)
  + (NOT-ispoint pos2-1)
  + (NOT-ispoint pos2-2)
  + (NOT-ispoint pos2-3)
  + (NOT-ispoint pos3-0)
  + (NOT-ispoint pos3-2)
  + (NOT-ispoint pos3-3)
  + (NOT-ispoint pos3-4)
  + (NOT-ispoint pos4-0)
  + (NOT-ispoint pos4-2)
  + (NOT-ispoint pos4-3)
  + (NOT-ispoint pos4-4)
  - (blocked pos3-0)
  - (blocked pos4-0)
Goal:
  - (and (not (ispoint pos0-0)) (not (ispoint pos0-1)) (not (ispoint pos0-4)) (not (ispoint pos1-0)) (not (ispoint pos1-1)) (not (ispoint pos1-2)) (not (ispoint pos1-3)) (not (ispoint pos1-4)) (not (ispoint pos2-0)) (not (ispoint pos2-4)) (not (ispoint pos3-1)) (not (ispoint pos3-3)) (not (ispoint pos3-4)) (not (ispoint pos4-1)) (not (ispoint pos4-2)))
  + (and (NOT-ispoint pos0-0) (NOT-ispoint pos0-1) (NOT-ispoint pos0-4) (NOT-ispoint pos1-0) (NOT-ispoint pos1-1) (NOT-ispoint pos1-2) (NOT-ispoint pos1-3) (NOT-ispoint pos1-4) (NOT-ispoint pos2-0) (NOT-ispoint pos2-4) (NOT-ispoint pos3-1) (NOT-ispoint pos3-3) (NOT-ispoint pos3-4) (NOT-ispoint pos4-1) (NOT-ispoint pos4-2))
Pred prop:
  + (NOT-blocked object): in_init in_pre in_eff
  + (NOT-ispoint object): in_init in_pre in_goal in_eff
  - (blocked object): in_init in_pre in_pre_neg in_eff
  - (ispoint object): in_init in_pre in_pre_neg in_goal in_goal_neg in_eff
  + (ispoint object): in_init in_pre in_eff
