      pre: (and (NOT-blocked ?newhead) (NOT-ispoint ?newhead) (headsnake ?head) (isadjacent ?head ?newhead) (nextsnake ?newtail ?tail) (tailsnake ?tail))
      eff: (and (headsnake ?newhead) (nextsnake ?newhead ?head) (not (NOT-blocked ?newhead)) (not (headsnake ?head)) (not (nextsnake ?newtail ?tail)) (not (tailsnake ?tail)) (tailsnake ?newtail) (when (not (= ?newhead ?tail)) (NOT-blocked ?tail)))
