      pre: (and (NOT-blocked ?newhead) (headsnake ?head) (isadjacent ?head ?newhead) (ispoint ?newhead) (nextspawn ?spawnpoint ?nextspawnpoint) (not (= ?spawnpoint dummypoint)) (spawn ?spawnpoint))
