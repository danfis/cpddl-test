Require:
  - :conditional-effects
  - :disjunctive-preconditions
  - :equality
  - :existential-preconditions
  - :typing
  - :universal-preconditions
Predicate:
  + (equal object object)
Action:
  - move-and-eat-spawn: ?head - object ?newhead - object ?spawnpoint - object ?nextspawnpoint - object
      pre: (and (headsnake ?head) (isadjacent ?head ?newhead) (ispoint ?newhead) (nextspawn ?spawnpoint ?nextspawnpoint) (not (= ?spawnpoint dummypoint)) (not (blocked ?newhead)) (spawn ?spawnpoint))
      eff: (and (blocked ?newhead) (headsnake ?newhead) (ispoint ?spawnpoint) (nextsnake ?newhead ?head) (not (headsnake ?head)) (not (ispoint ?newhead)) (not (spawn ?spawnpoint)) (spawn ?nextspawnpoint))
  + move-and-eat-spawn: ?head - object ?newhead - object ?spawnpoint - object ?nextspawnpoint - object
      pre: (and (headsnake ?head) (isadjacent ?head ?newhead) (ispoint ?newhead) (nextspawn ?spawnpoint ?nextspawnpoint) (not (blocked ?newhead)) (not (equal ?spawnpoint dummypoint)) (spawn ?spawnpoint))
      eff: (and (blocked ?newhead) (headsnake ?newhead) (ispoint ?spawnpoint) (nextsnake ?newhead ?head) (not (headsnake ?head)) (not (ispoint ?newhead)) (not (spawn ?spawnpoint)) (spawn ?nextspawnpoint))
Init:
  + (equal dummypoint dummypoint)
  + (equal pos0-0 pos0-0)
  + (equal pos0-1 pos0-1)
  + (equal pos0-2 pos0-2)
  + (equal pos0-3 pos0-3)
  + (equal pos0-4 pos0-4)
  + (equal pos1-0 pos1-0)
  + (equal pos1-1 pos1-1)
  + (equal pos1-2 pos1-2)
  + (equal pos1-3 pos1-3)
  + (equal pos1-4 pos1-4)
  + (equal pos2-0 pos2-0)
  + (equal pos2-1 pos2-1)
  + (equal pos2-2 pos2-2)
  + (equal pos2-3 pos2-3)
  + (equal pos2-4 pos2-4)
  + (equal pos3-0 pos3-0)
  + (equal pos3-1 pos3-1)
  + (equal pos3-2 pos3-2)
  + (equal pos3-3 pos3-3)
  + (equal pos3-4 pos3-4)
  + (equal pos4-0 pos4-0)
  + (equal pos4-1 pos4-1)
  + (equal pos4-2 pos4-2)
  + (equal pos4-3 pos4-3)
  + (equal pos4-4 pos4-4)
Pred prop:
  - (= object object): in_pre in_pre_neg
  + (equal object object): in_init in_pre in_pre_neg
Global prop:
  - has_eq_pred
