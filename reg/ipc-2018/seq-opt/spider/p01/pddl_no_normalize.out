Domain: spider
Problem: spider-1-4-3-3-2-1400
Require:
  :action-costs
  :conditional-effects
  :disjunctive-preconditions
  :equality
  :existential-preconditions
  :negative-preconditions
  :strips
  :typing
  :universal-preconditions
Type:
  card - card_or_tableau
  card_or_tableau - cardposition
  cardposition - object
  deal - cardposition
  object
  tableau - card_or_tableau
Obj:
  card-d0-s0-v0 - card
  card-d0-s0-v1 - card
  card-d0-s0-v2 - card
  card-d0-s1-v0 - card
  card-d0-s1-v1 - card
  card-d0-s1-v2 - card
  card-d0-s2-v0 - card
  card-d0-s2-v1 - card
  card-d0-s2-v2 - card
  card-d0-s3-v0 - card
  card-d0-s3-v1 - card
  card-d0-s3-v2 - card
  deal-0 - deal
  deal-1 - deal
  deal-2 - deal
  discard - cardposition :constant
  pile-0 - tableau
  pile-1 - tableau
  pile-2 - tableau
Predicate:
  (= object object) :eq
  (can-be-placed-on card card)
  (can-continue-group card cardposition)
  (clear cardposition)
  (collect-card cardposition)
  (current-deal deal)
  (currently-collecting-deck)
  (currently-dealing)
  (currently-updating-movable)
  (currently-updating-part-of-tableau)
  (currently-updating-unmovable)
  (in-play card)
  (is-ace card)
  (is-king card)
  (make-movable cardposition)
  (make-part-of-tableau card tableau)
  (make-unmovable card)
  (movable card)
  (next-deal deal deal)
  (on card cardposition)
  (part-of-tableau cardposition tableau)
  (to-deal card tableau deal cardposition)
Function:
  (total-cost) :total-cost
Action:
  change-tableau-and-continue: ?c - card ?tbefore - tableau ?t - tableau ?next - card
      pre: (and (currently-updating-part-of-tableau) (make-part-of-tableau ?c ?t) (not (currently-collecting-deck)) (on ?next ?c) (part-of-tableau ?c ?tbefore))
      eff: (and (make-part-of-tableau ?next ?t) (not (make-part-of-tableau ?c ?t)) (not (part-of-tableau ?c ?tbefore)) (part-of-tableau ?c ?t))
  change-tableau-and-stop: ?c - card ?tbefore - tableau ?t - tableau
      pre: (and (clear ?c) (currently-updating-part-of-tableau) (make-part-of-tableau ?c ?t) (not (currently-collecting-deck)) (part-of-tableau ?c ?tbefore))
      eff: (and (not (currently-updating-part-of-tableau)) (not (make-part-of-tableau ?c ?t)) (not (part-of-tableau ?c ?tbefore)) (part-of-tableau ?c ?t))
  collect-card: ?c - card ?nextcard - cardposition ?p - tableau
      pre: (and (can-continue-group ?c ?nextcard) (collect-card ?c) (currently-collecting-deck) (in-play ?c) (not (currently-dealing)) (not (currently-updating-movable)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)) (on ?c ?nextcard) (part-of-tableau ?c ?p))
      eff: (and (clear ?nextcard) (collect-card ?nextcard) (not (collect-card ?c)) (not (in-play ?c)) (not (movable ?c)) (not (on ?c ?nextcard)) (not (part-of-tableau ?c ?p)) (on ?c discard))
  deal-card: ?c - card ?from - cardposition ?fromdeal - deal ?to - card ?totableau - tableau
      pre: (and (clear ?c) (clear ?to) (current-deal ?fromdeal) (currently-dealing) (not (currently-collecting-deck)) (not (currently-updating-movable)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)) (on ?c ?from) (part-of-tableau ?to ?totableau) (to-deal ?c ?totableau ?fromdeal ?from))
      eff: (and (clear ?from) (in-play ?c) (movable ?c) (not (clear ?to)) (not (on ?c ?from)) (on ?c ?to) (part-of-tableau ?c ?totableau) (when (not (can-continue-group ?c ?to)) (and (currently-updating-unmovable) (make-unmovable ?to))))
  finish-collecting-deck: ?c - card ?nextcard - cardposition ?p - tableau
      pre: (and (collect-card ?c) (currently-collecting-deck) (in-play ?c) (is-king ?c) (not (currently-dealing)) (not (currently-updating-movable)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)) (on ?c ?nextcard) (part-of-tableau ?c ?p))
      eff: (and (clear ?nextcard) (currently-updating-movable) (make-movable ?nextcard) (not (collect-card ?c)) (not (currently-collecting-deck)) (not (in-play ?c)) (not (movable ?c)) (not (on ?c ?nextcard)) (not (part-of-tableau ?c ?p)) (on ?c discard))
  finish-dealing: ?d - deal ?nd - deal
      pre: (and (clear ?d) (current-deal ?d) (currently-dealing) (next-deal ?d ?nd) (not (currently-collecting-deck)) (not (currently-updating-movable)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)))
      eff: (and (current-deal ?nd) (not (current-deal ?d)) (not (currently-dealing)))
  make-movable-and-continue: ?c - card ?nextcard - card
      pre: (and (can-continue-group ?c ?nextcard) (currently-updating-movable) (make-movable ?c) (not (currently-collecting-deck)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)) (on ?c ?nextcard))
      eff: (and (make-movable ?nextcard) (movable ?c) (not (make-movable ?c)))
  make-movable-and-stop: ?c - card ?nextcard - cardposition
      pre: (and (currently-updating-movable) (make-movable ?c) (not (can-continue-group ?c ?nextcard)) (not (currently-collecting-deck)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)) (on ?c ?nextcard))
      eff: (and (movable ?c) (not (currently-updating-movable)) (not (make-movable ?c)))
  make-movable-ignore-pile: ?p - tableau
      pre: (and (currently-updating-movable) (make-movable ?p) (not (currently-collecting-deck)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)))
      eff: (and (not (currently-updating-movable)) (not (make-movable ?p)))
  make-unmovable-and-continue: ?c - card ?nextcard - card
      pre: (and (can-continue-group ?c ?nextcard) (currently-updating-unmovable) (make-unmovable ?c) (movable ?nextcard) (not (currently-collecting-deck)) (not (currently-updating-part-of-tableau)) (on ?c ?nextcard))
      eff: (and (make-unmovable ?nextcard) (not (make-unmovable ?c)) (not (movable ?c)))
  make-unmovable-and-stop-at-tableau: ?c - card ?t - tableau
      pre: (and (currently-updating-unmovable) (make-unmovable ?c) (not (currently-collecting-deck)) (not (currently-updating-part-of-tableau)) (on ?c ?t))
      eff: (and (not (currently-updating-unmovable)) (not (make-unmovable ?c)) (not (movable ?c)))
  make-unmovable-and-stop-at-unmovable: ?c - card ?nextcard - card
      pre: (and (currently-updating-unmovable) (make-unmovable ?c) (not (currently-collecting-deck)) (not (currently-updating-part-of-tableau)) (not (movable ?nextcard)) (on ?c ?nextcard))
      eff: (and (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)) (not (make-unmovable ?c)) (not (movable ?c)))
  move-to-card: ?c - card ?from - card_or_tableau ?to - card ?totableau - tableau
      pre: (and (can-be-placed-on ?c ?to) (clear ?to) (in-play ?c) (in-play ?to) (movable ?c) (not (currently-collecting-deck)) (not (currently-dealing)) (not (currently-updating-movable)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)) (on ?c ?from) (part-of-tableau ?to ?totableau))
      eff: (and (clear ?from) (currently-updating-part-of-tableau) (increase (total-cost) 1) (make-part-of-tableau ?c ?totableau) (not (clear ?to)) (not (on ?c ?from)) (on ?c ?to) (when (not (can-continue-group ?c ?from)) (and (currently-updating-movable) (make-movable ?from))) (when (not (can-continue-group ?c ?to)) (and (currently-updating-unmovable) (make-unmovable ?to))))
  move-to-tableau: ?c - card ?from - card_or_tableau ?to - tableau
      pre: (and (clear ?to) (in-play ?c) (movable ?c) (not (currently-collecting-deck)) (not (currently-dealing)) (not (currently-updating-movable)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)) (on ?c ?from))
      eff: (and (clear ?from) (currently-updating-part-of-tableau) (increase (total-cost) 1) (make-part-of-tableau ?c ?to) (not (clear ?to)) (not (on ?c ?from)) (on ?c ?to) (when (not (can-continue-group ?c ?from)) (and (currently-updating-movable) (make-movable ?from))))
  start-collecting-deck: ?c - card
      pre: (and (clear ?c) (in-play ?c) (is-ace ?c) (not (currently-collecting-deck)) (not (currently-dealing)) (not (currently-updating-movable)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)))
      eff: (and (collect-card ?c) (currently-collecting-deck) (increase (total-cost) 1))
  start-dealing:
      pre: (and (not (currently-collecting-deck)) (not (currently-dealing)) (not (currently-updating-movable)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)))
      eff: (and (currently-dealing) (increase (total-cost) 1))
