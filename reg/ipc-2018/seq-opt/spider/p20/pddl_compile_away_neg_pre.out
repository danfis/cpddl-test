Require:
  - :negative-preconditions
Predicate:
  + (NOT-can-continue-group card cardposition) neg-of (can-continue-group)
  + (NOT-currently-collecting-deck) neg-of (currently-collecting-deck)
  + (NOT-currently-dealing) neg-of (currently-dealing)
  + (NOT-currently-updating-movable) neg-of (currently-updating-movable)
  + (NOT-currently-updating-part-of-tableau) neg-of (currently-updating-part-of-tableau)
  + (NOT-currently-updating-unmovable) neg-of (currently-updating-unmovable)
  + (NOT-movable card) neg-of (movable)
  - (can-continue-group card cardposition)
  + (can-continue-group card cardposition) neg-of (NOT-can-continue-group)
  - (currently-collecting-deck)
  + (currently-collecting-deck) neg-of (NOT-currently-collecting-deck)
  - (currently-dealing)
  + (currently-dealing) neg-of (NOT-currently-dealing)
  - (currently-updating-movable)
  + (currently-updating-movable) neg-of (NOT-currently-updating-movable)
  - (currently-updating-part-of-tableau)
  + (currently-updating-part-of-tableau) neg-of (NOT-currently-updating-part-of-tableau)
  - (currently-updating-unmovable)
  + (currently-updating-unmovable) neg-of (NOT-currently-updating-unmovable)
  - (movable card)
  + (movable card) neg-of (NOT-movable)
Action:
  - change-tableau-and-continue: ?c - card ?tbefore - tableau ?t - tableau ?next - card
      pre: (and (currently-updating-part-of-tableau) (make-part-of-tableau ?c ?t) (not (currently-collecting-deck)) (on ?next ?c) (part-of-tableau ?c ?tbefore))
      eff: (and (make-part-of-tableau ?next ?t) (not (make-part-of-tableau ?c ?t)) (not (part-of-tableau ?c ?tbefore)) (part-of-tableau ?c ?t))
  + change-tableau-and-continue: ?c - card ?tbefore - tableau ?t - tableau ?next - card
      pre: (and (NOT-currently-collecting-deck) (currently-updating-part-of-tableau) (make-part-of-tableau ?c ?t) (on ?next ?c) (part-of-tableau ?c ?tbefore))
      eff: (and (make-part-of-tableau ?next ?t) (not (make-part-of-tableau ?c ?t)) (not (part-of-tableau ?c ?tbefore)) (part-of-tableau ?c ?t))
  - change-tableau-and-stop: ?c - card ?tbefore - tableau ?t - tableau
      pre: (and (clear ?c) (currently-updating-part-of-tableau) (make-part-of-tableau ?c ?t) (not (currently-collecting-deck)) (part-of-tableau ?c ?tbefore))
      eff: (and (not (currently-updating-part-of-tableau)) (not (make-part-of-tableau ?c ?t)) (not (part-of-tableau ?c ?tbefore)) (part-of-tableau ?c ?t))
  + change-tableau-and-stop: ?c - card ?tbefore - tableau ?t - tableau
      pre: (and (NOT-currently-collecting-deck) (clear ?c) (currently-updating-part-of-tableau) (make-part-of-tableau ?c ?t) (part-of-tableau ?c ?tbefore))
      eff: (and (NOT-currently-updating-part-of-tableau) (not (currently-updating-part-of-tableau)) (not (make-part-of-tableau ?c ?t)) (not (part-of-tableau ?c ?tbefore)) (part-of-tableau ?c ?t))
  - collect-card: ?c - card ?nextcard - cardposition ?p - tableau
      pre: (and (can-continue-group ?c ?nextcard) (collect-card ?c) (currently-collecting-deck) (in-play ?c) (not (currently-dealing)) (not (currently-updating-movable)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)) (on ?c ?nextcard) (part-of-tableau ?c ?p))
      eff: (and (clear ?nextcard) (collect-card ?nextcard) (not (collect-card ?c)) (not (in-play ?c)) (not (movable ?c)) (not (on ?c ?nextcard)) (not (part-of-tableau ?c ?p)) (on ?c discard))
  + collect-card: ?c - card ?nextcard - cardposition ?p - tableau
      pre: (and (NOT-currently-dealing) (NOT-currently-updating-movable) (NOT-currently-updating-part-of-tableau) (NOT-currently-updating-unmovable) (can-continue-group ?c ?nextcard) (collect-card ?c) (currently-collecting-deck) (in-play ?c) (on ?c ?nextcard) (part-of-tableau ?c ?p))
      eff: (and (NOT-movable ?c) (clear ?nextcard) (collect-card ?nextcard) (not (collect-card ?c)) (not (in-play ?c)) (not (movable ?c)) (not (on ?c ?nextcard)) (not (part-of-tableau ?c ?p)) (on ?c discard))
  - deal-card: ?c - card ?from - cardposition ?fromdeal - deal ?to - card ?totableau - tableau
      pre: (and (clear ?c) (clear ?to) (current-deal ?fromdeal) (currently-dealing) (not (currently-collecting-deck)) (not (currently-updating-movable)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)) (on ?c ?from) (part-of-tableau ?to ?totableau) (to-deal ?c ?totableau ?fromdeal ?from))
      eff: (and (clear ?from) (in-play ?c) (movable ?c) (not (clear ?to)) (not (on ?c ?from)) (on ?c ?to) (part-of-tableau ?c ?totableau) (when (not (can-continue-group ?c ?to)) (and (currently-updating-unmovable) (make-unmovable ?to))))
  + deal-card: ?c - card ?from - cardposition ?fromdeal - deal ?to - card ?totableau - tableau
      pre: (and (NOT-currently-collecting-deck) (NOT-currently-updating-movable) (NOT-currently-updating-part-of-tableau) (NOT-currently-updating-unmovable) (clear ?c) (clear ?to) (current-deal ?fromdeal) (currently-dealing) (on ?c ?from) (part-of-tableau ?to ?totableau) (to-deal ?c ?totableau ?fromdeal ?from))
      eff: (and (clear ?from) (in-play ?c) (movable ?c) (not (NOT-movable ?c)) (not (clear ?to)) (not (on ?c ?from)) (on ?c ?to) (part-of-tableau ?c ?totableau) (when (NOT-can-continue-group ?c ?to) (and (currently-updating-unmovable) (make-unmovable ?to) (not (NOT-currently-updating-unmovable)))))
  - finish-collecting-deck: ?c - card ?nextcard - cardposition ?p - tableau
      pre: (and (collect-card ?c) (currently-collecting-deck) (in-play ?c) (is-king ?c) (not (currently-dealing)) (not (currently-updating-movable)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)) (on ?c ?nextcard) (part-of-tableau ?c ?p))
      eff: (and (clear ?nextcard) (currently-updating-movable) (make-movable ?nextcard) (not (collect-card ?c)) (not (currently-collecting-deck)) (not (in-play ?c)) (not (movable ?c)) (not (on ?c ?nextcard)) (not (part-of-tableau ?c ?p)) (on ?c discard))
  + finish-collecting-deck: ?c - card ?nextcard - cardposition ?p - tableau
      pre: (and (NOT-currently-dealing) (NOT-currently-updating-movable) (NOT-currently-updating-part-of-tableau) (NOT-currently-updating-unmovable) (collect-card ?c) (currently-collecting-deck) (in-play ?c) (is-king ?c) (on ?c ?nextcard) (part-of-tableau ?c ?p))
      eff: (and (NOT-currently-collecting-deck) (NOT-movable ?c) (clear ?nextcard) (currently-updating-movable) (make-movable ?nextcard) (not (NOT-currently-updating-movable)) (not (collect-card ?c)) (not (currently-collecting-deck)) (not (in-play ?c)) (not (movable ?c)) (not (on ?c ?nextcard)) (not (part-of-tableau ?c ?p)) (on ?c discard))
  - finish-dealing: ?d - deal ?nd - deal
      pre: (and (clear ?d) (current-deal ?d) (currently-dealing) (next-deal ?d ?nd) (not (currently-collecting-deck)) (not (currently-updating-movable)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)))
      eff: (and (current-deal ?nd) (not (current-deal ?d)) (not (currently-dealing)))
  + finish-dealing: ?d - deal ?nd - deal
      pre: (and (NOT-currently-collecting-deck) (NOT-currently-updating-movable) (NOT-currently-updating-part-of-tableau) (NOT-currently-updating-unmovable) (clear ?d) (current-deal ?d) (currently-dealing) (next-deal ?d ?nd))
      eff: (and (NOT-currently-dealing) (current-deal ?nd) (not (current-deal ?d)) (not (currently-dealing)))
  - make-movable-and-continue: ?c - card ?nextcard - card
      pre: (and (can-continue-group ?c ?nextcard) (currently-updating-movable) (make-movable ?c) (not (currently-collecting-deck)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)) (on ?c ?nextcard))
      eff: (and (make-movable ?nextcard) (movable ?c) (not (make-movable ?c)))
  + make-movable-and-continue: ?c - card ?nextcard - card
      pre: (and (NOT-currently-collecting-deck) (NOT-currently-updating-part-of-tableau) (NOT-currently-updating-unmovable) (can-continue-group ?c ?nextcard) (currently-updating-movable) (make-movable ?c) (on ?c ?nextcard))
      eff: (and (make-movable ?nextcard) (movable ?c) (not (NOT-movable ?c)) (not (make-movable ?c)))
  - make-movable-and-stop: ?c - card ?nextcard - cardposition
      pre: (and (currently-updating-movable) (make-movable ?c) (not (can-continue-group ?c ?nextcard)) (not (currently-collecting-deck)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)) (on ?c ?nextcard))
      eff: (and (movable ?c) (not (currently-updating-movable)) (not (make-movable ?c)))
  - make-movable-ignore-pile: ?p - tableau
      pre: (and (currently-updating-movable) (make-movable ?p) (not (currently-collecting-deck)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)))
      eff: (and (not (currently-updating-movable)) (not (make-movable ?p)))
  + make-movable-ignore-pile: ?p - tableau
      pre: (and (NOT-currently-collecting-deck) (NOT-currently-updating-part-of-tableau) (NOT-currently-updating-unmovable) (currently-updating-movable) (make-movable ?p))
      eff: (and (NOT-currently-updating-movable) (not (currently-updating-movable)) (not (make-movable ?p)))
  - make-unmovable-and-continue: ?c - card ?nextcard - card
      pre: (and (can-continue-group ?c ?nextcard) (currently-updating-unmovable) (make-unmovable ?c) (movable ?nextcard) (not (currently-collecting-deck)) (not (currently-updating-part-of-tableau)) (on ?c ?nextcard))
      eff: (and (make-unmovable ?nextcard) (not (make-unmovable ?c)) (not (movable ?c)))
  + make-unmovable-and-continue: ?c - card ?nextcard - card
      pre: (and (NOT-currently-collecting-deck) (NOT-currently-updating-part-of-tableau) (can-continue-group ?c ?nextcard) (currently-updating-unmovable) (make-unmovable ?c) (movable ?nextcard) (on ?c ?nextcard))
      eff: (and (NOT-movable ?c) (make-unmovable ?nextcard) (not (make-unmovable ?c)) (not (movable ?c)))
  - make-unmovable-and-stop-at-tableau: ?c - card ?t - tableau
      pre: (and (currently-updating-unmovable) (make-unmovable ?c) (not (currently-collecting-deck)) (not (currently-updating-part-of-tableau)) (on ?c ?t))
      eff: (and (not (currently-updating-unmovable)) (not (make-unmovable ?c)) (not (movable ?c)))
  + make-unmovable-and-stop-at-tableau: ?c - card ?t - tableau
      pre: (and (NOT-currently-collecting-deck) (NOT-currently-updating-part-of-tableau) (currently-updating-unmovable) (make-unmovable ?c) (on ?c ?t))
      eff: (and (NOT-currently-updating-unmovable) (NOT-movable ?c) (not (currently-updating-unmovable)) (not (make-unmovable ?c)) (not (movable ?c)))
  - make-unmovable-and-stop-at-unmovable: ?c - card ?nextcard - card
      pre: (and (currently-updating-unmovable) (make-unmovable ?c) (not (currently-collecting-deck)) (not (currently-updating-part-of-tableau)) (not (movable ?nextcard)) (on ?c ?nextcard))
      eff: (and (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)) (not (make-unmovable ?c)) (not (movable ?c)))
  + make-unmovable-and-stop-at-unmovable: ?c - card ?nextcard - card
      pre: (and (NOT-currently-collecting-deck) (NOT-currently-updating-part-of-tableau) (NOT-movable ?nextcard) (currently-updating-unmovable) (make-unmovable ?c) (on ?c ?nextcard))
      eff: (and (NOT-currently-updating-part-of-tableau) (NOT-currently-updating-unmovable) (NOT-movable ?c) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)) (not (make-unmovable ?c)) (not (movable ?c)))
  - move-to-card: ?c - card ?from - card_or_tableau ?to - card ?totableau - tableau
      pre: (and (can-be-placed-on ?c ?to) (clear ?to) (in-play ?c) (in-play ?to) (movable ?c) (not (currently-collecting-deck)) (not (currently-dealing)) (not (currently-updating-movable)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)) (on ?c ?from) (part-of-tableau ?to ?totableau))
      eff: (and (clear ?from) (currently-updating-part-of-tableau) (increase (total-cost) 1) (make-part-of-tableau ?c ?totableau) (not (clear ?to)) (not (on ?c ?from)) (on ?c ?to) (when (not (can-continue-group ?c ?from)) (and (currently-updating-movable) (make-movable ?from))) (when (not (can-continue-group ?c ?to)) (and (currently-updating-unmovable) (make-unmovable ?to))))
  + move-to-card: ?c - card ?from - card_or_tableau ?to - card ?totableau - tableau
      pre: (and (NOT-currently-collecting-deck) (NOT-currently-dealing) (NOT-currently-updating-movable) (NOT-currently-updating-part-of-tableau) (NOT-currently-updating-unmovable) (can-be-placed-on ?c ?to) (clear ?to) (in-play ?c) (in-play ?to) (movable ?c) (on ?c ?from) (part-of-tableau ?to ?totableau))
      eff: (and (clear ?from) (currently-updating-part-of-tableau) (increase (total-cost) 1) (make-part-of-tableau ?c ?totableau) (not (NOT-currently-updating-part-of-tableau)) (not (clear ?to)) (not (on ?c ?from)) (on ?c ?to) (when (NOT-can-continue-group ?c ?from) (and (currently-updating-movable) (make-movable ?from) (not (NOT-currently-updating-movable)))) (when (NOT-can-continue-group ?c ?to) (and (currently-updating-unmovable) (make-unmovable ?to) (not (NOT-currently-updating-unmovable)))))
  - move-to-tableau: ?c - card ?from - card_or_tableau ?to - tableau
      pre: (and (clear ?to) (in-play ?c) (movable ?c) (not (currently-collecting-deck)) (not (currently-dealing)) (not (currently-updating-movable)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)) (on ?c ?from))
      eff: (and (clear ?from) (currently-updating-part-of-tableau) (increase (total-cost) 1) (make-part-of-tableau ?c ?to) (not (clear ?to)) (not (on ?c ?from)) (on ?c ?to) (when (not (can-continue-group ?c ?from)) (and (currently-updating-movable) (make-movable ?from))))
  + move-to-tableau: ?c - card ?from - card_or_tableau ?to - tableau
      pre: (and (NOT-currently-collecting-deck) (NOT-currently-dealing) (NOT-currently-updating-movable) (NOT-currently-updating-part-of-tableau) (NOT-currently-updating-unmovable) (clear ?to) (in-play ?c) (movable ?c) (on ?c ?from))
      eff: (and (clear ?from) (currently-updating-part-of-tableau) (increase (total-cost) 1) (make-part-of-tableau ?c ?to) (not (NOT-currently-updating-part-of-tableau)) (not (clear ?to)) (not (on ?c ?from)) (on ?c ?to) (when (NOT-can-continue-group ?c ?from) (and (currently-updating-movable) (make-movable ?from) (not (NOT-currently-updating-movable)))))
  - start-collecting-deck: ?c - card
      pre: (and (clear ?c) (in-play ?c) (is-ace ?c) (not (currently-collecting-deck)) (not (currently-dealing)) (not (currently-updating-movable)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)))
      eff: (and (collect-card ?c) (currently-collecting-deck) (increase (total-cost) 1))
  + start-collecting-deck: ?c - card
      pre: (and (NOT-currently-collecting-deck) (NOT-currently-dealing) (NOT-currently-updating-movable) (NOT-currently-updating-part-of-tableau) (NOT-currently-updating-unmovable) (clear ?c) (in-play ?c) (is-ace ?c))
      eff: (and (collect-card ?c) (currently-collecting-deck) (increase (total-cost) 1) (not (NOT-currently-collecting-deck)))
  - start-dealing:
      pre: (and (not (currently-collecting-deck)) (not (currently-dealing)) (not (currently-updating-movable)) (not (currently-updating-part-of-tableau)) (not (currently-updating-unmovable)))
      eff: (and (currently-dealing) (increase (total-cost) 1))
  + start-dealing:
      pre: (and (NOT-currently-collecting-deck) (NOT-currently-dealing) (NOT-currently-updating-movable) (NOT-currently-updating-part-of-tableau) (NOT-currently-updating-unmovable))
      eff: (and (currently-dealing) (increase (total-cost) 1) (not (NOT-currently-dealing)))
