      pre: (and (NOT-currently-collecting-deck) (currently-updating-part-of-tableau) (make-part-of-tableau ?c ?t) (on ?next ?c) (part-of-tableau ?c ?tbefore))
      eff: (and (make-part-of-tableau ?next ?t) (not (make-part-of-tableau ?c ?t)) (not (part-of-tableau ?c ?tbefore)) (part-of-tableau ?c ?t))
  change-tableau-and-stop: ?c - card ?tbefore - tableau ?t - tableau
      pre: (and (NOT-currently-collecting-deck) (clear ?c) (currently-updating-part-of-tableau) (make-part-of-tableau ?c ?t) (part-of-tableau ?c ?tbefore))
