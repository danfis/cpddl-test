  move-to-card: ?c - card ?from - card_or_tableau ?to - card ?totableau - tableau
      pre: (and (NOT-currently-collecting-deck) (NOT-currently-dealing) (NOT-currently-updating-movable) (NOT-currently-updating-part-of-tableau) (NOT-currently-updating-unmovable) (can-be-placed-on ?c ?to) (clear ?to) (in-play ?c) (in-play ?to) (movable ?c) (on ?c ?from) (part-of-tableau ?to ?totableau))
