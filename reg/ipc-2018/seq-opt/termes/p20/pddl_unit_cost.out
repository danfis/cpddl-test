  (NOT-has-block) neg-of (has-block)
  (at position)
  (has-block) neg-of (NOT-has-block)
  (height position numb)
  (is-depot position)
  (neighbor position position)
  (succ numb numb)
Function:
Action:
  create-block: ?p - position
      pre: (and (NOT-has-block) (at ?p) (is-depot ?p))
      eff: (and (has-block) (not (NOT-has-block)))
  destroy-block: ?p - position
      pre: (and (at ?p) (has-block) (is-depot ?p))
      eff: (and (NOT-has-block) (not (has-block)))
  move-down: ?from - position ?hfrom - numb ?to - position ?hto - numb
      pre: (and (at ?from) (height ?from ?hfrom) (height ?to ?hto) (neighbor ?from ?to) (succ ?hfrom ?hto))
      eff: (and (at ?to) (not (at ?from)))
  move-up: ?from - position ?hfrom - numb ?to - position ?hto - numb
      pre: (and (at ?from) (height ?from ?hfrom) (height ?to ?hto) (neighbor ?from ?to) (succ ?hto ?hfrom))
      eff: (and (at ?to) (not (at ?from)))
  move: ?from - position ?to - position ?h - numb
      pre: (and (at ?from) (height ?from ?h) (height ?to ?h) (neighbor ?from ?to))
      eff: (and (at ?to) (not (at ?from)))
  place-block: ?rpos - position ?bpos - position ?hbefore - numb ?hafter - numb
      pre: (and (at ?rpos) (has-block) (height ?bpos ?hbefore) (height ?rpos ?hbefore) (neighbor ?rpos ?bpos) (not (is-depot ?bpos)) (succ ?hafter ?hbefore))
      eff: (and (NOT-has-block) (height ?bpos ?hafter) (not (has-block)) (not (height ?bpos ?hbefore)))
  remove-block: ?rpos - position ?bpos - position ?hbefore - numb ?hafter - numb
      pre: (and (NOT-has-block) (at ?rpos) (height ?bpos ?hbefore) (height ?rpos ?hafter) (neighbor ?rpos ?bpos) (succ ?hbefore ?hafter))
      eff: (and (has-block) (height ?bpos ?hafter) (not (NOT-has-block)) (not (height ?bpos ?hbefore)))
