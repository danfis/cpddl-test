Require:
  - :negative-preconditions
Predicate:
  + (NOT-has-block) neg-of (has-block)
  - (has-block)
  + (has-block) neg-of (NOT-has-block)
Action:
  - create-block: ?p - position
      pre: (and (at ?p) (is-depot ?p) (not (has-block)))
      eff: (and (has-block))
  + create-block: ?p - position
      pre: (and (NOT-has-block) (at ?p) (is-depot ?p))
      eff: (and (has-block) (not (NOT-has-block)))
  - destroy-block: ?p - position
      pre: (and (at ?p) (has-block) (is-depot ?p))
      eff: (and (not (has-block)))
  + destroy-block: ?p - position
      pre: (and (at ?p) (has-block) (is-depot ?p))
      eff: (and (NOT-has-block) (not (has-block)))
  - place-block: ?rpos - position ?bpos - position ?hbefore - numb ?hafter - numb
      pre: (and (at ?rpos) (has-block) (height ?bpos ?hbefore) (height ?rpos ?hbefore) (neighbor ?rpos ?bpos) (not (is-depot ?bpos)) (succ ?hafter ?hbefore))
      eff: (and (height ?bpos ?hafter) (not (has-block)) (not (height ?bpos ?hbefore)))
  - remove-block: ?rpos - position ?bpos - position ?hbefore - numb ?hafter - numb
      pre: (and (at ?rpos) (height ?bpos ?hbefore) (height ?rpos ?hafter) (neighbor ?rpos ?bpos) (not (has-block)) (succ ?hbefore ?hafter))
      eff: (and (has-block) (height ?bpos ?hafter) (not (height ?bpos ?hbefore)))
  + remove-block: ?rpos - position ?bpos - position ?hbefore - numb ?hafter - numb
      pre: (and (NOT-has-block) (at ?rpos) (height ?bpos ?hbefore) (height ?rpos ?hafter) (neighbor ?rpos ?bpos) (succ ?hbefore ?hafter))
      eff: (and (has-block) (height ?bpos ?hafter) (not (NOT-has-block)) (not (height ?bpos ?hbefore)))
Init:
  + (NOT-has-block)
Goal:
  - (and (height pos-0-0 n4) (height pos-0-1 n0) (height pos-0-2 n2) (height pos-1-0 n4) (height pos-1-1 n2) (height pos-1-2 n0) (height pos-2-0 n0) (height pos-2-1 n0) (height pos-2-2 n0) (height pos-3-0 n2) (height pos-3-1 n0) (height pos-3-2 n2) (not (has-block)))
  + (and (NOT-has-block) (height pos-0-0 n4) (height pos-0-1 n0) (height pos-0-2 n2) (height pos-1-0 n4) (height pos-1-1 n2) (height pos-1-2 n0) (height pos-2-0 n0) (height pos-2-1 n0) (height pos-2-2 n0) (height pos-3-0 n2) (height pos-3-1 n0) (height pos-3-2 n2))
Pred prop:
  + (NOT-has-block): in_init in_pre in_goal in_eff
  - (has-block): in_pre in_goal in_eff
  + (has-block): in_pre in_eff
