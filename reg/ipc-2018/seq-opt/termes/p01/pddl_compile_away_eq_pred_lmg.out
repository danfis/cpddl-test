Require:
  - :equality
Predicate:
  + (equal object object)
Action:
  - move-down: ?from - position ?hfrom - numb ?to - position ?hto - numb
      pre: (and (= ?hfrom ?hto) (at ?from) (height ?from ?hfrom) (height ?to ?hto) (neighbor ?from ?to) (succ ?hfrom ?hto))
      eff: (and (at ?to) (not (at ?from)))
  - move-down: ?from - position ?hfrom - numb ?to - position ?hto - numb
      pre: (and (at ?from) (height ?from ?hfrom) (height ?to ?hto) (neighbor ?from ?to) (not (= ?from ?to)) (succ ?hfrom ?hto))
      eff: (and (at ?to) (not (at ?from)))
  + move-down: ?from - position ?hfrom - numb ?to - position ?hto - numb
      pre: (and (at ?from) (equal ?hfrom ?hto) (height ?from ?hfrom) (height ?to ?hto) (neighbor ?from ?to) (succ ?hfrom ?hto))
      eff: (and (at ?to) (not (at ?from)))
  + move-down: ?from - position ?hfrom - numb ?to - position ?hto - numb
      pre: (and (at ?from) (height ?from ?hfrom) (height ?to ?hto) (neighbor ?from ?to) (not (equal ?from ?to)) (succ ?hfrom ?hto))
      eff: (and (at ?to) (not (at ?from)))
  - move-up: ?from - position ?hfrom - numb ?to - position ?hto - numb
      pre: (and (= ?hfrom ?hto) (at ?from) (height ?from ?hfrom) (height ?to ?hto) (neighbor ?from ?to) (succ ?hto ?hfrom))
      eff: (and (at ?to) (not (at ?from)))
  - move-up: ?from - position ?hfrom - numb ?to - position ?hto - numb
      pre: (and (at ?from) (height ?from ?hfrom) (height ?to ?hto) (neighbor ?from ?to) (not (= ?from ?to)) (succ ?hto ?hfrom))
      eff: (and (at ?to) (not (at ?from)))
  + move-up: ?from - position ?hfrom - numb ?to - position ?hto - numb
      pre: (and (at ?from) (equal ?hfrom ?hto) (height ?from ?hfrom) (height ?to ?hto) (neighbor ?from ?to) (succ ?hto ?hfrom))
      eff: (and (at ?to) (not (at ?from)))
  + move-up: ?from - position ?hfrom - numb ?to - position ?hto - numb
      pre: (and (at ?from) (height ?from ?hfrom) (height ?to ?hto) (neighbor ?from ?to) (not (equal ?from ?to)) (succ ?hto ?hfrom))
      eff: (and (at ?to) (not (at ?from)))
  - remove-block: ?rpos - position ?bpos - position ?hbefore - numb ?hafter - numb
      pre: (and (= ?hbefore ?hafter) (NOT-has-block) (at ?rpos) (height ?bpos ?hbefore) (height ?rpos ?hafter) (neighbor ?rpos ?bpos) (succ ?hbefore ?hafter))
      eff: (and (has-block) (height ?bpos ?hafter) (not (NOT-has-block)) (not (height ?bpos ?hbefore)))
  - remove-block: ?rpos - position ?bpos - position ?hbefore - numb ?hafter - numb
      pre: (and (NOT-has-block) (at ?rpos) (height ?bpos ?hbefore) (height ?rpos ?hafter) (neighbor ?rpos ?bpos) (not (= ?rpos ?bpos)) (succ ?hbefore ?hafter))
      eff: (and (has-block) (height ?bpos ?hafter) (not (NOT-has-block)) (not (height ?bpos ?hbefore)))
  + remove-block: ?rpos - position ?bpos - position ?hbefore - numb ?hafter - numb
      pre: (and (NOT-has-block) (at ?rpos) (equal ?hbefore ?hafter) (height ?bpos ?hbefore) (height ?rpos ?hafter) (neighbor ?rpos ?bpos) (succ ?hbefore ?hafter))
      eff: (and (has-block) (height ?bpos ?hafter) (not (NOT-has-block)) (not (height ?bpos ?hbefore)))
  + remove-block: ?rpos - position ?bpos - position ?hbefore - numb ?hafter - numb
      pre: (and (NOT-has-block) (at ?rpos) (height ?bpos ?hbefore) (height ?rpos ?hafter) (neighbor ?rpos ?bpos) (not (equal ?rpos ?bpos)) (succ ?hbefore ?hafter))
      eff: (and (has-block) (height ?bpos ?hafter) (not (NOT-has-block)) (not (height ?bpos ?hbefore)))
Init:
  + (equal n0 n0)
  + (equal n1 n1)
  + (equal n2 n2)
  + (equal n3 n3)
  + (equal pos-0-0 pos-0-0)
  + (equal pos-0-1 pos-0-1)
  + (equal pos-0-2 pos-0-2)
  + (equal pos-1-0 pos-1-0)
  + (equal pos-1-1 pos-1-1)
  + (equal pos-1-2 pos-1-2)
  + (equal pos-2-0 pos-2-0)
  + (equal pos-2-1 pos-2-1)
  + (equal pos-2-2 pos-2-2)
  + (equal pos-3-0 pos-3-0)
  + (equal pos-3-1 pos-3-1)
  + (equal pos-3-2 pos-3-2)
Pred prop:
  - (= object object): in_pre
  + (equal object object): in_init in_pre
