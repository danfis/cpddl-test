Domain: termes
Problem: termes-00038-0036-4x3x3-random_towers_4x3_3_1_3
Require:
  :negative-preconditions
  :strips
  :typing
Type:
  numb - object
  object
  position - object
Obj:
  n0 - numb
  n1 - numb
  n2 - numb
  n3 - numb
  pos-0-0 - position
  pos-0-1 - position
  pos-0-2 - position
  pos-1-0 - position
  pos-1-1 - position
  pos-1-2 - position
  pos-2-0 - position
  pos-2-1 - position
  pos-2-2 - position
  pos-3-0 - position
  pos-3-1 - position
  pos-3-2 - position
Predicate:
  (= object object) :eq
  (at position)
  (has-block)
  (height position numb)
  (is-depot position)
  (neighbor position position)
  (succ numb numb)
Function:
Action:
  create-block: ?p - position
      pre: (and (at ?p) (is-depot ?p) (not (has-block)))
      eff: (and (has-block))
  destroy-block: ?p - position
      pre: (and (at ?p) (has-block) (is-depot ?p))
      eff: (and (not (has-block)))
  move-down: ?from - position ?hfrom - numb ?to - position ?hto - numb
      pre: (and (at ?from) (height ?from ?hfrom) (height ?to ?hto) (neighbor ?from ?to) (succ ?hfrom ?hto))
      eff: (and (at ?to) (not (at ?from)))
  move-up: ?from - position ?hfrom - numb ?to - position ?hto - numb
      pre: (and (at ?from) (height ?from ?hfrom) (height ?to ?hto) (neighbor ?from ?to) (succ ?hto ?hfrom))
      eff: (and (at ?to) (not (at ?from)))
  move: ?from - position ?to - position ?h - numb
      pre: (and (at ?from) (height ?from ?h) (height ?to ?h) (neighbor ?from ?to))
      eff: (and (at ?to) (not (at ?from)))
  place-block: ?rpos - position ?bpos - position ?hbefore - numb ?hafter - numb
      pre: (and (at ?rpos) (has-block) (height ?bpos ?hbefore) (height ?rpos ?hbefore) (neighbor ?rpos ?bpos) (not (is-depot ?bpos)) (succ ?hafter ?hbefore))
      eff: (and (height ?bpos ?hafter) (not (has-block)) (not (height ?bpos ?hbefore)))
  remove-block: ?rpos - position ?bpos - position ?hbefore - numb ?hafter - numb
      pre: (and (at ?rpos) (height ?bpos ?hbefore) (height ?rpos ?hafter) (neighbor ?rpos ?bpos) (not (has-block)) (succ ?hbefore ?hafter))
      eff: (and (has-block) (height ?bpos ?hafter) (not (height ?bpos ?hbefore)))
Init:
  (at pos-2-0)
  (height pos-0-0 n0)
  (height pos-0-1 n0)
  (height pos-0-2 n0)
  (height pos-1-0 n0)
  (height pos-1-1 n0)
  (height pos-1-2 n0)
  (height pos-2-0 n0)
  (height pos-2-1 n0)
  (height pos-2-2 n0)
  (height pos-3-0 n0)
  (height pos-3-1 n0)
  (height pos-3-2 n0)
  (is-depot pos-2-0)
  (neighbor pos-0-0 pos-0-1)
  (neighbor pos-0-0 pos-1-0)
  (neighbor pos-0-1 pos-0-0)
  (neighbor pos-0-1 pos-0-2)
  (neighbor pos-0-1 pos-1-1)
  (neighbor pos-0-2 pos-0-1)
  (neighbor pos-0-2 pos-1-2)
  (neighbor pos-1-0 pos-0-0)
  (neighbor pos-1-0 pos-1-1)
  (neighbor pos-1-0 pos-2-0)
  (neighbor pos-1-1 pos-0-1)
  (neighbor pos-1-1 pos-1-0)
  (neighbor pos-1-1 pos-1-2)
  (neighbor pos-1-1 pos-2-1)
  (neighbor pos-1-2 pos-0-2)
  (neighbor pos-1-2 pos-1-1)
  (neighbor pos-1-2 pos-2-2)
  (neighbor pos-2-0 pos-1-0)
  (neighbor pos-2-0 pos-2-1)
  (neighbor pos-2-0 pos-3-0)
  (neighbor pos-2-1 pos-1-1)
  (neighbor pos-2-1 pos-2-0)
  (neighbor pos-2-1 pos-2-2)
  (neighbor pos-2-1 pos-3-1)
  (neighbor pos-2-2 pos-1-2)
  (neighbor pos-2-2 pos-2-1)
  (neighbor pos-2-2 pos-3-2)
  (neighbor pos-3-0 pos-2-0)
  (neighbor pos-3-0 pos-3-1)
  (neighbor pos-3-1 pos-2-1)
  (neighbor pos-3-1 pos-3-0)
  (neighbor pos-3-1 pos-3-2)
  (neighbor pos-3-2 pos-2-2)
  (neighbor pos-3-2 pos-3-1)
  (succ n1 n0)
  (succ n2 n1)
  (succ n3 n2)
Goal:
  (and (height pos-0-0 n0) (height pos-0-1 n0) (height pos-0-2 n0) (height pos-1-0 n0) (height pos-1-1 n0) (height pos-1-2 n3) (height pos-2-0 n0) (height pos-2-1 n0) (height pos-2-2 n0) (height pos-3-0 n0) (height pos-3-1 n0) (height pos-3-2 n0) (not (has-block)))
Metric:
Pred prop:
  (at position): in_init in_pre in_eff
  (has-block): in_pre in_pre_neg in_goal in_goal_neg in_eff
  (height position numb): in_init in_pre in_goal in_eff
