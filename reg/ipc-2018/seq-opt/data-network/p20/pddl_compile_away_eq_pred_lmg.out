Action[5]:
    release: ?d:1 ?s:3 ?size:4 ?before:4 ?after:4
        pre: (and (R:data-size ?d ?size) (R:sum ?after ?size ?before) (RW:cached ?d ?s) (RW:usage ?s ?before))
        eff: (and (N:RW:cached ?d ?s) (N:RW:usage ?s ?before) (RW:usage ?s ?after) (RW:NOT-cached ?d ?s))
    save: ?d:1 ?size:4 ?s:3
        pre: (and (R:data-size ?d ?size) (RW:cached ?d ?s))
        eff: (and (RW:saved ?d ?s) (increase (total-cost) (io-cost ?s ?size)))
    load: ?d:1 ?s:3 ?size:4 ?limit:4 ?before:4 ?after:4
        pre: (and (R:data-size ?d ?size) (R:capacity ?s ?limit) (R:sum ?before ?size ?after) (R:less-equal ?after ?limit) (RW:saved ?d ?s) (RW:usage ?s ?before) (RW:NOT-cached ?d ?s))
        eff: (and (RW:cached ?d ?s) (N:RW:usage ?s ?before) (RW:usage ?s ?after) (N:RW:NOT-cached ?d ?s) (increase (total-cost) (io-cost ?s ?size)))
    send: ?d:1 ?from:3 ?to:3 ?size:4 ?limit:4 ?before:4 ?after:4
        pre: (and (R:connected ?from ?to) (R:data-size ?d ?size) (R:capacity ?to ?limit) (R:sum ?before ?size ?after) (R:less-equal ?after ?limit) (N:R:equal ?from ?to) (RW:cached ?d ?from) (RW:usage ?to ?before) (RW:NOT-cached ?d ?to))
        eff: (and (RW:cached ?d ?to) (N:RW:usage ?to ?before) (RW:usage ?to ?after) (N:RW:NOT-cached ?d ?to) (increase (total-cost) (send-cost ?from ?to ?size)))
    process: ?in1:1 ?in2:1 ?out:1 ?sc:2 ?s:3 ?size:4 ?limit:4 ?before:4 ?after:4
        pre: (and (R:script-io ?sc ?in1 ?in2 ?out) (R:data-size ?out ?size) (R:capacity ?s ?limit) (R:sum ?before ?size ?after) (R:less-equal ?after ?limit) (N:R:equal ?in1 ?out) (N:R:equal ?in2 ?out) (RW:cached ?in1 ?s) (RW:cached ?in2 ?s) (RW:usage ?s ?before) (RW:NOT-cached ?out ?s))
        eff: (and (RW:cached ?out ?s) (N:RW:usage ?s ?before) (RW:usage ?s ?after) (N:RW:NOT-cached ?out ?s) (increase (total-cost) (process-cost ?sc ?s)))
