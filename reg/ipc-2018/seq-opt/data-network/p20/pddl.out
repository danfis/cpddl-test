Action:
  load: ?d - data ?s - server ?size - numbers ?limit - numbers ?before - numbers ?after - numbers
      pre: (and (NOT-cached ?d ?s) (capacity ?s ?limit) (data-size ?d ?size) (less-equal ?after ?limit) (saved ?d ?s) (sum ?before ?size ?after) (usage ?s ?before))
      eff: (and (cached ?d ?s) (increase (total-cost) (io-cost ?s ?size)) (not (NOT-cached ?d ?s)) (not (usage ?s ?before)) (usage ?s ?after))
  process: ?in1 - data ?in2 - data ?out - data ?sc - script ?s - server ?size - numbers ?limit - numbers ?before - numbers ?after - numbers
      pre: (and (NOT-cached ?out ?s) (cached ?in1 ?s) (cached ?in2 ?s) (capacity ?s ?limit) (data-size ?out ?size) (less-equal ?after ?limit) (script-io ?sc ?in1 ?in2 ?out) (sum ?before ?size ?after) (usage ?s ?before))
      eff: (and (cached ?out ?s) (increase (total-cost) (process-cost ?sc ?s)) (not (NOT-cached ?out ?s)) (not (usage ?s ?before)) (usage ?s ?after))
  release: ?d - data ?s - server ?size - numbers ?before - numbers ?after - numbers
      pre: (and (cached ?d ?s) (data-size ?d ?size) (sum ?after ?size ?before) (usage ?s ?before))
      eff: (and (NOT-cached ?d ?s) (not (cached ?d ?s)) (not (usage ?s ?before)) (usage ?s ?after))
  save: ?d - data ?size - numbers ?s - server
      pre: (and (cached ?d ?s) (data-size ?d ?size))
      eff: (and (increase (total-cost) (io-cost ?s ?size)) (saved ?d ?s))
  send: ?d - data ?from - server ?to - server ?size - numbers ?limit - numbers ?before - numbers ?after - numbers
      pre: (and (NOT-cached ?d ?to) (cached ?d ?from) (capacity ?to ?limit) (connected ?from ?to) (data-size ?d ?size) (less-equal ?after ?limit) (sum ?before ?size ?after) (usage ?to ?before))
      eff: (and (cached ?d ?to) (increase (total-cost) (send-cost ?from ?to ?size)) (not (NOT-cached ?d ?to)) (not (usage ?to ?before)) (usage ?to ?after))
