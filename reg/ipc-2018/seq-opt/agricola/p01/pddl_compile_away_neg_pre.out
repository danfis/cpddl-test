  - family_growth: ?w1 - worker ?w2 - worker ?wmax - worker ?wnewmax - worker ?r - round ?res - resource ?room - room
      pre: (and (available_action act_family) (built_rooms ?room ?wnewmax) (current_round ?r) (current_worker ?w1) (max_worker ?wmax) (next_worker ?w1 ?w2) (next_worker ?wnewmax ?wmax) (open_action act_family))
      eff: (and (current_worker ?w2) (increase (total-cost) (group_worker_cost ?wmax)) (newborn) (not (available_action act_family)) (not (current_worker ?w1)))
  + family_growth: ?w1 - worker ?w2 - worker ?wmax - worker ?wnewmax - worker ?r - round ?res - resource ?room - room
      pre: (and (available_action act_family) (built_rooms ?room ?wnewmax) (current_round ?r) (current_worker ?w1) (max_worker ?wmax) (next_worker ?w1 ?w2) (next_worker ?wnewmax ?wmax) (open_action act_family))
      eff: (and (current_worker ?w2) (increase (total-cost) (group_worker_cost ?wmax)) (newborn) (not (NOT-newborn)) (not (available_action act_family)) (not (current_worker ?w1)))
  - plow_field: ?w1 - worker ?w2 - worker ?wmax - worker ?r - round
      pre: (and (available_action act_plow) (current_round ?r) (current_worker ?w1) (max_worker ?wmax) (next_worker ?w1 ?w2) (not (plowed_fields)))
      eff: (and (current_worker ?w2) (increase (total-cost) (group_worker_cost ?wmax)) (not (available_action act_plow)) (not (current_worker ?w1)) (plowed_fields))
  + plow_field: ?w1 - worker ?w2 - worker ?wmax - worker ?r - round
      pre: (and (NOT-plowed_fields) (available_action act_plow) (current_round ?r) (current_worker ?w1) (max_worker ?wmax) (next_worker ?w1 ?w2))
      eff: (and (current_worker ?w2) (increase (total-cost) (group_worker_cost ?wmax)) (not (NOT-plowed_fields)) (not (available_action act_plow)) (not (current_worker ?w1)) (plowed_fields))
