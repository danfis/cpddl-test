  ag__finish_stage: ?s1 - stage ?s2 - stage ?r1 - round ?r2 - round ?act - actiontag
      pre: (and (category_round ?r1 tharvest) (current_stage ?s1) (drawcard_round ?act ?r2) (harvest_phase ?s1 harvest_end) (hold_round ?r1 roundend) (next_round ?r1 ?r2) (next_stage ?s1 ?s2))
      eff: (and (current_round ?r2) (current_stage ?s2) (harvest_phase ?s2 harvest_init) (increase (total-cost) 1) (not (current_stage ?s1)) (not (hold_round ?r1 roundend)) (open_action ?act))
  ag__harvest_breed_end: ?r - round ?s - stage
      pre: (and (category_round ?r tharvest) (harvest_phase ?s harvest_breeding) (hold_round ?r roundend))
      eff: (and (harvest_phase ?s harvest_end) (increase (total-cost) 1) (not (harvest_phase ?s harvest_breeding)))
