      pre: (and (can_breed ?a) (category_round ?r tharvest) (harvest_phase ?s harvest_breeding) (hold_round ?r roundend) (next2_num ?i ?i2) (num_food ?i) (owned_animals ?a))
      eff: (and (increase (total-cost) 1) (not (can_breed ?a)) (not (num_food ?i)) (num_food ?i2))
  ag__harvest_collect_end: ?r - round ?s - stage
      pre: (and (category_round ?r tharvest) (harvest_phase ?s harvest_init) (hold_round ?r roundend))
      eff: (and (harvest_phase ?s harvest_feeding) (increase (total-cost) 1) (not (harvest_phase ?s harvest_init)))
  ag__harvest_collecting_fromoven: ?r - round ?s - stage ?v - vegetable ?i1 - num ?i2 - num ?i3 - num
      pre: (and (can_harvest ?v) (category_round ?r tharvest) (harvest_phase ?s harvest_init) (hold_round ?r roundend) (home_improvement oven) (next2_num ?i1 ?i2) (next2_num ?i2 ?i3) (num_food ?i1) (sown_veg ?v))
      eff: (and (increase (total-cost) 1) (not (can_harvest ?v)) (not (num_food ?i1)) (not (sown_veg ?v)) (num_food ?i3))
