Action:
  ag__advance_round_normal: ?r1 - round ?r2 - round ?act - actiontag
      pre: (and (category_round ?r1 tnormal) (drawcard_round ?act ?r2) (hold_round ?r1 roundend) (next_round ?r1 ?r2))
      eff: (and (current_round ?r2) (increase (total-cost) 1) (not (hold_round ?r1 roundend)) (open_action ?act))
  ag__finish_round_backhome: ?r - round ?maxw - worker
      pre: (and (current_round ?r) (current_worker noworker) (max_worker ?maxw) (not (newborn)))
      eff: (and (current_worker ?maxw) (hold_round ?r backhome) (increase (total-cost) 1) (not (current_round ?r)) (not (current_worker noworker)))
