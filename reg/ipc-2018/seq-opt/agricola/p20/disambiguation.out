(ag__advance_round_normal round1 round2 act_sheep)
   (hold_round round1 roundend)
   + (current_worker worker2) (max_worker worker2)
(ag__advance_round_normal round2 round3 act_sow)
   (hold_round round2 roundend)
   + (current_worker worker2) (max_worker worker2)
(ag__advance_round_normal round3 round4 act_family)
   (hold_round round3 roundend)
   + (current_worker worker2) (max_worker worker2)
(ag__finish_round_renew round1 noworker)
   (hold_round round1 backhome)
   + (current_worker worker2) (max_worker worker2)
(ag__finish_round_renew round2 noworker)
   (hold_round round2 backhome)
   + (current_worker worker2) (max_worker worker2)
(ag__finish_round_renew round3 noworker)
   (hold_round round3 backhome)
   + (current_worker worker2) (max_worker worker2)
