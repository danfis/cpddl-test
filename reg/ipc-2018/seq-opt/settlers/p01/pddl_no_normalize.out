      eff: (and (forall (?sold - stone_level ?al - stone_atleastlevel) (when (and (available-stone ?p ?sold) (del-atleast-stone ?sold sl2 ?al)) (not (available-atleast-stone ?p ?al)))) (forall (?sold - stone_level ?snew - stone_level) (when (and (available-stone ?p ?sold) (diff-stone ?sold sl2 ?snew)) (and (available-stone ?p ?snew) (not (available-stone ?p ?sold))))) (forall (?wold - wood_level ?al - wood_atleastlevel) (when (and (available-wood ?p ?wold) (del-atleast-wood ?wold wl2 ?al)) (not (available-atleast-wood ?p ?al)))) (forall (?wold - wood_level ?wnew - wood_level) (when (and (available-wood ?p ?wold) (diff-wood ?wold wl2 ?wnew)) (and (available-wood ?p ?wnew) (not (available-wood ?p ?wold))))) (has-ironworks ?p) (increase (total-cost) 15))
  build-rail: ?p1 - place ?p2 - place
