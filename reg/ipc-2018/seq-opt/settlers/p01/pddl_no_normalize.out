Action:
  build-cart: ?p - place ?v - vehicle
      pre: (and (available-atleast-timber ?p tl1) (potential ?v))
      eff: (and (forall (?told - timber_level ?al - timber_atleastlevel) (when (and (available-timber ?p ?told) (del-atleast-timber ?told tl1 ?al)) (not (available-atleast-timber ?p ?al)))) (forall (?told - timber_level ?tnew - timber_level) (when (and (available-timber ?p ?told) (diff-timber ?told tl1 ?tnew)) (and (available-timber ?p ?tnew) (not (available-timber ?p ?told))))) (has-space ?v) (increase (total-cost) 5) (is-at ?v ?p) (is-cart ?v) (not (potential ?v)) (space-in ?v spl1))
