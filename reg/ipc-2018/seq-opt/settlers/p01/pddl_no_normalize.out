  make-iron: ?p - place
      pre: (and (available-atleast-coal ?p cl2) (available-atleast-ore ?p ol1) (has-ironworks ?p))
      eff: (and (forall (?cold - coal_level ?al - coal_atleastlevel) (when (and (available-coal ?p ?cold) (del-atleast-coal ?cold cl2 ?al)) (not (available-atleast-coal ?p ?al)))) (forall (?cold - coal_level ?cnew - coal_level) (when (and (available-coal ?p ?cold) (diff-coal ?cold cl2 ?cnew)) (and (available-coal ?p ?cnew) (not (available-coal ?p ?cold))))) (forall (?iold - iron_level ?al - iron_atleastlevel) (when (and (add-atleast-iron ?iold il1 ?al) (available-iron ?p ?iold)) (available-atleast-iron ?p ?al))) (forall (?iold - iron_level ?inew - iron_level) (when (and (available-iron ?p ?iold) (diff-iron ?inew il1 ?iold)) (and (available-iron ?p ?inew) (not (available-iron ?p ?iold))))) (forall (?oold - ore_level ?al - ore_atleastlevel) (when (and (available-ore ?p ?oold) (del-atleast-ore ?oold ol1 ?al)) (not (available-atleast-ore ?p ?al)))) (forall (?oold - ore_level ?onew - ore_level) (when (and (available-ore ?p ?oold) (diff-ore ?oold ol1 ?onew)) (and (available-ore ?p ?onew) (not (available-ore ?p ?oold))))) (increase (total-cost) 20))
  move-cart: ?v - vehicle ?p1 - place ?p2 - place
      pre: (and (connected-by-land ?p1 ?p2) (is-at ?v ?p1) (is-cart ?v))
      eff: (and (increase (total-cost) 10) (is-at ?v ?p2) (not (is-at ?v ?p1)))
  move-ship: ?v - vehicle ?p1 - place ?p2 - place
      pre: (and (available-atleast-coal ?v cl2) (connected-by-sea ?p1 ?p2) (is-at ?v ?p1) (is-ship ?v))
      eff: (and (forall (?cold - coal_level ?al - coal_atleastlevel) (when (and (available-coal ?v ?cold) (del-atleast-coal ?cold cl2 ?al)) (not (available-atleast-coal ?v ?al)))) (forall (?cold - coal_level ?cnew - coal_level) (when (and (available-coal ?v ?cold) (diff-coal ?cold cl2 ?cnew)) (and (available-coal ?v ?cnew) (not (available-coal ?v ?cold))))) (forall (?sold - space_level ?snew - space_level) (when (and (diff-space ?snew spl2 ?sold) (space-in ?v ?sold)) (and (not (space-in ?v ?sold)) (space-in ?v ?snew)))) (has-space ?v) (increase (total-cost) 20) (is-at ?v ?p2) (not (is-at ?v ?p1)))
  move-train: ?v - vehicle ?p1 - place ?p2 - place
      pre: (and (available-atleast-coal ?v cl1) (connected-by-rail ?p1 ?p2) (is-at ?v ?p1) (is-train ?v))
      eff: (and (forall (?cold - coal_level ?al - coal_atleastlevel) (when (and (available-coal ?v ?cold) (del-atleast-coal ?cold cl1 ?al)) (not (available-atleast-coal ?v ?al)))) (forall (?cold - coal_level ?cnew - coal_level) (when (and (available-coal ?v ?cold) (diff-coal ?cold cl1 ?cnew)) (and (available-coal ?v ?cnew) (not (available-coal ?v ?cold))))) (forall (?sold - space_level ?snew - space_level) (when (and (diff-space ?snew spl1 ?sold) (space-in ?v ?sold)) (and (not (space-in ?v ?sold)) (space-in ?v ?snew)))) (has-space ?v) (increase (total-cost) 10) (is-at ?v ?p2) (not (is-at ?v ?p1)))
  saw-wood: ?p - place
      pre: (and (available-atleast-timber ?p tl1) (has-sawmill ?p))
      eff: (and (forall (?told - timber_level ?al - timber_atleastlevel) (when (and (available-timber ?p ?told) (del-atleast-timber ?told tl1 ?al)) (not (available-atleast-timber ?p ?al)))) (forall (?told - timber_level ?tnew - timber_level) (when (and (available-timber ?p ?told) (diff-timber ?told tl1 ?tnew)) (and (available-timber ?p ?tnew) (not (available-timber ?p ?told))))) (forall (?wold - wood_level ?al - wood_atleastlevel) (when (and (add-atleast-wood ?wold wl1 ?al) (available-wood ?p ?wold)) (available-atleast-wood ?p ?al))) (forall (?wold - wood_level ?wnew - wood_level) (when (and (available-wood ?p ?wold) (diff-wood ?wnew wl1 ?wold)) (and (available-wood ?p ?wnew) (not (available-wood ?p ?wold))))))
  unload-coal: ?v - vehicle ?p - place
      pre: (and (available-atleast-coal ?v cl1) (is-at ?v ?p))
      eff: (and (forall (?rpold - coal_level ?al - coal_atleastlevel) (when (and (add-atleast-coal ?rpold cl1 ?al) (available-coal ?p ?rpold)) (available-atleast-coal ?p ?al))) (forall (?rpold - coal_level ?rpnew - coal_level) (when (and (available-coal ?p ?rpold) (diff-coal ?rpnew cl1 ?rpold)) (and (available-coal ?p ?rpnew) (not (available-coal ?p ?rpold))))) (forall (?rvold - coal_level ?al - coal_atleastlevel) (when (and (available-coal ?v ?rvold) (del-atleast-coal ?rvold cl1 ?al)) (not (available-atleast-coal ?v ?al)))) (forall (?rvold - coal_level ?rvnew - coal_level) (when (and (available-coal ?v ?rvold) (diff-coal ?rvold cl1 ?rvnew)) (and (available-coal ?v ?rvnew) (not (available-coal ?v ?rvold))))) (forall (?sold - space_level ?snew - space_level) (when (and (diff-space ?snew spl1 ?sold) (space-in ?v ?sold)) (and (not (space-in ?v ?sold)) (space-in ?v ?snew)))) (has-space ?v) (increase (total-cost) 5))
  unload-iron: ?v - vehicle ?p - place
      pre: (and (available-atleast-iron ?v il1) (is-at ?v ?p))
      eff: (and (forall (?rpold - iron_level ?al - iron_atleastlevel) (when (and (add-atleast-iron ?rpold il1 ?al) (available-iron ?p ?rpold)) (available-atleast-iron ?p ?al))) (forall (?rpold - iron_level ?rpnew - iron_level) (when (and (available-iron ?p ?rpold) (diff-iron ?rpnew il1 ?rpold)) (and (available-iron ?p ?rpnew) (not (available-iron ?p ?rpold))))) (forall (?rvold - iron_level ?al - iron_atleastlevel) (when (and (available-iron ?v ?rvold) (del-atleast-iron ?rvold il1 ?al)) (not (available-atleast-iron ?v ?al)))) (forall (?rvold - iron_level ?rvnew - iron_level) (when (and (available-iron ?v ?rvold) (diff-iron ?rvold il1 ?rvnew)) (and (available-iron ?v ?rvnew) (not (available-iron ?v ?rvold))))) (forall (?sold - space_level ?snew - space_level) (when (and (diff-space ?snew spl1 ?sold) (space-in ?v ?sold)) (and (not (space-in ?v ?sold)) (space-in ?v ?snew)))) (has-space ?v) (increase (total-cost) 5))
  unload-ore: ?v - vehicle ?p - place
      pre: (and (available-atleast-ore ?v ol1) (is-at ?v ?p))
      eff: (and (forall (?rpold - ore_level ?al - ore_atleastlevel) (when (and (add-atleast-ore ?rpold ol1 ?al) (available-ore ?p ?rpold)) (available-atleast-ore ?p ?al))) (forall (?rpold - ore_level ?rpnew - ore_level) (when (and (available-ore ?p ?rpold) (diff-ore ?rpnew ol1 ?rpold)) (and (available-ore ?p ?rpnew) (not (available-ore ?p ?rpold))))) (forall (?rvold - ore_level ?al - ore_atleastlevel) (when (and (available-ore ?v ?rvold) (del-atleast-ore ?rvold ol1 ?al)) (not (available-atleast-ore ?v ?al)))) (forall (?rvold - ore_level ?rvnew - ore_level) (when (and (available-ore ?v ?rvold) (diff-ore ?rvold ol1 ?rvnew)) (and (available-ore ?v ?rvnew) (not (available-ore ?v ?rvold))))) (forall (?sold - space_level ?snew - space_level) (when (and (diff-space ?snew spl1 ?sold) (space-in ?v ?sold)) (and (not (space-in ?v ?sold)) (space-in ?v ?snew)))) (has-space ?v) (increase (total-cost) 5))
  unload-stone: ?v - vehicle ?p - place
      pre: (and (available-atleast-stone ?v sl1) (is-at ?v ?p))
      eff: (and (forall (?rpold - stone_level ?al - stone_atleastlevel) (when (and (add-atleast-stone ?rpold sl1 ?al) (available-stone ?p ?rpold)) (available-atleast-stone ?p ?al))) (forall (?rpold - stone_level ?rpnew - stone_level) (when (and (available-stone ?p ?rpold) (diff-stone ?rpnew sl1 ?rpold)) (and (available-stone ?p ?rpnew) (not (available-stone ?p ?rpold))))) (forall (?rvold - stone_level ?al - stone_atleastlevel) (when (and (available-stone ?v ?rvold) (del-atleast-stone ?rvold sl1 ?al)) (not (available-atleast-stone ?v ?al)))) (forall (?rvold - stone_level ?rvnew - stone_level) (when (and (available-stone ?v ?rvold) (diff-stone ?rvold sl1 ?rvnew)) (and (available-stone ?v ?rvnew) (not (available-stone ?v ?rvold))))) (forall (?sold - space_level ?snew - space_level) (when (and (diff-space ?snew spl1 ?sold) (space-in ?v ?sold)) (and (not (space-in ?v ?sold)) (space-in ?v ?snew)))) (has-space ?v) (increase (total-cost) 5))
  unload-timber: ?v - vehicle ?p - place
      pre: (and (available-atleast-timber ?v tl1) (is-at ?v ?p))
      eff: (and (forall (?rpold - timber_level ?al - timber_atleastlevel) (when (and (add-atleast-timber ?rpold tl1 ?al) (available-timber ?p ?rpold)) (available-atleast-timber ?p ?al))) (forall (?rpold - timber_level ?rpnew - timber_level) (when (and (available-timber ?p ?rpold) (diff-timber ?rpnew tl1 ?rpold)) (and (available-timber ?p ?rpnew) (not (available-timber ?p ?rpold))))) (forall (?rvold - timber_level ?al - timber_atleastlevel) (when (and (available-timber ?v ?rvold) (del-atleast-timber ?rvold tl1 ?al)) (not (available-atleast-timber ?v ?al)))) (forall (?rvold - timber_level ?rvnew - timber_level) (when (and (available-timber ?v ?rvold) (diff-timber ?rvold tl1 ?rvnew)) (and (available-timber ?v ?rvnew) (not (available-timber ?v ?rvold))))) (forall (?sold - space_level ?snew - space_level) (when (and (diff-space ?snew spl1 ?sold) (space-in ?v ?sold)) (and (not (space-in ?v ?sold)) (space-in ?v ?snew)))) (has-space ?v) (increase (total-cost) 5))
  unload-wood: ?v - vehicle ?p - place
      pre: (and (available-atleast-wood ?v wl1) (is-at ?v ?p))
      eff: (and (forall (?rpold - wood_level ?al - wood_atleastlevel) (when (and (add-atleast-wood ?rpold wl1 ?al) (available-wood ?p ?rpold)) (available-atleast-wood ?p ?al))) (forall (?rpold - wood_level ?rpnew - wood_level) (when (and (available-wood ?p ?rpold) (diff-wood ?rpnew wl1 ?rpold)) (and (available-wood ?p ?rpnew) (not (available-wood ?p ?rpold))))) (forall (?rvold - wood_level ?al - wood_atleastlevel) (when (and (available-wood ?v ?rvold) (del-atleast-wood ?rvold wl1 ?al)) (not (available-atleast-wood ?v ?al)))) (forall (?rvold - wood_level ?rvnew - wood_level) (when (and (available-wood ?v ?rvold) (diff-wood ?rvold wl1 ?rvnew)) (and (available-wood ?v ?rvnew) (not (available-wood ?v ?rvold))))) (forall (?sold - space_level ?snew - space_level) (when (and (diff-space ?snew spl1 ?sold) (space-in ?v ?sold)) (and (not (space-in ?v ?sold)) (space-in ?v ?snew)))) (has-space ?v) (increase (total-cost) 5))
