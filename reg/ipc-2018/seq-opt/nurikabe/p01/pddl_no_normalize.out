Domain: nurikabe
Problem: random-3x3-2
Require:
  :conditional-effects
  :disjunctive-preconditions
  :equality
  :existential-preconditions
  :negative-preconditions
  :strips
  :typing
  :universal-preconditions
Type:
  cell - object
  group - object
  num - object
  object
Obj:
  g0 - group
  g1 - group
  n0 - num :constant
  n1 - num
  n2 - num
  pos-0-0 - cell
  pos-0-1 - cell
  pos-0-2 - cell
  pos-1-0 - cell
  pos-1-1 - cell
  pos-1-2 - cell
  pos-2-0 - cell
  pos-2-1 - cell
  pos-2-2 - cell
Predicate:
  (= object object) :eq
  (available cell)
  (blocked cell)
  (connected cell cell)
  (group-painted group)
  (moving)
  (next num num)
  (painted cell)
  (painting group)
  (part-of cell group)
  (remaining-cells group num)
  (robot-pos cell)
  (source cell group)
Function:
Action:
  end-painting: ?g - group
      pre: (and (painting ?g) (remaining-cells ?g n0))
      eff: (and (group-painted ?g) (moving) (not (painting ?g)))
  move-painting: ?from - cell ?to - cell ?g - group ?n1 - num ?n2 - num
      pre: (and (connected ?from ?to) (next ?n2 ?n1) (not (blocked ?to)) (not (painted ?to)) (painting ?g) (remaining-cells ?g ?n1) (robot-pos ?from))
      eff: (and (forall (?cadj - cell) (when (and (available ?cadj) (connected ?to ?cadj)) (and (not (available ?cadj)) (part-of ?cadj ?g)))) (forall (?cadj - cell) (when (and (connected ?to ?cadj) (not (available ?cadj)) (not (part-of ?cadj ?g))) (blocked ?cadj))) (not (remaining-cells ?g ?n1)) (not (robot-pos ?from)) (painted ?to) (remaining-cells ?g ?n2) (robot-pos ?to))
  move: ?from - cell ?to - cell
      pre: (and (connected ?from ?to) (moving) (not (painted ?to)) (robot-pos ?from))
      eff: (and (not (robot-pos ?from)) (robot-pos ?to))
  start-painting: ?c - cell ?g - group ?n1 - num ?n2 - num
      pre: (and (moving) (next ?n2 ?n1) (remaining-cells ?g ?n1) (robot-pos ?c) (source ?c ?g))
      eff: (and (not (moving)) (not (remaining-cells ?g ?n1)) (painted ?c) (painting ?g) (remaining-cells ?g ?n2))
Init:
  (available pos-0-2)
  (available pos-1-2)
  (connected pos-0-0 pos-0-1)
  (connected pos-0-0 pos-1-0)
  (connected pos-0-1 pos-0-0)
  (connected pos-0-1 pos-0-2)
  (connected pos-0-1 pos-1-1)
  (connected pos-0-2 pos-0-1)
  (connected pos-0-2 pos-1-2)
  (connected pos-1-0 pos-0-0)
  (connected pos-1-0 pos-1-1)
  (connected pos-1-0 pos-2-0)
  (connected pos-1-1 pos-0-1)
  (connected pos-1-1 pos-1-0)
  (connected pos-1-1 pos-1-2)
  (connected pos-1-1 pos-2-1)
  (connected pos-1-2 pos-0-2)
  (connected pos-1-2 pos-1-1)
  (connected pos-1-2 pos-2-2)
  (connected pos-2-0 pos-1-0)
  (connected pos-2-0 pos-2-1)
  (connected pos-2-1 pos-1-1)
  (connected pos-2-1 pos-2-0)
  (connected pos-2-1 pos-2-2)
  (connected pos-2-2 pos-1-2)
  (connected pos-2-2 pos-2-1)
  (moving)
  (next n0 n1)
  (next n1 n2)
  (part-of pos-0-1 g0)
  (part-of pos-1-0 g0)
  (part-of pos-1-1 g1)
  (part-of pos-2-0 g1)
  (part-of pos-2-2 g1)
  (remaining-cells g0 n2)
  (remaining-cells g1 n1)
  (robot-pos pos-0-0)
  (source pos-0-0 g0)
  (source pos-2-1 g1)
Goal:
  (and (group-painted g0) (group-painted g1))
Metric:
Pred prop:
  (available cell): in_init in_pre in_pre_neg in_eff
  (blocked cell): in_pre in_pre_neg in_eff
  (connected cell cell): in_init in_pre
  (group-painted group): in_goal in_eff
  (moving): in_init in_pre in_eff
  (next num num): in_init in_pre
  (painted cell): in_pre in_pre_neg in_eff
  (painting group): in_pre in_eff
  (part-of cell group): in_init in_pre in_pre_neg in_eff
  (remaining-cells group num): in_init in_pre in_eff
  (robot-pos cell): in_init in_pre in_eff
  (source cell group): in_init in_pre
Func prop:
Global prop:
  has_cond_eff
  has_non_static_neg_cond
  is_unit_cost
