    start-painting: ?c:1 ?g:3 ?n1:2 ?n2:2
        pre: (and (R:next ?n2 ?n1) (R:source ?c ?g) (RW:remaining-cells ?g ?n1) (RW:robot-pos ?c) (RW:moving))
        eff: (and (RW:painted ?c) (N:RW:remaining-cells ?g ?n1) (RW:remaining-cells ?g ?n2) (N:RW:moving) (RW:painting ?g))
    move-painting: ?from:1 ?to:1 ?g:3 ?n1:2 ?n2:2
        pre: (and (R:next ?n2 ?n1) (R:connected ?from ?to) (N:RW:painted ?to) (N:RW:blocked ?to) (RW:remaining-cells ?g ?n1) (RW:robot-pos ?from) (RW:painting ?g))
        eff: (and (RW:painted ?to) (N:RW:remaining-cells ?g ?n1) (RW:remaining-cells ?g ?n2) (N:RW:robot-pos ?from) (RW:robot-pos ?to) (forall (?cadj:1 I[0]:?from:1 I[1]:?to:1 I[2]:?g:3 I[3]:?n1:2 I[4]:?n2:2) (when (and (R:connected ?to ?cadj) (RW:available ?cadj)) (and (N:RW:available ?cadj) (RW:part-of ?cadj ?g)))) (forall (?cadj:1 I[0]:?from:1 I[1]:?to:1 I[2]:?g:3 I[3]:?n1:2 I[4]:?n2:2) (when (and (R:connected ?to ?cadj) (N:RW:available ?cadj) (N:RW:part-of ?cadj ?g)) (RW:blocked ?cadj))))
    end-painting: ?g:3
        pre: (and (RW:remaining-cells ?g n0) (RW:painting ?g))
        eff: (and (RW:moving) (N:RW:painting ?g) (RW:group-painted ?g))
