Function:
Action:
  end-painting: ?g - group
      pre: (and (painting ?g) (remaining-cells ?g n0))
      eff: (and (group-painted ?g) (moving) (not (painting ?g)))
  move-painting: ?from - cell ?to - cell ?g - group ?n1 - num ?n2 - num
      pre: (and (NOT-blocked ?to) (NOT-painted ?to) (connected ?from ?to) (next ?n2 ?n1) (painting ?g) (remaining-cells ?g ?n1) (robot-pos ?from))
      eff: (and (not (NOT-painted ?to)) (not (remaining-cells ?g ?n1)) (not (robot-pos ?from)) (remaining-cells ?g ?n2) (robot-pos ?to) (when (and (NOT-available pos-0-0) (NOT-part-of pos-0-0 ?g) (connected ?to pos-0-0)) (not (NOT-blocked pos-0-0))) (when (and (NOT-available pos-0-1) (NOT-part-of pos-0-1 ?g) (connected ?to pos-0-1)) (not (NOT-blocked pos-0-1))) (when (and (NOT-available pos-0-2) (NOT-part-of pos-0-2 ?g) (connected ?to pos-0-2)) (not (NOT-blocked pos-0-2))) (when (and (NOT-available pos-1-0) (NOT-part-of pos-1-0 ?g) (connected ?to pos-1-0)) (not (NOT-blocked pos-1-0))) (when (and (NOT-available pos-1-1) (NOT-part-of pos-1-1 ?g) (connected ?to pos-1-1)) (not (NOT-blocked pos-1-1))) (when (and (NOT-available pos-1-2) (NOT-part-of pos-1-2 ?g) (connected ?to pos-1-2)) (not (NOT-blocked pos-1-2))) (when (and (NOT-available pos-2-0) (NOT-part-of pos-2-0 ?g) (connected ?to pos-2-0)) (not (NOT-blocked pos-2-0))) (when (and (NOT-available pos-2-1) (NOT-part-of pos-2-1 ?g) (connected ?to pos-2-1)) (not (NOT-blocked pos-2-1))) (when (and (NOT-available pos-2-2) (NOT-part-of pos-2-2 ?g) (connected ?to pos-2-2)) (not (NOT-blocked pos-2-2))) (when (and (available pos-0-0) (connected ?to pos-0-0)) (and (NOT-available pos-0-0) (not (NOT-part-of pos-0-0 ?g)) (not (available pos-0-0)))) (when (and (available pos-0-1) (connected ?to pos-0-1)) (and (NOT-available pos-0-1) (not (NOT-part-of pos-0-1 ?g)) (not (available pos-0-1)))) (when (and (available pos-0-2) (connected ?to pos-0-2)) (and (NOT-available pos-0-2) (not (NOT-part-of pos-0-2 ?g)) (not (available pos-0-2)))) (when (and (available pos-1-0) (connected ?to pos-1-0)) (and (NOT-available pos-1-0) (not (NOT-part-of pos-1-0 ?g)) (not (available pos-1-0)))) (when (and (available pos-1-1) (connected ?to pos-1-1)) (and (NOT-available pos-1-1) (not (NOT-part-of pos-1-1 ?g)) (not (available pos-1-1)))) (when (and (available pos-1-2) (connected ?to pos-1-2)) (and (NOT-available pos-1-2) (not (NOT-part-of pos-1-2 ?g)) (not (available pos-1-2)))) (when (and (available pos-2-0) (connected ?to pos-2-0)) (and (NOT-available pos-2-0) (not (NOT-part-of pos-2-0 ?g)) (not (available pos-2-0)))) (when (and (available pos-2-1) (connected ?to pos-2-1)) (and (NOT-available pos-2-1) (not (NOT-part-of pos-2-1 ?g)) (not (available pos-2-1)))) (when (and (available pos-2-2) (connected ?to pos-2-2)) (and (NOT-available pos-2-2) (not (NOT-part-of pos-2-2 ?g)) (not (available pos-2-2)))))
  move: ?from - cell ?to - cell
      pre: (and (NOT-painted ?to) (connected ?from ?to) (moving) (robot-pos ?from))
      eff: (and (not (robot-pos ?from)) (robot-pos ?to))
  start-painting: ?c - cell ?g - group ?n1 - num ?n2 - num
      pre: (and (moving) (next ?n2 ?n1) (remaining-cells ?g ?n1) (robot-pos ?c) (source ?c ?g))
      eff: (and (not (NOT-painted ?c)) (not (moving)) (not (remaining-cells ?g ?n1)) (painting ?g) (remaining-cells ?g ?n2))
