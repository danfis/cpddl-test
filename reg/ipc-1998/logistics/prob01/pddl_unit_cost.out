Function:
Action:
  drive-truck: ?truck - object ?loc-from - object ?loc-to - object ?city - object
      pre: (and (at ?truck ?loc-from) (city ?city) (in-city ?loc-from ?city) (in-city ?loc-to ?city) (location ?loc-from) (location ?loc-to) (truck ?truck))
      eff: (and (at ?truck ?loc-to) (not (at ?truck ?loc-from)))
  fly-airplane: ?airplane - object ?loc-from - object ?loc-to - object
      pre: (and (airplane ?airplane) (airport ?loc-from) (airport ?loc-to) (at ?airplane ?loc-from))
      eff: (and (at ?airplane ?loc-to) (not (at ?airplane ?loc-from)))
  load-airplane: ?obj - object ?airplane - object ?loc - object
      pre: (and (airplane ?airplane) (at ?airplane ?loc) (at ?obj ?loc) (location ?loc) (obj ?obj))
      eff: (and (in ?obj ?airplane) (not (at ?obj ?loc)))
  load-truck: ?obj - object ?truck - object ?loc - object
      pre: (and (at ?obj ?loc) (at ?truck ?loc) (location ?loc) (obj ?obj) (truck ?truck))
      eff: (and (in ?obj ?truck) (not (at ?obj ?loc)))
  unload-airplane: ?obj - object ?airplane - object ?loc - object
      pre: (and (airplane ?airplane) (at ?airplane ?loc) (in ?obj ?airplane) (location ?loc) (obj ?obj))
      eff: (and (at ?obj ?loc) (not (in ?obj ?airplane)))
  unload-truck: ?obj - object ?truck - object ?loc - object
      pre: (and (at ?truck ?loc) (in ?obj ?truck) (location ?loc) (obj ?obj) (truck ?truck))
      eff: (and (at ?obj ?loc) (not (in ?obj ?truck)))
