Action:
  drink: ?n1 - object ?n2 - object ?l11 - object ?l12 - object ?l13 - object ?l21 - object ?l22 - object
      pre: (and (attacks ?l12 ?l11) (attacks ?l13 ?l12) (attacks ?l21 ?l22) (locale ?n1 ?l11) (locale ?n2 ?l21) (not (= ?n1 ?n2)))
      eff: (and (locale ?n1 ?l12) (locale ?n2 ?l22) (not (locale ?n1 ?l11)) (not (locale ?n2 ?l21)))
  feast: ?v - object ?n1 - object ?n2 - object ?l1 - object ?l2 - object
      pre: (and (attacks ?l1 ?l2) (craves ?v ?n1) (eats ?n1 ?n2) (food ?n1) (food ?n2) (locale ?n1 ?l2) (pleasure ?v))
      eff: (and (craves ?v ?n2) (locale ?n1 ?l1) (not (craves ?v ?n1)) (not (locale ?n1 ?l2)))
  overcome: ?c - object ?v - object ?n - object ?s1 - object ?s2 - object
      pre: (and (craves ?c ?n) (craves ?v ?n) (food ?n) (harmony ?v ?s2) (orbits ?s1 ?s2) (pain ?c) (planet ?s1) (planet ?s2) (pleasure ?v))
      eff: (and (fears ?c ?v) (harmony ?v ?s1) (not (craves ?c ?n)) (not (harmony ?v ?s2)))
  succumb: ?c - object ?v - object ?n - object ?s1 - object ?s2 - object
      pre: (and (craves ?v ?n) (fears ?c ?v) (food ?n) (harmony ?v ?s1) (orbits ?s1 ?s2) (pain ?c) (pleasure ?v))
      eff: (and (craves ?c ?n) (harmony ?v ?s2) (not (fears ?c ?v)) (not (harmony ?v ?s1)))
