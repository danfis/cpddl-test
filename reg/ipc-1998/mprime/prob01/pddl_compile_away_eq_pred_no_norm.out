  + drink: ?n1 - object ?n2 - object ?l11 - object ?l12 - object ?l13 - object ?l21 - object ?l22 - object
      pre: (and (attacks ?l12 ?l11) (attacks ?l13 ?l12) (attacks ?l21 ?l22) (locale ?n1 ?l11) (locale ?n2 ?l21) (not (equal ?n1 ?n2)))
      eff: (and (locale ?n1 ?l12) (locale ?n2 ?l22) (not (locale ?n1 ?l11)) (not (locale ?n2 ?l21)))
