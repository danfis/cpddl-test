Require:
  + :equality
  + :negative-preconditions
Action:
  - succumb: ?c - object ?v - object ?n - object ?s1 - object ?s2 - object
      pre: (and (craves ?v ?n) (fears ?c ?v) (food ?n) (harmony ?v ?s1) (orbits ?s1 ?s2) (pain ?c) (pleasure ?v))
      eff: (and (craves ?c ?n) (harmony ?v ?s2) (not (fears ?c ?v)) (not (harmony ?v ?s1)))
  + succumb: ?c - object ?v - object ?n - object ?s1 - object ?s2 - object
      pre: (and (craves ?v ?n) (fears ?c ?v) (food ?n) (harmony ?v ?s1) (not (= ?c ?v)) (orbits ?s1 ?s2) (pain ?c) (pleasure ?v))
      eff: (and (craves ?c ?n) (harmony ?v ?s2) (not (fears ?c ?v)) (not (harmony ?v ?s1)))
Pred prop:
  + (= object object): in_pre
